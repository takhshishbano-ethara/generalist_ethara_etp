<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="kaiju_dashboard.KaijuShowcase">
        <div class="kj-showcase">
            <header class="kj-showcase-header">
                <span class="kj-tag">LIBRARY GENERATION &#xB7; RL ENVIRONMENT</span>
                <h1 class="kj-title">KAIJU</h1>
                <p class="kj-subtitle">
                    From-Scratch Library Generation &#xB7; Go, Python, Rust &#xB7; held-out test grading
                </p>
                <p class="kj-byline">
                    by <strong>Ethara AI</strong> &#xB7;
                    <a href="https://www.ethara.ai" target="_blank" rel="noopener">www.ethara.ai</a>
                </p>
            </header>

            <section class="kj-section kj-description">
                <p>
                    Kaiju is a reinforcement-learning environment for agentic code
                    generation. Each of its library-generation tasks drops a coding agent
                    into a hermetic container with a specification and build config and no
                    test code, asks it to implement a complete open-source library from
                    scratch across Go, Python, and Rust, and grades the result against a
                    held-out test suite. The module-level pass fraction is the scalar reward.
                </p>
            </section>

            <section class="kj-section kj-capabilities">
                <ul class="kj-capabilities-list">
                    <li><span class="kj-cap-arrow">&#x2192;</span> Specification-driven generation: build a complete library from a spec alone</li>
                    <li><span class="kj-cap-arrow">&#x2192;</span> Three languages: Go, Python, and Rust libraries built from scratch</li>
                    <li><span class="kj-cap-arrow">&#x2192;</span> Held-out grading: the agent never sees the test suite it is scored on</li>
                    <li><span class="kj-cap-arrow">&#x2192;</span> Hermetic, offline build verification with a per-project test harness</li>
                    <li><span class="kj-cap-arrow">&#x2192;</span> Dense scalar reward = modules passed / total &#x2208; [0, 1], reported per stage</li>
                </ul>
            </section>

            <section class="kj-section kj-metrics">
                <div class="kj-metric-grid">
                    <div class="kj-metric-card">
                        <span class="kj-metric-value">23</span>
                        <span class="kj-metric-label">Library Tasks</span>
                        <span class="kj-metric-detail">5 Go &#xB7; 6 Python &#xB7; 12 Rust</span>
                    </div>
                    <div class="kj-metric-card">
                        <span class="kj-metric-value">12,402</span>
                        <span class="kj-metric-label">Held-out Tests</span>
                        <span class="kj-metric-detail">across 23 real libraries</span>
                    </div>
                    <div class="kj-metric-card">
                        <span class="kj-metric-value">3</span>
                        <span class="kj-metric-label">Languages</span>
                        <span class="kj-metric-detail">Go &#xB7; Python &#xB7; Rust</span>
                    </div>
                    <div class="kj-metric-card">
                        <span class="kj-metric-value">1</span>
                        <span class="kj-metric-label">Calibration Model</span>
                        <span class="kj-metric-detail">Claude Opus 4.8</span>
                    </div>
                </div>
            </section>

            <section class="kj-section kj-phases">
                <div class="kj-phases-row">
                    <div class="kj-phase-card">
                        <div class="kj-phase-number">1</div>
                        <h3>Environment &amp; Spec</h3>
                        <p>
                            Ship a hermetic container with a specification and build config.
                            No test code is exposed to the agent.
                        </p>
                    </div>
                    <div class="kj-phase-arrow">&#x2192;</div>
                    <div class="kj-phase-card">
                        <div class="kj-phase-number">2</div>
                        <h3>Agent Builds Library</h3>
                        <p>
                            The agent implements the complete library from scratch across a
                            draft, lint, and test refinement pipeline.
                        </p>
                    </div>
                    <div class="kj-phase-arrow">&#x2192;</div>
                    <div class="kj-phase-card">
                        <div class="kj-phase-number">3</div>
                        <h3>Grade via test suite</h3>
                        <p>
                            The held-out suite runs and reward = modules passed / total
                            becomes the RL signal.
                        </p>
                    </div>
                </div>
            </section>

            <section class="kj-section kj-links">
                <a class="kj-btn" t-att-href="state.trajectoriesUrl"
                   target="_blank" rel="noopener">
                    Repository
                </a>
                <a class="kj-btn kj-btn-filled" t-att-href="state.datasetUrl"
                   target="_blank" rel="noopener">
                    Dataset
                </a>
            </section>
        </div>
    </t>
</templates>
