<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_kaiju_dashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kaiju_dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Kaiju Dashboard" string="Kaiju Dashboard" name="kaiju_dashboard">
                    <block title="Showcase Link Buttons">
                        <setting string="Trajectories URL"
                                 help="Override the Trajectories button link. Leave empty to use the default GitHub URL.">
                            <field name="kaiju_trajectories_url"
                                   placeholder="https://github.com/EtharaOrion/kaiju-samples.git"/>
                        </setting>
                        <setting string="Dataset URL"
                                 help="Override the Dataset button link. Leave empty to use the default HuggingFace URL.">
                            <field name="kaiju_dataset_url"
                                   placeholder="https://huggingface.co/datasets/ethara/kaiju-samples"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
