<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_submit_pending_builds" model="ir.cron">
            <field name="name">Kaiju: Submit Pending Builds to Argo</field>
            <field name="model_id" ref="model_kaiju_commit0"/>
            <field name="code">model._cron_submit_pending_builds()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">50</field>
        </record>

        <record id="ir_cron_poll_build_status" model="ir.cron">
            <field name="name">Kaiju: Poll Build Status</field>
            <field name="model_id" ref="model_kaiju_commit0"/>
            <field name="code">model._cron_poll_build_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">100</field>
        </record>

        <record id="ir_cron_poll_run_status" model="ir.cron">
            <field name="name">Kaiju: Poll Run Status</field>
            <field name="model_id" ref="model_kaiju_commit0_run"/>
            <field name="code">model._cron_poll_run_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">100</field>
        </record>

    </data>
</odoo>
