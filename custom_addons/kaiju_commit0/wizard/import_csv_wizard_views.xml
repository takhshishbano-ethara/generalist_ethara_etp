<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_csv_wizard_form" model="ir.ui.view">
        <field name="name">kaiju.commit0.import.wizard.form</field>
        <field name="model">kaiju.commit0.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Bulk Builds">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <strong>Expected CSV columns:</strong> repo_name, language, branch_name<br/>
                    <small class="text-muted">
                        Only <code>repo_name</code> is required (owner/repo format).
                        Language defaults to "python", branch to "commit0_combined".
                    </small>
                </div>
                <footer>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_csv_wizard" model="ir.actions.act_window">
        <field name="name">Import Bulk Builds (CSV)</field>
        <field name="res_model">kaiju.commit0.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
