<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         LIST VIEW — Builds
         ════════════════════════════════════════════════════════════════════ -->

    <record id="view_kaiju_commit0_tree" model="ir.ui.view">
        <field name="name">kaiju.commit0.list</field>
        <field name="model">kaiju.commit0</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="%(action_import_csv_wizard)d" type="action"
                            string="Import CSV" class="btn-secondary"
                            icon="fa-upload"/>
                    <button name="action_sync_all_logs" type="object"
                            string="Sync All Logs" class="btn-secondary"
                            icon="fa-cloud-download"/>
                </header>
                <field name="name" string="Build ID"/>
                <field name="repo_name"/>
                <field name="language"/>
                <field name="build_status" widget="badge" string="Build"
                       decoration-info="build_status == 'pending'"
                       decoration-warning="build_status == 'running'"
                       decoration-success="build_status == 'done'"
                       decoration-danger="build_status == 'failed'"/>
                <field name="error_summary" optional="show"
                       decoration-danger="build_status == 'failed'"/>
                <field name="run_count" string="Runs"/>
                <field name="image_uri" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         FORM VIEW — Build (2-phase stepper)
         ════════════════════════════════════════════════════════════════════ -->

    <record id="view_kaiju_commit0_form" model="ir.ui.view">
        <field name="name">kaiju.commit0.form</field>
        <field name="model">kaiju.commit0</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_abort" type="object"
                            string="Abort Build"
                            class="btn-danger"
                            invisible="build_status != 'running'"
                            confirm="This will abort the running build. Continue?"/>

                    <button name="action_reset" type="object"
                            string="Reset"
                            class="btn-secondary"
                            invisible="not config_valid or build_status == 'running'"
                            confirm="This will reset configuration and build. Runs are kept. Continue?"/>

                    <button name="action_sync_logs" type="object"
                            string="Sync Logs"
                            class="btn-secondary"
                            icon="fa-cloud-download"
                            invisible="not s3_log_prefix or build_status == 'running'"
                            help="Download step logs from S3 (uploaded by the Argo exit hook on workflow completion)."/>

                    <button name="action_fetch_pipeline_metadata" type="object"
                            string="Refresh Metadata"
                            class="btn-secondary"
                            icon="fa-refresh"
                            invisible="not s3_dataset_uri"
                            help="Re-download dataset_entries.json from S3 and refresh pipeline metadata (base/reference commits, instance ID, forked repo)."/>
                </header>

                <sheet>
                    <div class="oe_title mb-0">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <field name="current_phase" widget="commit0_stepper"/>

                    <field name="config_valid" invisible="1"/>
                    <field name="build_status" invisible="1"/>
                    <field name="is_build_running" invisible="1"/>
                    <field name="can_go_next" invisible="1"/>
                    <field name="can_go_back" invisible="1"/>
                    <field name="can_create_run" invisible="1"/>
                    <field name="run_count" invisible="1"/>
                    <field name="step_count" invisible="1"/>

                    <!-- ══════════════════════════════════════════════════
                         SCREEN 1: Configuration
                         ══════════════════════════════════════════════════ -->

                    <div class="c0-phase-screen" invisible="current_phase != 'config'">
                        <div class="c0-phase-header">
                            <h3>Build Configuration</h3>
                            <p class="text-muted">Set up repository and language.</p>
                        </div>
                        <group>
                            <group>
                                <field name="repo_name"
                                       placeholder="e.g. Zahgon/gson"
                                       readonly="build_status in ('running','done')"/>
                                <field name="language"
                                       readonly="build_status in ('running','done')"/>
                            </group>
                        </group>

                        <div class="c0-phase-hint mt-2">
                            <span class="text-muted small">
                                <i class="fa fa-info-circle me-1"/>
                                Set repository in <b>owner/repo</b> format, then click <b>Next →</b> to proceed to the Build phase.
                            </span>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         SCREEN 2: Build (prepare + build-repo-image)
                         ══════════════════════════════════════════════════ -->

                    <div class="c0-phase-screen" invisible="current_phase != 'build'">
                        <div class="c0-phase-header">
                            <h3>Build Pipeline</h3>
                            <p class="text-muted">Prepare dataset, generate Dockerfile, build and push image to ECR.</p>
                        </div>

                        <div class="c0-phase-meta" invisible="not build_start">
                            <group>
                                <group>
                                    <field name="build_start"/>
                                    <field name="build_end" invisible="not build_end"/>
                                </group>
                                <group>
                                    <field name="build_status" widget="badge"
                                           decoration-info="build_status == 'pending'"
                                           decoration-warning="build_status == 'running'"
                                           decoration-success="build_status == 'done'"
                                           decoration-danger="build_status == 'failed'"/>
                                </group>
                            </group>
                        </div>

                        <!-- Hide Start Build when: already running/done, OR CSV-queued waiting for submit cron -->
                        <div class="c0-phase-action" invisible="build_status in ('done', 'running') or (build_status == 'pending' and submit_attempts &gt; 0)">
                            <button name="action_run_build" type="object"
                                    string="Start Build"
                                    class="btn-primary"/>
                        </div>
                        <!-- Queued indicator (CSV import created this record; submit cron will launch within ~1 min) -->
                        <div class="alert alert-info" role="alert"
                             invisible="not (build_status == 'pending' and submit_attempts &gt; 0)">
                            <i class="fa fa-clock-o me-2"/>
                            <strong>Queued.</strong> Waiting for submit cron (runs every minute). Attempts: <field name="submit_attempts" readonly="1" class="d-inline"/>/3.
                            <div invisible="not submit_error" class="mt-1 text-muted small">Last error: <field name="submit_error" readonly="1" nolabel="1" class="d-inline"/></div>
                        </div>

                        <field name="build_log" widget="commit0_terminal"
                               invisible="not build_log"/>

                        <!-- ═══ Error Banner (only when failed) ═══ -->
                        <div class="alert alert-danger mt-3"
                             invisible="build_status != 'failed' or not error_summary"
                             role="alert">
                            <div class="d-flex align-items-start">
                                <i class="fa fa-exclamation-triangle fa-lg me-2 mt-1"/>
                                <div>
                                    <strong>Build failed.</strong>
                                    <div class="mt-1">
                                        <field name="error_summary" readonly="1" nolabel="1"/>
                                    </div>
                                    <small class="text-muted">Check the failed step's logs below.</small>
                                </div>
                            </div>
                        </div>

                        <!-- ═══ Workflow Steps + Logs (notebook with two views) ═══ -->
                        <div invisible="build_status == 'pending'">
                            <h5 class="mt-3 mb-2">
                                <i class="fa fa-tasks me-2"/>Workflow Steps &amp; Logs
                                <span class="badge text-bg-secondary ms-2"
                                      invisible="step_count == 0">
                                    <field name="step_count" readonly="1" nolabel="1"/> steps
                                </span>
                            </h5>

                            <notebook>
                                <page string="Per-Step" name="per_step">
                                    <p class="text-muted small">
                                        Each row is one pipeline pod (prepare, build-repo-image, callback).
                                        Click a step to view its full pod logs.
                                    </p>
                                    <field name="step_ids" readonly="1">
                                        <list decoration-danger="phase in ('Failed', 'Error')"
                                              decoration-warning="phase == 'Running'"
                                              decoration-success="phase == 'Succeeded'"
                                              decoration-muted="phase in ('Skipped', 'Omitted')">
                                            <field name="step_name" string="Step"/>
                                            <field name="phase" widget="badge"
                                                   decoration-info="phase == 'Pending'"
                                                   decoration-warning="phase == 'Running'"
                                                   decoration-success="phase == 'Succeeded'"
                                                   decoration-danger="phase in ('Failed', 'Error')"
                                                   decoration-muted="phase in ('Skipped', 'Omitted')"/>
                                            <field name="started_at" string="Started"/>
                                            <field name="finished_at" string="Finished"/>
                                            <field name="duration_seconds" string="Duration (s)"
                                                   widget="float_time" optional="show"/>
                                            <field name="log_size_human" string="Log Size"
                                                   optional="show"/>
                                            <field name="has_log" widget="boolean_toggle"
                                                   string="Captured" optional="show" readonly="1"/>
                                            <field name="log_fetched_at" string="Fetched"
                                                   optional="hide"/>
                                            <field name="pod_name" optional="hide"/>
                                            <field name="template_name" optional="hide"/>
                                            <field name="message" optional="hide"/>
                                        </list>
                                    </field>
                                </page>

                                <page string="Combined Logs" name="combined_logs">
                                    <p class="text-muted small">
                                        All step logs concatenated chronologically with step headers —
                                        useful for tracing the full pipeline execution flow.
                                        Use <kbd>Ctrl+F</kbd> in your browser to search across all steps.
                                    </p>
                                    <field name="combined_log_text" widget="commit0_terminal"
                                           nolabel="1" readonly="1"
                                           invisible="not combined_log_text"/>
                                    <div class="alert alert-info" invisible="combined_log_text">
                                        <i class="fa fa-info-circle me-2"/>
                                        No logs captured yet. Click
                                        <b>Sync Logs</b> in the header to download from S3.
                                    </div>
                                </page>
                            </notebook>
                        </div>

                        <!-- ═══ Datasets — slim view (binary + HF link) ═══ -->
                        <div class="c0-pipeline-metadata mt-3" invisible="build_status != 'done'">
                            <h5 class="mt-3 mb-2">
                                <i class="fa fa-database me-2"/>Datasets
                            </h5>
                            <p class="text-muted small" invisible="dataset_file or metadata_error">
                                Click <b>Refresh Metadata</b> in the header to download the dataset from S3.
                            </p>
                            <p class="text-danger small" invisible="not metadata_error">
                                <i class="fa fa-exclamation-triangle me-1"/>
                                Metadata fetch error: <field name="metadata_error" readonly="1" nolabel="1"/>
                            </p>

                            <notebook>
                                <page string="Datasets" name="datasets">
                                    <group>
                                        <group string="Hugging Face">
                                            <field name="hf_dataset_url"
                                                   widget="url"
                                                   string="Hugging Face"
                                                   readonly="1"
                                                   nolabel="1"/>
                                        </group>
                                    </group>
                                    <separator string="Dataset (dataset_entries.json)"/>
                                    <p class="text-muted small" invisible="dataset_json_text">
                                        No dataset cached yet. Click <b>Refresh Metadata</b> in the header to download from S3.
                                    </p>
                                    <field name="dataset_filename" invisible="1"/>
                                    <field name="dataset_file" invisible="1"/>
                                    <field name="dataset_json_text"
                                           widget="ace"
                                           options="{'mode': 'json'}"
                                           nolabel="1"
                                           readonly="1"
                                           invisible="not dataset_json_text"/>
                                </page>
                            </notebook>
                        </div>

                        <div class="mt-4" invisible="build_status != 'done'">
                            <div class="d-flex align-items-center gap-3">
                                <button name="action_create_run" type="object"
                                        string="Create Run"
                                        class="btn-primary"
                                        icon="fa-plus"/>
                                <button name="action_view_runs" type="object"
                                        string="View All Runs"
                                        class="btn-secondary"
                                        icon="fa-list"
                                        invisible="run_count == 0"/>
                                <span class="text-muted" invisible="run_count == 0">
                                    (<field name="run_count" readonly="1"/> runs)
                                </span>
                            </div>
                        </div>

                        <div invisible="run_count == 0 or build_status != 'done'">
                            <h5 class="mt-4 mb-2">Runs</h5>
                            <field name="run_ids" readonly="1">
                                <list>
                                    <field name="name" string="Run ID"/>
                                    <field name="model_name" string="Model"/>
                                    <field name="num_samples" string="Samples"/>
                                    <field name="run_status" widget="badge" string="Status"
                                           decoration-info="run_status == 'pending'"
                                           decoration-warning="run_status == 'running'"
                                           decoration-success="run_status == 'done'"
                                           decoration-danger="run_status == 'failed'"/>
                                    <field name="pass_rate" widget="progressbar"/>
                                    <field name="cost_usd" string="Cost ($)"/>
                                </list>
                            </field>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         NAVIGATION BAR
                         ══════════════════════════════════════════════════ -->

                    <div class="c0-nav-bar">
                        <button name="action_prev_phase" type="object"
                                string="← Back"
                                class="btn btn-secondary"
                                invisible="not can_go_back"/>

                        <div class="c0-nav-spacer"/>

                        <button name="action_next_phase" type="object"
                                string="Next →"
                                class="btn btn-primary"
                                invisible="not can_go_next"/>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         ACTION
         ════════════════════════════════════════════════════════════════════ -->

    <record id="action_kaiju_commit0" model="ir.actions.act_window">
        <field name="name">Builds</field>
        <field name="res_model">kaiju.commit0</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         LIST VIEW — Ready for Evaluation (completed builds)
         ════════════════════════════════════════════════════════════════════ -->

    <record id="view_kaiju_commit0_eval_ready_tree" model="ir.ui.view">
        <field name="name">kaiju.commit0.eval.ready.list</field>
        <field name="model">kaiju.commit0</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_create_run" type="object"
                            string="Create Run" class="btn-primary"
                            icon="fa-play"/>
                </header>
                <field name="name" string="Build ID"/>
                <field name="repo_name" string="Repository"/>
                <field name="language"/>
                <field name="build_end" string="Built On"/>
                <field name="image_uri" string="Image" optional="show"/>
                <field name="run_count" string="Runs"/>
                <field name="build_status" widget="badge" string="Build"
                       decoration-success="build_status == 'done'"/>
            </list>
        </field>
    </record>

    <!-- ACTION — Ready for Evaluation -->

    <record id="action_kaiju_commit0_eval_ready" model="ir.actions.act_window">
        <field name="name">Ready for Evaluation</field>
        <field name="res_model">kaiju.commit0</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('build_status', '=', 'done')]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kaiju_commit0_eval_ready_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_kaiju_commit0_form')})]"/>
    </record>

    <record id="action_server_sync_build_logs" model="ir.actions.server">
        <field name="name">Sync Logs</field>
        <field name="model_id" ref="model_kaiju_commit0"/>
        <field name="binding_model_id" ref="model_kaiju_commit0"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_sync_logs()</field>
    </record>

</odoo>
