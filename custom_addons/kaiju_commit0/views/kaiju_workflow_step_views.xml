<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         LIST VIEW — Workflow Steps
         ════════════════════════════════════════════════════════════════════ -->

    <record id="view_kaiju_workflow_step_tree" model="ir.ui.view">
        <field name="name">kaiju.commit0.workflow.step.list</field>
        <field name="model">kaiju.commit0.workflow.step</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" string="Step" widget="char"/>
                <field name="phase" widget="badge"
                       decoration-info="phase == 'Pending'"
                       decoration-warning="phase == 'Running'"
                       decoration-success="phase == 'Succeeded'"
                       decoration-danger="phase in ('Failed', 'Error')"
                       decoration-muted="phase in ('Skipped', 'Omitted')"/>
                <field name="started_at"/>
                <field name="finished_at" optional="show"/>
                <field name="pod_name" optional="hide"/>
                <field name="template_name" optional="hide"/>
                <field name="log_fetched_at" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         FORM VIEW — Workflow Step (with terminal log viewer)
         ════════════════════════════════════════════════════════════════════ -->

    <record id="view_kaiju_workflow_step_form" model="ir.ui.view">
        <field name="name">kaiju.commit0.workflow.step.form</field>
        <field name="model">kaiju.commit0.workflow.step</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Refresh Logs button removed — logs are synced from S3
                         via the parent build/run's "Sync Logs" action. -->
                    <field name="phase" widget="statusbar"
                           statusbar_visible="Pending,Running,Succeeded,Failed"/>
                </header>

                <sheet>
                    <div class="oe_title mb-0">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Identifiers">
                            <field name="node_id"/>
                            <field name="pod_name"/>
                            <field name="template_name"/>
                            <field name="node_type"/>
                        </group>
                        <group string="Timing">
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="log_fetched_at"/>
                            <field name="workflow_name"/>
                        </group>
                    </group>

                    <group invisible="not message">
                        <field name="message" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Logs" name="logs">
                            <field name="log_text" widget="commit0_terminal" nolabel="1"/>
                        </page>
                        <page string="Fetch Diagnostic" name="diagnostic"
                              invisible="not last_fetch_diagnostic">
                            <div class="alert alert-info" role="alert">
                                <strong>Last log-fetch attempt details.</strong>
                                Use this to troubleshoot when logs are missing.
                            </div>
                            <field name="last_fetch_diagnostic" nolabel="1" readonly="1"
                                   widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         ACTION — Standalone steps browser (optional, not menu-linked)
         ════════════════════════════════════════════════════════════════════ -->

    <record id="action_kaiju_workflow_step" model="ir.actions.act_window">
        <field name="name">Workflow Steps</field>
        <field name="res_model">kaiju.commit0.workflow.step</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
