<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_kaiju_build" model="ir.module.category">
            <field name="name">Kaiju Build</field>
            <field name="description">Kaiju — Docker image build platform</field>
            <field name="sequence">31</field>
        </record>

        <!-- Privilege (Odoo 19 pattern) -->
        <record id="res_groups_privilege_kaiju_build" model="res.groups.privilege">
            <field name="name">Kaiju Build</field>
            <field name="sequence">31</field>
            <field name="category_id" ref="module_category_kaiju_build"/>
        </record>

    </data>

    <data noupdate="1">

        <!-- User Group -->
        <record id="group_kaiju_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_kaiju_build"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view builds and trigger builds for registered apps.</field>
        </record>

        <!-- Admin Group (implies User) -->
        <record id="group_kaiju_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="res_groups_privilege_kaiju_build"/>
            <field name="implied_ids" eval="[(4, ref('group_kaiju_user'))]"/>
            <field name="comment">Full access: manage apps, builds, and configuration.</field>
        </record>

        <!-- Record Rules: Users see only own builds, Admins see all -->

        <record id="rule_kaiju_build_user" model="ir.rule">
            <field name="name">Kaiju Build: own records only</field>
            <field name="model_id" ref="model_kaiju_build"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_kaiju_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_kaiju_build_admin" model="ir.rule">
            <field name="name">Kaiju Build: admin sees all</field>
            <field name="model_id" ref="model_kaiju_build"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_kaiju_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
