                <div class="vx-card">
                    <div class="vx-card-header vx-header-gpt">GPT External Preference</div>
                    <div class="vx-card-body">
                        <t t-set="gext" t-value="task['comparisons']['gpt_external']"/>
                        <p class="vx-pref-hint"><b>-3</b> (Ophelia wins) to <b>+3</b> (GPT wins)</p>
                        <div t-attf-class="vx-pref-badges #{gext['error_preference'] and 'vx-pref-error' or ''}" data-field="gpt_preference" data-scale="pref">
                            <t t-foreach="[('-3','Oph+++'),('-2','Oph++'),('-1','Oph+'),('0','Tie'),('1','GPT+'),('2','GPT++'),('3','GPT+++')]" t-as="pv">
