                    <div class="vx-card-body">
                        <t t-foreach="['truthfulness','instruction_following','writing_quality','verbosity','prompt_correctness','overall_quality']" t-as="dim">
                            <t t-set="sd" t-value="task['scores']['gpt_sxs'][dim]"/>
                            <t t-set="fn" t-value="'gpt_%s_a' % dim"/>
                            <div t-attf-class="vx-dimension #{sd['error'] and 'vx-dimension-error' or ''}">
                                <div class="vx-dim-header">
                                    <span class="vx-dim-label"><t t-out="dim.replace('_',' ').title()"/></span>
                                    <t t-if="sd['reason']"><span class="vx-ai-reason-icon" t-att-data-reason="sd['reason']">i</span></t>
                                </div>
                                <div class="vx-score-badges" t-att-data-field="fn" data-scale="6">
                                    <t t-foreach="[1,2,3,4,5,6]" t-as="s">
                                        <button t-attf-class="vx-score-btn #{str(s)==sd['human'] and 'active' or ''} #{sd['error'] and str(s)==sd['human'] and 'error' or ''}" t-att-data-value="s"><t t-out="s"/></button>
                                    </t>
                                    <t t-if="sd['llm']"><span class="vx-llm-score">LLM: <t t-out="sd['llm']"/></span></t>
                                </div>
                                <t t-if="sd['error']"><div class="vx-error-msg">Rating Mismatch: <t t-out="sd['reason']"/></div></t>
                            </div>
                        </t>
                    </div>
                </div>
