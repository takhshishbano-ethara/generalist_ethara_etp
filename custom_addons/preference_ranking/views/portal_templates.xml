                            <button class="vx-btn vx-btn-secondary" id="vx-btn-evaluate" t-att-data-task-id="task['id']">Evaluate</button>
                            <button class="vx-btn vx-btn-primary" id="vx-btn-submit" t-att-data-task-id="task['id']">Submit Task</button>
                        </div>
                    </div>
