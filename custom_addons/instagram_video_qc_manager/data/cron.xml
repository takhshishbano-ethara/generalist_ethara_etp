<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Weekly orphan-media-dir purge.

             Walks <media_root>/ and removes any subdirectory whose
             integer name no longer matches a live video.task row.
             Disabled by default — an operator should enable this in
             production once they're comfortable that no legitimate
             task ids will be missed (e.g. tasks soft-archived via
             active=False are STILL visible to the purge via
             with_context(active_test=False), so they're safe). -->
        <!-- NOTE: Odoo 19 dropped the ``numbercall`` field on ir.cron.
             Crons in 19 are simply "active or not"; failures auto-bump
             ``failure_count`` and the scheduler stops calling them after
             repeated failures.  Don't add ``numbercall`` back here. -->
        <record id="ir_cron_video_qc_purge_orphan_media" model="ir.cron">
            <field name="name">Video QC: Purge orphan media dirs</field>
            <field name="model_id" ref="model_video_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_purge_orphan_media_dirs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>
