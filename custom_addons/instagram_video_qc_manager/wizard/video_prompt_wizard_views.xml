<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_video_prompt_wizard_form" model="ir.ui.view">
        <field name="name">video.prompt.wizard.form</field>
        <field name="model">video.prompt.wizard</field>
        <field name="arch" type="xml">
            <form string="Attach Prompt">
                <sheet>
                    <group>
                        <field name="version_id" readonly="1"/>
                        <field name="prompt_text" placeholder="Describe the desired AI/content prompt..." nolabel="1"/>
                        <field name="prompt_response" placeholder="(Optional) AI response or notes..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save Prompt" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_video_prompt_wizard" model="ir.actions.act_window">
        <field name="name">Attach Prompt</field>
        <field name="res_model">video.prompt.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_video_task_version"/>
        <field name="binding_view_types">form,list</field>
    </record>

</odoo>
