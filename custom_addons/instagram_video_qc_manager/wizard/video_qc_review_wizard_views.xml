<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_video_qc_review_wizard_form" model="ir.ui.view">
        <field name="name">video.qc.review.wizard.form</field>
        <field name="model">video.qc.review.wizard</field>
        <field name="arch" type="xml">
            <form string="QC Review">
                <sheet>
                    <group>
                        <field name="task_id" readonly="1"/>
                        <field name="version_id" readonly="1"/>
                        <field name="decision" widget="radio"/>
                        <field name="comment" placeholder="Reviewer notes (visible in chatter)..."/>
                        <field name="next_prompt"
                               placeholder="Suggested prompt for the next iteration..."
                               invisible="decision != 'rework'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object"
                            string="Submit QC" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_video_qc_review_wizard" model="ir.actions.act_window">
        <field name="name">QC Review</field>
        <field name="res_model">video.qc.review.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_video_task_version"/>
        <field name="binding_view_types">form,list</field>
    </record>

</odoo>
