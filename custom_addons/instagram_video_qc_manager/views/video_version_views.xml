<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_video_task_version_form" model="ir.ui.view">
        <field name="name">video.task.version.form</field>
        <field name="model">video.task.version</field>
        <field name="arch" type="xml">
            <form string="Video Version">
                <header>
                    <button name="action_render" type="object" string="Render"
                            class="btn-primary" invisible="status == 'processing'"/>
                    <button name="%(action_video_qc_review_wizard)d" type="action"
                            string="QC Review" class="btn-secondary"
                            invisible="not edited_attachment_id"/>
                    <button name="%(action_video_prompt_wizard)d" type="action"
                            string="Attach Prompt" class="btn-secondary"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,processing,rendered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                            <span class="badge text-bg-info" invisible="not is_latest">LATEST</span>
                        </h1>
                    </div>

                    <!-- Explicit Trim 1 / Trim 2 cards.  Each card is
                         the "trim record" for one source slot: it shows
                         the original source attachment used, the trim
                         window, the crop config, the trimmed output
                         attachment, and an inline player.  Falls back
                         to a source-with-fragment preview when the
                         slot hasn't been rendered yet. -->
                    <div class="o_video_qc_trim_cards">
                        <div class="o_video_qc_trim_card">
                            <div class="o_video_qc_trim_card__header">
                                <h4><i class="fa fa-cut"/> Trim 1 — Source #1</h4>
                            </div>
                            <field name="edited_1_play_url"
                                   widget="video_preview"
                                   nolabel="1" readonly="1"/>
                            <div class="o_video_qc_trim_card__meta">
                                <div class="meta-row">
                                    <span class="label">Source:</span>
                                    <field name="source_1_attachment_id" readonly="1" nolabel="1"/>
                                </div>
                                <div class="meta-row">
                                    <span class="label">Trim window:</span>
                                    <field name="trim_1_start" readonly="1" nolabel="1"/>
                                    <span>→</span>
                                    <field name="trim_1_end" readonly="1" nolabel="1"/>
                                    <span class="dur">(<field name="trim_1_duration" readonly="1" nolabel="1"/> s)</span>
                                </div>
                                <div class="meta-row">
                                    <span class="label">Crop:</span>
                                    <field name="crop_1_data_json" readonly="1" nolabel="1"
                                           placeholder="No crop"/>
                                </div>
                                <div class="meta-row">
                                    <span class="label">Trim file:</span>
                                    <field name="edited_attachment_1_id" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>

                        <div class="o_video_qc_trim_card">
                            <div class="o_video_qc_trim_card__header">
                                <h4><i class="fa fa-cut"/> Trim 2 — Source #2</h4>
                            </div>
                            <field name="edited_2_play_url"
                                   widget="video_preview"
                                   nolabel="1" readonly="1"/>
                            <div class="o_video_qc_trim_card__meta">
                                <div class="meta-row">
                                    <span class="label">Source:</span>
                                    <field name="source_2_attachment_id" readonly="1" nolabel="1"/>
                                </div>
                                <div class="meta-row">
                                    <span class="label">Trim window:</span>
                                    <field name="trim_2_start" readonly="1" nolabel="1"/>
                                    <span>→</span>
                                    <field name="trim_2_end" readonly="1" nolabel="1"/>
                                    <span class="dur">(<field name="trim_2_duration" readonly="1" nolabel="1"/> s)</span>
                                </div>
                                <div class="meta-row">
                                    <span class="label">Crop:</span>
                                    <field name="crop_2_data_json" readonly="1" nolabel="1"
                                           placeholder="No crop"/>
                                </div>
                                <div class="meta-row">
                                    <span class="label">Trim file:</span>
                                    <field name="edited_attachment_2_id" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="version_no"/>
                            <field name="created_by"/>
                            <field name="created_on"/>
                            <field name="is_latest"/>
                        </group>
                        <group>
                            <field name="duration"/>
                            <field name="resolution"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preview">
                            <group>
                                <group string="Source #1">
                                    <field name="edited_attachment_1_id"/>
                                </group>
                                <group string="Source #2">
                                    <field name="edited_attachment_2_id"/>
                                </group>
                            </group>
                            <group>
                                <group string="Original (legacy)" col="2">
                                    <field name="original_attachment_id"/>
                                </group>
                                <group string="Edited (legacy)" col="2">
                                    <field name="edited_attachment_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Editing">
                            <field name="editing_json" widget="ace" options="{'mode': 'json'}"/>
                            <field name="crop_data_json"/>
                            <field name="ffmpeg_command" readonly="1"/>
                            <field name="edit_notes"/>
                            <field name="processing_error" readonly="1"
                                   invisible="not processing_error"/>
                        </page>
                        <page string="Prompt &amp; QC">
                            <!-- Prompt + AI Response stretch full width
                                 and get tall (~ 200px) textareas so long
                                 briefs are easy to read and edit. -->
                            <div class="o_video_qc_prompt_block">
                                <label for="prompt_text" string="Prompt"/>
                                <field name="prompt_text" nolabel="1"
                                       class="o_video_qc_prompt_textarea"
                                       placeholder="Describe the AI / content prompt for this version..."/>
                                <label for="prompt_response" string="AI Response / Notes"/>
                                <field name="prompt_response" nolabel="1"
                                       class="o_video_qc_prompt_textarea"
                                       placeholder="Optional notes..."/>
                            </div>
                            <group string="QC">
                                <field name="qc_status" widget="badge"
                                       decoration-success="qc_status == 'approved'"
                                       decoration-danger="qc_status == 'rejected'"
                                       decoration-warning="qc_status in ('pending', 'rework')"/>
                                <field name="qc_user"/>
                                <field name="qc_date"/>
                                <field name="qc_comment"/>
                            </group>
                        </page>
                        <page string="Edit Actions">
                            <field name="edit_history_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="action_type"/>
                                    <field name="action_data"/>
                                    <field name="created_by"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_video_task_version_list" model="ir.ui.view">
        <field name="name">video.task.version.list</field>
        <field name="model">video.task.version</field>
        <field name="arch" type="xml">
            <list string="Versions"
                  decoration-success="qc_status == 'approved'"
                  decoration-danger="qc_status == 'rejected'"
                  decoration-warning="qc_status in ('pending', 'rework')">
                <field name="task_id"/>
                <field name="version_no"/>
                <field name="status" widget="badge"/>
                <field name="qc_status" widget="badge"/>
                <field name="created_by"/>
                <field name="created_on"/>
                <field name="duration"/>
                <field name="resolution"/>
                <field name="is_latest" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_video_task_version" model="ir.actions.act_window">
        <field name="name">All Versions</field>
        <field name="res_model">video.task.version</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
