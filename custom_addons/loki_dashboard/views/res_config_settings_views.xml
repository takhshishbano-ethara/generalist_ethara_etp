<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_loki_dashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.loki_dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Loki Dashboard" string="Loki Dashboard" name="loki_dashboard">
                    <block title="Dashboard Settings">
                        <setting string="Dashboard Title"
                                 help="Override the page title. Leave empty to use the default.">
                            <field name="loki_dashboard_title"
                                   placeholder="Dashboard"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
