<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="portal_dashboard" name="Loki Dashboard">
    <html lang="en">
    <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <title t-esc="dashboard_title"/>
      <link rel="preconnect" href="https://fonts.googleapis.com"/>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;1,400;1,500&amp;family=DM+Sans:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;600&amp;display=swap"/>
      <link rel="stylesheet" href="/loki_dashboard/static/src/portal/css/loki_portal.css?v=14"/>
      <script>
        (function(){
          var t;
          try { t = localStorage.getItem('loki:theme'); } catch(e){}
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        })();
      </script>
      <script src="/loki_dashboard/static/src/portal/js/loki_portal.js?v=15" defer="defer"/>
    </head>
    <body>

      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode" aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>

      <div class="loki-page">

        <section class="section" id="dataset">

          <div class="viewer-controls">
            <div class="viewer-search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <input type="text" id="viewer-search" placeholder="Search records..." autocomplete="off"/>
            </div>
            <div class="viewer-filters">
              <select id="viewer-filter">
                <option value="">All Records</option>
                <option value="diseased">Diseased</option>
                <option value="normal">Normal</option>
              </select>
              <select id="viewer-sort">
                <option value="index">Record #</option>
                <option value="age">Age</option>
                <option value="hr">Heart Rate</option>
                <option value="diagnosis">Diagnosis</option>
                <option value="gender">Sex</option>
              </select>
            </div>
            <div class="viewer-meta">
              <span id="viewer-count">Loading...</span>
            </div>
          </div>

          <div class="loki-table-section">
          <div class="table-wrap">
            <table class="loki-table" id="loki-table">
              <thead>
                <tr>
                  <th class="th-num" data-sort="index">#</th>
                  <th data-sort="record">Record</th>
                  <th data-sort="age">Age</th>
                  <th data-sort="gender">Sex</th>
                  <th data-sort="diagnosis">Diagnosis</th>
                  <th data-sort="hr">HR</th>
                  <th data-sort="qrs">QRS</th>
                  <th class="th-expand"></th>
                </tr>
              </thead>
              <tbody id="loki-tbody">
                <tr class="loading-row"><td colspan="8">Loading&#8230;</td></tr>
              </tbody>
            </table>
          </div>
          </div>
        </section>

        <footer class="foot">
          <div class="foot-inner">
            <p class="mono"><a href="https://www.ethara.ai">Ethara.AI</a> · Project Loki</p>
          </div>
        </footer>

      </div>

      <div class="doc-modal" id="doc-modal" aria-hidden="true">
        <div class="doc-backdrop" id="doc-backdrop"></div>
        <div class="doc-modal-content">
          <div class="doc-modal-bar">
            <span class="doc-modal-caption" id="doc-caption"></span>
            <a id="doc-download" class="doc-download" download="download" href="" target="_blank">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Download .docx</span>
            </a>
          </div>
          <iframe id="doc-iframe" src="about:blank" title="Document Preview"></iframe>
        </div>
        <button type="button" class="doc-close" id="doc-close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="lightbox" id="lightbox" aria-hidden="true">
        <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
        <div class="lightbox-content">
          <img id="lightbox-img" src="" alt="ECG Full Preview"/>
          <p class="lightbox-caption" id="lightbox-caption"></p>
        </div>
        <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <div class="lightbox-zoom-bar" id="lightbox-zoom-bar">
          <button type="button" class="lb-zoom-btn" id="lb-zoom-out" aria-label="Zoom out">&#8722;</button>
          <span class="lb-zoom-level" id="lb-zoom-level">100%</span>
          <button type="button" class="lb-zoom-btn" id="lb-zoom-in" aria-label="Zoom in">&#43;</button>
          <button type="button" class="lb-zoom-btn" id="lb-zoom-reset" aria-label="Reset zoom">&#8634;</button>
        </div>
      </div>

    </body>
    </html>
  </template>

</odoo>
