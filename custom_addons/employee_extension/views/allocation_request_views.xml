<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_allocation_request_form" model="ir.ui.view">
        <field name="name">employee.allocation.request.form</field>
        <field name="model">employee.allocation.request</field>
        <field name="arch" type="xml">
            <form string="Employee Allocation Request">
                <header>
<!--                    <button name="action_submit" string="Submit" type="object" class="oe_highlight"-->
<!--                            invisible="state != 'draft'"/>-->
<!--                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"-->
<!--                            invisible="state != 'submitted'"/>-->
<!--                    <button name="action_reject" string="Reject" type="object"-->
<!--                            invisible="state != 'submitted'"/>-->
<!--                    <button name="action_reset_draft" string="Reset to Draft" type="object"-->
<!--                            invisible="state in ('draft', 'submitted')"/>-->
<!--                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>-->
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="project_id"/>
                            <field name="role_id"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="requested_by" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="justification"/>
                    </group>
                    <group string="Additional Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_allocation_request_tree" model="ir.ui.view">
        <field name="name">employee.allocation.request.tree</field>
        <field name="model">employee.allocation.request</field>
        <field name="arch" type="xml">
            <list string="Employee Allocation Requests"
                  decoration-success="state == 'approved'" 
                  decoration-danger="state == 'rejected'"
                  decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="role_id"/>
                <field name="quantity"/>
                <field name="requested_by"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

