<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Allocation Request Form View -->
    <record id="view_allocation_request_form" model="ir.ui.view">
        <field name="name">employee.allocation.request.form</field>
        <field name="model">employee.allocation.request</field>
        <field name="arch" type="xml">
            <form string="Employee Allocation Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'submitted'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state in ('draft', 'submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="role_id" readonly="state != 'draft'"/>
                            <field name="quantity" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="requested_by"/>
                            <field name="approved_by" invisible="state not in ('approved',)"/>
                            <field name="approval_date" invisible="state not in ('approved',)"/>
                        </group>
                    </group>
                    <group string="Justification">
                        <field name="justification" nolabel="1" readonly="state != 'draft'"/>
                    </group>
                    <group string="Assigned Employees" invisible="state != 'approved'">
                        <field name="assign_employees" nolabel="1" widget="many2many_tags"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
<!--                <div class="oe_chatter">-->
<!--                    <field name="message_ids"/>-->
<!--                    <field name="activity_ids"/>-->
<!--                </div>-->
            </form>
        </field>
    </record>

    <!-- Allocation Request Tree/List View -->
    <record id="view_allocation_request_tree" model="ir.ui.view">
        <field name="name">employee.allocation.request.tree</field>
        <field name="model">employee.allocation.request</field>
        <field name="arch" type="xml">
            <list string="Employee Allocation Requests"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-warning="state == 'submitted'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="role_id"/>
                <field name="quantity"/>
                <field name="requested_by"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'submitted'"
                       decoration-info="state == 'draft'"/>
                <field name="create_date" string="Created On"/>
            </list>
        </field>
    </record>

    <!-- Allocation Request Search View -->
    <record id="view_allocation_request_search" model="ir.ui.view">
        <field name="name">employee.allocation.request.search</field>
        <field name="model">employee.allocation.request</field>
        <field name="arch" type="xml">
            <search string="Search Allocation Requests">
                <field name="name"/>
                <field name="project_id"/>
                <field name="role_id"/>
                <field name="requested_by"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="My Requests" name="my_requests"
                        domain="[('requested_by', '=', uid)]"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Role" name="group_role" context="{'group_by': 'role_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Requested By" name="group_requested_by" context="{'group_by': 'requested_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Allocation Request Action -->
    <record id="action_allocation_request" model="ir.actions.act_window">
        <field name="name">Allocation Requests</field>
        <field name="res_model">employee.allocation.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_allocation_request_search"/>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Employee Allocation Request
            </p>
            <p>
                Request employee allocations for your projects. Requests go through a draft → submit → approve/reject workflow.
            </p>
        </field>
    </record>

    <record id="view_offboarding_reasons_tree" model="ir.ui.view">
        <field name="name">hr.employee.offboarding.reasons.tree</field>
        <field name="model">hr.employee.offboarding.reasons</field>
        <field name="arch" type="xml">
            <list string="Offboarding Reason" editable="top">
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="action_offboarding_reasons" model="ir.actions.act_window">
        <field name="name">Offboarding Reason</field>
        <field name="res_model">hr.employee.offboarding.reasons</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your Offboarding Reason Request
            </p>
        </field>
    </record>

</odoo>
