<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_assignment_history_list" model="ir.ui.view">
        <field name="name">hr.employee.assignment.history.list</field>
        <field name="model">hr.employee.assignment.history</field>
        <field name="arch" type="xml">
            <list string="Assignment History" create="false" edit="false" delete="false">
                <field name="employee_id"/>
                <field name="role_type"/>
                <field name="from_assignee_id"/>
                <field name="assignee_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration_days"/>
                <field name="is_active"
                       decoration-success="is_active == True"
                       decoration-muted="is_active == False"/>
                <field name="changed_by_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_assignment_history_form" model="ir.ui.view">
        <field name="name">hr.employee.assignment.history.form</field>
        <field name="model">hr.employee.assignment.history</field>
        <field name="arch" type="xml">
            <form string="Assignment History" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="role_type"/>
                            <field name="from_assignee_id"/>
                            <field name="assignee_id"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_days"/>
                            <field name="changed_by_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_employee_assignment_history_search" model="ir.ui.view">
        <field name="name">hr.employee.assignment.history.search</field>
        <field name="model">hr.employee.assignment.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="from_assignee_id"/>
                <field name="assignee_id"/>
                <field name="role_type"/>
                <filter string="Active" name="active" domain="[('end_date', '=', False)]"/>
                <filter string="Closed" name="closed" domain="[('end_date', '!=', False)]"/>
                <separator/>
                <filter string="QR" name="role_qr" domain="[('role_type', '=', 'qr')]"/>
                <filter string="PL" name="role_pl" domain="[('role_type', '=', 'pl')]"/>
                <filter string="TPM" name="role_tpm" domain="[('role_type', '=', 'tpm')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Role" name="group_role" context="{'group_by': 'role_type'}"/>
                    <filter string="Assignee" name="group_assignee" context="{'group_by': 'assignee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_assignment_history" model="ir.actions.act_window">
        <field name="name">Assignment History</field>
        <field name="res_model">hr.employee.assignment.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_employee_assignment_history_search"/>
    </record>

    <record id="view_employee_form_assignment_history" model="ir.ui.view">
        <field name="name">hr.employee.form.assignment.history</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Assignment History" name="assignment_history">
                    <field name="assignment_history_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="role_type"/>
                            <field name="from_assignee_id"/>
                            <field name="assignee_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_days"/>
                            <field name="is_active"
                                   decoration-success="is_active == True"
                                   decoration-muted="is_active == False"/>
                            <field name="changed_by_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
