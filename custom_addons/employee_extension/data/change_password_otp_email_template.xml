<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_change_password_otp" model="mail.template">
            <field name="name">Change Password - Email OTP</field>
            <field name="model_id" ref="model_employee_registration_otp"/>
            <field name="email_from">{{ ctx.get('email_from') or user.company_id._get_notification_from_email() }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Reset your Ethara password</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 0; background-color: #f2f3f7;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f2f3f7; padding: 32px 12px;">
                        <tr>
                            <td align="center">
                                <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width: 640px; width: 100%; background-color: #ffffff; border-radius: 6px; overflow: hidden; border: 1px solid #e5e7eb; font-family: Arial, Helvetica, sans-serif;">

                                    <tr>
                                        <td style="padding: 28px 36px 20px 36px; border-bottom: 1px solid #e5e7eb;">
                                            <div style="font-size: 22px; font-weight: 700; letter-spacing: 0.2px;">
                                                <span style="color: #c026d3;">Ethara</span><span style="color: #111827;">.AI</span>
                                            </div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="padding: 36px 36px 10px 36px;">
                                            <p style="margin: 0 0 22px 0; font-size: 15px; color: #111827;">
                                                Your one-time verification code is:
                                            </p>
                                            <div style="font-size: 34px; font-weight: 700; color: #111827; letter-spacing: 10px; font-family: Arial, Helvetica, sans-serif; margin: 0 0 30px 0;">
                                                <t t-out="object.otp_code">000000</t>
                                            </div>
                                            <p style="margin: 0 0 10px 0; font-size: 15px; color: #111827;">
                                                This code expires in <strong><t t-out="ctx.get('ttl_minutes', 10)">10</t> minutes</strong>.
                                            </p>
                                            <p style="margin: 0 0 26px 0; font-size: 13px; color: #6b7280;">
                                                If you did not request this, ignore this email.
                                            </p>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="padding: 0 36px;">
                                            <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 0;"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="padding: 22px 36px 30px 36px;">
                                            <p style="margin: 0 0 6px 0; font-size: 14px; font-weight: 700; color: #111827;">
                                                Ethara.AI
                                            </p>
                                            <p style="margin: 0 0 6px 0; font-size: 13px; color: #6b7280;">
                                                5th Floor, Plot No. 273, Udyog Vihar Phase 1, Sector 20, Gurugram, Haryana 122016
                                            </p>
                                            <p style="margin: 0; font-size: 13px;">
                                                <a href="https://www.ethara.ai" style="color: #c026d3; text-decoration: none;">www.ethara.ai</a>
                                            </p>
                                        </td>
                                    </tr>

                                </table>

                                <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="max-width: 640px; width: 100%;">
                                    <tr>
                                        <td style="padding: 18px 12px; text-align: center;">
                                            <p style="margin: 0; font-size: 12px; color: #9ca3af;">
                                                &#169; 2025 Ethara.AI. All rights reserved.
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                            </td>
                        </tr>
                    </table>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>
