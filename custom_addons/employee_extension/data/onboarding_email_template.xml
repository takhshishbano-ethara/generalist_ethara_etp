<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_employee_onboarding" model="mail.template">
            <field name="name">Employee Onboarding - Welcome</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="email_from">{{ (object.company_id.email or 'noreply@ethara.ai') }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Welcome to Ethara - Your Login Credentials</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #ffffff;">
                    <div style="text-align: center; padding: 20px 0; border-bottom: 2px solid #007bff;">
                        <h1 style="color: #007bff; margin: 0;">Welcome to Ethara!</h1>
                    </div>

                    <div style="padding: 30px 0;">
                        <p style="font-size: 16px; color: #333;">Hi <t t-out="object.name">User</t>,</p>
                        <p style="font-size: 14px; color: #555;">
                            Welcome aboard! Your account has been created on the Ethara ETP platform.
                            Below are your login credentials to get started:
                        </p>

                        <div style="background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 20px; margin: 25px 0;">
                            <table style="width: 100%; font-size: 14px;">
                                <tr>
                                    <td style="padding: 8px 0; color: #666; font-weight: bold; width: 140px;">Login Email:</td>
                                    <td style="padding: 8px 0; color: #333;"><t t-out="object.login">email</t></td>
                                </tr>
                                <tr>
                                    <td style="padding: 8px 0; color: #666; font-weight: bold;">Password:</td>
                                    <td style="padding: 8px 0; color: #333;"><t t-out="ctx.get('plain_password', 'Ethara@123')">password</t></td>
                                </tr>
                                <tr>
                                    <td style="padding: 8px 0; color: #666; font-weight: bold;">Role:</td>
                                    <td style="padding: 8px 0; color: #333;"><t t-out="ctx.get('role_name', '')">role</t></td>
                                </tr>
                            </table>
                        </div>

                        <div style="background-color: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 15px; margin: 20px 0;">
                            <p style="margin: 0; font-size: 13px; color: #856404;">
                                <strong>Important:</strong> Please change your password after your first login for security purposes.
                            </p>
                        </div>

                        <p style="text-align: center; margin: 30px 0;">
                            <a t-att-href="ctx.get('login_url', 'https://etp.stage.ethara.ai')"
                               style="background-color: #007bff; color: white; padding: 12px 30px;
                                      text-decoration: none; border-radius: 5px; font-size: 16px; display: inline-block;">
                               Login to Ethara ETP
                            </a>
                        </p>

                        <p style="font-size: 14px; color: #555;">
                            If you have any questions, please reach out to your team lead or the HR team.
                        </p>
                    </div>

                    <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;"/>
                    <p style="color: #999; font-size: 11px; text-align: center;">Ethara ETP Team</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="onboarding_login_url_param" model="ir.config_parameter">
            <field name="key">employee_extension.onboarding_login_url</field>
            <field name="value">https://etp.stage.ethara.ai</field>
        </record>

    </data>
</odoo>
