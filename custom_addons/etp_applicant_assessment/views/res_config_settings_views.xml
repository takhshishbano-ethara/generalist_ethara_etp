<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_eaa_llm_qc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.eaa.llm.qc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Assessment LLM QC" string="Assessment LLM QC"
                     name="etp_applicant_assessment" groups="base.group_system">
                    <block title="Assessment LLM QC"
                           name="eaa_llm_qc_block">
                        <setting id="eaa_llm_qc_prompt_setting"
                                 string="Seed Prompt"
                                 help="Instruction sent to the LLM before each batch of candidate answers.">
                            <field name="eaa_llm_qc_prompt"
                                   widget="text"
                                   placeholder="You are a strict evaluator ..."
                                   nolabel="1"/>
                        </setting>
                        <setting id="eaa_llm_api_key_setting"
                                 string="API Key"
                                 help="Shared with Resume Screening (ethara_hrms.llm_api_key).">
                            <field name="eaa_llm_api_key" password="True"/>
                        </setting>
                        <setting id="eaa_llm_base_url_setting"
                                 string="Base URL"
                                 help="OpenAI-compatible base URL. '/chat/completions' is appended automatically.">
                            <field name="eaa_llm_base_url"/>
                        </setting>
                        <setting id="eaa_llm_model_setting" string="Model">
                            <field name="eaa_llm_model"/>
                        </setting>
                        <setting id="eaa_llm_timeout_setting"
                                 string="Timeout (seconds)">
                            <field name="eaa_llm_timeout"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
