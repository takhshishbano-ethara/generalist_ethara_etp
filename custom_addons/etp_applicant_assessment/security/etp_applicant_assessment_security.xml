<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_applicant_assessment" model="ir.module.category">
            <field name="name">Applicant Assessment</field>
            <field name="description">Recruitment-side proctored assessments</field>
            <field name="sequence">85</field>
        </record>

        <record id="res_groups_privilege_applicant_assessment" model="res.groups.privilege">
            <field name="name">Applicant Assessment</field>
            <field name="sequence">85</field>
            <field name="category_id" ref="module_category_applicant_assessment"/>
        </record>

        <record id="group_applicant_assessment_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_applicant_assessment"/>
            <field name="implied_ids" eval="[(4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
        </record>

        <record id="group_applicant_assessment_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_applicant_assessment"/>
            <field name="implied_ids" eval="[(4, ref('group_applicant_assessment_user')), (4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
