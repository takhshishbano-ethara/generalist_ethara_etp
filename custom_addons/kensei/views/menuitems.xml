<odoo>

    <record model="ir.actions.client" id="kensei_costing_action">
        <field name="name">Token Usage</field>
        <field name="tag">kensei_costing_dashboard</field>
    </record>

    <menuitem name="Kensei" id="kensei.menu_kensei_root"
              groups="kensei.group_kensei_tasker,kensei.group_kensei_tracker_viewer"/>

    <menuitem name="Tasks" id="kensei.menu_kensei_tasks" parent="kensei.menu_kensei_root"
              action="kensei_kensei_action_window" sequence="10"
              groups="kensei.group_kensei_tasker"/>
    <menuitem name="Costing" id="kensei.menu_kensei_costing" parent="kensei.menu_kensei_root"
              action="kensei_costing_action" sequence="12"
              groups="kensei.group_kensei_pl"/>
    <menuitem name="Personas" id="kensei.menu_kensei_personas" parent="kensei.menu_kensei_root"
              action="kensei_persona_action_window" sequence="15"
              groups="kensei.group_kensei_ql"/>
    <menuitem name="Domains" id="kensei.menu_kensei_domains" parent="kensei.menu_kensei_root"
              action="domain_action_window" sequence="30"
              groups="kensei.group_kensei_ql"/>
    <menuitem name="Turns" id="kensei.menu_kensei_turns" parent="kensei.menu_kensei_root"
              action="kensei_turn_action_window" sequence="25"
              groups="kensei.group_kensei_ql"/>
    <menuitem name="Sandboxes" id="kensei.menu_kensei_sandboxes" parent="kensei.menu_kensei_root"
              action="kensei_sandbox_action_window" sequence="35"
              groups="kensei.group_kensei_ql"/>
    <menuitem name="API Logs" id="kensei.menu_kensei_api_requests" parent="kensei.menu_kensei_root"
              action="action_kensei_api_request" sequence="40"
              groups="kensei.group_kensei_pl"/>
    <menuitem name="Test Results" id="kensei.menu_kensei_test_results" parent="kensei.menu_kensei_root"
              action="action_kensei_test_results" sequence="45"
              groups="kensei.group_kensei_tasker"/>

    <!-- ===================== Kensei Tracker ===================== -->
    <!-- Nested under the Kensei app, right after "Test Results" (seq 45). -->
    <menuitem name="Kensei Tracker" id="kensei.menu_kensei_tracker_root"
              parent="kensei.menu_kensei_root" sequence="50"
              groups="kensei.group_kensei_tasker,kensei.group_kensei_tracker_viewer"/>

    <menuitem name="Dashboard" id="kensei.menu_kensei_tracker_dashboard"
              parent="kensei.menu_kensei_tracker_root"
              action="kensei_tracker_dashboard_action" sequence="10"
              groups="kensei.group_kensei_ql,kensei.group_kensei_tracker_viewer"/>
    <menuitem name="Task Allocation" id="kensei.menu_kensei_tracker_allocation"
              parent="kensei.menu_kensei_tracker_root"
              action="kensei_tracker_allocation_action" sequence="20"
              groups="kensei.group_kensei_tasker,kensei.group_kensei_tracker_viewer"/>
    <menuitem name="Daily Tracker" id="kensei.menu_kensei_tracker_daily"
              parent="kensei.menu_kensei_tracker_root"
              action="kensei_tracker_daily_action" sequence="25"
              groups="kensei.group_kensei_ql,kensei.group_kensei_tracker_viewer"/>
    <menuitem name="Assign Personas" id="kensei.menu_kensei_tracker_persona_assign"
              parent="kensei.menu_kensei_tracker_root"
              action="action_kensei_tracker_persona_assign" sequence="28"
              groups="kensei.group_kensei_ql"/>
    <menuitem name="Viewer" id="kensei.menu_kensei_tracker_viewer"
              parent="kensei.menu_kensei_tracker_root"
              action="kensei_tracker_viewer_act_window" sequence="30"
              groups="kensei.group_kensei_tasker,kensei.group_kensei_tracker_viewer"/>
</odoo>
