<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="kensei_tracker_persona_assign_form" model="ir.ui.view">
      <field name="name">kensei.tracker.persona.assign.form</field>
      <field name="model">kensei.tracker.persona.assign</field>
      <field name="arch" type="xml">
        <form string="Assign Personas">
          <div class="alert alert-info" role="alert">
            Upload a CSV with a <b>Persona Name</b> column and optional
            <b>L1</b> / <b>L2</b> category columns. Any Persona not already in
            the master is <b>created automatically</b>. Personas are then
            randomly assigned to the selected taskers (none reused until the
            list is exhausted).
            <div class="mt-2">
              <a href="/kensei/tracker/persona/sample_csv">
                <i class="fa fa-download me-1"/>Download sample file
              </a>
            </div>
          </div>
          <group>
            <field name="csv_file" filename="filename" widget="binary"/>
            <field name="filename" invisible="1"/>
            <field name="only_without_persona"/>
          </group>
          <field name="allocation_ids">
            <list>
              <field name="task_id"/>
              <field name="tasker_name"/>
              <field name="tasker_email"/>
              <field name="persona_id"/>
            </list>
          </field>
          <footer>
            <button string="Assign" name="action_assign" type="object" class="btn-primary"/>
            <button string="Cancel" class="btn-secondary" special="cancel"/>
          </footer>
        </form>
      </field>
    </record>

    <record id="action_kensei_tracker_persona_assign" model="ir.actions.act_window">
      <field name="name">Assign Personas</field>
      <field name="res_model">kensei.tracker.persona.assign</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

  </data>
</odoo>
