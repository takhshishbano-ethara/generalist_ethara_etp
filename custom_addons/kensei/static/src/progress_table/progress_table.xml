<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="kensei.ProgressTable">
        <div class="o_ktd_table_wrap">
            <table class="o_ktd_table">
                <thead>
                    <tr>
                        <th class="o_ktd_col_idx">#</th>
                        <th class="o_ktd_col_pl"><t t-out="props.head"/></th>
                        <th>Total</th>
                        <th>In Auth</th>
                        <th>Ready</th>
                        <th>In Traj</th>
                        <th>Manual QC</th>
                        <th>Handed Off</th>
                        <th>Verified</th>
                        <th>Blocked</th>
                        <th>Avg Score</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-if="total === 0">
                        <tr>
                            <td colspan="11" class="o_ktd_empty">
                                <i class="fa fa-inbox me-1"/>No allocations yet.
                            </td>
                        </tr>
                    </t>
                    <!-- t-key on row.id alone collides: the server emits id 0 for the
                         "Unassigned" bucket, and any second id-less row would key the
                         same, making OWL patch the wrong <tr>. _idx is unique per page. -->
                    <t t-foreach="pageRows" t-as="row" t-key="row.id + '_' + row._idx">
                        <tr class="o_ktd_clickable" t-on-click="() => this.rowClick(row)"
                            tabindex="0" role="button"
                            t-on-keydown="(ev) => this.rowKeydown(ev, row)">
                            <td class="o_ktd_col_idx"><t t-out="row._idx"/></td>
                            <td class="o_ktd_col_pl"><t t-out="row.name"/></td>
                            <td><t t-out="row.total"/></td>
                            <td><t t-out="row.in_auth"/></td>
                            <td><t t-out="row.ready"/></td>
                            <td><t t-out="row.in_traj"/></td>
                            <td><t t-out="row.manual_qc"/></td>
                            <td><t t-out="row.handed_off"/></td>
                            <td class="o_ktd_cell_verified"><t t-out="row.verified"/></td>
                            <td t-att-class="row.blocked > 0 ? 'o_ktd_cell_blocked' : ''">
                                <t t-out="row.blocked"/>
                            </td>
                            <td><t t-out="fmt(row.avg_score)"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <!-- reads `page` (the clamped getter), never state.page — a stale
                 state.page would otherwise render "5 / 3" after a filter shrinks
                 the rows, and leave the buttons enabled with nothing to do. -->
            <div class="o_ktd_pager" t-if="totalPages > 1">
                <button class="o_ktd_pager_btn" t-att-disabled="page &lt;= 1"
                        t-on-click="prev" aria-label="Previous page">
                    <i class="fa fa-chevron-left"/>
                </button>
                <span class="o_ktd_pager_info">
                    <t t-out="page"/> / <t t-out="totalPages"/>
                    <span class="text-muted"> · <t t-out="total"/></span>
                </span>
                <button class="o_ktd_pager_btn" t-att-disabled="page >= totalPages"
                        t-on-click="next" aria-label="Next page">
                    <i class="fa fa-chevron-right"/>
                </button>
            </div>
        </div>
    </t>
</templates>
