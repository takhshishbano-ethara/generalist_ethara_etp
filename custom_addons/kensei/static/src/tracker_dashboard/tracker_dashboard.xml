<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="kensei.TrackerDashboard">
        <div class="o_kensei_tracker_dashboard">

            <!-- Top bar -->
            <div class="o_ktd_topbar">
                <div class="o_ktd_topbar_titles">
                    <span class="o_ktd_title">
                        <i class="fa fa-line-chart me-2"/>Kensei-RL Dashboard
                    </span>
                    <span class="o_ktd_subtitle">
                        Reinforcement Learning pipeline
                        <t t-if="state.lastUpdated">· Updated <t t-out="state.lastUpdated"/></t>
                    </span>
                </div>
                <div class="o_ktd_topbar_actions">
                    <div class="o_ktd_filters" title="Filter the pipeline by assignment date">
                        <i class="fa fa-calendar o_ktd_filter_icon"/>
                        <input type="date" class="o_ktd_date" aria-label="From date"
                               t-att-value="state.dateFrom"
                               t-on-change="ev => this.onDateInput('dateFrom', ev)"/>
                        <span class="o_ktd_date_sep">→</span>
                        <input type="date" class="o_ktd_date" aria-label="To date"
                               t-att-value="state.dateTo"
                               t-on-change="ev => this.onDateInput('dateTo', ev)"/>
                        <button class="o_ktd_preset" t-on-click="() => this.setPreset(1)">Today</button>
                        <button class="o_ktd_preset" t-on-click="() => this.setPreset(7)">7D</button>
                        <button class="o_ktd_preset" t-on-click="() => this.setPreset(30)">30D</button>
                        <button class="o_ktd_preset"
                                t-att-class="{ 'o_ktd_preset_active': !isFiltered }"
                                t-on-click="() => this.setPreset(null)">All</button>
                    </div>
                    <button class="o_ktd_refresh_btn" t-on-click="onRefresh"
                            t-att-disabled="state.loading">
                        <i class="fa fa-refresh" t-att-class="{ 'fa-spin': state.loading }"/>
                        <span>Refresh</span>
                    </button>
                </div>
            </div>

            <!-- ===================== TEAM COMPOSITION ===================== -->
            <div class="o_ktd_section">
                <div class="o_ktd_section_header">
                    <i class="fa fa-users me-2"/>TEAM COMPOSITION
                </div>
                <div class="o_ktd_cards">
                    <t t-foreach="state.teamComposition" t-as="card" t-key="card.key">
                        <div t-attf-class="o_ktd_metric_card o_ktd_clickable o_ktd_metric_#{card.key}"
                             t-on-click="() => this.onCompositionClick(card)"
                             title="View these members">
                            <div class="o_ktd_metric_label"><t t-out="card.label"/></div>
                            <div class="o_ktd_metric_value">
                                <t t-out="fmt(card.value)"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- ===================== RL PIPELINE FUNNEL ===================== -->
            <div class="o_ktd_section">
                <div class="o_ktd_section_header">
                    <i class="fa fa-filter me-2"/>RL PIPELINE FUNNEL
                </div>
                <div class="o_ktd_cards">
                    <t t-foreach="state.funnel" t-as="card" t-key="card.key">
                        <div t-attf-class="o_ktd_funnel_card o_ktd_clickable o_ktd_funnel_#{card.key}"
                             t-on-click="() => this.onStatusCardClick(card)"
                             title="View these tasks">
                            <div class="o_ktd_metric_label"><t t-out="card.label"/></div>
                            <div class="o_ktd_metric_value"><t t-out="fmt(card.value)"/></div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- ===================== ACTIVITY ===================== -->
            <div class="o_ktd_section">
                <div class="o_ktd_section_header">
                    <i class="fa fa-bolt me-2"/>ACTIVITY
                </div>
                <div class="o_ktd_cards">
                    <t t-foreach="state.latestActivity" t-as="card" t-key="card.key">
                        <div t-attf-class="o_ktd_metric_card o_ktd_metric_#{card.key}"
                             t-att-class="{ 'o_ktd_clickable': card.statuses and card.statuses.length }"
                             t-on-click="() => this.onStatusCardClick(card)">
                            <div class="o_ktd_metric_label"><t t-out="card.label"/></div>
                            <div class="o_ktd_metric_value">
                                <t t-out="fmt(card.value)"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- ===================== PER-PL PROGRESS ===================== -->
            <div class="o_ktd_section">
                <div class="o_ktd_section_header">
                    <i class="fa fa-list-ol me-2"/>PER-PL PROGRESS
                </div>
                <t t-call="kensei.TrackerProgressTable">
                    <t t-set="rows" t-value="state.perPl"/>
                    <t t-set="head" t-value="'PL'"/>
                    <t t-set="onRowClick" t-value="row => this.onPlClick(row)"/>
                </t>
            </div>

            <!-- ===================== PER-QL PROGRESS ===================== -->
            <div class="o_ktd_section">
                <div class="o_ktd_section_header">
                    <i class="fa fa-check-square-o me-2"/>PER-QL PROGRESS
                </div>
                <t t-call="kensei.TrackerProgressTable">
                    <t t-set="rows" t-value="state.perQl"/>
                    <t t-set="head" t-value="'QL'"/>
                    <t t-set="onRowClick" t-value="row => this.onQlClick(row)"/>
                </t>
            </div>

        </div>
    </t>

    <!-- Reusable progress table (Per-PL / Per-QL) -->
    <t t-name="kensei.TrackerProgressTable">
        <div class="o_ktd_table_wrap">
            <table class="o_ktd_table">
                <thead>
                    <tr>
                        <th class="o_ktd_col_idx">#</th>
                        <th class="o_ktd_col_pl"><t t-out="head"/></th>
                        <th>Team</th>
                        <th>In Auth</th>
                        <th>Ready</th>
                        <th>In Traj</th>
                        <th>Manual QC</th>
                        <th>Verified</th>
                        <th>Blocked</th>
                        <th>Avg Score</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-if="rows.length === 0">
                        <tr>
                            <td colspan="10" class="o_ktd_empty">
                                <i class="fa fa-inbox me-1"/>No allocations yet.
                            </td>
                        </tr>
                    </t>
                    <t t-foreach="rows" t-as="row" t-key="row.id">
                        <tr class="o_ktd_clickable" t-on-click="() => onRowClick(row)">
                            <td class="o_ktd_col_idx"><t t-out="row_index + 1"/></td>
                            <td class="o_ktd_col_pl"><t t-out="row.name"/></td>
                            <td><t t-out="row.team"/></td>
                            <td><t t-out="row.in_auth"/></td>
                            <td><t t-out="row.ready"/></td>
                            <td><t t-out="row.in_traj"/></td>
                            <td><t t-out="row.manual_qc"/></td>
                            <td class="o_ktd_cell_verified"><t t-out="row.verified"/></td>
                            <td t-att-class="row.blocked > 0 ? 'o_ktd_cell_blocked' : ''">
                                <t t-out="row.blocked"/>
                            </td>
                            <td><t t-out="fmt(row.avg_score)"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>
</templates>
