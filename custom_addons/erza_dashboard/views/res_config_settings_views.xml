<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_erza" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.erza.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Erza Dashboard" name="erza_dashboard">
                    <block title="External Data Sources">
                        <setting string="GitHub Repository" help="Client-facing delivery repo for the Erza benchmark.">
                            <field name="erza_github_url" placeholder="https://github.com/Ethara-Ai/erza-delivery/"/>
                        </setting>
                        <setting string="HuggingFace Dataset" help="Public HuggingFace dataset for the Erza sample bundle(s).">
                            <field name="erza_huggingface_url" placeholder="https://huggingface.co/datasets/ethara/erza-samples"/>
                        </setting>
                        <setting string="Paper / Report" help="Long-form methodology write-up.">
                            <field name="erza_paper_url" placeholder="https://..."/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_erza_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'erza_dashboard', 'bin_size': False}</field>
    </record>
</odoo>
