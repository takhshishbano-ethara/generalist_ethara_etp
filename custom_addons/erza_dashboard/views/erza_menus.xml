<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="erza_showcase_action" model="ir.actions.client">
        <field name="name">Erza Overview</field>
        <field name="tag">erza_dashboard.showcase</field>
    </record>

    <menuitem id="erza_menu_root"
              name="Erza"
              sequence="204"
              web_icon="erza_dashboard,static/description/icon.png"/>

    <menuitem id="erza_menu_overview"
              name="Overview"
              parent="erza_menu_root"
              action="erza_showcase_action"
              sequence="10"/>

    <menuitem id="erza_menu_tasks"
              name="Tasks"
              parent="erza_menu_root"
              action="action_erza_task"
              sequence="20"/>

    <menuitem id="erza_menu_runs"
              name="Runs"
              parent="erza_menu_root"
              action="action_erza_run"
              sequence="30"/>

    <menuitem id="erza_menu_models"
              name="Models"
              parent="erza_menu_root"
              action="action_erza_model"
              sequence="40"/>

    <menuitem id="erza_menu_settings"
              name="Settings"
              parent="erza_menu_root"
              action="action_erza_settings"
              sequence="90"
              groups="base.group_system"/>
</odoo>
