<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_mm_performance" model="ir.module.category">
            <field name="name">MM Performance</field>
            <field name="description">MM Performance Dashboard</field>
            <field name="sequence">95</field>
        </record>

        <!-- Privilege (Odoo 19: dropdown in Access Rights tab) -->
        <record id="res_groups_privilege_mm_performance" model="res.groups.privilege">
            <field name="name">MM Performance</field>
            <field name="sequence">95</field>
            <field name="category_id" ref="module_category_mm_performance"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Viewer Group -->
        <record id="group_viewer" model="res.groups">
            <field name="name">Viewer</field>
            <field name="privilege_id" ref="res_groups_privilege_mm_performance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- User Group (inherits Viewer) -->
        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_mm_performance"/>
            <field name="implied_ids" eval="[(4, ref('group_viewer'))]"/>
        </record>

        <!-- Admin Group (inherits User) -->
        <record id="group_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="res_groups_privilege_mm_performance"/>
            <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
