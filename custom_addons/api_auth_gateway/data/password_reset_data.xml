<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_password_reset" model="mail.template">
            <field name="name">Password Reset - Ethara</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="email_from">{{ (object.company_id.email or 'no-reply@kuberha.ai') }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Password Reset Request - Ethara</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
                    <h2 style="color: #333;">Password Reset Request</h2>
                    <p>Hi <t t-out="ctx.get('user_name', object.name)">User</t>,</p>
                    <p>We received a request to reset your password. Click the button below to set a new password:</p>
                    <p style="text-align: center; margin: 30px 0;">
                        <a t-att-href="ctx.get('reset_link', '#')"
                           style="background-color: #007bff; color: white; padding: 12px 30px;
                                  text-decoration: none; border-radius: 5px; font-size: 16px; display: inline-block;">
                           Reset Password
                        </a>
                    </p>
                    <p style="color: #666; font-size: 13px;">This link will expire in <strong>1 hour</strong>.</p>
                    <p style="color: #666; font-size: 13px;">If you did not request a password reset, please ignore this email. Your password will remain unchanged.</p>
                    <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;"/>
                    <p style="color: #999; font-size: 11px;">Ethara Team</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="password_reset_url_param" model="ir.config_parameter">
            <field name="key">api_auth_gateway.password_reset_url</field>
            <field name="value">http://localhost:8071/reset-password</field>
        </record>

    </data>
</odoo>
