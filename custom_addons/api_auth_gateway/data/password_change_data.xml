<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_password_changed" model="mail.template">
            <field name="name">Password Changed - Ethara</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="email_from">{{ (object.company_id.email or 'no-reply@kuberha.ai') }}</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="subject">Your Ethara password was changed</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
                    <h2 style="color: #333;">Password Changed Successfully</h2>
                    <p>Hi <t t-out="ctx.get('user_name', object.name)">User</t>,</p>
                    <p>This is a confirmation that the password for your Ethara account was changed successfully.</p>
                    <table style="width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 14px;">
                        <tr>
                            <td style="padding: 8px 12px; color: #666; border-bottom: 1px solid #eee; width: 40%;">Date &amp; Time</td>
                            <td style="padding: 8px 12px; color: #333; border-bottom: 1px solid #eee;">
                                <t t-out="ctx.get('change_time', '')">-</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 12px; color: #666; border-bottom: 1px solid #eee;">IP Address</td>
                            <td style="padding: 8px 12px; color: #333; border-bottom: 1px solid #eee;">
                                <t t-out="ctx.get('ip_address', 'Unknown')">Unknown</t>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 12px; color: #666; border-bottom: 1px solid #eee;">Device / Browser</td>
                            <td style="padding: 8px 12px; color: #333; border-bottom: 1px solid #eee;">
                                <t t-out="ctx.get('device_info', 'Unknown')">Unknown</t>
                            </td>
                        </tr>
                    </table>
                    <p style="background-color: #fff4f4; border-left: 4px solid #d9534f; padding: 12px 16px; color: #a94442; font-size: 14px;">
                        <strong>If you did not make this change, please contact support immediately.</strong>
                    </p>
                    <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;"/>
                    <p style="color: #999; font-size: 11px;">Ethara Team</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
