<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="portal_dashboard" name="Loki Clinical Dashboard">
    <html lang="en">
    <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <title t-esc="dashboard_title"/>
      <link rel="preconnect" href="https://fonts.googleapis.com"/>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;1,400;1,500&amp;family=DM+Sans:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;600&amp;display=swap"/>
      <link rel="stylesheet" href="/loki_dashboard_2/static/src/portal/css/loki2_portal.css?v=3"/>
      <script>
        (function(){
          var t;
          try { t = localStorage.getItem('loki:theme'); } catch(e){}
          if (t === 'dark' || t === 'light') {
            document.documentElement.setAttribute('data-theme', t);
          }
        })();
      </script>
      <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
      <script src="/loki_dashboard_2/static/src/portal/vendor/openseadragon/openseadragon.min.js"></script>
      <script src="/loki_dashboard_2/static/src/portal/js/loki2_portal.js?v=4" defer="defer"></script>
    </head>
    <body>

      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode" aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>

      <div class="loki-page">

        <header class="masthead">
          <div class="mast-top">
            <div class="wordmark" t-esc="dashboard_title">Clinical Dashboard</div>
            <span class="badge">Oncology</span>
          </div>
          <hr class="rule"/>
          <p class="thesis">Three patients. <em>One unified view.</em></p>
          <p class="byline">Ethara · Clinical Data Viewer · <a href="https://www.ethara.ai">ethara.ai</a></p>
        </header>

        <div class="patient-picker" id="patient-picker">
          <span class="picker-label">Patient</span>
          <button type="button" class="patient-chip" data-pid="3">P3 <span class="chip-meta">Colon</span></button>
          <button type="button" class="patient-chip" data-pid="4">P4 <span class="chip-meta">Colon · Liver</span></button>
          <button type="button" class="patient-chip" data-pid="7_GB">P7-GB <span class="chip-meta">Biliary</span></button>
          <button type="button" class="compare-toggle" id="compare-toggle">Compare All</button>
        </div>

        <main id="dashboard-main">

          <div class="empty-state" id="empty-state" style="display:none;">
            <h2>No patient data found.</h2>
            <p>Drop Excel files into:</p>
            <code>custom_addons/loki_dashboard_2/data/Clinical_Data/Patient_*/structured/</code>
            <p>Then run:</p>
            <code>python custom_addons/loki_dashboard_2/tools/ingest_excel.py</code>
            <p>And for whole-slide images:</p>
            <code>python custom_addons/loki_dashboard_2/tools/generate_dzi.py</code>
          </div>

          <section class="section" data-view="header" id="view-header">
            <h2 class="section-label">Header · Demographics · Stage <span class="label-meta" id="header-meta"></span></h2>
            <div class="kpi-row" id="kpi-row"></div>
            <div class="header-grid">
              <div class="prose" id="header-prose"></div>
              <aside class="glance" id="header-glance"></aside>
            </div>
          </section>

          <section class="section" data-view="timeline" id="view-timeline">
            <h2 class="section-label">Timeline <span class="label-meta">Surgery · Chemo · Imaging · Events</span></h2>
            <div class="timeline-wrap"><svg class="timeline-svg" id="timeline-svg" aria-label="Patient timeline"></svg></div>
            <div class="timeline-legend" id="timeline-legend"></div>
          </section>

          <section class="section" data-view="biomarkers" id="view-biomarkers">
            <h2 class="section-label">Biomarkers <span class="label-meta">Serum trends</span></h2>
            <div class="chart-grid" id="biomarkers-grid"></div>
          </section>

          <section class="section" data-view="labs" id="view-labs">
            <h2 class="section-label">Labs <span class="label-meta">Hematology · Clinical BioChemistry</span></h2>
            <div class="chart-grid" id="labs-grid"></div>
          </section>

          <section class="section" data-view="treatments" id="view-treatments">
            <h2 class="section-label">Treatments <span class="label-meta">Chemo · Immuno · Targeted · Radiation · Surgery</span></h2>
            <div class="clinical-table-wrap">
              <table class="clinical-table" id="treatments-table">
                <thead><tr><th>Type</th><th>Drug / Procedure</th><th>Start</th><th>End</th><th>Cycles</th><th>Comments</th></tr></thead>
                <tbody id="treatments-tbody"></tbody>
              </table>
            </div>
          </section>

          <section class="section" data-view="imaging" id="view-imaging">
            <h2 class="section-label">Imaging <span class="label-meta">Radiology reports</span></h2>
            <div class="imaging-list" id="imaging-list"></div>
          </section>

          <section class="section" data-view="pathology-molecular" id="view-pathmol">
            <h2 class="section-label">Pathology &amp; Molecular <span class="label-meta">IHC · NGS · Histology</span></h2>
            <div class="pathmol-grid">
              <div class="pathmol-card">
                <h3>Pathology</h3>
                <div class="clinical-table-wrap">
                  <table class="clinical-table" id="pathology-table">
                    <thead><tr><th>Date</th><th>Type</th><th>Tissue</th><th>pT</th><th>pN</th><th>pM</th><th>Grade</th></tr></thead>
                    <tbody id="pathology-tbody"></tbody>
                  </table>
                </div>
              </div>
              <div class="pathmol-card">
                <h3>Molecular</h3>
                <div id="molecular-content"></div>
              </div>
            </div>
          </section>

          <section class="section" data-view="wsi" id="view-wsi">
            <h2 class="section-label">Whole-Slide Imagery <span class="label-meta">Deep Zoom · Pan / Pinch</span></h2>
            <div class="wsi-tabs" id="wsi-tabs"></div>
            <div class="wsi-viewer-wrap" id="wsi-viewer-wrap">
              <div id="wsi-viewer"></div>
            </div>
          </section>

          <section class="section" data-view="documents" id="view-documents">
            <h2 class="section-label">Documents <span class="label-meta">Source PDFs by category</span></h2>
            <div class="doc-library" id="doc-library"></div>
          </section>

          <section class="section" data-view="compare" id="view-compare" style="display:none;">
            <h2 class="section-label">Compare · All Patients</h2>
            <div class="compare-grid" id="compare-grid"></div>
          </section>

        </main>

        <footer class="foot">
          <div class="foot-inner">
            <p class="mono"><a href="https://www.ethara.ai">Ethara.AI</a> · Project Loki · Clinical Dashboard</p>
          </div>
        </footer>

      </div>

      <div class="doc-modal" id="doc-modal" aria-hidden="true">
        <div class="doc-backdrop" id="doc-backdrop"></div>
        <div class="doc-modal-content">
          <div class="doc-modal-bar">
            <span class="doc-modal-caption" id="doc-caption"></span>
          </div>
          <iframe id="doc-iframe" src="about:blank" title="Document Preview"></iframe>
        </div>
        <button type="button" class="doc-close" id="doc-close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="lightbox" id="lightbox" aria-hidden="true">
        <div class="lightbox-backdrop" id="lightbox-backdrop"></div>
        <div class="lightbox-content">
          <img id="lightbox-img" src="" alt="Preview"/>
          <p class="lightbox-caption" id="lightbox-caption"></p>
        </div>
        <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <div class="tt-tooltip" id="tt-tooltip"></div>

    </body>
    </html>
  </template>

</odoo>
