<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_llm_auto_score" model="ir.cron">
            <field name="name">ETP Assessment: Auto-score submitted candidates</field>
            <field name="model_id" ref="model_etp_assessment_pro"/>
            <field name="state">code</field>
            <field name="code">model._cron_llm_auto_score(shard=0)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Parallel scoring lanes 1-3. Idle no-ops until
             ir.config_parameter etp_assessment_pro.scoring_shards > shard. -->
        <record id="ir_cron_llm_auto_score_shard_1" model="ir.cron">
            <field name="name">ETP Assessment: Auto-score (shard 1)</field>
            <field name="model_id" ref="model_etp_assessment_pro"/>
            <field name="state">code</field>
            <field name="code">model._cron_llm_auto_score(shard=1)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_llm_auto_score_shard_2" model="ir.cron">
            <field name="name">ETP Assessment: Auto-score (shard 2)</field>
            <field name="model_id" ref="model_etp_assessment_pro"/>
            <field name="state">code</field>
            <field name="code">model._cron_llm_auto_score(shard=2)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_llm_auto_score_shard_3" model="ir.cron">
            <field name="name">ETP Assessment: Auto-score (shard 3)</field>
            <field name="model_id" ref="model_etp_assessment_pro"/>
            <field name="state">code</field>
            <field name="code">model._cron_llm_auto_score(shard=3)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_recompute_subjective_results" model="ir.cron">
            <field name="name">ETP Assessment: Recompute pass/fail after threshold change</field>
            <field name="model_id" ref="model_etp_assessment_pro"/>
            <field name="state">code</field>
            <field name="code">model._cron_recompute_subjective_results()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_send_pending_invitations" model="ir.cron">
            <field name="name">ETP Assessment: Send queued candidate invitations</field>
            <field name="model_id" ref="model_etp_assessment_pro_evaluator"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_pending_invitations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_render_pending_images" model="ir.cron">
            <field name="name">ETP Assessment: Auto-render pending question images</field>
            <field name="model_id" ref="model_etp_assessment_pro_prompt_question"/>
            <field name="state">code</field>
            <field name="code">model._cron_render_pending_images()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_detect_image_labels" model="ir.cron">
            <field name="name">ETP Assessment: Detect &amp; annotate image_label images</field>
            <field name="model_id" ref="model_etp_assessment_pro_question_image"/>
            <field name="state">code</field>
            <field name="code">model._cron_detect_image_labels()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_poll_video_ops" model="ir.cron">
            <field name="name">ETP Assessment: Submit &amp; poll async Veo video generation</field>
            <field name="model_id" ref="model_etp_assessment_pro_prompt_question"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_video_ops()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_expire_stale_attempts" model="ir.cron">
            <field name="name">ETP Assessment: Auto-submit abandoned attempts past deadline</field>
            <field name="model_id" ref="model_etp_assessment_pro_evaluator"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_stale_attempts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_generate_from_sop" model="ir.cron">
            <field name="name">ETP Assessment: Generate questions from SOP</field>
            <field name="model_id" ref="model_etp_assessment_pro_prompt"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_from_sop()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
