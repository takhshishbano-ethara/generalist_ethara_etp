<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Master dimensions + options for image_ab questions. Authors attach
         these to an image_ab question and tick the is_correct option per
         dimension. IF/VQ/LAI are objective; OC is the overall choice. -->

    <record id="dim_image_if" model="etp.assessment.pro.dimension">
        <field name="name">Instruction Following (IF)</field>
        <field name="sequence">10</field>
    </record>
    <record id="dim_image_if_opt_a" model="etp.assessment.pro.dimension.option">
        <field name="name">Response A</field>
        <field name="dimension_id" ref="dim_image_if"/>
        <field name="sequence">10</field>
    </record>
    <record id="dim_image_if_opt_b" model="etp.assessment.pro.dimension.option">
        <field name="name">Response B</field>
        <field name="dimension_id" ref="dim_image_if"/>
        <field name="sequence">20</field>
    </record>
    <record id="dim_image_if_opt_bg" model="etp.assessment.pro.dimension.option">
        <field name="name">Both Good</field>
        <field name="dimension_id" ref="dim_image_if"/>
        <field name="sequence">30</field>
    </record>
    <record id="dim_image_if_opt_bb" model="etp.assessment.pro.dimension.option">
        <field name="name">Both Bad</field>
        <field name="dimension_id" ref="dim_image_if"/>
        <field name="sequence">40</field>
    </record>
    <record id="dim_image_if_opt_tie" model="etp.assessment.pro.dimension.option">
        <field name="name">Tie</field>
        <field name="dimension_id" ref="dim_image_if"/>
        <field name="sequence">50</field>
    </record>

    <record id="dim_image_vq" model="etp.assessment.pro.dimension">
        <field name="name">Visual Quality (VQ)</field>
        <field name="sequence">20</field>
    </record>
    <record id="dim_image_vq_opt_a" model="etp.assessment.pro.dimension.option">
        <field name="name">Response A</field>
        <field name="dimension_id" ref="dim_image_vq"/>
        <field name="sequence">10</field>
    </record>
    <record id="dim_image_vq_opt_b" model="etp.assessment.pro.dimension.option">
        <field name="name">Response B</field>
        <field name="dimension_id" ref="dim_image_vq"/>
        <field name="sequence">20</field>
    </record>
    <record id="dim_image_vq_opt_bg" model="etp.assessment.pro.dimension.option">
        <field name="name">Both Good</field>
        <field name="dimension_id" ref="dim_image_vq"/>
        <field name="sequence">30</field>
    </record>
    <record id="dim_image_vq_opt_bb" model="etp.assessment.pro.dimension.option">
        <field name="name">Both Bad</field>
        <field name="dimension_id" ref="dim_image_vq"/>
        <field name="sequence">40</field>
    </record>
    <record id="dim_image_vq_opt_tie" model="etp.assessment.pro.dimension.option">
        <field name="name">Tie</field>
        <field name="dimension_id" ref="dim_image_vq"/>
        <field name="sequence">50</field>
    </record>

    <record id="dim_image_lai" model="etp.assessment.pro.dimension">
        <field name="name">Less AI-Generated (LAI)</field>
        <field name="sequence">30</field>
    </record>
    <record id="dim_image_lai_opt_a" model="etp.assessment.pro.dimension.option">
        <field name="name">Response A</field>
        <field name="dimension_id" ref="dim_image_lai"/>
        <field name="sequence">10</field>
    </record>
    <record id="dim_image_lai_opt_b" model="etp.assessment.pro.dimension.option">
        <field name="name">Response B</field>
        <field name="dimension_id" ref="dim_image_lai"/>
        <field name="sequence">20</field>
    </record>
    <record id="dim_image_lai_opt_bg" model="etp.assessment.pro.dimension.option">
        <field name="name">Both Good</field>
        <field name="dimension_id" ref="dim_image_lai"/>
        <field name="sequence">30</field>
    </record>
    <record id="dim_image_lai_opt_bb" model="etp.assessment.pro.dimension.option">
        <field name="name">Both Bad</field>
        <field name="dimension_id" ref="dim_image_lai"/>
        <field name="sequence">40</field>
    </record>
    <record id="dim_image_lai_opt_tie" model="etp.assessment.pro.dimension.option">
        <field name="name">Tie</field>
        <field name="dimension_id" ref="dim_image_lai"/>
        <field name="sequence">50</field>
    </record>

    <record id="dim_image_oc" model="etp.assessment.pro.dimension">
        <field name="name">Overall Choice (OC)</field>
        <field name="sequence">40</field>
    </record>
    <record id="dim_image_oc_opt_a" model="etp.assessment.pro.dimension.option">
        <field name="name">Response A</field>
        <field name="dimension_id" ref="dim_image_oc"/>
        <field name="sequence">10</field>
    </record>
    <record id="dim_image_oc_opt_b" model="etp.assessment.pro.dimension.option">
        <field name="name">Response B</field>
        <field name="dimension_id" ref="dim_image_oc"/>
        <field name="sequence">20</field>
    </record>
    <record id="dim_image_oc_opt_bg" model="etp.assessment.pro.dimension.option">
        <field name="name">Both Good</field>
        <field name="dimension_id" ref="dim_image_oc"/>
        <field name="sequence">30</field>
    </record>
    <record id="dim_image_oc_opt_bb" model="etp.assessment.pro.dimension.option">
        <field name="name">Both Bad</field>
        <field name="dimension_id" ref="dim_image_oc"/>
        <field name="sequence">40</field>
    </record>
    <record id="dim_image_oc_opt_tie" model="etp.assessment.pro.dimension.option">
        <field name="name">Tie</field>
        <field name="dimension_id" ref="dim_image_oc"/>
        <field name="sequence">50</field>
    </record>

</odoo>
