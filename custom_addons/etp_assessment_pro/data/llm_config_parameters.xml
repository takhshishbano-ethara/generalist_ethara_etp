<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="param_vertex_location" model="ir.config_parameter">
            <field name="key">etp_assessment_pro.vertex_location</field>
            <field name="value">global</field>
        </record>
        <!-- Single model for EVERY task: extraction, generation, scoring AND
             image rendering. -->
        <record id="param_vertex_model" model="ir.config_parameter">
            <field name="key">etp_assessment_pro.vertex_model</field>
            <field name="value">gemini-3-pro-image</field>
        </record>
        <record id="param_s3_region" model="ir.config_parameter">
            <field name="key">etp_assessment_pro.s3_region</field>
            <field name="value">us-east-1</field>
        </record>
        <record id="param_s3_folder" model="ir.config_parameter">
            <field name="key">etp_assessment_pro.s3_folder</field>
            <field name="value">etp_assessment</field>
        </record>
        <record id="param_s3_max_retries" model="ir.config_parameter">
            <field name="key">etp_assessment_pro.s3_max_retries</field>
            <field name="value">3</field>
        </record>
    </data>
</odoo>
