<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="etp_assessment_pro_category_tree" model="ir.ui.view">
        <field name="name">etp.assessment.pro.category.tree</field>
        <field name="model">etp.assessment.pro.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="question_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_pro_category_form" model="ir.ui.view">
        <field name="name">etp.assessment.pro.category.form</field>
        <field name="model">etp.assessment.pro.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Category Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="question_count"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Category description..."/>
                    <notebook>
                        <page string="Questions">
                            <group>
                                <field name="add_question_ids" widget="many2many_tags"
                                       options="{'no_create': True}"/>
                                <button name="action_add_questions_from_bank"
                                        type="object"
                                        string="Add Selected to Category"
                                        class="btn-secondary"
                                        invisible="not add_question_ids"/>
                            </group>
                            <field name="question_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="question_type"/>
                                    <field name="difficulty"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etp_assessment_pro_category" model="ir.actions.act_window">
        <field name="name">Question Categories</field>
        <field name="res_model">etp.assessment.pro.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
