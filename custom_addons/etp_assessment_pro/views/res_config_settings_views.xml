<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_etp_assessment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.etp_assessment</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ETP Assessment Pro"
                     string="ETP Assessment Pro"
                     name="etp_assessment_pro"
                     groups="etp_assessment_pro.group_assessment_manager">

                    <block title="Vertex AI" name="etp_vertex_section">
                        <setting id="etp_vertex_project_id"
                                 string="Vertex Project ID"
                                 help="GCP project ID hosting the Vertex AI / Gemini deployment.">
                            <field name="etp_assessment_pro_vertex_project_id"
                                   placeholder="my-gcp-project"/>
                        </setting>
                        <setting id="etp_vertex_location"
                                 string="Vertex Location"
                                 help="Region for ALL Gemini models (text and image). Gemini-3 series is served on 'global'.">
                            <field name="etp_assessment_pro_vertex_location"
                                   placeholder="global"/>
                        </setting>
                        <setting id="etp_vertex_model"
                                 string="Model"
                                 help="Default Gemini model for scoring, image rendering, and any task without its own override.">
                            <field name="etp_assessment_pro_vertex_model"
                                   placeholder="gemini-3-pro-image"/>
                        </setting>
                        <setting id="etp_generation_model"
                                 string="Question Generation Model"
                                 help="Strong multimodal model that reads the SOP document (with images) and authors questions directly. Leave empty to use the default Model.">
                            <field name="etp_assessment_pro_generation_model"
                                   placeholder="gemini-3-pro"/>
                        </setting>
                        <setting id="etp_detection_model"
                                 string="Image Detection Model"
                                 help="Multimodal model that detects elements in an image_label stimulus for the numbered-box overlay. Leave empty to use the Question Generation Model.">
                            <field name="etp_assessment_pro_detection_model"
                                   placeholder="gemini-3.1-pro-preview"/>
                        </setting>
                        <setting id="etp_scoring_model"
                                 string="Subjective Scoring Model"
                                 help="TEXT model the subjective judge grades with. MUST be a text model, never the image model. Leave empty to use the Question Generation Model.">
                            <field name="etp_assessment_pro_scoring_model"
                                   placeholder="gemini-2.5-pro"/>
                        </setting>
                        <setting id="etp_image_model"
                                 string="Image Rendering Model"
                                 help="Model that RENDERS image_ab / image_prompt / image_label pictures (gemini-3-pro-image = Nano Banana Pro, or cheaper gemini-3.1-flash-image = Nano Banana 2). Leave empty to use the Default Model.">
                            <field name="etp_assessment_pro_image_model"
                                   placeholder="gemini-3-pro-image"/>
                        </setting>
                        <setting id="etp_vertex_api_key"
                                 string="API Key"
                                 help="AIza... (Gemini Developer API) or AQ... (Vertex Express).">
                            <field name="etp_assessment_pro_vertex_api_key"
                                   password="True"
                                   placeholder="AIza... or AQ..."/>
                        </setting>
                        <setting id="etp_vertex_access_token"
                                 string="Static OAuth Bearer (optional)"
                                 help="Static aiplatform OAuth bearer. Leave empty to use SA JSON.">
                            <field name="etp_assessment_pro_vertex_access_token"
                                   password="True"/>
                        </setting>
                        <setting id="etp_vertex_sa"
                                 string="Service Account JSON"
                                 help="Upload a GCP service-account JSON. The module signs JWTs and auto-refreshes 1h bearers.">
                            <field name="vertex_sa_upload"
                                   widget="binary"
                                   filename="vertex_sa_upload_filename"/>
                            <field name="vertex_sa_upload_filename" invisible="1"/>
                            <div invisible="not etp_assessment_pro_vertex_service_account_filename"
                                 class="text-muted mt-1">
                                Current: <field name="etp_assessment_pro_vertex_service_account_filename"
                                                readonly="1" nolabel="1"/>
                            </div>
                        </setting>
                    </block>

                    <block title="Video Generation (Veo, optional)" name="etp_video_section">
                        <setting id="etp_video_model"
                                 string="Video Model (Veo)"
                                 help="Optional. Veo model for async video_prompt clip generation. Video generation only fires when this AND Vertex credentials resolve; otherwise video_prompt clips stay upload-only.">
                            <field name="etp_assessment_pro_video_model"
                                   placeholder="veo-3.1-generate-001"/>
                        </setting>
                        <setting id="etp_video_location"
                                 string="Video Location"
                                 help="Vertex region for Veo. Veo is served on us-central1, NOT 'global' (the gemini default 404s for Veo).">
                            <field name="etp_assessment_pro_video_location"
                                   placeholder="us-central1"/>
                        </setting>
                        <setting id="etp_video_default_duration_s"
                                 string="Clip Duration (s)"
                                 help="Default generated clip length in seconds when a brief omits one.">
                            <field name="etp_assessment_pro_video_default_duration_s"/>
                        </setting>
                    </block>

                    <block title="S3 Storage" name="etp_s3_section">
                        <setting id="etp_s3_bucket"
                                 string="S3 Bucket"
                                 help="Target bucket. Leave empty to disable S3.">
                            <field name="etp_assessment_pro_s3_bucket"/>
                        </setting>
                        <setting id="etp_s3_region"
                                 string="S3 Region"
                                 help="AWS region for the bucket.">
                            <field name="etp_assessment_pro_s3_region"/>
                        </setting>
                        <setting id="etp_s3_access_key_id"
                                 string="S3 Access Key ID"
                                 help="AWS access key with PutObject/DeleteObject permissions.">
                            <field name="etp_assessment_pro_s3_access_key_id"/>
                        </setting>
                        <setting id="etp_s3_secret_key"
                                 string="S3 Secret Key"
                                 help="AWS secret matching the access key ID.">
                            <field name="etp_assessment_pro_s3_secret_key"
                                   password="True"/>
                        </setting>
                        <setting id="etp_s3_folder"
                                 string="S3 Key Prefix"
                                 help="Folder under the bucket where uploads land.">
                            <field name="etp_assessment_pro_s3_folder"/>
                        </setting>
                        <setting id="etp_s3_cdn_url"
                                 string="CDN Base URL"
                                 help="Optional. Returned URLs use this base instead of the virtual-hosted S3 URL.">
                            <field name="etp_assessment_pro_s3_cdn_url"
                                   placeholder="https://cdn.example.com"/>
                        </setting>
                        <setting id="etp_s3_max_retries"
                                 string="Max Upload Retries"
                                 help="put_object retry count on transient errors.">
                            <field name="etp_assessment_pro_s3_max_retries"/>
                        </setting>
                    </block>

                    <block title="Scoring" name="etp_scoring_section">
                        <setting id="etp_llm_max_attempts"
                                 string="LLM Scoring Max Attempts"
                                 help="After this many failed attempts a response resolves as a fail instead of staying pending.">
                            <field name="etp_assessment_pro_llm_max_attempts"/>
                        </setting>
                        <setting id="etp_scoring_batch_size"
                                 string="Scoring Batch Size"
                                 help="Max answers graded in one Vertex call; large candidates are split into sub-batches of this size.">
                            <field name="etp_assessment_pro_scoring_batch_size"/>
                        </setting>
                    </block>

                    <block title="System Prompts" name="etp_prompts_section">
                        <setting id="etp_question_prompt"
                                 string="Question Generation Prompt (.md upload)"
                                 help="Upload a .md to override the bundled prompts/question.md. Empty = use bundled.">
                            <field name="question_prompt_upload"
                                   widget="binary"
                                   filename="question_prompt_upload_filename"/>
                            <field name="question_prompt_upload_filename" invisible="1"/>
                            <field name="etp_assessment_pro_question_prompt" invisible="1"/>
                            <field name="etp_assessment_pro_question_prompt_filename" invisible="1"/>
                            <div invisible="not etp_assessment_pro_question_prompt"
                                 class="text-muted mt-1">
                                Current: <field name="etp_assessment_pro_question_prompt_filename"
                                              readonly="1" nolabel="1" class="d-inline-block"/>
                                <br/>
                                Custom override active. Clear at Technical → System
                                Parameters → etp_assessment_pro.question_prompt to revert.
                            </div>
                        </setting>
                        <setting id="etp_scoring_prompt"
                                 string="Scoring Prompt (.md upload)"
                                 help="Upload a .md to override the bundled prompts/scoring.md. Governs ALL graded types (subjective + image). Empty = use bundled.">
                            <field name="scoring_prompt_upload"
                                   widget="binary"
                                   filename="scoring_prompt_upload_filename"/>
                            <field name="scoring_prompt_upload_filename" invisible="1"/>
                            <field name="etp_assessment_pro_scoring_prompt" invisible="1"/>
                            <field name="etp_assessment_pro_scoring_prompt_filename" invisible="1"/>
                            <div invisible="not etp_assessment_pro_scoring_prompt"
                                 class="text-muted mt-1">
                                Current: <field name="etp_assessment_pro_scoring_prompt_filename"
                                              readonly="1" nolabel="1" class="d-inline-block"/>
                                <br/>
                                Custom override active. Clear at Technical → System
                                Parameters → etp_assessment_pro.scoring_system_prompt to revert.
                            </div>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <record id="action_etp_assessment_pro_config" model="ir.actions.act_window">
        <field name="name">ETP Assessment Pro Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'etp_assessment'}</field>
    </record>
</odoo>
