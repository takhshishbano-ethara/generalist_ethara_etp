<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="etp_assessment_pro_question_tree" model="ir.ui.view">
        <field name="name">etp.assessment.pro.question.tree</field>
        <field name="model">etp.assessment.pro.question</field>
        <field name="arch" type="xml">
            <list class="o_etp_backend">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="question_type"/>
                <field name="generator_id"/>
                <field name="difficulty"/>
                <field name="source_ref"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_pro_question_form" model="ir.ui.view">
        <field name="name">etp.assessment.pro.question.form</field>
        <field name="model">etp.assessment.pro.question</field>
        <field name="arch" type="xml">
            <form class="o_etp_backend">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Question Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="question_type"/>
                            <field name="generator_id"/>
                            <field name="difficulty"/>
                            <field name="detection_mode"
                                   invisible="question_type != 'image_label'"/>
                            <field name="time_minutes"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="source_ref" readonly="1"/>
                            <field name="has_subjective" readonly="1"/>
                        </group>
                    </group>
                    <field name="prompt" placeholder="Question prompt..."/>
                    <field name="description" placeholder="Optional description..."/>
                    <field name="has_valid_key" invisible="1"/>
                    <field name="has_revealing_option" invisible="1"/>
                    <field name="has_source_reference" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="has_valid_key">
                        <strong>Missing answer key.</strong> This objective
                        question has no correct option marked, so it cannot be
                        scored. Mark the correct option(s) under Dimensions.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not has_revealing_option">
                        <strong>Option reveals its rationale.</strong> An option
                        name embeds a "…, because …" justification. Option names
                        are shown to the candidate — keep them to the bare choice
                        (e.g. <strong>Image B</strong>) and move the "why" to the
                        hidden Answer Rationale. Regenerate or edit the option text.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not has_source_reference">
                        <strong>References the source material.</strong> This item
                        (or its answer key) cites the SOP / guidelines / a Section,
                        but the candidate never sees the source — the question must
                        be self-contained. Regenerate, or rewrite so the deciding
                        facts live in the scenario itself.
                    </div>
                    <separator string="Answer Key" invisible="not has_answer_key"/>
                    <field name="has_answer_key" invisible="1"/>
                    <field name="answer_key_preview" widget="html"
                           invisible="not has_answer_key"/>
                    <notebook>
                        <page string="Skills">
                            
                        </page>
                        <page string="Dimensions">
                            <div class="alert alert-info" role="alert"
                                 invisible="not has_answer_key">
                                The badged <strong>Answer Key</strong> above is the
                                published view. Edit option text or the correct
                                flag here; the preview updates on save.
                            </div>
                            <field name="question_dimension_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="sequence"/>
                                        </group>
                                        <field name="option_line_ids">
                                            <list editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="name"/>
                                                <field name="is_correct"/>
                                                <field name="score" readonly="1"/>
                                            </list>
                                        </field>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Grading / Rubric"
                              invisible="question_type in ('image_ab','image_prompt','image_label') or (question_type in ('mcq','msq') and not official_reasoning)">
                            <group>
                                <field name="official_reasoning" readonly="1"
                                       string="Answer Rationale (hidden from candidate)"
                                       invisible="question_type not in ('mcq','msq')"/>
                                <field name="subjective_rubric_json" placeholder="[]" widget="text"
                                       invisible="question_type != 'subjective_rubric'"/>
                                <field name="grading_json" placeholder="{}" widget="text"
                                       invisible="not grading_json"/>
                                <field name="meta_json" placeholder="{}" widget="text"
                                       invisible="not meta_json"/>
                            </group>
                        </page>
                        <page string="Image Evaluation"
                              invisible="question_type not in ('image_ab','image_prompt','image_label')">
                            <div class="etp-imgeval">
                                <div class="alert alert-info etp-imgeval-banner" role="alert"
                                     invisible="question_type != 'image_label'">
                                    <i class="fa fa-object-group" role="img" aria-label="Image Labelling"/>
                                    <span><strong>Image Labelling.</strong> Upload a source
                                    image on the Single row (a photo, or a UI
                                    screenshot), pick the matching <strong>Detection
                                    Mode</strong> above, then click
                                    <strong>Detect Now</strong> — or wait a minute for
                                    the background cron. Detection draws the numbered
                                    overlay the candidate sees and stores the answer
                                    key below.</span>
                                </div>
                                <div class="etp-imgeval-toolbar">
                                    <button name="action_offload_images_s3" type="object"
                                            string="Offload Images to S3"
                                            icon="fa-cloud-upload"
                                            class="btn-secondary"/>
                                    <button name="action_detect_now" type="object"
                                            string="Detect Now"
                                            icon="fa-magic"
                                            class="btn-primary"
                                            invisible="question_type != 'image_label'"/>
                                </div>
                                <field name="image_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="label"/>
                                        <field name="slot_ab"
                                               column_invisible="parent.question_type != 'image_ab'"/>
                                        <field name="slot_text"
                                               column_invisible="parent.question_type not in ('image_prompt','image_label')"/>
                                        <field name="image" widget="image"
                                               options="{'size': [90, 90]}"/>
                                        <field name="image_admin_url" widget="image_url"
                                               string="Preview"
                                               options="{'size': [0, 90]}"/>
                                        <field name="image_url" widget="url"
                                               string="S3 URL" optional="show"/>
                                        <field name="annotated_image" widget="image"
                                               options="{'size': [90, 90]}" readonly="1"
                                               column_invisible="parent.question_type != 'image_label'"/>
                                        <field name="annotated_admin_url" widget="image_url"
                                               string="Annotated"
                                               options="{'size': [0, 90]}"
                                               column_invisible="parent.question_type != 'image_label'"/>
                                        <field name="detections_json" readonly="1"
                                               column_invisible="parent.question_type != 'image_label'"/>
                                        <field name="source_url" widget="url"
                                               string="Source URL" optional="show"
                                               column_invisible="parent.question_type != 'image_label'"/>
                                        <field name="capture_viewport" readonly="1"
                                               string="Viewport" optional="hide"
                                               column_invisible="parent.question_type != 'image_label'"/>
                                        <field name="dom_manifest_json" readonly="1"
                                               string="DOM Manifest" optional="hide"
                                               column_invisible="parent.question_type != 'image_label'"/>
                                        <field name="behavioural_key_json" readonly="1"
                                               string="Behavioural Key" optional="hide"
                                               column_invisible="parent.question_type != 'image_label'"/>
                                        <button name="action_capture_url" type="object"
                                                string="Capture URL" icon="fa-crosshairs"
                                                column_invisible="parent.question_type != 'image_label'"
                                                invisible="not source_url"/>
                                    </list>
                                </field>
                                <group invisible="question_type != 'image_ab'">
                                    <field name="official_reasoning"
                                           placeholder="Official rationale the LLM grades the candidate justification against..."/>
                                    <field name="flaw_plan_json" widget="text" readonly="1"
                                           string="Flaw Plan (JSON)"
                                           invisible="not flaw_plan_json"/>
                                </group>
                                <group string="Answer Key (JSON)" class="etp-akey"
                                       invisible="question_type not in ('image_prompt','image_label')">
                                    <field name="subjective_rubric_json" nolabel="1"
                                           placeholder='{"ideal_prompt or ideal_labels": "...", "mandatory_elements": ["..."], "penalty_rules": ["..."], "scoring_guide": "..."}'
                                           widget="text"/>
                                </group>
                            </div>
                        </page>
                        <page string="Video Evaluation"
                              invisible="question_type != 'video_prompt'">
                            <div class="etp-imgeval">
                                <div class="alert alert-info etp-imgeval-banner" role="alert">
                                    <i class="fa fa-film" role="img" aria-label="Video Prompt"/>
                                    <span><strong>Video Prompt.</strong> Upload a
                                    <strong>Reference</strong> clip and an
                                    <strong>Output</strong> clip below (mp4/webm),
                                    then fill the Answer Key with the ideal prompt.
                                    The candidate writes the transformation prompt,
                                    graded like an Image Prompt.</span>
                                </div>
                                <group string="Upload Clip">
                                    <field name="upload_video_slot"/>
                                    <field name="upload_video" widget="binary"
                                           filename="upload_video_filename"/>
                                    <field name="upload_video_filename" invisible="1"/>
                                    <button name="action_apply_uploaded_video" type="object"
                                            string="Apply Uploaded Video"
                                            icon="fa-cloud-upload"
                                            class="btn-primary"
                                            invisible="not upload_video"/>
                                </group>
                                <field name="video_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="label"/>
                                        <field name="slot"/>
                                        <field name="video_url" widget="url"
                                               string="S3 URL" optional="show"/>
                                        <field name="video" widget="binary"
                                               filename="video_filename"/>
                                        <field name="video_filename" optional="hide"/>
                                        <field name="poster_url" widget="url"
                                               optional="hide"/>
                                        <field name="duration_s" optional="hide"/>
                                        <field name="has_audio" optional="hide"/>
                                    </list>
                                </field>
                                <group string="Answer Key (JSON)" class="etp-akey">
                                    <field name="subjective_rubric_json" nolabel="1"
                                           placeholder='{"ideal_prompt": "...", "mandatory_elements": ["..."], "penalty_rules": ["..."], "scoring_guide": "..."}'
                                           widget="text"/>
                                </group>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="etp_assessment_pro_question_kanban" model="ir.ui.view">
        <field name="name">etp.assessment.pro.question.kanban</field>
        <field name="model">etp.assessment.pro.question</field>
        <field name="arch" type="xml">
            <kanban class="o_etp_backend" sample="1">
                <field name="question_type"/>
                <templates>
                    <t t-name="card">
                        <div class="etp-kanban-card etp-kanban-card--question">
                            <span class="etp-kc-accent"/>
                            <field class="etp-kc-title" name="name"/>
                            <div class="etp-kc-tags">
                                <field name="question_type" widget="badge"
                                       decoration-info="question_type in ('mcq','msq')"
                                       decoration-warning="question_type == 'subjective_rubric'"
                                       decoration-success="question_type in ('image_ab','image_prompt','image_label')"/>
                                <field name="difficulty" widget="badge"
                                       decoration-success="difficulty == 'easy'"
                                       decoration-warning="difficulty == 'medium'"
                                       decoration-danger="difficulty == 'hard'"/>
                            </div>
                            <div class="etp-kc-sub">
                                <i class="fa fa-folder-o me-1" role="img"
                                   aria-label="Question Generator"/>
                                <field name="generator_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="etp_assessment_pro_question_search" model="ir.ui.view">
        <field name="name">etp.assessment.pro.question.search</field>
        <field name="model">etp.assessment.pro.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="prompt"/>
                <field name="generator_id"/>
                
                <separator/>
                <filter name="filter_mcq" string="MCQ" domain="[('question_type','=','mcq')]"/>
                <filter name="filter_msq" string="MSQ" domain="[('question_type','=','msq')]"/>
                <filter name="filter_subjective" string="Subjective"
                        domain="[('question_type','=','subjective_rubric')]"/>
                <filter name="filter_image" string="Image Evaluation"
                        domain="[('question_type','in',('image_ab','image_prompt','image_label'))]"/>
                <filter name="group_generator" string="Question Generator"
                        context="{'group_by':'generator_id'}"/>
                <filter name="group_type" string="Type"
                        context="{'group_by':'question_type'}"/>
                <filter name="group_difficulty" string="Difficulty"
                        context="{'group_by':'difficulty'}"/>
            </search>
        </field>
    </record>

    <record id="action_etp_assessment_pro_question" model="ir.actions.act_window">
        <field name="name">Question Bank</field>
        <field name="res_model">etp.assessment.pro.question</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="etp_assessment_pro_question_search"/>
    </record>

    <record id="action_export_question_bank_json" model="ir.actions.server">
        <field name="name">Export to JSON</field>
        <field name="model_id" ref="model_etp_assessment_pro_question"/>
        <field name="binding_model_id" ref="model_etp_assessment_pro_question"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_json()</field>
    </record>

    <record id="action_export_question_bank_csv" model="ir.actions.server">
        <field name="name">Export to CSV</field>
        <field name="model_id" ref="model_etp_assessment_pro_question"/>
        <field name="binding_model_id" ref="model_etp_assessment_pro_question"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_csv()</field>
    </record>

    <record id="action_export_question_bank_native" model="ir.actions.server">
        <field name="name">Export to JSON (round-trip)</field>
        <field name="model_id" ref="model_etp_assessment_pro_question"/>
        <field name="binding_model_id" ref="model_etp_assessment_pro_question"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_native_json()</field>
    </record>
</odoo>
