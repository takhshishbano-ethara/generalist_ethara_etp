<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- Analytics Dashboard — native graph + pivot on the evaluator   -->
    <!-- (per-candidate result row, the richest analytics model).      -->
    <!-- All measures/group-bys below are STORED fields.               -->
    <!-- ============================================================= -->

    <record id="etp_assessment_pro_evaluator_graph" model="ir.ui.view">
        <field name="name">etp.assessment.pro.evaluator.graph</field>
        <field name="model">etp.assessment.pro.evaluator</field>
        <field name="arch" type="xml">
            <graph string="Candidate Results" type="bar" sample="1">
                <field name="assessment_id" type="row"/>
                <field name="result" type="col"/>
                <field name="score_percent" type="measure" string="Avg Score %"/>
            </graph>
        </field>
    </record>

    <record id="etp_assessment_pro_evaluator_pivot" model="ir.ui.view">
        <field name="name">etp.assessment.pro.evaluator.pivot</field>
        <field name="model">etp.assessment.pro.evaluator</field>
        <field name="arch" type="xml">
            <pivot string="Candidate Results" sample="1">
                <field name="assessment_id" type="row"/>
                <field name="result" type="col"/>
                <field name="score_percent" type="measure" string="Avg Score %"/>
                <field name="total_score" type="measure"/>
                <field name="llm_total_score" type="measure"/>
                <field name="answered_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="etp_assessment_pro_evaluator_analytics_search"
            model="ir.ui.view">
        <field name="name">etp.assessment.pro.evaluator.analytics.search</field>
        <field name="model">etp.assessment.pro.evaluator</field>
        <field name="arch" type="xml">
            <search>
                <field name="assessment_id"/>
                <field name="applicant_id"/>
                <filter name="f_pass" string="Passed"
                        domain="[('result','=','pass')]"/>
                <filter name="f_fail" string="Failed"
                        domain="[('result','=','fail')]"/>
                <filter name="f_submitted" string="Submitted"
                        domain="[('state','=','submitted')]"/>
                <separator/>
                <filter name="g_assessment" string="Assessment"
                        context="{'group_by':'assessment_id'}"/>
                <filter name="g_result" string="Result"
                        context="{'group_by':'result'}"/>
                <filter name="g_state" string="State"
                        context="{'group_by':'state'}"/>
                <filter name="g_month" string="Started (Month)"
                        context="{'group_by':'create_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_etp_assessment_pro_dashboard"
            model="ir.actions.act_window">
        <field name="name">Analytics Dashboard</field>
        <field name="res_model">etp.assessment.pro.evaluator</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id"
               ref="etp_assessment_pro_evaluator_analytics_search"/>
        <field name="context">{'search_default_g_assessment': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">No candidate results yet.</p>
            <p>Once candidates are scored, their results power these native
               bar / pie charts and the pivot table - average score,
               pass/fail split, and objective vs subjective marks per
               assessment.</p>
        </field>
    </record>

</odoo>
