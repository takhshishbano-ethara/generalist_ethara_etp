<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Menu visibility
      ===============
      Both candidates and managers open the SAME app (apps menu -> ETP
      Assessment). What differs is what's inside:

        - Candidates (group_assessment_evaluator) see ONLY "My Assessments".
        - Managers (group_assessment_manager, which implies evaluator) see
          everything: Assessments, Plans, Configuration, etc.

      So the root menu is gated to the EVALUATOR group (the lowest common
      denominator) and every admin/config item is gated to MANAGER. This keeps
      candidates inside the app but blocks them from any admin data — the
      record rules scope My Assessments to their own rows on top of that.
    -->

    <!-- App root: visible to anyone in the assessment groups -->
    <menuitem id="menu_etp_assessment_pro_root"
              name="ETP Assessment Pro"
              sequence="100"
              groups="etp_assessment_pro.group_assessment_evaluator"/>

    <!--
      Candidates are PORTAL users now; their assessment view is the website
      portal page (/my/pro_assessments). The former backend "My Assessments"
      menuitem + its action_my_assessments were removed as obsolete.
    -->

    <!-- Everything below is MANAGER-only -->
    <menuitem id="menu_etp_assessment_pro_assessments"
              name="Assessments"
              parent="menu_etp_assessment_pro_root"
              action="action_etp_assessment"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="5"/>

    <!-- Plans: day plans + the materialized per-candidate day sessions -->
    <menuitem id="menu_etp_assessment_pro_plans"
              name="Plans"
              parent="menu_etp_assessment_pro_root"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="10"/>

    <menuitem id="menu_etp_assessment_pro_days_admin"
              name="Day Plans"
              parent="menu_etp_assessment_pro_plans"
              action="action_assessment_days_admin"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="1"/>

    <menuitem id="menu_etp_assessment_pro_day_sessions_admin"
              name="Day Sessions"
              parent="menu_etp_assessment_pro_plans"
              action="action_assessment_day_sessions_admin"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="2"/>

    <menuitem id="menu_etp_assessment_pro_question"
              name="Questions"
              parent="menu_etp_assessment_pro_root"
              action="action_etp_assessment_pro_question"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="20"/>

    <menuitem id="menu_etp_assessment_pro_prompt"
              name="Generators"
              parent="menu_etp_assessment_pro_root"
              action="action_etp_assessment_pro_prompt"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="30"/>

    <menuitem id="menu_etp_assessment_pro_responses"
              name="All Responses"
              parent="menu_etp_assessment_pro_root"
              action="action_etp_assessment_pro_response"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="40"/>

    <!-- Configuration: reference data + settings -->
    <menuitem id="menu_etp_assessment_pro_config_root"
              name="Configuration"
              parent="menu_etp_assessment_pro_root"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="90"/>

    <menuitem id="menu_etp_assessment_pro_skill"
              name="Skills"
              parent="menu_etp_assessment_pro_config_root"
              action="action_etp_assessment_pro_skill"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="1"/>

    <menuitem id="menu_etp_assessment_pro_category"
              name="Categories"
              parent="menu_etp_assessment_pro_config_root"
              action="action_etp_assessment_pro_category"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="2"/>

    <menuitem id="menu_etp_assessment_pro_dimension"
              name="Dimensions"
              parent="menu_etp_assessment_pro_config_root"
              action="action_etp_assessment_pro_dimension"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="3"/>

    <menuitem id="menu_etp_assessment_pro_config"
              name="Settings"
              parent="menu_etp_assessment_pro_config_root"
              action="action_etp_assessment_pro_config"
              groups="etp_assessment_pro.group_assessment_manager"
              sequence="10"/>
</odoo>
