<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =====================================================================
         Import Question Bank wizard. Opens from a button on the Question Bank
         Generators form header. Parses a CSV (Download Template) and publishes
         each row straight into the bank. Multi-dimension questions (image_ab,
         dense-bbox) are authored with indexed dimN_* columns so no manual
         dimension entry is needed.
         ===================================================================== -->
    <record id="etp_assessment_pro_bank_import_wizard_form" model="ir.ui.view">
        <field name="name">etp.assessment.pro.bank.import.wizard.form</field>
        <field name="model">etp.assessment.pro.bank.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Question Bank">
                <sheet>
                    <div class="oe_title">
                        <h2>Import Question Bank</h2>
                    </div>
                    <group>
                        <group>
                            <field name="target_category_id"
                                   options="{'no_create_edit': False}"/>
                            <field name="data_file" filename="data_filename"
                                   widget="binary"/>
                            <field name="data_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="generator_name"
                                   placeholder="Defaults to the filename"/>
                            <field name="question_count" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Click <em>Download Template</em> for a sample with one row
                        per question type and every supported column. Inside a cell,
                        separate multiple options / correct answers / skills with a
                        pipe <code>|</code>. Multi-dimension questions use the
                        indexed columns <code>dim1_label / dim1_options /
                        dim1_correct</code> … <code>dimN_*</code>. Images use
                        <code>img1_url / img1_slot / img1_label</code> … — URLs are
                        used directly, and offloaded to S3 when configured.
                    </div>
                </sheet>
                <footer>
                    <button name="action_import" type="object"
                            string="Import to Question Bank"
                            class="btn-primary"/>
                    <button name="action_download_template" type="object"
                            string="Download Template" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_etp_assessment_pro_bank_import" model="ir.actions.act_window">
        <field name="name">Import Question Bank</field>
        <field name="res_model">etp.assessment.pro.bank.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
