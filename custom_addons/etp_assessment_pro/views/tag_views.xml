<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_etp_assessment_pro_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">etp.assessment.pro.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Manage the SOP tag vocabulary</p>
            <p>
                Tags are usually created automatically when a SOP is analysed. Here you
                can rename their readable label, recolour them, delete unused ones, or
                select several and <b>Merge</b> near-duplicates into one — every project
                using a merged tag is repointed to the survivor so ranking stays clean.
            </p>
        </field>
    </record>

    <record id="etp_assessment_pro_tag_list" model="ir.ui.view">
        <field name="name">etp.assessment.pro.tag.list</field>
        <field name="model">etp.assessment.pro.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1">
                <header>
                    <button name="action_merge_tags" type="object"
                            string="Merge Selected"
                            help="Merge the selected tags into the most-used one and repoint every project to it."/>
                </header>
                <field name="prefix" optional="show"
                       placeholder="e.g. domain"/>
                <field name="display" string="Readable Name"
                       placeholder="e.g. AI Image Editing"/>
                <field name="name" string="Machine Key" readonly="1"
                       force_save="1"
                       help="Auto-built from Prefix + Readable Name. Ranking reads this."/>
                <field name="usage_count" string="Used in Projects" readonly="1"/>
                <field name="color" widget="color_picker" optional="show"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_pro_tag_form" model="ir.ui.view">
        <field name="name">etp.assessment.pro.tag.form</field>
        <field name="model">etp.assessment.pro.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="display" string="Readable Name"/>
                        <h1><field name="display" placeholder="e.g. Compare Two AI Images (A/B)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="prefix"
                                   placeholder="domain / task / modality / output-format / skill"/>
                            <field name="name" string="Machine Key (facet:value)"
                                   readonly="1" force_save="1"/>
                            <field name="label" readonly="1"/>
                        </group>
                        <group>
                            <field name="usage_count" readonly="1"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Ranking always uses the machine key. The readable name is what
                        the growth team sees. One key maps to one readable name.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="etp_assessment_pro_tag_search" model="ir.ui.view">
        <field name="name">etp.assessment.pro.tag.search</field>
        <field name="model">etp.assessment.pro.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="display"/>
                <field name="name"/>
                <field name="prefix"/>
                <filter name="group_prefix" string="Facet"
                        context="{'group_by': 'prefix'}"/>
            </search>
        </field>
    </record>

</odoo>
