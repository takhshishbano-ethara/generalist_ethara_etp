<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="etp_assessment_pro_prompt_tree" model="ir.ui.view">
        <field name="name">etp.assessment.pro.prompt.tree</field>
        <field name="model">etp.assessment.pro.prompt</field>
        <field name="arch" type="xml">
            <list js_class="etp_prompt_import_list" class="o_etp_backend">
                <header>
                    <button name="action_normalize_tags" type="object"
                            string="Normalize Tags"
                            help="Re-extract SOP tags for the selected generators so drifted tags converge on the shared vocabulary and similarity ranking improves."/>
                </header>
                <field name="name"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}" optional="hide"
                       context="{'etp_hide_tag_prefix': True}"/>
                <field name="resource_count"/>
                <field name="question_count"/>
                <field name="approved_count"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_pro_prompt_similar_tree" model="ir.ui.view">
        <field name="name">etp.assessment.pro.prompt.similar.tree</field>
        <field name="model">etp.assessment.pro.prompt</field>
        <!-- High priority so this ranking-only view is never auto-selected as the
             default list for the Generators action (it is referenced explicitly
             by the "Similar Projects" action's view_id). -->
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list class="o_etp_backend" create="false">
                <field name="name"/>
                <field name="tag_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"
                       context="{'etp_hide_tag_prefix': True}"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_pro_prompt_form" model="ir.ui.view">
        <field name="name">etp.assessment.pro.prompt.form</field>
        <field name="model">etp.assessment.pro.prompt</field>
        <field name="arch" type="xml">
            <form class="o_etp_backend">
                <header>
                    <button name="%(action_etp_assessment_pro_bank_import)d"
                            type="action" string="Import Question Bank"
                            class="btn-secondary" icon="fa-upload"/>
                    <button name="action_generate_from_sop" type="object"
                            string="Generate Questions"
                            class="oe_highlight"
                            invisible="not resource_ids"/>
                    <button name="action_extract_tags" type="object"
                            string="Extract Tags"
                            invisible="not resource_ids"/>
                    <button name="action_approve_all_drafts" type="object"
                            string="Approve All Drafts"
                            confirm="Approve every pending draft question into the question bank?"
                            invisible="question_count == 0"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,skills_ready,generating,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_similar" type="object"
                                class="oe_stat_button" icon="fa-sitemap"
                                invisible="similar_count == 0">
                            <field name="similar_count" widget="statinfo"
                                   string="Similar"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Prompt Title"/>
                        </h1>
                    </div>

                    <!-- Step 1: the mandatory SOP upload, front and centre -->
                    <field name="has_sop_resource" invisible="1"/>
                    <div class="o_etp_sop_upload p-2 mb-3">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <label for="upload_sop_file" string="SOP document (required)"
                                   class="o_etp_flabel fw-semibold mb-0"/>
                            <field name="upload_sop_file" nolabel="1"
                                   widget="etp_upload_button"
                                   filename="upload_sop_filename"
                                   required="not has_sop_resource"
                                   help="Required: the SOP document questions are generated from."/>
                            <field name="upload_sop_filename" invisible="1"/>
                            <field name="resource_ids" nolabel="1"
                                   widget="etp_file_chips"
                                   options="{'category': 'sop'}"/>
                        </div>
                    </div>

                    <!-- Status: what the system reports (dimmed, secondary) -->
                    <group class="o_etp_status">
                        <group>
                            <field name="resource_count" readonly="1"/>
                            <field name="sop_gen_state" readonly="1"
                                   decoration-info="sop_gen_state == 'queued'"
                                   decoration-warning="sop_gen_state == 'generating'"
                                   decoration-success="sop_gen_state == 'done'"
                                   decoration-danger="sop_gen_state == 'failed'"
                                   widget="badge"/>
                            <field name="sop_gen_error" readonly="1"
                                   invisible="sop_gen_state != 'failed'"/>
                            <field name="tag_extract_state" readonly="1"
                                   decoration-info="tag_extract_state == 'queued'"
                                   decoration-warning="tag_extract_state == 'generating'"
                                   decoration-success="tag_extract_state == 'done'"
                                   decoration-danger="tag_extract_state == 'failed'"
                                   widget="badge"/>
                            <field name="tag_extract_error" readonly="1"
                                   invisible="tag_extract_state != 'failed'"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"
                                   context="{'etp_hide_tag_prefix': True}"
                                   placeholder="Semantic SOP tags..."/>
                        </group>
                        <group>
                            <field name="last_extract_summary" readonly="1"/>
                            <field name="question_count" readonly="1"/>
                            <field name="approved_count" readonly="1"/>
                        </group>
                    </group>

                    <!-- Generation controls: every knob for the run, in one card -->
                    <div class="o_etp_panel">
                        <separator string="Generation controls"/>
                        <div class="d-flex align-items-center gap-3 flex-wrap mb-2 mt-1">
                            <label for="question_count_mode" string="Questions to generate"
                                   class="o_etp_flabel fw-semibold mb-0"/>
                            <field name="question_count_mode" nolabel="1"
                                   widget="radio" options="{'horizontal': True}"/>
                            <field name="sop_question_count" nolabel="1" widget="integer"
                                   invisible="question_count_mode != 'fixed'"
                                   class="o_etp_count_input"/>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                            <label for="upload_sample_file" string="Sample questions (optional)"
                                   class="o_etp_flabel fw-semibold mb-0"/>
                            <field name="upload_sample_file" nolabel="1"
                                   widget="etp_upload_button"
                                   filename="upload_sample_filename"
                                   help="Upload a sample-questions file (PDF/DOCX/MD/image) so generated questions match its format - optional."/>
                            <field name="upload_sample_filename" invisible="1"/>
                            <field name="resource_ids" nolabel="1"
                                   widget="etp_file_chips"
                                   options="{'category': 'sample'}"/>
                        </div>
                        <div class="d-flex align-items-center justify-content-between mb-1 mt-3">
                            <span class="fw-semibold">Allowed question types</span>
                            <span class="d-inline-flex align-items-center gap-1 small text-muted">
                                <field name="select_all_types" nolabel="1"/>
                                <label for="select_all_types" string="Select all" class="mb-0 fw-normal"/>
                            </span>
                        </div>
                        <div class="o_etp_control mb-1 o_etp_qtypes">
                            <field name="types_all_selected" invisible="1"/>
                            <span class="o_etp_qtypes_full" invisible="not types_all_selected"/>
                            <field name="allowed_question_type_ids" nolabel="1"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   domain="[('id', 'not in', allowed_question_type_ids)]"
                                   placeholder="Add a type…"
                                   help="Leave empty to let the model choose the best type per item."/>
                        </div>
                        <div class="text-muted small mb-2">
                            The generator may author only these types. Leave empty to let it choose freely per the SOP.
                            <span class="d-block">“Questions to Generate” is kept at least the number of selected types, so each can appear once.</span>
                        </div>
                        <div class="fw-semibold mb-1 mt-3">Extra instructions</div>
                        <div class="o_etp_control">
                            <field name="source_text" nolabel="1" rows="4"
                                   placeholder="Optional extra instructions for the generator…"/>
                        </div>
                        <div class="text-muted small mt-1">
                            Appended to the source material the model reads - e.g. "focus on edge-case moderation calls; keep language plain, avoid legalese."
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-2 mt-3">
                            <label for="upload_reference_file" string="Reference files (optional)"
                                   class="o_etp_flabel fw-semibold mb-0"/>
                            <field name="upload_reference_file" nolabel="1"
                                   widget="etp_upload_button"
                                   options="{'icon_only': true, 'label': 'Add a reference file'}"
                                   filename="upload_reference_filename"
                                   help="Supporting documents the generator reads alongside the SOP and your notes."/>
                            <field name="upload_reference_filename" invisible="1"/>
                            <field name="resource_ids" nolabel="1"
                                   widget="etp_file_chips"
                                   options="{'category': 'reference'}"/>
                        </div>
                    </div>

                    <div class="alert alert-info" role="alert"
                         invisible="extract_state not in ('queued','extracting')">
                        Tag extraction runs in the background. Tags will appear
                        within about a minute.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="extract_state != 'failed'">
                        <strong>Extraction failed.</strong>
                        <field name="extract_error" readonly="1" nolabel="1"
                               class="d-inline"/>
                        Fix the issue and click Extract Tags again.
                    </div>
                    <notebook>
                        <page string="Resources">
                            <div class="alert alert-info" role="alert">
                                Every file attached to this generator. Upload from the form above.
                                Text is extracted from .docx, .txt, .md, .csv, .html, .json and .xml;
                                .pdf and images are read directly by the model instead.
                            </div>
                            <field name="resource_ids" readonly="1">
                                <list create="false" delete="false" edit="false">
                                    <field name="category"/>
                                    <field name="name"/>
                                    <field name="file" filename="name"/>
                                    <field name="char_count"/>
                                    <field name="status"/>
                                    <field name="extraction_error"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name" readonly="1"/>
                                            <field name="file" filename="name" readonly="1"/>
                                            <field name="char_count" readonly="1"/>
                                            <field name="status" readonly="1"/>
                                            <field name="extraction_error" readonly="1"/>
                                        </group>
                                        <field name="extracted_text" readonly="1"/>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Similar Projects" name="similar_projects">
                            <div class="o_etp_backend etp-simrank-wrap">
                                <field name="similar_html" widget="html"
                                       readonly="1" nolabel="1"/>
                            </div>
                        </page>
                        <page string="Question Drafts">
                            <field name="question_ids">
                                <list>
                                    <header>
                                        <button name="action_approve" type="object"
                                                string="Approve Selected" class="btn-primary"/>
                                        <button name="action_deny" type="object"
                                                string="Deny Selected" class="btn-secondary"/>
                                    </header>
                                    
                                    <field name="name"/>
                                    <field name="question_type"/>
                                    <field name="difficulty"/>
                                    <field name="has_dimensions" string="Keyed"
                                           widget="boolean"/>
                                    <field name="has_images" string="Images"
                                           widget="boolean"/>
                                    <field name="state"/>
                                    <button name="action_approve" type="object"
                                            icon="fa-check" title="Approve"
                                            invisible="state != 'draft'"/>
                                    <button name="action_deny" type="object"
                                            icon="fa-times" title="Deny"
                                            invisible="state != 'draft'"/>
                                </list>
                                <form>
                                    <header>
                                        <button name="action_approve" type="object"
                                                string="Approve" class="btn-primary"
                                                invisible="state != 'draft'"/>
                                        <button name="action_deny" type="object"
                                                string="Deny" class="btn-secondary"
                                                invisible="state != 'draft'"/>
                                        <field name="state" widget="statusbar"
                                               statusbar_visible="draft,approved,denied"/>
                                    </header>
                                    <sheet>
                                        <div class="oe_title">
                                            <h2><field name="name"
                                                       placeholder="Question Title"/></h2>
                                        </div>
                                        <group>
                                            <group>
                                                <field name="question_type"/>
                                                <field name="medium_display"/>
                                                <field name="difficulty"/>
                                                <field name="time_minutes"/>
                                            </group>
                                            <group>
                                                <field name="approved_question_id"
                                                       readonly="1"/>
                                                <field name="has_dimensions" invisible="1"/>
                                                <field name="has_images" invisible="1"/>
                                            </group>
                                        </group>
                                        <field name="question_prompt"
                                               placeholder="Question prompt shown to the candidate..."/>
                                        <field name="description"
                                               placeholder="Optional candidate-facing description..."/>
                                        <field name="image_preview" widget="html"
                                               invisible="not has_images"/>
                                        <group string="Images"
                                               invisible="question_type not in ('image_ab','image_prompt','image_label')">
                                            <field name="image_state"/>
                                            <field name="upload_slot"
                                                   placeholder="a / b / single / reference / output"/>
                                            <field name="upload_image" widget="image"
                                                   filename="upload_slot"/>
                                            <button name="action_apply_uploaded_image" type="object"
                                                    string="Apply Uploaded Image"
                                                    class="btn-secondary"
                                                    invisible="not upload_image"/>
                                            <field name="image_brief_json" widget="text"
                                                   placeholder="Render briefs (used by the automatic render)..."/>
                                            <field name="flaw_plan_json" widget="text" readonly="1"
                                                   string="Flaw Plan (answer key by construction)"
                                                   invisible="question_type != 'image_ab' or not flaw_plan_json"
                                                   help="Injected flaws + construction_keys the answer key is derived from. Eyeball the FLAWED image against injected_flaws before approving."/>
                                        </group>
                                        <field name="has_video_clips" invisible="1"/>
                                        <field name="video_preview" widget="html"
                                               invisible="not has_video_clips"/>
                                        <group string="Reference / Output Clips"
                                               invisible="question_type != 'video_prompt'">
                                            <field name="video_state"/>
                                            <div class="alert alert-info" role="alert" colspan="2"
                                                 invisible="video_state not in ('pending','generating')">
                                                Clips are still generating… reopen this draft in a moment.
                                            </div>
                                            <div class="alert alert-danger" role="alert" colspan="2"
                                                 invisible="video_state != 'failed'">
                                                Video generation failed.
                                                <field name="video_error" readonly="1" nolabel="1"/>
                                            </div>
                                            <div class="text-muted" colspan="2"
                                                 invisible="video_state != 'rendered' or has_video_clips">
                                                No viewable clips are staged for this draft.
                                            </div>
                                        </group>
                                        <field name="has_revealing_option" invisible="1"/>
                                        <field name="has_source_reference" invisible="1"/>
                                        <div class="alert alert-warning" role="alert"
                                             invisible="not has_source_reference">
                                            This item or its answer key
                                            <strong>references the source material</strong>
                                            (SOP / guidelines / a Section). The candidate never
                                            sees the source - the question must be self-contained.
                                            Regenerate, or rewrite so the deciding facts live in
                                            the scenario itself.
                                        </div>
                                        <separator string="Answer Key"
                                                   invisible="question_type not in ('mcq','msq','image_ab')"/>
                                        <div class="alert alert-warning" role="alert"
                                             invisible="not has_revealing_option">
                                            An option name embeds its rationale
                                            ("…, <strong>because</strong> …"). Option names are
                                            shown to the candidate - keep them to the bare choice
                                            (e.g. <strong>Image B</strong>) and move the "why" to the
                                            hidden <strong>Answer Rationale</strong>. Regenerate or
                                            edit the option text before approving.
                                        </div>
                                        <div class="alert alert-secondary" role="alert"
                                             invisible="question_type not in ('mcq','msq','image_ab')">
                                            Each row is one scoring <strong>dimension</strong>; the
                                            <strong>Correct</strong> toggle marks the answer key. Used
                                            <strong>only for scoring</strong> - candidates see the options
                                            to choose from but never which one is correct.
                                        </div>
                                        <field name="dimensions_preview" widget="html"
                                               invisible="not has_dimensions"/>
                                        <field name="answer_dimension_ids"
                                               invisible="question_type not in ('mcq','msq','image_ab')">
                                            <list editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="label"/>
                                            </list>
                                            <form>
                                                <group>
                                                    <field name="label"/>
                                                </group>
                                                <field name="option_line_ids">
                                                    <list editable="bottom">
                                                        <field name="sequence" widget="handle"/>
                                                        <field name="name"/>
                                                        <field name="is_correct" widget="boolean_toggle"/>
                                                    </list>
                                                </field>
                                            </form>
                                        </field>
                                        <group string="Answer Key - Rubric"
                                               invisible="question_type not in ('subjective_rubric','image_prompt','image_label')">
                                            <field name="ak_ideal_answer"
                                                   invisible="question_type not in ('image_prompt','image_label')"
                                                   placeholder="The ideal prompt (image_prompt) or ideal labels (image_label) the candidate is graded against..."/>
                                            <field name="ak_mandatory_elements"
                                                   invisible="question_type not in ('image_prompt','image_label')"
                                                   placeholder="One required element per line..."/>
                                            <field name="ak_penalty_rules"
                                                   invisible="question_type not in ('image_prompt','image_label')"
                                                   placeholder="One penalty rule per line..."/>
                                            <field name="ak_scoring_guide"
                                                   invisible="question_type not in ('image_prompt','image_label')"/>
                                            <field name="ak_checklist"
                                                   invisible="question_type != 'subjective_rubric'"
                                                   placeholder="One required point per line..."/>
                                            <field name="ak_constraints"
                                                   invisible="question_type != 'subjective_rubric'"
                                                   placeholder="One constraint per line..."/>
                                            <field name="ak_pass_condition"
                                                   invisible="question_type != 'subjective_rubric'"/>
                                        </group>
                                        <field name="official_reasoning"
                                               invisible="question_type not in ('mcq','msq','image_ab')"
                                               placeholder="Hidden answer-key rationale - stored for review/scoring, never shown to the candidate..."/>
                                        <notebook>
                                            <page string="Advanced (raw JSON)">
                                                <div class="alert alert-info" role="alert">
                                                    The <strong>Answer Key</strong> above is what gets
                                                    published. These raw fields are the original LLM
                                                    output; edit them only for power tweaks, then click
                                                    <strong>Rebuild Answer Key from JSON</strong>.
                                                </div>
                                                <button name="action_rebuild_answer_key_from_json"
                                                        type="object"
                                                        string="Rebuild Answer Key from JSON"
                                                        class="btn-secondary mb-2"/>
                                                <group>
                                                    <field name="options_json" widget="text"
                                                           invisible="question_type not in ('mcq','msq')"/>
                                                    <field name="correct_answer_json" widget="text"
                                                           invisible="question_type not in ('mcq','msq')"/>
                                                    <field name="dimensions_json" widget="text"
                                                           invisible="question_type != 'image_ab'"/>
                                                    <field name="rubric_json" widget="text"
                                                           invisible="question_type not in ('subjective_rubric','image_prompt','image_label')"/>
                                                    <field name="image_summary" readonly="1"
                                                           help="Images are shown above. Raw base64 is intentionally hidden."/>
                                                </group>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etp_assessment_pro_prompt" model="ir.actions.act_window">
        <field name="name">Question Bank Generators</field>
        <field name="res_model">etp.assessment.pro.prompt</field>
        <field name="view_mode">list,form</field>
        <!-- Pin the list to the main tree; otherwise the create="false" similar
             ranking view (same model) can shadow it and hide the New button. -->
        <field name="view_id" ref="etp_assessment_pro_prompt_tree"/>
    </record>

    <record id="etp_assessment_pro_prompt_question_tree" model="ir.ui.view">
        <field name="name">etp.assessment.pro.prompt.question.tree</field>
        <field name="model">etp.assessment.pro.prompt.question</field>
        <field name="arch" type="xml">
            <list class="o_etp_backend">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve Selected" class="btn-primary"/>
                    <button name="action_deny" type="object"
                            string="Deny Selected" class="btn-secondary"/>
                </header>
                <field name="prompt_id"/>
                
                <field name="name"/>
                <field name="question_type"/>
                <field name="difficulty"/>
                <field name="has_dimensions" string="Keyed" widget="boolean"
                       optional="show"/>
                <field name="has_images" string="Images" widget="boolean"
                       optional="show"/>
                <field name="state"/>
                <field name="approved_question_id" optional="hide"/>
                <button name="action_approve" type="object"
                        icon="fa-check" title="Approve"
                        invisible="state != 'draft'"/>
                <button name="action_deny" type="object"
                        icon="fa-times" title="Deny"
                        invisible="state != 'draft'"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_pro_prompt_question_form" model="ir.ui.view">
        <field name="name">etp.assessment.pro.prompt.question.form</field>
        <field name="model">etp.assessment.pro.prompt.question</field>
        <field name="arch" type="xml">
            <form class="o_etp_backend">
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_deny" type="object"
                            string="Deny" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,denied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="name" placeholder="Question Title"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="prompt_id" readonly="1"/>
                            <field name="question_type"/>
                            <field name="medium_display"/>
                            <field name="difficulty"/>
                            <field name="time_minutes"/>
                        </group>
                        <group>
                            <field name="approved_question_id" readonly="1"/>
                            <field name="has_dimensions" invisible="1"/>
                            <field name="has_images" invisible="1"/>
                        </group>
                    </group>
                    <field name="question_prompt"
                           placeholder="Question prompt shown to the candidate..."/>
                    <field name="description"
                           placeholder="Optional candidate-facing description..."/>
                    <field name="image_preview" widget="html"
                           invisible="not has_images"/>
                    <group string="Images"
                           invisible="question_type not in ('image_ab','image_prompt','image_label')">
                        <field name="image_state"/>
                        <field name="upload_slot"
                               placeholder="a / b / single / reference / output"/>
                        <field name="upload_image" widget="image"
                               filename="upload_slot"/>
                        <button name="action_apply_uploaded_image" type="object"
                                string="Apply Uploaded Image"
                                class="btn-secondary"
                                invisible="not upload_image"/>
                        <field name="image_brief_json" widget="text"
                               placeholder="Render briefs (used by the automatic render)..."/>
                        <field name="flaw_plan_json" widget="text" readonly="1"
                               string="Flaw Plan (answer key by construction)"
                               invisible="question_type != 'image_ab' or not flaw_plan_json"
                               help="Injected flaws + construction_keys the answer key is derived from. Eyeball the FLAWED image against injected_flaws before approving."/>
                    </group>
                    <field name="has_video_clips" invisible="1"/>
                    <field name="video_preview" widget="html"
                           invisible="not has_video_clips"/>
                    <group string="Reference / Output Clips"
                           invisible="question_type != 'video_prompt'">
                        <field name="video_state"/>
                        <div class="alert alert-info" role="alert" colspan="2"
                             invisible="video_state not in ('pending','generating')">
                            Clips are still generating… reopen this draft in a moment.
                        </div>
                        <div class="alert alert-danger" role="alert" colspan="2"
                             invisible="video_state != 'failed'">
                            Video generation failed.
                            <field name="video_error" readonly="1" nolabel="1"/>
                        </div>
                        <div class="text-muted" colspan="2"
                             invisible="video_state != 'rendered' or has_video_clips">
                            No viewable clips are staged for this draft.
                        </div>
                    </group>
                    <field name="has_revealing_option" invisible="1"/>
                    <field name="has_source_reference" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="not has_source_reference">
                        This item or its answer key
                        <strong>references the source material</strong>
                        (SOP / guidelines / a Section). The candidate never sees the
                        source - the question must be self-contained. Regenerate, or
                        rewrite so the deciding facts live in the scenario itself.
                    </div>
                    <separator string="Answer Key"
                               invisible="question_type not in ('mcq','msq','image_ab')"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="not has_revealing_option">
                        An option name embeds its rationale
                        ("…, <strong>because</strong> …"). Option names are shown to the
                        candidate - keep them to the bare choice (e.g. <strong>Image B</strong>)
                        and move the "why" to the hidden <strong>Answer Rationale</strong>.
                        Regenerate or edit the option text before approving.
                    </div>
                    <div class="alert alert-secondary" role="alert"
                         invisible="question_type not in ('mcq','msq','image_ab')">
                        Each row is one scoring <strong>dimension</strong>; the
                        <strong>Correct</strong> toggle marks the answer key. Used
                        <strong>only for scoring</strong> - candidates see the options
                        to choose from but never which one is correct.
                    </div>
                    <field name="dimensions_preview" widget="html"
                           invisible="not has_dimensions"/>
                    <field name="answer_dimension_ids"
                           invisible="question_type not in ('mcq','msq','image_ab')">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="label"/>
                        </list>
                        <form>
                            <group>
                                <field name="label"/>
                            </group>
                            <field name="option_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="is_correct" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </form>
                    </field>
                    <group string="Answer Key - Rubric"
                           invisible="question_type not in ('subjective_rubric','image_prompt','image_label')">
                        <field name="ak_ideal_answer"
                               invisible="question_type not in ('image_prompt','image_label')"
                               placeholder="The ideal prompt (image_prompt) or ideal labels (image_label) the candidate is graded against..."/>
                        <field name="ak_mandatory_elements"
                               invisible="question_type not in ('image_prompt','image_label')"
                               placeholder="One required element per line..."/>
                        <field name="ak_penalty_rules"
                               invisible="question_type not in ('image_prompt','image_label')"
                               placeholder="One penalty rule per line..."/>
                        <field name="ak_scoring_guide"
                               invisible="question_type not in ('image_prompt','image_label')"/>
                        <field name="ak_checklist"
                               invisible="question_type != 'subjective_rubric'"
                               placeholder="One required point per line..."/>
                        <field name="ak_constraints"
                               invisible="question_type != 'subjective_rubric'"
                               placeholder="One constraint per line..."/>
                        <field name="ak_pass_condition"
                               invisible="question_type != 'subjective_rubric'"/>
                    </group>
                    <field name="official_reasoning"
                           invisible="question_type not in ('mcq','msq','image_ab')"
                           placeholder="Hidden answer-key rationale - stored for review/scoring, never shown to the candidate..."/>
                    <notebook>
                        <page string="Advanced (raw JSON)">
                            <div class="alert alert-info" role="alert">
                                The <strong>Answer Key</strong> above is what gets published.
                                These raw fields are the original LLM output; edit them only for
                                power tweaks, then click <strong>Rebuild Answer Key from JSON</strong>.
                            </div>
                            <button name="action_rebuild_answer_key_from_json"
                                    type="object"
                                    string="Rebuild Answer Key from JSON"
                                    class="btn-secondary mb-2"/>
                            <group>
                                <field name="options_json" widget="text"
                                       invisible="question_type not in ('mcq','msq')"/>
                                <field name="correct_answer_json" widget="text"
                                       invisible="question_type not in ('mcq','msq')"/>
                                <field name="dimensions_json" widget="text"
                                       invisible="question_type != 'image_ab'"/>
                                <field name="rubric_json" widget="text"
                                       invisible="question_type not in ('subjective_rubric','image_prompt','image_label')"/>
                                <field name="image_summary" readonly="1"
                                       help="Images are shown above. Raw base64 is intentionally hidden."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="etp_assessment_pro_prompt_question_search" model="ir.ui.view">
        <field name="name">etp.assessment.pro.prompt.question.search</field>
        <field name="model">etp.assessment.pro.prompt.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="prompt_id"/>
                
                <filter name="pending" string="Pending"
                        domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state','=','approved')]"/>
                <filter name="denied" string="Denied"
                        domain="[('state','=','denied')]"/>
                <separator/>
                <filter name="group_generator" string="Generator"
                        context="{'group_by':'prompt_id'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_etp_assessment_pro_prompt_question_pending" model="ir.actions.act_window">
        <field name="name">Pending Approvals</field>
        <field name="res_model">etp.assessment.pro.prompt.question</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="etp_assessment_pro_prompt_question_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No questions awaiting approval</p>
            <p>Generated draft questions land here. Approve them to publish them
               into the Question Bank, or deny the ones you don't want.</p>
        </field>
    </record>

    <record id="etp_assessment_pro_question_tree_pending_button" model="ir.ui.view">
        <field name="name">etp.assessment.pro.question.tree.pending.button</field>
        <field name="model">etp.assessment.pro.question</field>
        <field name="inherit_id" ref="etp_assessment_pro_question_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(action_etp_assessment_pro_prompt_question_pending)d"
                            type="action" string="Pending Approvals"
                            class="btn-secondary" display="always"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
