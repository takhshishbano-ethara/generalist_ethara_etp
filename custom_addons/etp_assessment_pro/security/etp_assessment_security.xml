<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_etp_assessment" model="ir.module.category">
            <field name="name">ETP Assessment Pro</field>
            <field name="sequence">210</field>
        </record>

        <record id="privilege_etp_assessment" model="res.groups.privilege">
            <field name="name">ETP Assessment Pro Access</field>
            <field name="category_id" ref="module_category_etp_assessment"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_assessment_evaluator" model="res.groups">
            <field name="name">Evaluator</field>
            <field name="privilege_id" ref="privilege_etp_assessment"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('hr_recruitment.group_hr_recruitment_interviewer'))]"/>
        </record>

        <record id="group_assessment_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_etp_assessment"/>
            <field name="implied_ids" eval="[(4, ref('etp_assessment_pro.group_assessment_evaluator')), (4, ref('hr_recruitment.group_hr_recruitment_user'))]"/>
            <!-- Grant the installing admin the Manager group. Without this a FRESH
                 install leaves this group with zero members, and since every ETP
                 menu/action is restricted to it the admin who just installed the
                 app cannot open Generators/Questions/Assessments at all. (4,…) is
                 an additive link, so it is idempotent across upgrades. -->
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
