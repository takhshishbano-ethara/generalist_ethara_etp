<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_assessment_evaluator_own_records_evaluator" model="ir.rule">
            <field name="name">etp.assessment.pro.evaluator: candidate sees only own row</field>
            <field name="model_id" ref="model_etp_assessment_pro_evaluator"/>
            <field name="groups" eval="[(4, ref('etp_assessment_pro.group_assessment_evaluator'))]"/>
            <field name="domain_force">[('applicant_id.candidate_user_id','=',user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

