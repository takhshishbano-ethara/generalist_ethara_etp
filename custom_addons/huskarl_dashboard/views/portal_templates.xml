          <img class="chart-dark" src="/huskarl_dashboard/static/src/portal/img/01_success_rate_graph_dark.png" alt="Success rate by difficulty level for GLM-5 and Nova-2-Lite" loading="lazy" />
          <span class="chart-zoom-hint" aria-hidden="true">Click to expand</span>
