<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="cron_tf_inactivity_check" model="ir.cron">
            <field name="name">Task Forge: Inactivity Check</field>
            <field name="model_id" ref="model_task_forge_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_inactivity_check()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:30:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

    </data>
</odoo>
