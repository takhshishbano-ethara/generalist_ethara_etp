<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_forge_log_tree" model="ir.ui.view">
        <field name="name">task.forge.log.tree</field>
        <field name="model">task.forge.log</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'in_progress'" decoration-success="state == 'completed'" decoration-danger="state == 'blocker'" decoration-warning="state in ('returned','ack','escalated')">
                <field name="sequence"/>
                <field name="name"/>
                <field name="employee_name"/>
                <field name="project_name"/>
                <field name="date"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="time_taken_mins"/>
                <field name="quality_score"/>
                <field name="grammar_checked" widget="boolean_toggle" optional="hide"/>
                <field name="grammar_is_perfect" widget="boolean_toggle" optional="hide"/>
                <field name="total_grammar_issues" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_task_forge_log_form" model="ir.ui.view">
        <field name="name">task.forge.log.form</field>
        <field name="model">task.forge.log</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="in_progress,completed,blocker,escalated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="sequence" readonly="1"/> - <field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Task Details">
                            <field name="employee_id"/>
                            <field name="project_id"/>
                            <field name="date"/>
                            <field name="quality_score"/>
                        </group>
                        <group string="Time">
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="time_taken_mins"/>
                        </group>
                    </group>
                    <group>
                        <group string="Screenshots">
                            <field name="start_screenshot_url" widget="url"/>
                            <field name="end_screenshot_url" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <group>
                                <field name="blocker_reason"/>
                                <field name="prompt_justification"/>
                                <field name="feedback_note"/>
                            </group>
                        </page>
                        <page string="Blockers">
                            <field name="blocker_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="qr_id"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bug Reports">
                            <field name="bug_report_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="video_url" widget="url"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Image And Video URL">
                            <field name="image_url_lines">
                                <list>
                                    <field name="image_url"/>
                                    <field name="image_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Grammar Check" name="grammar_check">
                            <group>
                                <group string="Status">
                                    <field name="grammar_checked"/>
                                    <field name="grammar_is_perfect"/>
                                    <field name="total_grammar_issues"/>
                                </group>
                                <group string="Error %">
                                    <field name="prompt_error_percentage"/>
                                    <field name="justification_error_percentage"/>
                                </group>
                            </group>
                            <group>
                                <group string="Prompt Summary">
                                    <field name="prompt_issue_count"/>
                                    <field name="prompt_grammar_count"/>
                                    <field name="prompt_misspelling_count"/>
                                    <field name="prompt_punctuation_count"/>
                                    <field name="prompt_clarity_count"/>
                                    <field name="prompt_typography_count"/>
                                    <field name="prompt_capitalization_count"/>
                                    <field name="prompt_miscellaneous_count"/>
                                </group>
                                <group string="Justification Summary">
                                    <field name="justification_issue_count"/>
                                    <field name="justification_grammar_count"/>
                                    <field name="justification_misspelling_count"/>
                                    <field name="justification_punctuation_count"/>
                                    <field name="justification_clarity_count"/>
                                    <field name="justification_typography_count"/>
                                    <field name="justification_capitalization_count"/>
                                    <field name="justification_miscellaneous_count"/>
                                </group>
                            </group>
                            <group string="Texts">
                                <field name="prompt_text" string="Original Prompt"/>
                                <field name="prompt_corrected" string="Corrected Prompt"/>
                                <field name="justification_text" string="Original Justification"/>
                                <field name="justification_corrected" string="Corrected Justification"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_task_forge_log" model="ir.actions.act_window">
        <field name="name">Task Logs</field>
        <field name="res_model">task.forge.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
