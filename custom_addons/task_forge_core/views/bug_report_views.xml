<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tf_bug_report_tree" model="ir.ui.view">
        <field name="name">task.forge.bug.report.tree</field>
        <field name="model">task.forge.bug.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="task_name"/>
                <field name="employee_name"/>
                <field name="state" widget="badge"/>
                <field name="video_url" widget="url"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_tf_bug_report_form" model="ir.ui.view">
        <field name="name">task.forge.bug.report.form</field>
        <field name="model">task.forge.bug.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="task_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="qr_id"/>
                            <field name="pl_id"/>
                            <field name="video_url" widget="url"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tf_bug_report" model="ir.actions.act_window">
        <field name="name">Bug Reports</field>
        <field name="res_model">task.forge.bug.report</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
