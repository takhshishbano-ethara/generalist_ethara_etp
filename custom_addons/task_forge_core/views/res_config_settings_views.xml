<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_task_forge" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.task.forge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Task Forge" string="Task Forge" name="task_forge_core">
                    <block title="Kimi K2.5 Configuration" help="Configure AWS Bedrock credentials for Kimi K2.5 grammar analysis.">
                        <setting string="AWS Region" help="The AWS region where Bedrock is configured.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="kimi_aws_region" class="col-lg-3"/>
                                    <field name="kimi_aws_region" class="col-lg-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Bedrock API Key" help="Bearer token for Bedrock API authentication.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="kimi_api_key" class="col-lg-3"/>
                                    <field name="kimi_api_key" class="col-lg-6" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Bedrock Inference ARN" help="Full ARN of the Bedrock inference profile for Kimi K2.5.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="kimi_model_arn" class="col-lg-3"/>
                                    <field name="kimi_model_arn" class="col-lg-6"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
