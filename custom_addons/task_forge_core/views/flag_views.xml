<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tf_flag_tree" model="ir.ui.view">
        <field name="name">task.forge.flag.tree</field>
        <field name="model">task.forge.flag</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity == 'high'" decoration-warning="severity == 'medium'">
                <field name="name"/>
                <field name="flag_type"/>
                <field name="severity" widget="badge"/>
                <field name="related_employee_name"/>
                <field name="related_project_name"/>
                <field name="is_resolved"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_tf_flag_form" model="ir.ui.view">
        <field name="name">task.forge.flag.form</field>
        <field name="model">task.forge.flag</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_resolve" string="Resolve" type="object" invisible="is_resolved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="flag_type"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="related_employee_id"/>
                            <field name="related_project_id"/>
                            <field name="is_resolved"/>
                            <field name="resolved_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tf_flag" model="ir.actions.act_window">
        <field name="name">Flags</field>
        <field name="res_model">task.forge.flag</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
