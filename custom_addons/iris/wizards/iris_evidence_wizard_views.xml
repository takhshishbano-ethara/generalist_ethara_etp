<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- Evidence Wizard Form                                         -->
        <!-- ============================================================ -->
        <record id="view_iris_evidence_wizard_form" model="ir.ui.view">
            <field name="name">iris.evidence.wizard.form</field>
            <field name="model">iris.evidence.wizard</field>
            <field name="arch" type="xml">
                <form string="Record Verification Evidence">
                    <group>
                        <field name="candidate_id" readonly="1"/>
                    </group>
                    <group string="Clarifying Questions (sent to the candidate)"
                           invisible="not clarifying_questions">
                        <field name="clarifying_questions" nolabel="1"
                               colspan="2" readonly="1"/>
                    </group>
                    <group>
                        <field name="evidence" required="1"
                               placeholder="What was verified and how — links checked, repos reviewed, references called, dates confirmed..."/>
                        <field name="rescreen_now"
                               help="Immediately queue a re-screen using this evidence. Untick to record the evidence now and re-screen later."/>
                    </group>
                    <footer>
                        <button name="action_confirm" string="Confirm" type="object"
                                class="oe_highlight" data-hotkey="q"/>
                        <button string="Cancel" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- Action (opened by iris.candidate.action_open_evidence_wizard -->
        <!-- with {'default_candidate_id': id} in context)                -->
        <!-- ============================================================ -->
        <record id="action_iris_evidence_wizard" model="ir.actions.act_window">
            <field name="name">Record Verification Evidence</field>
            <field name="res_model">iris.evidence.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_iris_evidence_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
