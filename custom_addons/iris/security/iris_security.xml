<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_iris" model="ir.module.category">
            <field name="name">Iris</field>
            <field name="description">Recruitment Screening (LLM-assisted)</field>
            <field name="sequence">95</field>
        </record>

        <!-- Privilege (Odoo 19: replaces category_id on res.groups) -->
        <record id="res_groups_privilege_iris" model="res.groups.privilege">
            <field name="name">Iris</field>
            <field name="sequence">95</field>
            <field name="category_id" ref="module_category_iris"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- User Group: full pipeline visibility, no unlink -->
        <record id="group_iris_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_iris"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager Group (inherits User): unlink + manual verdicts -->
        <record id="group_iris_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_iris"/>
            <field name="implied_ids" eval="[(4, ref('group_iris_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- No record rules: all iris users see the whole pipeline (plan decision). -->
    </data>
</odoo>
