<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- LLM queue processor: 2-min sweep + instant _trigger() from actions -->
        <record id="cron_process_llm_queue" model="ir.cron">
            <field name="name">Iris: Process LLM Queue</field>
            <field name="model_id" ref="model_iris_candidate"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_llm_queue(batch_size=10)</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Daily auto-BLOCK of holds past their deadline -->
        <record id="cron_auto_block_holds" model="ir.cron">
            <field name="name">Iris: Auto-Block Expired Holds</field>
            <field name="model_id" ref="model_iris_candidate"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_block_expired_holds()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
