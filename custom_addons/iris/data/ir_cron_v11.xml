<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Quarterly review of the central Tech Date Reference table
             (v2.0 governance: "review quarterly; screeners may not assert
             dates from memory"). Skips with a log line while the table is
             empty; otherwise schedules a stock To-Do activity on the
             latest-written active row for the first Iris manager. -->
        <record id="cron_tech_date_quarterly_review" model="ir.cron">
            <field name="name">Iris: Tech Date Reference Quarterly Review</field>
            <field name="model_id" ref="model_iris_tech_date_reference"/>
            <field name="state">code</field>
            <field name="code">model._cron_schedule_quarterly_review()</field>
            <field name="interval_number">3</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
