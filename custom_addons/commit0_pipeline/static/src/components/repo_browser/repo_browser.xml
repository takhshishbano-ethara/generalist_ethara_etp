<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="commit0_pipeline.RepoBrowser">
        <div class="o_repo_browser d-flex flex-column" t-ref="rootRef">

            <div class="o_repo_browser_toolbar d-flex align-items-center gap-2 px-2 py-1 border-bottom bg-100">
                <i class="fa fa-code-fork text-primary"/>
                <span class="fw-bold text-truncate" t-esc="state.repoName"/>

                <div class="flex-grow-1">
                    <SelectMenu
                        choices="selectMenuChoices"
                        value="state.selectedPath"
                        onSelect.bind="onFileSelect"
                        placeholder="'Select a file...'"
                        class="'o_repo_browser_select w-100'"
                    />
                </div>

                <t t-if="state.selectedPath">
                    <span class="badge bg-secondary" t-esc="state.aceMode"/>
                    <span class="text-muted small" t-esc="fileSizeFormatted"/>

                    <t t-if="canShowDiff">
                        <button t-attf-class="btn btn-sm {{ state.diffMode ? 'btn-primary' : 'btn-outline-secondary' }}" t-on-click="toggleDiff" title="Toggle diff view">
                            <i class="fa fa-exchange me-1"/>Diff
                        </button>
                    </t>

                    <button class="btn btn-sm btn-outline-secondary" t-on-click="onCopy" title="Copy to clipboard">
                        <i t-attf-class="fa {{ state.copied ? 'fa-check text-success' : 'fa-clipboard' }}"/>
                    </button>

                    <button class="btn btn-sm btn-outline-secondary" t-on-click="toggleTheme" title="Toggle dark/light theme">
                        <i t-attf-class="fa {{ state.darkTheme ? 'fa-sun-o' : 'fa-moon-o' }}"/>
                    </button>
                </t>

                <t t-if="state.loading">
                    <i class="fa fa-spinner fa-spin text-primary"/>
                </t>
            </div>

            <t t-if="state.error">
                <div class="alert alert-danger m-2 py-2">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    <t t-esc="state.error"/>
                </div>
            </t>

            <t t-if="state.selectedPath and !state.error and (!state.diffMode or !canShowDiff)">
                <div class="o_repo_browser_editor flex-grow-1">
                    <CodeEditor
                        value="state.fileContent"
                        mode="state.aceMode"
                        theme="editorTheme"
                        readonly="true"
                        sessionId="state.selectedPath"
                    />
                </div>
            </t>

            <t t-if="state.selectedPath and !state.error and state.diffMode and canShowDiff">
                <div class="o_repo_browser_diff flex-grow-1 overflow-auto">
                    <t t-if="!state.hasDiffChanges">
                        <div class="text-muted p-4 text-center">
                            <i class="fa fa-check-circle fa-2x mb-2 d-block text-success opacity-75"/>
                            <span>No changes — file is identical in both versions.</span>
                        </div>
                    </t>
                    <t t-if="state.hasDiffChanges">
                        <pre class="o_diff_output m-0 p-2"><t t-foreach="diffLines" t-as="line" t-key="line_index"><span t-attf-class="o_diff_line {{ line.startsWith('+') and !line.startsWith('+++') ? 'o_diff_add' : line.startsWith('-') and !line.startsWith('---') ? 'o_diff_del' : line.startsWith('@@') ? 'o_diff_hunk' : 'o_diff_ctx' }}" t-esc="line"/>
</t></pre>
                    </t>
                </div>
            </t>

            <t t-if="!state.selectedPath and state.treeLoaded and !state.error">
                <div class="text-muted p-4 text-center">
                    <i class="fa fa-file-code-o fa-3x mb-2 d-block opacity-50"/>
                    <span>Select a file from the dropdown to view its contents.</span>
                    <div class="mt-1 small">
                        <t t-esc="state.flatFiles.length"/> files available
                    </div>
                </div>
            </t>

            <t t-if="!state.treeLoaded and !state.loading and !state.error">
                <div class="p-3 text-center">
                    <button class="btn btn-primary" t-on-click="onClickLoadTree">
                        <i class="fa fa-eye me-1"/>View Repository
                    </button>
                </div>
            </t>

        </div>
    </t>
</templates>
