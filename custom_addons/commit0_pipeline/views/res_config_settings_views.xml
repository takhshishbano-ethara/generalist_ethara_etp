<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_commit0" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.commit0</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Commit0 Pipeline" string="Commit0 Pipeline" name="commit0_pipeline" groups="commit0_pipeline.group_commit0_admin">
                    <block title="Commit0 Pipeline Configuration">
                        <setting string="Tools Path" help="Path to the commit0 pipeline tools directory.">
                            <field name="commit0_tools_path"/>
                        </setting>
                        <setting string="GitHub Token" help="Personal access token for GitHub API operations.">
                            <field name="github_token" password="True"/>
                        </setting>
                        <setting string="GitHub Organization" help="GitHub organization to fork repositories into.">
                            <field name="github_org"/>
                        </setting>
                        <setting string="Default Model" help="Default AI model preset for pipeline runs.">
                            <field name="commit0_default_model"/>
                        </setting>
                        <setting string="Default Stubbing Mode" help="Default mode for code stubbing.">
                            <field name="commit0_default_stubbing_mode"/>
                        </setting>
                        <setting string="Docker Status" help="Whether Docker is available on this system.">
                            <field name="docker_available" widget="boolean"/>
                        </setting>
                        <setting string="Task Allocation" help="Maximum number of active (non-terminal) tasks per user.">
                            <field name="max_active_tasks"/>
                        </setting>
                        <setting string="Lambda Function Name" help="AWS Lambda function name or ARN for PDF scraping.">
                            <field name="lambda_pdf_function_name" placeholder="ethara-pdf-scraper"/>
                        </setting>
                        <setting string="Lambda Region" help="AWS region where the PDF Lambda is deployed.">
                            <field name="lambda_pdf_region" placeholder="ap-south-1"/>
                        </setting>
                        <setting string="AWS Access Key" help="AWS access key for Lambda authentication.">
                            <field name="lambda_pdf_access_key"/>
                        </setting>
                        <setting string="AWS Secret Key" help="AWS secret key for Lambda authentication.">
                            <field name="lambda_pdf_secret_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
