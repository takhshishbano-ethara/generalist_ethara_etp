<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Tree View (editable)                                               -->
    <!-- ================================================================== -->
    <record id="commit0_discovery_candidate_view_tree" model="ir.ui.view">
        <field name="name">commit0.discovery.candidate.list</field>
        <field name="model">commit0.discovery.candidate</field>
        <field name="arch" type="xml">
            <list string="Discovery Candidates" editable="bottom">
                <field name="selected" widget="boolean"/>
                <field name="full_name"/>
                <field name="stars"/>
                <field name="python_pct"/>
                <field name="has_pytest"/>
                <field name="license"/>
                <field name="release_tag"/>
                <field name="validation_status" widget="badge"
                       decoration-success="validation_status == 'pass'"
                       decoration-danger="validation_status == 'fail'"
                       decoration-muted="validation_status == 'pending'"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Action                                                             -->
    <!-- ================================================================== -->
    <record id="commit0_discovery_candidate_action" model="ir.actions.act_window">
        <field name="name">Discovery Candidates</field>
        <field name="res_model">commit0.discovery.candidate</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No discovery candidates yet
            </p>
            <p>
                Discovery candidates are populated during the discovery phase of a pipeline run.
            </p>
        </field>
    </record>

</odoo>
