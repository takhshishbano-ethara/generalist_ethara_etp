<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Form View                                                          -->
    <!-- ================================================================== -->
    <record id="commit0_repo_evaluation_view_form" model="ir.ui.view">
        <field name="name">commit0.repo.evaluation.form</field>
        <field name="model">commit0.repo.evaluation</field>
        <field name="arch" type="xml">
            <form string="Repo Evaluation">
                <header>
                    <button name="action_submit_task"
                            string="SUBMIT TASK"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_validate"
                            string="VALIDATE"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'in_review'"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_review,validated"/>
                </header>
                <sheet>
                    <!-- Title -->
                    <div class="oe_title mb-3">
                        <h1>
                            <field name="repo_name"
                                   placeholder="e.g. django/django"/>
                        </h1>
                        <div>
                            <field name="repo_url" widget="url"
                                   placeholder="https://github.com/owner/repo"/>
                        </div>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>

                    <!-- ===================================================== -->
                    <!-- CRITICAL GATES (MUST) — Red Banner                    -->
                    <!-- ===================================================== -->
                    <div class="alert alert-danger mb-0 rounded-0" role="alert">
                        <strong>CRITICAL GATES (MUST)</strong>
                    </div>
                    <group>
                        <field name="check_language"
                               widget="radio"
                               options="{'horizontal': true}"
                               string="1. Language (95% Python, No C/Rust/Extensions)"/>
                        <field name="check_tests"
                               widget="radio"
                               options="{'horizontal': true}"
                               string="2. Tests (Pytest, &lt;30m, No GPU)"/>
                        <field name="check_documentation"
                               widget="radio"
                               options="{'horizontal': true}"
                               string="3. Documentation (API Ref, Guide, Type Specs)"/>
                    </group>

                    <!-- ===================================================== -->
                    <!-- QUALITY INDICATORS (SHOULD) — Yellow Banner           -->
                    <!-- ===================================================== -->
                    <div class="alert alert-warning mb-0 rounded-0" role="alert">
                        <strong>QUALITY INDICATORS (SHOULD)</strong>
                    </div>
                    <group>
                        <field name="check_github_metrics"
                            widget="radio"
                               options="{'horizontal': true}"
                               string="4. GitHub (5k+ Stars, Not Fork/Archived)"/>
                        <field name="check_project_structure"
                               widget="radio"
                               options="{'horizontal': true}"
                               string="5. Project Structure (src/ layout, Installable)"/>
                        <field name="check_build"
                               widget="radio"
                               options="{'horizontal': true}"
                               string="6. Build (Docker Clean, No system pkgs)"/>
                    </group>

                    <!-- ===================================================== -->
                    <!-- CODE &amp; RELIABILITY (CHECK) — Blue Banner          -->
                    <!-- ===================================================== -->
                    <div class="alert alert-info mb-0 rounded-0" role="alert">
                        <strong>CODE &amp; RELIABILITY (CHECK)</strong>
                    </div>
                    <group>
                        <field name="check_code_quality"
                               widget="radio"
                               options="{'horizontal': true}"
                               string="7. Code Quality (Parses, Separate src/tests)"/>
                        <field name="check_reliability"
                               widget="radio"
                               options="{'horizontal': true}"
                               string="8. Reliability (Not Flaky, No Network, No Side Effects)"/>
                        <field name="check_complexity"
                               widget="radio"
                               options="{'horizontal': true}"
                               string="9. Complexity (50-500 Funcs, No Circular Imports)"/>
                    </group>

                    <!-- ===================================================== -->
                    <!-- FINAL VERDICT                                         -->
                    <!-- ===================================================== -->
                    <div class="bg-200 p-4 mt-4 rounded">
                        <h3 class="text-center mb-3">FINAL VERDICT</h3>
                        <field name="must_gates_passed" invisible="1"/>
                        <div class="text-center mb-3">
                            <button name="action_select"
                                    string="Selected"
                                    type="object"
                                    class="btn btn-lg btn-success me-3"
                                    invisible="verdict == 'selected'"/>
                            <field name="verdict" invisible="1"/>
                            <button name="action_reject"
                                    string="REJECTED"
                                    type="object"
                                    class="btn btn-lg btn-danger"
                                    invisible="verdict == 'rejected'"/>
                        </div>
                        <div class="text-center mb-2"
                             invisible="not verdict">
                            <field name="verdict" widget="badge"
                                   decoration-success="verdict == 'selected'"
                                   decoration-danger="verdict == 'rejected'"
                                   readonly="1"/>
                        </div>
                        <group>
                            <field name="verdict_reason" nolabel="1"
                                   placeholder="Reason: e.g. Failed MUST Gate (Tests). Repository requires GPU."/>
                        </group>
                    </div>

                    <separator/>

                    <!-- ===================================================== -->
                    <!-- DOCUMENT VALIDATION (from Page 2)                     -->
                    <!-- ===================================================== -->
                    <notebook>
                        <page string="Document Validation" name="document_validation">
                            <group>
                                <group>
                                    <field name="document_file"
                                           filename="document_filename"/>
                                    <field name="document_filename" invisible="1"/>
                                </group>
                                <group>
                                    <field name="doc_related_to_repo"/>
                                    <field name="doc_not_blank"/>
                                </group>
                            </group>
                            <div>
                                <button name="action_validate_document"
                                        string="Validate Document"
                                        type="object"
                                        class="btn btn-primary"/>
                            </div>
                        </page>

                        <!-- Fork Repository Tab -->
                        <page string="Fork Repository" name="fork"
                              invisible="verdict != 'selected'">
                            <group>
                                <group>
                                    <button name="action_fork_repo"
                                            string="Fork Repo into Ethara"
                                            type="object"
                                            class="btn btn-success mb-3"/>
                                    <field name="fork_url" widget="url"/>
                                </group>
                                <group>
                                    <field name="fork_progress"
                                           widget="progressbar"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Tree View                                                          -->
    <!-- ================================================================== -->
    <record id="commit0_repo_evaluation_view_tree" model="ir.ui.view">
        <field name="name">commit0.repo.evaluation.list</field>
        <field name="model">commit0.repo.evaluation</field>
        <field name="arch" type="xml">
            <list string="Repo Evaluations"
                  decoration-success="verdict == 'selected'"
                  decoration-danger="verdict == 'rejected'">
                <field name="name"/>
                <field name="repo_name"/>
                <field name="repo_url" widget="url" optional="hide"/>
                <field name="check_language" widget="badge"
                       decoration-success="check_language == 'pass'"
                       decoration-danger="check_language == 'fail'"
                       optional="show"/>
                <field name="check_tests" widget="badge"
                       decoration-success="check_tests == 'pass'"
                       decoration-danger="check_tests == 'fail'"
                       optional="show"/>
                <field name="check_documentation" widget="badge"
                       decoration-success="check_documentation == 'pass'"
                       decoration-danger="check_documentation == 'fail'"
                       optional="show"/>
                <field name="must_gates_passed" widget="boolean"
                       string="MUST Passed"
                       optional="show"/>
                <field name="verdict" widget="badge"
                       decoration-success="verdict == 'selected'"
                       decoration-danger="verdict == 'rejected'"
                       optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-info="state == 'in_review'"
                       decoration-muted="state == 'draft'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Search View                                                        -->
    <!-- ================================================================== -->
    <record id="commit0_repo_evaluation_view_search" model="ir.ui.view">
        <field name="name">commit0.repo.evaluation.search</field>
        <field name="model">commit0.repo.evaluation</field>
        <field name="arch" type="xml">
            <search string="Search Evaluations">
                <field name="name"/>
                <field name="repo_name"/>
                <field name="user_id"/>
                <separator/>
                <filter string="My Evaluations" name="my_evaluations"
                        domain="[('user_id', '=', uid)]"/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="In Review" name="in_review"
                        domain="[('state', '=', 'in_review')]"/>
                <filter string="Validated" name="validated"
                        domain="[('state', '=', 'validated')]"/>
                <separator/>
                <filter string="Selected" name="selected"
                        domain="[('verdict', '=', 'selected')]"/>
                <filter string="Rejected" name="rejected"
                        domain="[('verdict', '=', 'rejected')]"/>
                <filter string="MUST Gates Failed" name="must_failed"
                        domain="[('must_gates_passed', '=', False)]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Verdict" name="group_verdict"
                            context="{'group_by': 'verdict'}"/>
                    <filter string="Evaluator" name="group_user"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Action                                                             -->
    <!-- ================================================================== -->
    <record id="commit0_repo_evaluation_action" model="ir.actions.act_window">
        <field name="name">Evaluations</field>
        <field name="res_model">commit0.repo.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="commit0_repo_evaluation_view_search"/>
        <field name="context">{'search_default_my_evaluations': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first repo evaluation
            </p>
            <p>
                Evaluate repositories against language, testing, documentation,
                and quality criteria for the Commit0 benchmark.
            </p>
        </field>
    </record>

</odoo>
