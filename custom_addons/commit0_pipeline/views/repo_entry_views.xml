<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Form View                                                          -->
    <!-- ================================================================== -->
    <record id="commit0_repo_entry_view_form" model="ir.ui.view">
        <field name="name">commit0.repo.entry.form</field>
        <field name="model">commit0.repo.entry</field>
        <field name="arch" type="xml">
            <form string="Repository Entry">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,preparing,forking,cloning,stubbing,pushing,complete"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Repository Info">
                            <field name="repo_name"/>
                            <field name="repo_url" widget="url"/>
                            <field name="fork_url" widget="url"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'complete'"
                                   decoration-danger="state == 'failed'"
                                   decoration-info="state in ('preparing', 'forking', 'cloning', 'stubbing', 'pushing', 'dataset_created', 'tests_generated', 'setup_done', 'built')"/>
                            <field name="stubbing_mode"/>
                        </group>
                        <group string="Git &amp; Build Details">
                            <field name="base_commit"/>
                            <field name="reference_commit"/>
                            <field name="src_dir"/>
                            <field name="test_dir"/>
                            <field name="test_count"/>
                            <field name="python_version"/>
                            <field name="install_cmd"/>
                            <field name="docker_image"/>
                            <field name="clone_path"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="File Browser" name="file_browser">
                            <field name="clone_path" widget="repo_browser" nolabel="1"/>
                        </page>
                        <page string="Output" name="output">
                            <group>
                                <field name="error_message" readonly="1"/>
                                <field name="log_output" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Tree View                                                          -->
    <!-- ================================================================== -->
    <record id="commit0_repo_entry_view_tree" model="ir.ui.view">
        <field name="name">commit0.repo.entry.list</field>
        <field name="model">commit0.repo.entry</field>
        <field name="arch" type="xml">
            <list string="Repository Entries"
                  decoration-success="state == 'complete'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state in ('preparing', 'forking', 'cloning', 'stubbing', 'pushing', 'dataset_created', 'tests_generated', 'setup_done', 'built')">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="repo_url"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'complete'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state in ('preparing', 'forking', 'cloning', 'stubbing', 'pushing', 'dataset_created', 'tests_generated', 'setup_done', 'built')"/>
                <field name="test_count"/>
                <field name="base_commit"/>
                <field name="docker_image"/>
            </list>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Action                                                             -->
    <!-- ================================================================== -->
    <record id="commit0_repo_entry_action" model="ir.actions.act_window">
        <field name="name">Repository Entries</field>
        <field name="res_model">commit0.repo.entry</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No repository entries yet
            </p>
            <p>
                Repository entries are created automatically when a pipeline run processes repositories.
            </p>
        </field>
    </record>

</odoo>
