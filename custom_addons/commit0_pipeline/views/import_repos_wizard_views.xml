<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="import_repos_wizard_view_form" model="ir.ui.view">
        <field name="name">commit0.import.repos.wizard.form</field>
        <field name="model">commit0.import.repos.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Repository URLs">
                <group>
                    <field name="csv_file" filename="csv_filename"
                           invisible="result_message"/>
                    <field name="csv_filename" invisible="1"/>
                </group>
                <group invisible="not result_message">
                    <field name="result_message" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_import" string="Import"
                            type="object" class="btn-primary"
                            invisible="result_message"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="import_repos_wizard_action" model="ir.actions.act_window">
        <field name="name">Import Repos from CSV</field>
        <field name="res_model">commit0.import.repos.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
