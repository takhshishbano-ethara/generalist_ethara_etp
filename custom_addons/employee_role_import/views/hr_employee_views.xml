<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr.group_hr_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('base.group_allow_export'))]"/>
    </record>

    <!-- Employee ID (employee_code) on the standard employee FORM.
         Shown directly under the employee name as a labelled badge, matching
         the Email / Work Phone header style. Previously this field was inserted
         after work_email, which made the imported Employee ID render in the
         wrong position (floating next to the work email field). -->
    <record id="view_hr_employee_form_inherit_role_import" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.role.import</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <h5 class="d-flex align-items-baseline mb-0">
                    <i class="fa fa-id-badge fa-fw me-1 text-primary" title="Employee ID"/>
                    <field name="employee_code" placeholder="e.g. GRP1234"
                           string="Employee ID" class="w-100 w-sm-75"/>
                </h5>
            </xpath>
        </field>
    </record>

    <!-- Employee ID (employee_code) on the standard employee LIST as the
         leading column. -->
    <record id="view_hr_employee_tree_inherit_role_import" model="ir.ui.view">
        <field name="name">hr.employee.tree.inherit.role.import</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="employee_code" string="Employee ID" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Employee ID (employee_code) searchable on the standard employee SEARCH. -->
    <record id="view_hr_employee_filter_inherit_role_import" model="ir.ui.view">
        <field name="name">hr.employee.filter.inherit.role.import</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="employee_code" string="Employee ID"
                       filter_domain="[('employee_code', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_imported_employees_list" model="ir.ui.view">
        <field name="name">hr.employee.imported.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list editable="bottom"
                  multi_edit="1"
                  string="Imported Employees"
                  class="o_imported_employees_list"
                  decoration-muted="not active">
                <field name="name" required="1" decoration-bf="1"/>
                <field name="employee_code" string="Employee ID"/>
                <field name="work_email" string="Email"/>
                <field name="role"
                       decoration-success="role in ('tasker','ql','qr')"
                       decoration-info="role in ('pl','dm')"
                       decoration-warning="role in ('tpm','cto')"
                       decoration-primary="role in ('hr_admin','it_admin')"/>
                <field name="job_title" string="Job Title"/>
                <field name="task_forge_ql_id"
                       string="Assigned QL"
                       options="{'no_create': True, 'no_create_edit': True}"
                       readonly="role != 'tasker'"/>
                <field name="task_forge_pl_id"
                       string="Assigned PL"
                       options="{'no_create': True, 'no_create_edit': True}"
                       readonly="role not in ('qr','ql')"/>
                <field name="task_forge_tpm_id"
                       string="Assigned TPM"
                       options="{'no_create': True, 'no_create_edit': True}"
                       readonly="role != 'pl'"/>
                <field name="active" string="Status" widget="boolean_toggle"/>
                <button name="action_delete_with_user"
                        type="object"
                        icon="fa-trash"
                        string="Delete"
                        class="btn-link text-danger"
                        confirm="Delete this employee and their login user? This cannot be undone."/>
            </list>
        </field>
    </record>



    <record id="view_imported_employees_search" model="ir.ui.view">
        <field name="name">hr.employee.imported.search</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_code" string="Employee ID"/>
                <field name="work_email" string="Email"/>
                <field name="role"/>
                <field name="job_title" string="Job Title"/>
                <field name="task_forge_ql_id" string="Assigned QL"/>
                <field name="task_forge_pl_id" string="Assigned PL"/>
                <field name="task_forge_tpm_id" string="Assigned TPM"/>
                <field name="user_id" string="Login User"/>
                <filter name="filter_with_user" string="Has Login User"
                        domain="[('user_id', '!=', False)]"/>
                <filter name="filter_no_user" string="No Login User"
                        domain="[('user_id', '=', False)]"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_by_role" string="Group by Role"
                        context="{'group_by': 'role'}"/>
                <filter name="group_by_ql" string="Group by Assigned QL"
                        context="{'group_by': 'task_forge_ql_id'}"/>
                <filter name="group_by_pl" string="Group by Assigned PL"
                        context="{'group_by': 'task_forge_pl_id'}"/>
                <filter name="group_by_tpm" string="Group by Assigned TPM"
                        context="{'group_by': 'task_forge_tpm_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_imported_employees" model="ir.actions.act_window">
        <field name="name">Imported Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_imported_employees_list"/>
        <field name="search_view_id" ref="view_imported_employees_search"/>
        <field name="domain">['|', ('user_id', '=', False), ('user_id', '!=', uid)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No employees yet. Import some using the wizard.
            </p>
        </field>
    </record>

    <!-- Make Task Forge hierarchy fields read-only (visible, but not fillable)
         when they do not apply to the employee's own role. QL and QR are the
         same level, so a QL/QR employee gets no quality-tier (QR) manager; a PL
         gets no PL manager; TPM/CTO/HR get none. Lives here (not in
         task_forge_bridge) because the `role` field is added by this module,
         which loads after task_forge_bridge. -->
    <record id="view_employee_form_task_forge_role_filter" model="ir.ui.view">
        <field name="name">hr.employee.form.task.forge.role.filter</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="task_forge_bridge.view_employee_form_task_forge"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='task_forge']//field[@name='task_forge_tpm_id']" position="before">
                <field name="role" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='task_forge']//field[@name='task_forge_qr_id']" position="attributes">
                <attribute name="readonly">role != 'tasker'</attribute>
            </xpath>
            <xpath expr="//page[@name='task_forge']//field[@name='task_forge_pl_id']" position="attributes">
                <attribute name="readonly">role not in ('qr','ql')</attribute>
            </xpath>
            <xpath expr="//page[@name='task_forge']//field[@name='task_forge_tpm_id']" position="attributes">
                <attribute name="readonly">role != 'pl'</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_delete_employee_with_user" model="ir.actions.server">
        <field name="name">Delete (incl. login user)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_delete_with_user()</field>
    </record>

</odoo>
