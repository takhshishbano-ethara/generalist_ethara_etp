<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============ CLIENT ACTIONS (OWL components) ============ -->
    <record id="action_runs_dashboard" model="ir.actions.client">
        <field name="name">Training Dashboard</field>
        <field name="tag">rl_gym_dashboard.runs_dashboard</field>
    </record>

    <record id="action_rl_gym_dashboard" model="ir.actions.client">
        <field name="name">RL Training Monitor</field>
        <field name="tag">rl_gym_dashboard.main</field>
    </record>

    <record id="action_training_wizard" model="ir.actions.client">
        <field name="name">Training Wizard</field>
        <field name="tag">rl_gym_dashboard.training_wizard</field>
    </record>

    <!-- ============ MENUS ============ -->
    <menuitem id="menu_rl_gym_root"
              name="RL Training"
              sequence="205"/>

    <menuitem id="menu_runs_dashboard"
              name="Dashboard"
              parent="menu_rl_gym_root"
              action="action_runs_dashboard"
              sequence="5"/>

    <menuitem id="menu_training_wizard"
              name="New Training"
              parent="menu_rl_gym_root"
              action="action_training_wizard"
              sequence="10"/>

    <menuitem id="menu_training_jobs"
              name="All Jobs"
              parent="menu_rl_gym_root"
              action="action_training_job_list"
              sequence="20"/>
</odoo>
