<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_arc_bench" model="ir.module.category">
        <field name="name">ARC Bench Analytics</field>
        <field name="sequence">22</field>
    </record>

    <record id="privilege_arc_bench" model="res.groups.privilege">
        <field name="name">ARC Bench Analyst</field>
        <field name="category_id" ref="module_category_arc_bench"/>
    </record>

    <record id="group_arc_bench_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_arc_bench"/>
        <field name="comment">Can view and run benchmark analysis sessions.</field>
    </record>

    <record id="group_arc_bench_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_arc_bench"/>
        <field name="implied_ids" eval="[(4, ref('group_arc_bench_user'))]"/>
        <field name="comment">Full bench analytics access: manage sessions, delete results.</field>
    </record>

    <!-- Assign admin group to base admin user -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('arc_bench_analytics.group_arc_bench_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_arc_bench_session_user_own" model="ir.rule">
        <field name="name">ARC Bench Session: User sees own</field>
        <field name="model_id" ref="model_arc_bench_session"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_arc_bench_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_arc_bench_session_admin" model="ir.rule">
        <field name="name">ARC Bench Session: Admin full access</field>
        <field name="model_id" ref="model_arc_bench_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_arc_bench_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
