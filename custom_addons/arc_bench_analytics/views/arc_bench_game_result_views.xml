<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== LIST VIEW ===================== -->
    <record id="view_arc_bench_game_result_list" model="ir.ui.view">
        <field name="name">arc.bench.game.result.list</field>
        <field name="model">arc.bench.game.result</field>
        <field name="arch" type="xml">
            <list string="Game Results">
                <field name="game_id"/>
                <field name="model_count"/>
                <field name="session_id"/>
            </list>
        </field>
    </record>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_arc_bench_game_result_form" model="ir.ui.view">
        <field name="name">arc.bench.game.result.form</field>
        <field name="model">arc.bench.game.result</field>
        <field name="arch" type="xml">
            <form string="Game Result">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="game_id" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="model_count"/>
                            <field name="game_path"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Score over Steps" name="plot1">
                            <field name="plot1_image" widget="image"
                                   options="{'size': [1200, 600]}"/>
                        </page>
                        <page string="Score vs Cost" name="plot2">
                            <field name="plot2_image" widget="image"
                                   options="{'size': [1200, 600]}"/>
                        </page>
                        <page string="Model Results" name="models">
                            <field name="model_result_ids">
                                <list>
                                    <field name="model_name"/>
                                    <field name="run_count"/>
                                    <field name="mean_score_pct"/>
                                    <field name="mean_cost_usd"/>
                                    <field name="solved_count"/>
                                    <field name="mean_elapsed_seconds"/>
                                    <field name="total_steps"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== ACTION ===================== -->
    <record id="action_arc_bench_game_result" model="ir.actions.act_window">
        <field name="name">Game Results</field>
        <field name="res_model">arc.bench.game.result</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
