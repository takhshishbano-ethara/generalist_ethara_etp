<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_game_result_findings" model="ir.actions.report">
        <field name="name">Game QC Report</field>
        <field name="model">arc.qc.game.result</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">arc_qc.report_game_result_findings</field>
