<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== LIST VIEW ===================== -->
    <record id="view_arc_qc_session_list" model="ir.ui.view">
        <field name="name">arc.qc.session.list</field>
        <field name="model">arc.qc.session</field>
        <field name="arch" type="xml">
            <list string="QC Sessions"
                  decoration-danger="state == 'blocked'"
                  decoration-warning="state == 'conditional_ship'"
                  decoration-success="state == 'ship'">
                <field name="name"/>
                <field name="source_type"/>
                <field name="state"/>
                <field name="games_checked"/>
                <field name="critical_count"/>
                <field name="high_count"/>
                <field name="medium_count"/>
                <field name="low_count"/>
                <field name="duration_seconds" widget="float_time"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_arc_qc_session_form" model="ir.ui.view">
        <field name="name">arc.qc.session.form</field>
        <field name="model">arc.qc.session</field>
        <field name="arch" type="xml">
            <form string="QC Session">
                <header>
                    <button name="action_run_qc"
                            string="Run QC"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('draft', 'error')"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state in ('draft', 'running')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- State banners -->
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'blocked'">
                        <strong>BLOCKED</strong> — This delivery does not meet QC requirements.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'conditional_ship'">
                        <strong>CONDITIONAL SHIP</strong> — Minor issues require review before shipping.
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'ship'">
                        <strong>SHIP</strong> — Delivery passes all QC checks.
                    </div>

                    <group>
                        <group string="Source">
                            <field name="source_type" widget="radio"/>
                            <field name="session_path"
                                   invisible="source_type != 'local'"
                                   required="source_type == 'local'"/>
                            <field name="repo_url"
                                   invisible="source_type != 'git'"
                                   required="source_type == 'git'"
                                   placeholder="https://github.com/org/repo"/>
                            <field name="repo_token"
                                   invisible="source_type != 'git'"
                                   password="True"
                                   placeholder="ghp_xxxx..."/>
                            <field name="repo_branch"
                                   invisible="source_type != 'git'"/>
                            <field name="clone_path"
                                   invisible="not clone_path"/>
                        </group>
                        <group string="Config">
                            <field name="expected_runs"/>
                            <field name="max_steps"/>
                            <field name="skip_content_safety"/>
                            <field name="skip_smell_tests"/>
                        </group>
                    </group>
                    <group string="Results" invisible="state in ('draft', 'running')">
                        <group>
                            <field name="state" string="Verdict"/>
                            <field name="games_checked"/>
                            <field name="models_checked"/>
                            <field name="runs_checked"/>
                            <field name="steps_checked"/>
                            <field name="duration_seconds"/>
                        </group>
                        <group>
                            <field name="critical_count"/>
                            <field name="high_count"/>
                            <field name="medium_count"/>
                            <field name="low_count"/>
                            <field name="total_findings"/>
                        </group>
                    </group>

                    <div invisible="state != 'error'">
                        <group string="Error">
                            <field name="error_message" widget="text"/>
                        </group>
                    </div>

                    <notebook invisible="state not in ('ship', 'conditional_ship', 'blocked')">
                        <page string="Summary" name="summary">
                            <field name="summary_html" nolabel="1"/>
                        </page>
                        <page string="Game Results" name="game_results">
                            <field name="game_result_ids" nolabel="1">
                                <list decoration-danger="verdict == 'block'"
                                      decoration-warning="verdict == 'conditional_ship'"
                                      decoration-success="verdict == 'ship'"
                                      open_form_view="True">
                                    <field name="passed" widget="boolean"/>
                                    <field name="game_id"/>
                                    <field name="verdict"/>
                                    <field name="models_found"/>
                                    <field name="runs_checked"/>
                                    <field name="steps_checked"/>
                                    <field name="critical_count"/>
                                    <field name="high_count"/>
                                    <field name="medium_count"/>
                                    <field name="low_count"/>
                                    <field name="finding_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Findings" name="findings">
                            <field name="finding_ids" nolabel="1">
                                <list                   decoration-danger="severity == 'critical'"
                                      decoration-warning="severity == 'high'"
                                      limit="200">
                                    <field name="game_id"/>
                                    <field name="severity"/>
                                    <field name="phase"/>
                                    <field name="code"/>
                                    <field name="message"/>
                                    <field name="file_path"/>
                                    <field name="line_number"/>
                                    <field name="spec_ref"/>
                                </list>
                            </field>
                        </page>
                        <page string="QC Info" name="qc_info">
                            <div class="o_form_sheet">

                                <h3>Validation Phases</h3>
                                <table class="table table-sm table-bordered">
                                    <thead><tr>
                                        <th>Phase</th><th>Description</th><th>Checks</th>
                                    </tr></thead>
                                    <tbody>
                                        <tr>
                                            <td><strong>1. Discovery</strong></td>
                                            <td>Walks session directory, finds game directories and model subdirectories</td>
                                            <td>4 canonical model dirs present per game (Claude_Opus_4.7, Gemini_3.1_Pro, GPT_5.4_Thinking, Kimi_K2.5)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>2. Structural</strong></td>
                                            <td>File existence, encoding, JSONL parse integrity</td>
                                            <td>runs.jsonl + steps.jsonl exist, non-empty, valid UTF-8, no null bytes, valid JSON per line</td>
                                        </tr>
                                        <tr>
                                            <td><strong>3. Runs Validation</strong></td>
                                            <td>25 required fields, type/value checks, 7 invariants (§6)</td>
                                            <td>type=run_complete, score_pct math, solved IFF conditions, unsolved=200 steps, dead-on-arrival, reset_count, run ordering</td>
                                        </tr>
                                        <tr>
                                            <td><strong>4. Steps Validation</strong></td>
                                            <td>23 required fields, action allow-list, sequence checks, sequential invariants (§7)</td>
                                            <td>Actions: CLICK X Y / LEFT / RIGHT / UP / DOWN / RESET / SELECT N / UNDO. States: NOT_FINISHED / WIN / GAME_OVER. Step contiguity 0..N-1, timestamp monotonicity, CLICK [0,63] bounds. State transitions: legal table enforced (RESET from any→NOT_FINISHED; WIN terminal; GAME_OVER→{GAME_OVER, NOT_FINISHED}). Score monotonicity §7.3 — drops only when: (a) curr=RESET + level=1 + (prev=RESET OR just arrived at new level), or (b) prev_state=GAME_OVER + score→0. RESET state consistency §7.4 — score=0 + level&gt;1 on RESET = impossible unless prev=GAME_OVER (CRITICAL). Score-level formula §7.4 — score==(level-1)/total on non-RESET steps (CRITICAL). Level progression — same drop rule as score + allowed after GAME_OVER; 0/+1 only otherwise (CRITICAL). No steps after done=true. Cumulative cost additive (cum[N] ≥ cum[N-1] + step_cost[N]).</td>
                                        </tr>
                                        <tr>
                                            <td><strong>5. Cross-Run</strong></td>
                                            <td>Consistency between runs.jsonl and steps.jsonl (§11)</td>
                                            <td>run_id linkage, step count vs total_steps, game_id consistency, terminal state alignment, reset_count match, token sum verification (run.total_tokens ≥ Σ step.tokens)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>6. Content Safety</strong></td>
                                            <td>~40 regex patterns for harmful content (§10)</td>
                                            <td>Project leakage, prompt injection, recording awareness, data corruption, malicious base64/hex, PII (emails, phones, SSNs, credit cards), weak citations. Filters: §10.5 PII validators, §10.6.1 puzzle-geometry, §10.7 FIM/URL whitelist, + 8 false-positive filters for ARC game data (see SPEC_COMPLIANCE.md)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>7. Smell Tests</strong></td>
                                            <td>Statistical anomaly detection (§12)</td>
                                            <td>Cookie-cutter CoT (CV&lt;0.1), empty reasoning (&gt;30%), zero tokens (&gt;10% — Claude/Gemini/Kimi exempt), synthetic timestamps, linear cost slope, empty-field context dump</td>
                                        </tr>
                                    </tbody>
                                </table>

                                <h3 class="mt-4">Severity Levels</h3>
                                <table class="table table-sm table-bordered">
                                    <thead><tr>
                                        <th>Severity</th><th>Meaning</th><th>Examples</th>
                                    </tr></thead>
                                    <tbody>
                                        <tr class="table-danger">
                                            <td><strong>CRITICAL</strong></td>
                                            <td>Data integrity violation — delivery is unreliable</td>
                                            <td>Missing required fields, invalid field types/values, broken invariants, missing model directories, PII detection (credit card, SSN), prompt injection markers, CLICK out-of-bounds, illegal state transitions, score monotonicity violation, steps after done=true, level progression violation</td>
                                        </tr>
                                        <tr style="background: #fff3cd;">
                                            <td><strong>HIGH</strong></td>
                                            <td>Significant quality concern — data usable but suspect</td>
                                            <td>Unexpected extra files, cross-run mismatches, content safety patterns (recording awareness, data corruption), cumulative cost additive mismatch, token sum impossible</td>
                                        </tr>
                                        <tr class="table-warning">
                                            <td><strong>MEDIUM</strong></td>
                                            <td>Quality warning — needs attention</td>
                                            <td>Prompt injection attempts (act as, new instructions), role-play patterns, private IPs, smell test anomalies</td>
                                        </tr>
                                        <tr>
                                            <td><strong>LOW</strong></td>
                                            <td>Minor observation — informational</td>
                                            <td>Weak citation markers ([N], (YYYY)), zero reasoning tokens, extra fields in JSONL</td>
                                        </tr>
                                    </tbody>
                                </table>

                                <h3 class="mt-4">Verdict Rules</h3>
                                <table class="table table-sm table-bordered">
                                    <thead><tr>
                                        <th>Verdict</th><th>Rule</th>
                                    </tr></thead>
                                    <tbody>
                                        <tr class="table-danger">
                                            <td><strong>BLOCK</strong></td>
                                            <td>1+ CRITICAL, OR 2+ HIGH, OR 4+ MEDIUM, OR 6+ LOW findings</td>
                                        </tr>
                                        <tr class="table-warning">
                                            <td><strong>CONDITIONAL SHIP</strong></td>
                                            <td>Exactly 3 MEDIUM findings, OR exactly 5 LOW findings (with 0 CRITICAL, 0-1 HIGH)</td>
                                        </tr>
                                        <tr class="table-success">
                                            <td><strong>SHIP</strong></td>
                                            <td>0 CRITICAL, 0-1 HIGH, 0-2 MEDIUM, 0-4 LOW</td>
                                        </tr>
                                    </tbody>
                                </table>

                                <h3 class="mt-4">Expected Data Structure</h3>
                                <pre style="background:#f8f9fa;padding:12px;border-radius:4px;font-size:13px;">{session_root}/
├── {game_id}/                    # e.g. bb01, cc01, dr07
│   ├── Claude_Opus_4.7/
│   │   ├── runs.jsonl            # 3 lines (one per run)
│   │   └── steps.jsonl           # All steps interleaved
│   ├── Gemini_3.1_Pro/
│   │   ├── runs.jsonl
│   │   └── steps.jsonl
│   ├── GPT_5.4_Thinking/
│   │   ├── runs.jsonl
│   │   └── steps.jsonl
│   └── Kimi_K2.5/
│       ├── runs.jsonl
│       └── steps.jsonl
└── ...</pre>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================== SEARCH VIEW ===================== -->
    <record id="view_arc_qc_session_search" model="ir.ui.view">
        <field name="name">arc.qc.session.search</field>
        <field name="model">arc.qc.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="session_path"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Running" name="filter_running" domain="[('state', '=', 'running')]"/>
                <filter string="SHIP" name="filter_ship" domain="[('state', '=', 'ship')]"/>
                <filter string="CONDITIONAL" name="filter_conditional" domain="[('state', '=', 'conditional_ship')]"/>
                <filter string="BLOCKED" name="filter_blocked" domain="[('state', '=', 'blocked')]"/>
                <filter string="Error" name="filter_error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <group>
                    <filter string="State" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="groupby_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===================== ACTION ===================== -->
    <record id="action_arc_qc_session" model="ir.actions.act_window">
        <field name="name">QC Sessions</field>
        <field name="res_model">arc.qc.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_arc_qc_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new QC session to validate ARC-AGI trajectory data.
            </p>
        </field>
    </record>

</odoo>
