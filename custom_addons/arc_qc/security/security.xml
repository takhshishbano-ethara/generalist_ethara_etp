<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_arc_qc" model="ir.module.category">
        <field name="name">ARC QC</field>
        <field name="sequence">21</field>
    </record>

    <record id="privilege_arc_qc" model="res.groups.privilege">
        <field name="name">ARC QC Validator</field>
        <field name="category_id" ref="module_category_arc_qc"/>
    </record>

    <record id="group_arc_qc_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_arc_qc"/>
        <field name="implied_ids" eval="[(4, ref('arc_eval_launcher.group_arc_eval_user'))]"/>
        <field name="comment">Can view and run QC sessions on own eval sessions.</field>
    </record>

    <record id="group_arc_qc_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_arc_qc"/>
        <field name="implied_ids" eval="[(4, ref('group_arc_qc_user'))]"/>
        <field name="comment">Full QC access: run on any session, delete findings, manage config.</field>
    </record>

    <!-- Assign admin group to base admin user -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('arc_qc.group_arc_qc_admin'))]"/>
    </record>

    <!-- Record Rules -->

    <record id="rule_arc_qc_session_user_own" model="ir.rule">
        <field name="name">ARC QC Session: User sees own</field>
        <field name="model_id" ref="model_arc_qc_session"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_arc_qc_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_arc_qc_session_admin" model="ir.rule">
        <field name="name">ARC QC Session: Admin full access</field>
        <field name="model_id" ref="model_arc_qc_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_arc_qc_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_arc_qc_finding_user_own" model="ir.rule">
        <field name="name">ARC QC Finding: User sees own session findings</field>
        <field name="model_id" ref="model_arc_qc_finding"/>
        <field name="domain_force">[('session_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_arc_qc_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_arc_qc_finding_admin" model="ir.rule">
        <field name="name">ARC QC Finding: Admin full access</field>
        <field name="model_id" ref="model_arc_qc_finding"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_arc_qc_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
