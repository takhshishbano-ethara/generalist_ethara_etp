<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Milo-Bench Showcase — public single-page editorial view.

    Mounted at /aurora by controllers/main.py (AuroraShowcase).
    The controller passes evaluation data which the client-side JS
    consumes to render the dataset viewer table.

    Layout: standalone HTML (no portal.portal_layout). Mirrors
    Tesseract's editorial section-numbered design with Milo-Bench's
    RL benchmark content and all DOM IDs preserved for JS hooks.
  -->

  <template id="portal_showcase" name="Milo-Bench Dashboard">
    <html lang="en">
    <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <title>MILO-BENCH — Long-Horizon Software Evolution · ETHARA AI</title>
      <meta name="description" content="Milo-Bench trains AI agents to perform long-horizon software evolution. Given real-world codebases and their development history, the system works through sequences of 1 to 100+ consecutive production pull requests across Python, Rust, Go, TypeScript, JavaScript, Java, C, and C++."/>
      <meta name="theme-color" content="#F7F8FA" media="(prefers-color-scheme: light)"/>
      <meta name="theme-color" content="#0B0E14" media="(prefers-color-scheme: dark)"/>

      <!-- Sync theme-setter: reads the saved choice BEFORE stylesheet
           tokens resolve, so there is no flash when revisiting the page.
           Runs inline (no defer) by design. -->
      <script>
        (function(){
          try {
            var saved = localStorage.getItem('aurora:theme');
            if (saved === 'light' || saved === 'dark') {
              document.documentElement.setAttribute('data-theme', saved);
            } else {
              document.documentElement.setAttribute('data-theme', 'dark');
            }
          } catch(e) {}
        })();
      </script>

      <link rel="preconnect" href="https://fonts.googleapis.com"/>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin"/>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600;700&amp;family=DM+Sans:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap"/>

      <!-- Aurora dark editorial stylesheet served as a static asset
           (bypasses web.assets_frontend so Bootstrap/portal chrome
           does not override the design). -->
      <link rel="stylesheet" href="/aurora_dashboard/static/src/portal/css/aurora_portal.css"/>

      <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer="defer"/>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer="defer"/>
      <script src="/aurora_dashboard/static/src/portal/js/aurora_portal.js" defer="defer"/>
    </head>
    <body>
      <a class="skip-link" href="#main">Skip to content</a>

      <!-- Scroll progress rail. Thin 2px bar at the top of the viewport
           that fills left-to-right as the user scrolls. Updated via
           requestAnimationFrame in aurora_portal.js. -->
      <div class="scroll-progress" aria-hidden="true"/>

      <!-- Theme toggle. Two icons layered; CSS flips visibility per
           `data-theme` attribute on :root. JS updates the attribute
           and persists the choice to localStorage. -->
      <button type="button" id="au-theme-toggle" class="theme-toggle"
              aria-label="Toggle light / dark mode"
              title="Toggle light / dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"/>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/><path d="M12 20v2"/>
          <path d="M4.93 4.93l1.41 1.41"/><path d="M17.66 17.66l1.41 1.41"/>
          <path d="M2 12h2"/><path d="M20 12h2"/>
          <path d="M4.93 19.07l1.41-1.41"/><path d="M17.66 6.34l1.41-1.41"/>
        </svg>
      </button>

      <div class="page" id="au-portal">

  <!-- ================= MASTHEAD ================= -->
  <header class="masthead">
    <div class="mast-top">
      <h1 class="wordmark">MILO-BENCH</h1>
      <span class="badge mono">LONG-HORIZON SOFTWARE EVOLUTION</span>
    </div>
    <hr class="rule"/>
    <p class="thesis">Can frontier models perform long-horizon software evolution with production-grade reliability?</p>
    <p class="byline">by <a href="https://www.ethara.ai" target="_blank" rel="noopener">Ethara AI</a></p>
  </header>

  <main id="main">

  <!-- ================= §01 Overview ================= -->
  <section class="section" id="overview" aria-labelledby="overview-label" data-animate="fade-up">
    <p class="section-label" id="overview-label">§01 · Overview</p>
    <div class="overview-grid">
      <div class="prose">
        <p>MILO-Bench trains AI agents to perform long-horizon software evolution extended from SWE-EVO. Given real-world codebases and their development history, the system works through sequences of 2 to 100+ consecutive production pull requests across Python, Rust, Go, TypeScript, JavaScript, Java, C, and C++. Unlike single-issue setups, it requires maintaining coherent, consistent development over extended timelines. Each instance reconstructs a milestone from post-training-cutoff repositories, with hermetic Docker environments.</p>
        <ul class="capabilities">
          <li>Long-horizon evaluation: 2–100+ consecutive PR sequences per instance</li>
          <li>Multi-language coverage across 8 programming languages</li>
          <li>Contamination-audited instances from post-training-cutoff repositories</li>
          <li>Hermetic Docker environments with private holistic test oracles</li>
          <li>Three-model reference evaluation framework for reproducible scoring</li>
        </ul>
      </div>

      <aside class="glance" aria-label="At a glance">
        <p class="glance-label mono">At a glance</p>
        <dl class="glance-list">
          <div class="glance-row"><dt>Instances</dt><dd><b>10,000</b></dd></div>
          <div class="glance-row"><dt>Models</dt><dd><b>2</b></dd></div>
          <div class="glance-row"><dt>Trajectories</dt><dd><b>60,000</b></dd></div>
          <div class="glance-row"><dt>Phases</dt><dd><b>3</b></dd></div>
          <div class="glance-row"><dt>Languages</dt><dd><b>8</b></dd></div>
          <div class="glance-row"><dt>Runtime</dt><dd>Hermetic · Docker</dd></div>
        </dl>
        <!-- <p class="glance-foot mono">Milo-Bench · v1 · 2026</p> -->
      </aside>
    </div>
  </section>

  <!-- ================= §02 KEY METRICS ================= -->
  <section class="section" id="scale" aria-labelledby="scale-label">
    <p class="section-label" id="scale-label">§02 · Key metrics</p>
    <p class="section-desc">Three numbers that define the scope of MILO-Bench.</p>
    <div class="kpi-row" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
      <div class="kpi-card">
        <p class="kpi-label">Instances Curated</p>
        <p class="kpi-value"><span class="kpi-big">10,000</span></p>
        <p class="kpi-sub mono">across 8 languages</p>
      </div>
      <div class="kpi-card">
        <p class="kpi-label">Models Evaluated</p>
        <p class="kpi-value"><span class="kpi-big">2</span></p>
        <p class="kpi-sub mono">GLM 5 · Kimi K2.5</p>
      </div>
      <div class="kpi-card">
        <p class="kpi-label">Trajectories Generated</p>
        <p class="kpi-value"><span class="kpi-big">60,000</span></p>
        <p class="kpi-sub mono">2 models × 3 seeds × 10,000 instances</p>
      </div>
    </div>
  </section>

  <!-- ================= §03 METHODOLOGY ================= -->
  <section class="section" id="methodology" aria-labelledby="methodology-label">
    <p class="section-label" id="methodology-label">§03 · Methodology</p>
    <p class="section-desc">How the metrics and scores are computed. Four principles govern the MILO-Bench scoring system.</p>

    <div class="pipeline-frame">
      <div class="pipeline pipeline-a" style="grid-template-columns: repeat(2, 1fr);">
        <article class="phase">
          <p class="phase-label">Principle 01</p>
          <h4 class="phase-title">Long-Horizon Software Evolution</h4>
          <ul class="phase-body">
            <li>Tasks span multi-step, multi-commit evolution chains across entire repositories</li>
            <li>Each trajectory requires understanding of full codebase context and history</li>
            <li>60,000 trajectories generated across 10,000 instances</li>
          </ul>
        </article>
        <article class="phase">
          <p class="phase-label">Principle 02</p>
          <h4 class="phase-title">Production-Grade Reliability</h4>
          <ul class="phase-body">
            <li>Patches must pass CI test suites — no regressions allowed</li>
            <li>Cross-file consistency verified across the full dependency graph</li>
            <li>Build integrity maintained through the entire evolution chain</li>
          </ul>
        </article>
        <article class="phase">
          <p class="phase-label">Principle 03</p>
          <h4 class="phase-title">Multi-Language Coverage</h4>
          <ul class="phase-body">
            <li>8 programming languages: Python, JavaScript, TypeScript, Java, C++, Go, Rust, Ruby</li>
            <li>Real-world repositories with production codebases</li>
            <li>Difficulty calibrated by trajectory length, files touched, and dependency complexity</li>
          </ul>
        </article>
        <article class="phase">
          <p class="phase-label">Principle 04</p>
          <h4 class="phase-title">Two-Model Evaluation</h4>
          <ul class="phase-body">
            <li>GLM 5 and Kimi K2.5 evaluated head-to-head</li>
            <li>Each model gets exactly one attempt per instance (Pass@1)</li>
            <li>No retries — measures true first-attempt evolution capability</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ================= §04 PIPELINE ================= -->
  <section class="section section-pipeline" id="pipeline" aria-labelledby="pipeline-label" data-animate="fade-up">
    <p class="section-label" id="pipeline-label">§04 · Evaluation pipeline</p>
    <div class="pipeline-frame">
      <div class="pipeline-intro">
        <p class="pipeline-eyebrow mono">The method</p>
        <h2 class="pipeline-title">Three phases turn raw repositories into scored long-horizon software evolution framework.</h2>
      </div>

      <div class="pipeline">
        <article class="phase">
          <p class="phase-label">Phase 01</p>
          <h4 class="phase-title">Environment Setup</h4>
          <ul class="phase-body">
            <li>Crawl 500+ repos, identify post-cutoff PR sequences</li>
            <li>Build JSONL dataset with instance metadata</li>
            <li>Construct hermetic Docker images per instance (base → PR image)</li>
            <li>Generate run results and test baselines</li>
          </ul>
        </article>
        <article class="phase">
          <p class="phase-label">Phase 02</p>
          <h4 class="phase-title">Agent Interaction</h4>
          <ul class="phase-body">
            <li>Run AI agents in sandboxed Docker environments</li>
            <li>2 models × 3 seeds × 10,000 instances</li>
            <li>Agents receive issue context and produce git diff patches</li>
            <li>Tool-use interaction across long-horizon sequences</li>
          </ul>
        </article>
        <article class="phase">
          <p class="phase-label">Phase 03</p>
          <h4 class="phase-title">Evaluation &amp; Scoring</h4>
          <ul class="phase-body">
            <li>Apply model patches to clean repo checkouts</li>
            <li>Evaluate against full test suite in hermetic containers</li>
            <li>Produce pass@k summaries per instance</li>
            <li>Grade resolution verdicts across all trajectories</li>
          </ul>
        </article>
      </div>
    </div><!-- /.pipeline-frame -->
  </section>

  <!-- ================= §05 RESULTS ================= -->
  <section class="section section-reveal" id="results" aria-labelledby="results-label" data-animate="fade-up">
    <p class="section-label" id="results-label">§05 · Results</p>

    <div class="reveal">
      <p class="reveal-line">
        Pass@3 by PR horizon range for two frontier models (Kimi K2.5, GLM 5).
      </p>
      <p class="reveal-line reveal-kicker">
        All models show sharp performance degradation as horizon increases from ~60% at 2–5 PRs to near 0% beyond 40 PRs.
      </p>
    </div>

    <div class="charts">
      <figure class="chart chart--hero">
        <button type="button" class="chart-trigger" aria-label="Preview Combined Pass Rate chart full size">
          <img class="au-chart-card au-chart-light" src="/aurora_dashboard/static/src/portal/img/combined_passrate_by_pr_range_light.png" alt="Combined Pass Rate by PR Range — both models" loading="lazy"/>
          <img class="au-chart-card au-chart-dark" src="/aurora_dashboard/static/src/portal/img/combined_passrate_by_pr_range_dark.png" alt="Combined Pass Rate by PR Range — both models" loading="lazy"/>
          <span class="chart-zoom-hint" aria-hidden="true">Click to expand</span>
        </button>
        <figcaption>Fig. 1 — Combined pass rate by PR range (all models)</figcaption>
      </figure>
    </div>

    <p class="section-desc">Distribution of best Pass@3 rate (highest of Kimi K2.5 and GLM 5).</p>

    <div class="quality-grid">
      <div class="quality-card quality-clean" data-animate="fade-up" data-delay="0">
        <span class="au-quality-num">18</span>
        <span class="quality-label">≥ 50% PASS</span>
        <span class="quality-pct mono">36.0%</span>
      </div>
      <div class="quality-card quality-fixable" data-animate="fade-up" data-delay="1">
        <span class="au-quality-num">20</span>
        <span class="quality-label">10–49% PASS</span>
        <span class="quality-pct mono">40.0%</span>
      </div>
      <div class="quality-card quality-degraded" data-animate="fade-up" data-delay="2">
        <span class="au-quality-num">8</span>
        <span class="quality-label">&lt; 10% PASS</span>
        <span class="quality-pct mono">16.0%</span>
      </div>
      <div class="quality-card quality-broken" data-animate="fade-up" data-delay="3">
        <span class="au-quality-num">4</span>
        <span class="quality-label">0% PASS</span>
        <span class="quality-pct mono">8.0%</span>
      </div>
    </div>

    <div class="confidence-strip" data-animate="fade-up">
      <span class="au-confidence-big">29.3%</span>
      <span class="confidence-lbl mono">Mean Pass Rate</span>
    </div>
  </section>

  <!-- ================= §06 DATASET VIEWER ================= -->
  <section class="section" id="au-eval-viewer" aria-labelledby="viewer-label" data-animate="fade-up">
    <p class="section-label" id="viewer-label">§06 · Dataset Viewer</p>

    <!-- KPI row -->
    <div class="kpi-row" aria-label="Headline statistics for the evaluation">
      <div class="kpi-card">
        <p class="kpi-label">Total Instances</p>
        <p class="kpi-value"><span class="kpi-big">10,000</span></p>
      </div>
      <div class="kpi-card">
        <p class="kpi-label">Models</p>
        <p class="kpi-value"><span class="kpi-big">2</span></p>
      </div>
      <div class="kpi-card">
        <p class="kpi-label">Total Runs</p>
        <p class="kpi-value"><span class="kpi-big">60,000</span></p>
      </div>
      <div class="kpi-card kpi-card--accent">
        <p class="kpi-label">Mean Pass Rate</p>
        <p class="kpi-value"><span class="kpi-big">29.3<small>%</small></span></p>
      </div>
    </div>

    <!-- Controls -->
    <div class="eval-controls">
      <div class="eval-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" id="au-eval-search" placeholder="Search instances..." autocomplete="off"/>
      </div>
      <div class="eval-filters">
        <select id="au-eval-language">
          <option value="">All Languages</option>
          <option value="Python">Python</option>
          <option value="JavaScript">JavaScript</option>
          <option value="TypeScript">TypeScript</option>
          <option value="Go">Go</option>
          <option value="Rust">Rust</option>
          <option value="Java">Java</option>
          <option value="C++">C++</option>
          <option value="C">C</option>
        </select>
        <select id="au-eval-sort">
          <option value="instance_id">Instance (A-Z)</option>
          <option value="pr_range">PR Range</option>
          <option value="language">Language</option>
          <option value="glm_pass" selected="selected">GLM 5</option>
          <option value="kimi_pass">Kimi K2.5</option>
        </select>
        <button type="button" id="au-eval-sort-dir-btn" class="sort-dir-btn" title="Descending – click to reverse">↓</button>
      </div>
      <div class="eval-meta">
        <span id="au-eval-count">Loading...</span>
      </div>
    </div>

    <!-- Table -->
    <div class="eval-table-wrap" id="au-eval-table-wrap">
      <table class="eval-table">
        <thead>
          <tr>
            <th class="eth-instance">Instance</th>
            <th class="eth-prrange">PR Range</th>
            <th class="eth-lang">Language</th>
            <th class="eth-glm">GLM 5</th>
            <th class="eth-kimi">Kimi K2.5</th>
            <th class="eth-repo">Repo</th>
            <th class="eth-expand"></th>
          </tr>
        </thead>
        <tbody id="au-eval-tbody"></tbody>
      </table>
    </div>
    <div class="eval-pagination" id="au-eval-pagination"></div>
  </section>

  <!-- ================= §07 MODEL COMPARISON ================= -->
  <section class="section" id="models" aria-labelledby="models-label">
    <p class="section-label" id="models-label">§07 · Model comparison</p>
    <p class="section-desc">Head-to-head breakdown of both evaluated frontier models on long-horizon evolution tasks.</p>

    <div class="kpi-row" style="grid-template-columns: repeat(2, 1fr);">
      <div class="kpi-card" style="min-height: auto;">
        <p class="kpi-label"><span class="tok-kimi">Kimi K2.5</span></p>
        <dl class="glance-list" style="margin-top: 12px;">
          <div class="glance-row"><dt>Overall Pass Rate</dt><dd><b>36.4%</b></dd></div>
          <div class="glance-row"><dt>Short Trajectories</dt><dd><b>49.7%</b></dd></div>
          <div class="glance-row"><dt>Long Trajectories</dt><dd><b>23.1%</b></dd></div>
          <div class="glance-row"><dt>Avg Cost/Instance</dt><dd><b>~$0.06</b></dd></div>
        </dl>
      </div>
      <div class="kpi-card" style="min-height: auto;">
        <p class="kpi-label">GLM 5</p>
        <dl class="glance-list" style="margin-top: 12px;">
          <div class="glance-row"><dt>Overall Pass Rate</dt><dd><b>31.2%</b></dd></div>
          <div class="glance-row"><dt>Short Trajectories</dt><dd><b>44.5%</b></dd></div>
          <div class="glance-row"><dt>Long Trajectories</dt><dd><b>18.9%</b></dd></div>
          <div class="glance-row"><dt>Avg Cost/Instance</dt><dd><b>~$0.04</b></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ================= §08 RESOURCES ================= -->
  <section class="section" id="resources" aria-labelledby="resources-label" data-animate="fade-up">
    <p class="section-label" id="resources-label">§08 · Resources</p>
    <div class="resources" style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px;">
<!--      <a class="resource" href="https://github.com/Ethara-Ai/milo-bench-paper" target="_blank" rel="noopener">-->
      <a class="resource" href="https://github.com/Ethara-Ai/benchmarks" target="_blank" rel="noopener">
        <p class="res-label mono">GitHub</p>
        <p class="res-title">Trajectories</p>
        <p class="res-url mono">github.com/Ethara-Ai/benchmarks</p>
        <span class="res-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="resource" href="https://huggingface.co/datasets/ethara/MILO-Bench" target="_blank" rel="noopener">
        <p class="res-label mono">HuggingFace</p>
        <p class="res-title">Dataset</p>
        <p class="res-url mono">huggingface.co/datasets/ethara/MILO-Bench</p>
        <span class="res-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="resource" href="https://arxiv.org/abs/2512.18470" target="_blank" rel="noopener">
        <p class="res-label mono">Paper</p>
        <p class="res-title">Research Paper</p>
        <p class="res-url mono">arxiv.org/abs/2512.18470</p>
        <span class="res-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  </main>

  <footer class="foot">
    <div class="foot-inner">
      <p class="mono">ethara.ai · project milo-bench</p>
    </div>
  </footer>

</div><!-- /.page -->

      <!-- Lightbox overlay — hidden until a chart image is clicked.
           JS sets the <img> src + alt from the trigger, then toggles
           [data-open]. Close via button, overlay click, or Escape. -->
      <div class="lightbox" id="lightbox" role="dialog" aria-modal="true"
           aria-labelledby="lightbox-caption" aria-hidden="true" hidden="hidden">
        <button type="button" class="lightbox-close" id="lightbox-close"
                aria-label="Close preview">×</button>
        <figure class="lightbox-figure">
          <img id="lightbox-img" src="" alt=""/>
          <figcaption id="lightbox-caption" class="lightbox-caption mono"></figcaption>
        </figure>
      </div>

    </body>
    </html>
  </template>

</odoo>
