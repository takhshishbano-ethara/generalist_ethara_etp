<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="tron_dashboard.TronShowcase">
        <div class="tr-showcase">
            <header class="tr-showcase-header">
                <span class="tr-tag">ENTERPRISE-OPERATIONS AGENTIC CAPABILITIES</span>
                <h1 class="tr-title">TRON</h1>
                <p class="tr-subtitle">
                    Can AI agents follow enterprise policies to reliably complete
                    multi-step operations across multi-domain workflows?
                </p>
                <p class="tr-byline">
                    by <strong>Ethara AI</strong> &#xB7;
                    <a href="https://www.ethara.ai" target="_blank" rel="noopener">www.ethara.ai</a>
                </p>
            </header>

            <section class="tr-section tr-description">
                <p>
                    TRON is a reinforcement-learning environment for training
                    enterprise-operations agents on stateful, multi-step work across
                    eight enterprise domains. Each instance embeds a mock enterprise
                    state &#x2014; HR records, ITSM tickets, calendar entries, drive
                    contents &#x2014; and a task that can only be solved by choosing
                    the <strong>right tool, in the right order, under the right
                    policy</strong>. Reward signals are generated from deterministic
                    verifiers over the resulting workflow, decomposing performance
                    into policy adherence, tool-sequence correctness, and end-state
                    fidelity.
                </p>
            </section>

            <section class="tr-section tr-capabilities">
                <ul class="tr-capabilities-list">
                    <li><span class="tr-cap-arrow">&#x2192;</span>
                        <strong>SQL-based outcome verification:</strong>
                        hidden expert-authored SQL queries that validate final
                        database states to ensure exact business outcomes.
                    </li>
                    <li><span class="tr-cap-arrow">&#x2192;</span>
                        <strong>Resettable containerized sandbox:</strong>
                        Model Context Protocol (MCP)-powered live server environments
                        running against freshly seeded SQL database snapshots.
                    </li>
                    <li><span class="tr-cap-arrow">&#x2192;</span>
                        <strong>Long-horizon stateful planning:</strong>
                        multi-step trajectories requiring up to 34 sequential steps
                        with permanent, stateful database mutations.
                    </li>
                </ul>
            </section>

            <section class="tr-section tr-metrics">
                <div class="tr-metric-grid">
                    <div class="tr-metric-card">
                        <span class="tr-metric-value">10,000+</span>
                        <span class="tr-metric-label">Tasks</span>
                        <span class="tr-metric-detail">enterprise-ops workflows</span>
                    </div>
                    <div class="tr-metric-card">
                        <span class="tr-metric-value">8</span>
                        <span class="tr-metric-label">Domains</span>
                        <span class="tr-metric-detail">HR &#xB7; ITSM &#xB7; CSM &#xB7; Email &#xB7; Calendar &#xB7; Drive &#xB7; Teams &#xB7; Hybrid</span>
                    </div>
                    <div class="tr-metric-card">
                        <span class="tr-metric-value">512</span>
                        <span class="tr-metric-label">Tools</span>
                        <span class="tr-metric-detail">available across domains</span>
                    </div>
                    <div class="tr-metric-card">
                        <span class="tr-metric-value">Measured</span>
                        <span class="tr-metric-label">Methodology</span>
                        <span class="tr-metric-detail">difficulty is measured, not asserted</span>
                    </div>
                </div>
            </section>

            <section class="tr-section tr-phases">
                <div class="tr-phases-row">
                    <div class="tr-phase-card">
                        <div class="tr-phase-number">1</div>
                        <h3>Author &amp; Seed</h3>
                        <p>
                            Each instance ships as a JSONL bundle with user prompt,
                            system prompt, expected tool calls, and verifiers. A seed
                            DB materializes the mock enterprise state before the run.
                        </p>
                    </div>
                    <div class="tr-phase-arrow">&#x2192;</div>
                    <div class="tr-phase-card">
                        <div class="tr-phase-number">2</div>
                        <h3>Act &amp; Comply</h3>
                        <p>
                            Agent receives the prompt and a scoped tool set; it must
                            plan the correct tool sequence and obey the enterprise
                            policy layer (access, approval, PII) while executing.
                        </p>
                    </div>
                    <div class="tr-phase-arrow">&#x2192;</div>
                    <div class="tr-phase-card">
                        <div class="tr-phase-number">3</div>
                        <h3>Verify &amp; Score</h3>
                        <p>
                            Dual-axis process verification (P-axis policy, T-axis
                            tool sequence) plus end-state diff against the golden
                            seed DB, and Overstep efficiency vs a human reference.
                        </p>
                    </div>
                </div>
            </section>

            <section class="tr-section tr-links">
                <a class="tr-btn" t-att-href="state.trajectoriesUrl"
                   target="_blank" rel="noopener">
                    Repository
                </a>
                <a class="tr-btn tr-btn-filled" t-att-href="state.datasetUrl"
                   target="_blank" rel="noopener">
                    Dataset
                </a>
            </section>
        </div>
    </t>
</templates>
