<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_wildclaw" model="ir.module.category">
            <field name="name">WildClaw</field>
            <field name="description">WildClaw Core — Shared agent-sandbox base (powered by WildClawBench)</field>
            <field name="sequence">31</field>
        </record>

        <record id="res_groups_privilege_wildclaw" model="res.groups.privilege">
            <field name="name">WildClaw</field>
            <field name="sequence">31</field>
            <field name="category_id" ref="module_category_wildclaw"/>
        </record>

        <record id="group_wildclaw_tasker" model="res.groups">
            <field name="name">Tasker</field>
            <field name="privilege_id" ref="res_groups_privilege_wildclaw"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Works on own tasks, chats with sandboxes, submits trajectories.</field>
        </record>

        <record id="group_wildclaw_ql" model="res.groups">
            <field name="name">Quality Lead</field>
            <field name="privilege_id" ref="res_groups_privilege_wildclaw"/>
            <field name="implied_ids" eval="[(4, ref('group_wildclaw_tasker'))]"/>
            <field name="comment">Sees all tasks. Manages personas and domains. No costing access.</field>
        </record>

        <record id="group_wildclaw_pl" model="res.groups">
            <field name="name">Project Lead</field>
            <field name="privilege_id" ref="res_groups_privilege_wildclaw"/>
            <field name="implied_ids" eval="[(4, ref('group_wildclaw_ql'))]"/>
            <field name="comment">Full access: costing, settings, configuration.</field>
        </record>

    </data>
</odoo>
