<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="arc_eval_api_base" model="ir.config_parameter">
            <field name="key">arc_eval.api_base</field>
            <field name="value">http://localhost:5000</field>
        </record>

        <record id="arc_eval_request_timeout" model="ir.config_parameter">
            <field name="key">arc_eval.request_timeout</field>
            <field name="value">30</field>
        </record>

        <record id="arc_eval_games_endpoint" model="ir.config_parameter">
            <field name="key">arc_eval.games_endpoint</field>
            <field name="value">/api/arc3/local-games</field>
        </record>

        <record id="arc_eval_game_id_field" model="ir.config_parameter">
            <field name="key">arc_eval.game_id_field</field>
            <field name="value">game_id</field>
        </record>

    </data>
</odoo>
