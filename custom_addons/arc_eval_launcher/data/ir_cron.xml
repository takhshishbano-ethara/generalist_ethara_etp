<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_refresh_arc_eval_games" model="ir.cron">
            <field name="name">ARC Eval: Refresh Games</field>
            <field name="model_id" ref="model_arc_eval_game"/>
            <field name="state">code</field>
            <field name="code">model.action_refresh_from_api()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_refresh_arc_eval_models" model="ir.cron">
            <field name="name">ARC Eval: Refresh Models</field>
            <field name="model_id" ref="model_arc_eval_model"/>
            <field name="state">code</field>
            <field name="code">model.action_refresh_from_api()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
