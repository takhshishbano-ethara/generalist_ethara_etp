<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_arc_eval_launch_wizard_form" model="ir.ui.view">
        <field name="name">arc.eval.launch.wizard.form</field>
        <field name="model">arc.eval.launch.wizard</field>
        <field name="arch" type="xml">
            <form string="Launch ARC Eval">
                <sheet>
                    <div class="oe_title">
                        <h1>Launch ARC Eval Run</h1>
                        <p>
                            Select one or more games and models, tune parameters,
                            then click <strong>Launch</strong> to trigger a run
                            on the arc-explainer backend.
                        </p>
                    </div>
                    <group>
                        <group string="Targets">
                            <field name="game_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="model_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group string="Run Settings">
                            <field name="num_runs"/>
                            <field name="max_steps"/>
                            <field name="context_window"/>
                            <field name="with_images"/>
                        </group>
                    </group>
                    <group>
                        <group string="Parallelism">
                            <field name="parallel_games"/>
                            <field name="parallel_runs"/>
                            <field name="sequential_models"/>
                        </group>
                        <group string="Budget (optional)">
                            <field name="budget_global_usd"/>
                            <field name="budget_per_game_usd"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_launch"
                            type="object"
                            string="Launch"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_arc_eval_launch_wizard" model="ir.actions.act_window">
        <field name="name">Launch Eval</field>
        <field name="res_model">arc.eval.launch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
