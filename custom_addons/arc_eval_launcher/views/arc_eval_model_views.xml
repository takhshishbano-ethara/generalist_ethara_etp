<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_arc_eval_model_list" model="ir.ui.view">
        <field name="name">arc.eval.model.list</field>
        <field name="model">arc.eval.model</field>
        <field name="arch" type="xml">
            <list string="ARC Models" decoration-muted="not active">
                <field name="key"/>
                <field name="name"/>
                <field name="provider"/>
                <field name="supports_vision" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="last_synced_at"/>
            </list>
        </field>
    </record>

    <record id="view_arc_eval_model_form" model="ir.ui.view">
        <field name="name">arc.eval.model.form</field>
        <field name="model">arc.eval.model</field>
        <field name="arch" type="xml">
            <form string="ARC Model">
                <sheet>
                    <group>
                        <field name="key"/>
                        <field name="name"/>
                        <field name="provider"/>
                        <field name="supports_vision"/>
                        <field name="active"/>
                        <field name="last_synced_at" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_arc_eval_model_search" model="ir.ui.view">
        <field name="name">arc.eval.model.search</field>
        <field name="model">arc.eval.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="key"/>
                <field name="name"/>
                <field name="provider"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Supports Vision" name="filter_supports_vision" domain="[('supports_vision', '=', True)]"/>
                <filter string="Text Only" name="filter_text_only" domain="[('supports_vision', '=', False)]"/>
                <separator/>
                <filter string="Never Synced" name="filter_not_synced" domain="[('last_synced_at', '=', False)]"/>
                <separator/>
                <group>
                    <filter string="Provider" name="groupby_provider" context="{'group_by': 'provider'}"/>
                    <filter string="Vision Support" name="groupby_supports_vision" context="{'group_by': 'supports_vision'}"/>
                    <filter string="Active" name="groupby_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_arc_eval_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">arc.eval.model</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_arc_eval_model_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No models cached yet. Run "Refresh from arc-explainer" to fetch the catalog.
            </p>
        </field>
    </record>

    <record id="action_arc_eval_model_refresh" model="ir.actions.server">
        <field name="name">Refresh from arc-explainer</field>
        <field name="model_id" ref="model_arc_eval_model"/>
        <field name="state">code</field>
        <field name="code">model.action_refresh_from_api()</field>
    </record>

</odoo>
