<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_vegeta" model="ir.module.category">
            <field name="name">Vegeta</field>
            <field name="description">Vegeta — Automated PRD Generation Pipeline</field>
            <field name="sequence">100</field>
        </record>

        <record id="res_groups_privilege_vegeta" model="res.groups.privilege">
            <field name="name">Vegeta</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="module_category_vegeta"/>
        </record>

    </data>

    <data noupdate="1">

        <record id="group_vegeta_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_vegeta"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_vegeta_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="res_groups_privilege_vegeta"/>
            <field name="implied_ids" eval="[(4, ref('group_vegeta_user'))]"/>
        </record>

    </data>
</odoo>
