<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Taskers can only see their own assigned tasks -->
        <record id="rule_vegeta_job_user" model="ir.rule">
            <field name="name">Vegeta Task: User sees own tasks</field>
            <field name="model_id" ref="model_vegeta_job"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vegeta_user'))]"/>
        </record>

        <!-- Admins can see all tasks -->
        <record id="rule_vegeta_job_admin" model="ir.rule">
            <field name="name">Vegeta Task: Admin sees all</field>
            <field name="model_id" ref="model_vegeta_job"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_vegeta_admin'))]"/>
        </record>
    </data>
</odoo>
