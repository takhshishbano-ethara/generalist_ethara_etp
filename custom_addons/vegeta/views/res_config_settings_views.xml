<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_vegeta" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.vegeta</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Vegeta" string="Vegeta" name="vegeta">
                    <block title="Webhook">
                        <setting string="Webhook Token" help="Shared secret the Lambda sends as X-Vegeta-Token. Falls back to VEGETA_WEBHOOK_TOKEN env var if empty.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_webhook_token" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_webhook_token" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Webhook URL Override" help="Full callback URL. Leave empty in production to derive from web.base.url.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_webhook_url_override" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_webhook_url_override" class="oe_inline" placeholder="http://host.docker.internal:8069/api/v1/vegeta/webhook/extraction-complete"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Extraction Lambda">
                        <setting string="Lambda Function" help="AWS Lambda function name or ARN. Used with boto3 lambda:Invoke (async).">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_lambda_function_name" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_lambda_function_name" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_lambda_region" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_lambda_region" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_batch_concurrency" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_batch_concurrency" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_lambda_local_url" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_lambda_local_url" class="oe_inline" placeholder="http://localhost:9000/2015-03-31/functions/function/invocations"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Extraction AWS Credentials" help="Leave empty to use EKS pod IAM role (IRSA). Ignored when Lambda Local URL is set.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_extraction_access_key_id" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_extraction_access_key_id" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_extraction_secret_access_key" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_extraction_secret_access_key" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="AWS Bedrock (LLM)">
                        <setting string="Bedrock Inference ARN">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_bedrock_inference_arn" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_bedrock_inference_arn" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_bedrock_region" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_bedrock_region" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_max_llm_attempts" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_max_llm_attempts" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Bedrock AWS Credentials">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_bedrock_access_key_id" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_bedrock_access_key_id" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_bedrock_secret_access_key" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_bedrock_secret_access_key" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="S3 Storage">
                        <setting string="S3 Bucket">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_s3_bucket" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_s3_bucket" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_s3_region" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_s3_region" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_s3_folder" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_s3_folder" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_s3_cdn_url" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_s3_cdn_url" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_s3_endpoint_url" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_s3_endpoint_url" class="oe_inline" placeholder="e.g. http://localhost:9001 for MinIO"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="S3 AWS Credentials">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_s3_access_key_id" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_s3_access_key_id" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="vegeta_s3_secret_access_key" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_s3_secret_access_key" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Prompts">
                        <setting string="PRD System Prompt" help="Upload a .md file to override the built-in PRD generation prompt. Leave empty to use the default (prd_agent_spec.md).">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_prd_prompt_file" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_prd_prompt_file" filename="vegeta_prd_prompt_filename" class="oe_inline"/>
                                    <field name="vegeta_prd_prompt_filename" invisible="1"/>
                                </div>
                                <div class="row">
                                    <div class="col-lg-3"/>
                                    <field name="vegeta_prd_prompt_status" class="text-muted"/>
                                </div>
                                <div class="row mt8">
                                    <div class="col-lg-3"/>
                                    <button name="action_clear_prd_prompt" type="object" string="Reset to Default" class="btn-link btn-sm" icon="fa-undo"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="QC Review Prompt" help="Upload a .md file to override the built-in QC review prompt. Leave empty to use the default.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_qc_prompt_file" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_qc_prompt_file" filename="vegeta_qc_prompt_filename" class="oe_inline"/>
                                    <field name="vegeta_qc_prompt_filename" invisible="1"/>
                                </div>
                                <div class="row">
                                    <div class="col-lg-3"/>
                                    <field name="vegeta_qc_prompt_status" class="text-muted"/>
                                </div>
                                <div class="row mt8">
                                    <div class="col-lg-3"/>
                                    <button name="action_clear_qc_prompt" type="object" string="Reset to Default" class="btn-link btn-sm" icon="fa-undo"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Limits">
                        <setting string="Max Active Tasks per Tasker" help="Maximum active tasks per tasker. 0 = unlimited.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="vegeta_max_jobs_per_user" class="col-lg-3 o_light_label"/>
                                    <field name="vegeta_max_jobs_per_user" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
