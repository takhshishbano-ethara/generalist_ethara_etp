<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_vegeta_job" model="ir.sequence">
        <field name="name">Vegeta Task</field>
        <field name="code">vegeta.job</field>
        <field name="prefix">VEG-</field>
        <field name="padding">5</field>
    </record>

    <record id="ir_cron_vegeta_watchdog" model="ir.cron">
        <field name="name">Vegeta: Watchdog Stuck Tasks</field>
        <field name="model_id" ref="model_vegeta_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_watchdog_stuck_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
