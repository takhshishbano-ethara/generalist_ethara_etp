<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ethara_project_phase_request_review_wizard_form" model="ir.ui.view">
        <field name="name">ethara.project.phase.request.review.wizard.form</field>
        <field name="model">ethara.project.phase.request.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Phase Budget Request">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="mode" readonly="1"/>
                    <field name="note" placeholder="Explain what needs to change..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
