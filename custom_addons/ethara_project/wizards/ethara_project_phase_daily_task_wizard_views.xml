<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ethara_project_phase_daily_task_wizard_form" model="ir.ui.view">
        <field name="name">ethara.project.phase.daily.task.wizard.form</field>
        <field name="model">ethara.project.phase.daily.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Log Daily Task">
                <sheet>
                    <group>
                        <group>
                            <field name="phase_id" readonly="1"/>
                            <field name="entry_date"/>
                            <field name="connected_model"/>
                        </group>
                        <group>
                            <field name="done_count"/>
                            <field name="total_cost"/>
                            <field name="note" placeholder="Optional note"/>
                        </group>
                    </group>
                    <group string="Derived (auto-calculated)">
                        <group>
                            <field name="no_of_trajectory" readonly="1"/>
                            <field name="per_task_cost" readonly="1"/>
                            <field name="per_trajectory_cost" readonly="1"/>
                            <field name="ideal_per_task_cost" readonly="1"/>
                            <field name="ideal_per_trajectory_cost" readonly="1"/>
                        </group>
                        <group>
                            <field name="infra_cost" readonly="1"/>
                            <field name="subscription_cost" readonly="1"/>
                            <field name="health_status" widget="badge" decoration-success="health_status == 'healthy'" decoration-warning="health_status == 'warning'" decoration-danger="health_status == 'critical'" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_ethara_project_phase_daily_task_list" model="ir.ui.view">
        <field name="name">ethara.project.phase.daily.task.list</field>
        <field name="model">ethara.project.phase.daily.task</field>
        <field name="arch" type="xml">
            <list string="Daily Tasks" decoration-success="health_status == 'healthy'" decoration-warning="health_status == 'warning'" decoration-danger="health_status == 'critical'">
                <field name="entry_date"/>
                <field name="phase_id"/>
                <field name="ethara_project_id" optional="show"/>
                <field name="connected_model" optional="hide"/>
                <field name="done_count" sum="Total"/>
                <field name="no_of_trajectory" sum="Trajectories"/>
                <field name="per_task_cost"/>
                <field name="per_trajectory_cost" optional="hide"/>
                <field name="total_cost" sum="Total"/>
                <field name="ideal_per_task_cost" optional="hide"/>
                <field name="infra_cost" optional="hide"/>
                <field name="subscription_cost" optional="hide"/>
                <field name="health_status" widget="badge"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ethara_project_phase_daily_task_form" model="ir.ui.view">
        <field name="name">ethara.project.phase.daily.task.form</field>
        <field name="model">ethara.project.phase.daily.task</field>
        <field name="arch" type="xml">
            <form string="Daily Task">
                <sheet>
                    <group>
                        <group>
                            <field name="phase_id"/>
                            <field name="ethara_project_id" readonly="1"/>
                            <field name="entry_date"/>
                            <field name="connected_model"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="done_count"/>
                            <field name="no_of_trajectory"/>
                            <field name="per_task_cost"/>
                            <field name="per_trajectory_cost"/>
                            <field name="total_cost"/>
                        </group>
                    </group>
                    <group>
                        <group string="Ideal Reference">
                            <field name="ideal_per_task_cost"/>
                            <field name="ideal_per_trajectory_cost"/>
                        </group>
                        <group string="Fixed Costs">
                            <field name="infra_cost"/>
                            <field name="subscription_cost"/>
                            <field name="health_status" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Model Breakdown">
                            <field name="model_breakdown_ids">
                                <list editable="bottom">
                                    <field name="ai_model_id"/>
                                    <field name="ai_model_name"/>
                                    <field name="cost_type"/>
                                    <field name="per_task_cost"/>
                                    <field name="per_trajectory_cost"/>
                                    <field name="iterations"/>
                                    <field name="done_count"/>
                                    <field name="trajectory_count"/>
                                    <field name="ideal_cost"/>
                                    <field name="allocated_cost"/>
                                    <field name="variance"/>
                                    <field name="health_status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ethara_project_phase_daily_task" model="ir.actions.act_window">
        <field name="name">Daily Tasks</field>
        <field name="res_model">ethara.project.phase.daily.task</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
