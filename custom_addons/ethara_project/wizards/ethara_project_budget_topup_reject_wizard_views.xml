<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ethara_project_budget_topup_reject_wizard_form" model="ir.ui.view">
        <field name="name">ethara.project.budget.topup.reject.wizard.form</field>
        <field name="model">ethara.project.budget.topup.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Top-up">
                <group>
                    <field name="topup_id" readonly="1"/>
                    <field name="reason" placeholder="Why is this top-up being rejected?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm Rejection" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
