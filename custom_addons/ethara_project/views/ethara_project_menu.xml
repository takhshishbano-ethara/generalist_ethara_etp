<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         Root: mirrors etp_projects layout so the two modules feel identical.
         etp_projects nests its menus under Odoo's Project app; we cannot do
         that (ethara_project is standalone, does not depend on `project`),
         so we build the same 4-group tree under our own root menu with the
         same labels, sequences, and web icon.
         ===================================================================== -->
    <menuitem id="menu_ethara_project_root"
              name="Ethara Projects"
              web_icon="ethara_project,static/description/icon.png"
              sequence="71"/>

    <!-- ==================== Projects (registry) ==================== -->
    <menuitem id="menu_ethara_project_list"
              name="Projects"
              parent="menu_ethara_project_root"
              action="action_ethara_project"
              sequence="1"/>

