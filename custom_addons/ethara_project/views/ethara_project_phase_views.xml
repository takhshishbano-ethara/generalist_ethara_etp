<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ethara_project_phase_list" model="ir.ui.view">
        <field name="name">ethara.project.phase.list</field>
        <field name="model">ethara.project.phase</field>
        <field name="arch" type="xml">
            <list string="Ethara Project Phases">
                <field name="name"/>
                <field name="ethara_project_id"/>
                <field name="budget_id"/>
                <field name="total_tasks"/>
                <field name="estimated_cost"/>
                <field name="approved_amount"/>
                <field name="consumed_cost" optional="show"/>
                <field name="remaining_cost" optional="show"/>
                <field name="health_status" widget="badge"
                       decoration-success="health_status == 'healthy'"
                       decoration-info="health_status == 'unknown'"
                       decoration-warning="health_status == 'warning'"
                       decoration-danger="health_status in ('at_risk','critical')"
                       optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state in ('approved','in_progress','delivered','closed')"
                       decoration-danger="state in ('rejected','withdrawn')"/>
            </list>
        </field>
    </record>

    <record id="view_ethara_project_phase_form" model="ir.ui.view">
        <field name="name">ethara.project.phase.form</field>
        <field name="model">ethara.project.phase</field>
        <field name="arch" type="xml">
            <form string="Ethara Project Phase">
                <header>
                    <button name="action_refresh_model_lines" type="object"
                            string="Refresh Model Lines"
                            invisible="state != 'draft'"/>
                    <button name="action_withdraw" type="object"
                            string="Withdraw"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('rejected','withdrawn')"/>
                    <button name="action_deliver" type="object"
                            string="Mark Delivered"
                            class="oe_highlight"
                            invisible="state not in ('approved','in_progress')"/>
                    <button name="action_close" type="object"
                            string="Close"
                            invisible="state != 'delivered'"/>
                    <button name="action_restart" type="object"
                            string="Restart"
                            invisible="state != 'delivered'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,in_progress,delivered,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="request_count" widget="statinfo"
                                   string="Requests"/>
                        </button>
                        <button name="action_view_daily_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="done_tasks" widget="statinfo"
                                   string="Done Tasks"/>
                        </button>
                        <button name="action_open_request_wizard" type="object"
                                class="oe_stat_button" icon="fa-file-text"
                                invisible="state not in ('approved', 'in_progress', 'draft')">
                            <span>New Request</span>
                        </button>
                        <button name="action_open_daily_task_wizard" type="object"
                                class="oe_stat_button" icon="fa-plus"
                                invisible="state not in ('approved', 'in_progress')">
                            <span>Log Daily Task</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="budget_id"
                                   options="{'no_create': True}"/>
                            <field name="ethara_project_id" readonly="1"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="approver_id" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="total_tasks"/>
                            <field name="done_tasks" readonly="1"/>
                            <field name="remaining_tasks" readonly="1"/>
                            <field name="connected_model"/>
                            <field name="buffer_pct"/>
                        </group>
                    </group>
                    <group>
                        <group string="Financials">
                            <field name="estimated_cost" readonly="1"/>
                            <field name="phase_budget" readonly="1"/>
                            <field name="carried_over_amount" readonly="1"/>
                            <field name="approved_amount" readonly="1"/>
                        </group>
                        <group string="Consumption">
                            <field name="consumed_cost" readonly="1"/>
                            <field name="remaining_cost" readonly="1"/>
                            <field name="consumed_pct" readonly="1"/>
                            <field name="health_status" widget="badge" readonly="1"
                                   decoration-success="health_status == 'healthy'"
                                   decoration-info="health_status == 'unknown'"
                                   decoration-warning="health_status == 'warning'"
                                   decoration-danger="health_status in ('at_risk','critical')"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="AI Model Lines" name="model_lines">
                            <field name="model_line_ids">
                                <list editable="bottom">
                                    <field name="ai_model_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="ai_model_name"/>
                                    <field name="cost_type"/>
                                    <field name="per_trajectory_cost"/>
                                    <field name="iterations"/>
                                    <field name="per_task_cost"/>
                                    <field name="approved_amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Infrastructure Lines" name="infra_lines">
                            <field name="infra_line_ids">
                                <list editable="bottom">
                                    <field name="infra_type_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="description"/>
                                    <field name="budget_amount"/>
                                    <field name="approved_amount"/>
                                    <field name="per_day_cost" readonly="1"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subscription Lines" name="sub_lines">
                            <field name="subscription_line_ids">
                                <list editable="bottom">
                                    <field name="subscription_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="assigned_user_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                    <field name="subscription_count" readonly="1"/>
                                    <field name="final_amount" readonly="1"/>
                                    <field name="approved_amount"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Daily Tasks" name="daily_tasks">
                            <field name="daily_task_ids" readonly="1">
                                <list decoration-success="health_status == 'healthy'" decoration-warning="health_status == 'warning'" decoration-danger="health_status == 'critical'">
                                    <field name="entry_date"/>
                                    <field name="connected_model" optional="hide"/>
                                    <field name="done_count" sum="Total"/>
                                    <field name="no_of_trajectory"/>
                                    <field name="per_task_cost"/>
                                    <field name="total_cost" sum="Total"/>
                                    <field name="infra_cost" optional="hide"/>
                                    <field name="subscription_cost" optional="hide"/>
                                    <field name="health_status" widget="badge"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Connected Records" name="connected_records">
                            <field name="connected_record_ids">
                                <list editable="bottom">
                                    <field name="connected_model" readonly="1"/>
                                    <field name="res_id"/>
                                    <field name="record_display" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Info Links" name="info_links">
                            <field name="info_link_ids">
                                <list editable="bottom">
                                    <field name="label"/>
                                    <field name="url" widget="url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Feedback" name="feedback">
                            <field name="feedback_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="author_id"/>
                                    <field name="rating" widget="badge"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Completion" name="completion">
                            <group>
                                <field name="delivered_date" readonly="1"/>
                                <field name="closed_remaining" readonly="1"/>
                                <field name="completion_description"/>
                            </group>
                            <group string="Rejection" invisible="not rejection_reason">
                                <field name="rejection_reason" readonly="1"
                                       nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ethara_project_phase_search" model="ir.ui.view">
        <field name="name">ethara.project.phase.search</field>
        <field name="model">ethara.project.phase</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ethara_project_id"/>
                <field name="budget_id"/>
                <filter name="filter_active_phases" string="Active"
                        domain="[('state','in',('approved','in_progress'))]"/>
                <filter name="filter_at_risk" string="At Risk / Critical"
                        domain="[('health_status','in',('at_risk','critical'))]"/>
                <group>
                    <filter name="group_project" string="Project"
                            context="{'group_by': 'ethara_project_id'}"/>
                    <filter name="group_budget" string="Budget"
                            context="{'group_by': 'budget_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ethara_project_phase" model="ir.actions.act_window">
        <field name="name">Phases</field>
        <field name="res_model">ethara.project.phase</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ethara_project_phase_search"/>
    </record>

    <record id="view_ethara_project_phase_request_list" model="ir.ui.view">
        <field name="name">ethara.project.phase.request.list</field>
        <field name="model">ethara.project.phase.request</field>
        <field name="arch" type="xml">
            <list string="Phase Budget Requests">
                <field name="name"/>
                <field name="phase_id"/>
                <field name="ethara_project_id"/>
                <field name="request_type"/>
                <field name="priority"/>
                <field name="requested_total"/>
                <field name="approved_total"/>
                <field name="request_date"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft','cto_review','cfo_review')"
                       decoration-warning="state == 'changes_required'"
                       decoration-success="state in ('approved','partially_approved')"
                       decoration-danger="state == 'withdrawn'"/>
            </list>
        </field>
    </record>

    <record id="view_ethara_project_phase_request_form" model="ir.ui.view">
        <field name="name">ethara.project.phase.request.form</field>
        <field name="model">ethara.project.phase.request</field>
        <field name="arch" type="xml">
            <form string="Phase Budget Request">
                <header>
                    <button name="action_submit_for_approval" type="object"
                            string="Submit for Approval"
                            class="oe_highlight"
                            invisible="state not in ('draft','changes_required')"/>
                    <button name="action_cto_approve" type="object"
                            string="CTO Approve"
                            invisible="state != 'cto_review'"/>
                    <button name="action_cto_reject" type="object"
                            string="Send Back for Changes"
                            invisible="state != 'cto_review'"/>
                    <button name="action_cfo_approve" type="object"
                            string="CFO Approve"
                            class="oe_highlight"
                            invisible="state != 'cfo_review'"/>
                    <button name="action_cfo_request_changes" type="object"
                            string="Request Changes"
                            invisible="state != 'cfo_review'"/>
                    <button name="action_withdraw" type="object"
                            string="Withdraw"
                            invisible="state not in ('draft','cto_review','cfo_review','changes_required')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,cto_review,cfo_review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phase_id"
                                   options="{'no_create': True}"/>
                            <field name="budget_id" readonly="1"/>
                            <field name="ethara_project_id" readonly="1"/>
                            <field name="request_type"/>
                            <field name="topup_reason_id"
                                   options="{'no_create': True}"
                                   invisible="request_type != 'topup'"/>
                            <field name="priority"/>
                            <field name="sequence_number" readonly="1"/>
                            <field name="revision_no" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="requester_id" readonly="1"/>
                            <field name="requested_total"/>
                            <field name="approved_total"/>
                            <field name="remaining_amount" readonly="1"/>
                            <field name="total_tasks"/>
                            <field name="buffer_pct"/>
                        </group>
                    </group>
                    <group>
                        <button name="action_auto_distribute_approved"
                                type="object"
                                string="Auto-distribute Approved"
                                invisible="state not in ('cto_review','cfo_review')"/>
                    </group>
                    <notebook>
                        <page string="Model Lines" name="model_lines">
                            <field name="model_line_ids">
                                <list editable="bottom">
                                    <field name="ai_model_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="ai_model_name"/>
                                    <field name="cost_type"/>
                                    <field name="per_trajectory_cost"/>
                                    <field name="iterations"/>
                                    <field name="per_task_cost"/>
                                    <field name="requested_amount"/>
                                    <field name="approved_amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Infrastructure Lines" name="infra_lines">
                            <field name="infra_line_ids">
                                <list editable="bottom">
                                    <field name="infra_type_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="description"/>
                                    <field name="instance_type"/>
                                    <field name="quantity"/>
                                    <field name="duration_hours"/>
                                    <field name="unit_price_usd"/>
                                    <field name="ebs_storage_gb"/>
                                    <field name="volume_rate_usd_per_gb_mo"/>
                                    <field name="computed_amount" readonly="1"/>
                                    <field name="requested_amount"/>
                                    <field name="approved_amount"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subscription Lines" name="sub_lines">
                            <field name="subscription_line_ids">
                                <list editable="bottom">
                                    <field name="subscription_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="assigned_user_ids"
                                           widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                    <field name="subscription_count" readonly="1"/>
                                    <field name="final_amount" readonly="1"/>
                                    <field name="requested_amount"/>
                                    <field name="approved_amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Justification &amp; Message" name="justification">
                            <group>
                                <field name="justification"/>
                                <field name="subject"/>
                            </group>
                            <field name="message"/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <field name="attachment_urls"/>
                        </page>
                        <page string="Review Trail" name="review_trail">
                            <group string="CTO Review" invisible="not cto_reviewer_id">
                                <field name="cto_reviewer_id" readonly="1"/>
                                <field name="cto_review_date" readonly="1"/>
                                <field name="cto_review_note" readonly="1"/>
                            </group>
                            <group string="CFO Decision" invisible="not cfo_approver_id">
                                <field name="cfo_approver_id" readonly="1"/>
                                <field name="cfo_approval_date" readonly="1"/>
                                <field name="cfo_change_request_note" readonly="1"/>
                            </group>
                            <group string="Rejection" invisible="not rejection_reason">
                                <field name="rejected_by" readonly="1"/>
                                <field name="rejection_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ethara_project_phase_request" model="ir.actions.act_window">
        <field name="name">Phase Budget Requests</field>
        <field name="res_model">ethara.project.phase.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ethara_project_phase_topup_reason_list" model="ir.ui.view">
        <field name="name">ethara.project.phase.topup.reason.list</field>
        <field name="model">ethara.project.phase.topup.reason</field>
        <field name="arch" type="xml">
            <list string="Phase Top-up Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_ethara_project_phase_topup_reason" model="ir.actions.act_window">
        <field name="name">Top-up Reasons</field>
        <field name="res_model">ethara.project.phase.topup.reason</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
