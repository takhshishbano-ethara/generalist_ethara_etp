<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mm_tasker_run_wizard_form" model="ir.ui.view">
        <field name="name">mm.tasker.run.wizard.form</field>
        <field name="model">mm.tasker.run.wizard</field>
        <field name="arch" type="xml">
            <form string="Run Models">
                <sheet>
                    <div class="alert alert-info" role="status">
                        <i class="fa fa-info-circle me-2"/>
                        <b>Dispatch reference models.</b> Pick how many independent runs each model should perform.
                        Existing runs for this task will be discarded.
                    </div>

                    <field name="task_id" invisible="1"/>
                    <field name="model_1_key" invisible="1"/>
                    <field name="model_2_key" invisible="1"/>
                    <field name="model_3_key" invisible="1"/>

                    <group>
                        <group string="Model 1" invisible="not model_1_key">
                            <field name="model_1_label" readonly="1" string="Model"/>
                            <field name="model_1_runs"/>
                        </group>
                        <group string="Model 2" invisible="not model_2_key">
                            <field name="model_2_label" readonly="1" string="Model"/>
                            <field name="model_2_runs"/>
                        </group>
                        <group string="Model 3" invisible="not model_3_key">
                            <field name="model_3_label" readonly="1" string="Model"/>
                            <field name="model_3_runs"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_dispatch" type="object"
                            string="Dispatch"
                            class="btn-primary"
                            icon="fa-play"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mm_tasker_run_wizard" model="ir.actions.act_window">
        <field name="name">Run Models</field>
        <field name="res_model">mm.tasker.run.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mm_tasker_run_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
