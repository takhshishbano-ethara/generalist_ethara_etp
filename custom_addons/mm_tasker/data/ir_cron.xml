<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Poll the goku service for async /run jobs and ingest finished
             results. No-op in test_mode (runs are scored synchronously and
             carry no external_job_id). Runs every minute; bump the interval
             or deactivate from Settings → Technical → Scheduled Actions. -->
        <record id="cron_poll_jobs" model="ir.cron">
            <field name="name">MM Tasker: Poll service jobs</field>
            <field name="model_id" ref="model_mm_tasker_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_jobs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="datetime.now()"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
