<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============ External resources ============ -->
    <record id="resource_github" model="aurora.showcase.resource">
        <field name="sequence">10</field>
        <field name="label">GitHub</field>
        <field name="title">Harness</field>
        <field name="url">https://github.com/Ethara-Ai/milo-bench</field>
    </record>
    <record id="resource_huggingface" model="aurora.showcase.resource">
        <field name="sequence">20</field>
        <field name="label">HuggingFace</field>
        <field name="title">Dataset</field>
        <field name="url">https://huggingface.co/datasets/ethara/MILO-Bench</field>
    </record>
    <record id="resource_paper" model="aurora.showcase.resource">
        <field name="sequence">30</field>
        <field name="label">Paper</field>
        <field name="title">Research Paper</field>
        <field name="url">https://arxiv.org/abs/2512.18470</field>
    </record>

    <!-- ============ Methodology principles ============ -->
    <record id="methodology_1" model="aurora.showcase.methodology">
        <field name="sequence">10</field>
        <field name="principle_number">1</field>
        <field name="title">Long-Horizon Software Evolution</field>
        <field name="bullet_text">Tasks span multi-step, multi-commit evolution chains across entire repositories
Each trajectory requires understanding of full codebase context and history
60,000 trajectories generated across 10,000 instances</field>
    </record>
    <record id="methodology_2" model="aurora.showcase.methodology">
        <field name="sequence">20</field>
        <field name="principle_number">2</field>
        <field name="title">Production-Grade Reliability</field>
        <field name="bullet_text">Patches must pass CI test suites - no regressions allowed
Cross-file consistency verified across the full dependency graph
Build integrity maintained through the entire evolution chain</field>
    </record>
    <record id="methodology_3" model="aurora.showcase.methodology">
        <field name="sequence">30</field>
        <field name="principle_number">3</field>
        <field name="title">Multi-Language Coverage</field>
        <field name="bullet_text">8 programming languages: Python, JavaScript, TypeScript, Java, C++, Go, Rust, Ruby
Real-world repositories with production codebases
Difficulty calibrated by trajectory length, files touched, and dependency complexity</field>
    </record>
    <record id="methodology_4" model="aurora.showcase.methodology">
        <field name="sequence">40</field>
        <field name="principle_number">4</field>
        <field name="title">Two-Model Evaluation</field>
        <field name="bullet_text">GLM 5 and Kimi K2.5 evaluated head-to-head
Each model gets exactly one attempt per instance (Pass@1)
No retries - measures true first-attempt evolution capability</field>
    </record>

    <!-- ============ Pipeline steps ============ -->
    <record id="pipeline_step_1" model="aurora.showcase.pipeline.step">
        <field name="sequence">10</field>
        <field name="phase">1</field>
        <field name="title">Environment Setup</field>
        <field name="bullet_text">Crawl 500+ repos, identify post-cutoff PR sequences
Build JSONL dataset with instance metadata
Construct hermetic Docker images per instance (base → PR image)
Generate run results and test baselines</field>
    </record>
    <record id="pipeline_step_2" model="aurora.showcase.pipeline.step">
        <field name="sequence">20</field>
        <field name="phase">2</field>
        <field name="title">Agent Interaction</field>
        <field name="bullet_text">Run AI agents in sandboxed Docker environments
2 models × 3 seeds × 10,000 instances
Agents receive issue context and produce git diff patches
Tool-use interaction across long-horizon sequences</field>
    </record>
    <record id="pipeline_step_3" model="aurora.showcase.pipeline.step">
        <field name="sequence">30</field>
        <field name="phase">3</field>
        <field name="title">Evaluation &amp; Scoring</field>
        <field name="bullet_text">Apply model patches to clean repo checkouts
Evaluate against full test suite in hermetic containers
Produce pass@k summaries per instance
Grade resolution verdicts across all trajectories</field>
    </record>

    <!-- ============ Per-model summary stats ============ -->
    <record id="model_stat_kimi" model="aurora.showcase.model.stat">
        <field name="sequence">10</field>
        <field name="key">kimi</field>
        <field name="name">Kimi K2.5</field>
        <field name="overall_pass_rate">36.4%</field>
        <field name="short_trajectories">49.7%</field>
        <field name="long_trajectories">23.1%</field>
        <field name="avg_cost_per_instance">~$0.06</field>
    </record>
    <record id="model_stat_glm5" model="aurora.showcase.model.stat">
        <field name="sequence">20</field>
        <field name="key">glm5</field>
        <field name="name">GLM 5</field>
        <field name="overall_pass_rate">31.2%</field>
        <field name="short_trajectories">44.5%</field>
        <field name="long_trajectories">18.9%</field>
        <field name="avg_cost_per_instance">~$0.04</field>
    </record>

</odoo>
