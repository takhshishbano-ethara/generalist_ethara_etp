<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fenrir_phase_view_list" model="ir.ui.view">
        <field name="name">fenrir.phase.list</field>
        <field name="model">fenrir.phase</field>
        <field name="arch" type="xml">
            <list string="Phases" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="task_count" string="Tasks"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="fenrir_phase_view_form" model="ir.ui.view">
        <field name="name">fenrir.phase.form</field>
        <field name="model">fenrir.phase</field>
        <field name="arch" type="xml">
            <form string="Phase">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo"
                                   string="Tasks"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Phase"/>
                        <h1>
                            <field name="name" placeholder="e.g. Phase 1.5"/>
                        </h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="is_default"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fenrir_phase_view_search" model="ir.ui.view">
        <field name="name">fenrir.phase.search</field>
        <field name="model">fenrir.phase</field>
        <field name="arch" type="xml">
            <search string="Phases">
                <field name="name"/>
                <filter string="Default" name="filter_default"
                        domain="[('is_default','=',True)]"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="fenrir_phase_action" model="ir.actions.act_window">
        <field name="name">Phases</field>
        <field name="res_model">fenrir.phase</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first delivery phase
            </p>
            <p>
                Define the delivery phases (Phase 1, Phase 1.5, Phase 2, ...)
                used to organize tasks. Flag one as the default to preselect it
                on new tasks.
            </p>
        </field>
    </record>

</odoo>
