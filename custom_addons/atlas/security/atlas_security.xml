<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_atlas_build" model="ir.module.category">
            <field name="name">Atlas Build</field>
            <field name="description">Atlas — GLM 5 task management with sandbox environments</field>
            <field name="sequence">33</field>
        </record>

        <!-- Privilege (Odoo 19 pattern) -->
        <record id="res_groups_privilege_atlas_build" model="res.groups.privilege">
            <field name="name">Atlas Build</field>
            <field name="sequence">33</field>
            <field name="category_id" ref="module_category_atlas_build"/>
        </record>

    </data>

    <data noupdate="1">

        <!-- User Group -->
        <record id="group_atlas_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_atlas_build"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view builds and trigger builds for registered apps.</field>
        </record>

        <!-- Admin Group (implies User) -->
        <record id="group_atlas_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="res_groups_privilege_atlas_build"/>
            <field name="implied_ids" eval="[(4, ref('group_atlas_user'))]"/>
            <field name="comment">Full access: manage apps, builds, and configuration.</field>
        </record>

        <!-- ===== Record Rules: Atlas Task ===== -->
        <record id="atlas_task_rule_tasker" model="ir.rule">
            <field name="name">Atlas Task: Tasker sees own</field>
            <field name="model_id" ref="model_atlas_atlas"/>
            <field name="groups" eval="[(4, ref('etp_user_roles.group_tasker'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="atlas_task_rule_ql" model="ir.rule">
            <field name="name">Atlas Task: QL sees all</field>
            <field name="model_id" ref="model_atlas_atlas"/>
            <field name="groups" eval="[(4, ref('etp_user_roles.group_quality_lead'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="atlas_task_rule_admin" model="ir.rule">
            <field name="name">Atlas Task: Admin sees all</field>
            <field name="model_id" ref="model_atlas_atlas"/>
            <field name="groups" eval="[(4, ref('group_atlas_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ===== Record Rules: Atlas Turn ===== -->
        <record id="atlas_turn_rule_tasker" model="ir.rule">
            <field name="name">Atlas Turn: Tasker sees own</field>
            <field name="model_id" ref="model_atlas_turn"/>
            <field name="groups" eval="[(4, ref('etp_user_roles.group_tasker'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="atlas_turn_rule_ql" model="ir.rule">
            <field name="name">Atlas Turn: QL sees all</field>
            <field name="model_id" ref="model_atlas_turn"/>
            <field name="groups" eval="[(4, ref('etp_user_roles.group_quality_lead'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="atlas_turn_rule_admin" model="ir.rule">
            <field name="name">Atlas Turn: Admin sees all</field>
            <field name="model_id" ref="model_atlas_turn"/>
            <field name="groups" eval="[(4, ref('group_atlas_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ===== Record Rules: Atlas Sandbox ===== -->
        <record id="atlas_sandbox_rule_tasker" model="ir.rule">
            <field name="name">Atlas Sandbox: Tasker sees own</field>
            <field name="model_id" ref="model_atlas_sandbox"/>
            <field name="groups" eval="[(4, ref('etp_user_roles.group_tasker'))]"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="atlas_sandbox_rule_ql" model="ir.rule">
            <field name="name">Atlas Sandbox: QL sees all</field>
            <field name="model_id" ref="model_atlas_sandbox"/>
            <field name="groups" eval="[(4, ref('etp_user_roles.group_quality_lead'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="atlas_sandbox_rule_admin" model="ir.rule">
            <field name="name">Atlas Sandbox: Admin sees all</field>
            <field name="model_id" ref="model_atlas_sandbox"/>
            <field name="groups" eval="[(4, ref('group_atlas_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
