<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="atlas.GoalGenerationStatus">
        <div class="o_atlas_goal_status">
            <t t-if="isGenerating">
                <div class="o_generation_progress mb-2">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="fa fa-spinner fa-spin text-primary"/>
                        <span class="small fw-bold text-primary">
                            <t t-out="statusLabel"/>
                        </span>
                    </div>
                    <div class="d-flex gap-2">
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="small text-muted">Goal</span>
                                <span class="small" t-att-class="goalDone ? 'text-success' : 'text-primary'">
                                    <t t-if="goalDone"><i class="fa fa-check me-1"/>Done</t>
                                    <t t-else="">Generating…</t>
                                </span>
                            </div>
                            <div class="progress" style="height: 4px;">
                                <div t-att-class="'progress-bar ' + (goalDone ? 'bg-success' : 'progress-bar-striped progress-bar-animated bg-primary')"
                                     t-att-style="'width: ' + (goalDone ? '100' : '100') + '%'"/>
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="small text-muted">Rubric</span>
                                <span class="small" t-att-class="rubricDone ? 'text-success' : 'text-primary'">
                                    <t t-if="rubricDone"><i class="fa fa-check me-1"/>Done</t>
                                    <t t-else="">Generating…</t>
                                </span>
                            </div>
                            <div class="progress" style="height: 4px;">
                                <div t-att-class="'progress-bar ' + (rubricDone ? 'bg-success' : 'progress-bar-striped progress-bar-animated bg-primary')"
                                     t-att-style="'width: ' + (rubricDone ? '100' : '100') + '%'"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
