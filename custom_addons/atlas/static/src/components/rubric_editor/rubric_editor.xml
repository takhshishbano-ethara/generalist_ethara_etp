<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="atlas.RubricEditor">
        <div class="o_atlas_rubric_editor">
            <t t-if="state.loading">
                <div class="text-center py-3 text-muted">
                    <i class="fa fa-spinner fa-spin me-1"/> Loading criteria…
                </div>
            </t>
            <t t-elif="!taskId">
                <div class="text-muted py-3 text-center">Save the task first to add criteria.</div>
            </t>
            <t t-else="">
                <t t-if="isGenerating">
                    <div class="o_generation_progress mb-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fa fa-spinner fa-spin text-primary"/>
                            <span class="small fw-bold text-primary">
                                <t t-if="state.goalStatus === 'running' and state.rubricStatus !== 'running'">
                                    Generating goal description…
                                </t>
                                <t t-elif="state.rubricStatus === 'running' and state.goalStatus !== 'running'">
                                    Generating rubric criteria…
                                </t>
                                <t t-else="">
                                    Generating goal &amp; rubric criteria…
                                </t>
                            </span>
                        </div>
                        <div class="progress" style="height: 4px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width: 100%"/>
                        </div>
                    </div>
                </t>

                <!-- Select Rubrics Popup Button -->
                <t t-if="state.criteria.length and !isGenerating">
                    <div class="mb-2">
                        <button class="btn btn-sm btn-outline-info w-100"
                                t-on-click="onOpenRubricPopup">
                            <i class="fa fa-list-ul me-1"/> Select Rubrics
                        </button>
                    </div>
                </t>

                <t t-if="state.criteria.length">
                    <div class="o_atlas_rubric_cards">
                        <t t-foreach="state.criteria" t-as="c" t-key="c.id">
                            <t t-if="state.editingId === c.id">
                                <t t-call="atlas.RubricEditor.InlineForm"/>
                            </t>
                            <t t-else="">
                                <div class="o_atlas_rubric_card"
                                     t-att-class="{'o_negative': c.is_negative}">
                                    <div class="o_card_header d-flex align-items-start gap-2">
                                        <div class="o_importance_dot"
                                             t-att-style="'background:' + importanceColor(c.importance)"
                                             t-att-title="importanceLabel(c.importance)"/>
                                        <div class="flex-grow-1">
                                            <div class="o_card_title"><t t-out="c.name"/></div>
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                <span class="o_cat_badge"
                                                      t-att-style="'background:' + categoryMeta(c.category).color + '20; color:' + categoryMeta(c.category).color">
                                                    <i t-att-class="'fa ' + categoryMeta(c.category).icon + ' me-1'"/>
                                                    <t t-out="categoryMeta(c.category).label"/>
                                                </span>
                                                <span class="o_importance_badge"
                                                      t-att-style="'background:' + importanceColor(c.importance) + '20; color:' + importanceColor(c.importance)">
                                                    <t t-out="importanceLabel(c.importance)"/>
                                                </span>
                                                <t t-if="c.is_negative">
                                                    <span class="badge bg-danger">Negative</span>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="o_card_actions d-flex gap-1">
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    t-on-click="() => this.onQcCheck(c.id)"
                                                    t-att-disabled="c.qc_status === 'running'"
                                                    title="QC Check">
                                                <i t-att-class="'fa ' + (c.qc_status === 'running' ? 'fa-spinner fa-spin' : 'fa-check-square-o')"/>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    t-on-click="() => this.onEditCriteria(c.id)"
                                                    title="Edit">
                                                <i class="fa fa-pencil"/>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    t-on-click="() => this.onDeleteCriteria(c.id)"
                                                    title="Delete">
                                                <i class="fa fa-trash"/>
                                            </button>
                                        </div>
                                    </div>

                                    <t t-if="c.suggestion">
                                        <div class="o_card_suggestion mt-2">
                                            <i class="fa fa-lightbulb-o me-1"/><t t-out="c.suggestion"/>
                                        </div>
                                    </t>

                                    <t t-if="c.category === 'other'">
                                        <div class="o_card_custom_cat mt-1">
                                            <i class="fa fa-tag me-1"/>Criteria: <t t-out="c.custom_category || 'General'"/>
                                        </div>
                                    </t>

                                    <t t-if="c.levels and c.levels.length">
                                        <div class="o_card_levels mt-2 d-flex flex-wrap gap-1">
                                            <t t-foreach="c.levels" t-as="lv" t-key="lv.id || lv_index">
                                                <span class="o_level_chip"
                                                      t-att-class="{
                                                          'o_level_zero': lv.score === 0,
                                                          'o_level_mid': lv.score > 0 and lv.score &lt; (c.levels.length - 1),
                                                          'o_level_max': lv.score === (c.levels.length - 1),
                                                      }">
                                                    <strong><t t-out="lv.score"/></strong>
                                                    <t t-if="lv.label"> — <t t-out="lv.label"/></t>
                                                </span>
                                            </t>
                                        </div>
                                    </t>

                                    <t t-if="c.qc_status === 'done' or c.qc_status === 'error'">
                                        <div class="o_qc_result mt-2"
                                             t-att-class="{
                                                 'o_qc_pass': c.qc_severity === 'low',
                                                 'o_qc_warn': c.qc_severity === 'medium',
                                                 'o_qc_fail': c.qc_severity === 'high' or c.qc_severity === 'critical',
                                                 'o_qc_error': c.qc_status === 'error',
                                             }">
                                            <div class="d-flex align-items-center gap-1 mb-1">
                                                <i t-att-class="'fa me-1 ' + qcStatusIcon(c.qc_status)"/>
                                                <t t-if="c.qc_severity">
                                                    <span class="o_qc_severity_badge"
                                                          t-att-class="{
                                                              'o_severity_low': c.qc_severity === 'low',
                                                              'o_severity_medium': c.qc_severity === 'medium',
                                                              'o_severity_high': c.qc_severity === 'high',
                                                              'o_severity_critical': c.qc_severity === 'critical',
                                                          }">
                                                        <t t-out="c.qc_severity.toUpperCase()"/>
                                                    </span>
                                                </t>
                                            </div>
                                            <t t-if="c.qc_feedback">
                                                <div class="o_qc_feedback_body" t-out="formatQcFeedback(c.qc_feedback)"/>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <t t-if="!isGenerating">
                        <div class="text-muted small py-2 text-center">No criteria defined yet.</div>
                    </t>
                </t>

                <t t-if="state.inlineAdd">
                    <t t-call="atlas.RubricEditor.InlineForm"/>
                </t>

                <t t-if="!state.inlineAdd and state.editingId === null">
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-outline-primary btn-sm flex-grow-1"
                                t-on-click="onAddCriteria">
                            <i class="fa fa-plus me-1"/> Add criteria
                        </button>
                        <button class="btn btn-outline-info btn-sm"
                                t-on-click="onQcAll"
                                t-att-disabled="state.rubricQcStatus === 'running' or !state.criteria.length"
                                title="Holistic QC of the full rubric (coverage, weights, gaps, overlaps)">
                            <i t-att-class="'fa me-1 ' + (state.rubricQcStatus === 'running' ? 'fa-spinner fa-spin' : 'fa-shield')"/>
                            QC All Criteria
                        </button>
                    </div>
                </t>

                <t t-if="state.rubricQcStatus !== 'idle'">
                    <div class="o_atlas_rubric_qc_all mt-3"
                         t-att-class="'o_atlas_rubric_qc_all o_atlas_rubric_qc_all_' + state.rubricQcStatus">
                        <div class="o_atlas_rubric_qc_all_head" t-on-click="toggleRubricQcDetails">
                            <t t-if="state.rubricQcStatus === 'running'">
                                <i class="fa fa-spinner fa-spin me-2"/>
                                <span class="fw-semibold">Evaluating rubric…</span>
                            </t>
                            <t t-elif="state.rubricQcStatus === 'error'">
                                <i class="fa fa-exclamation-triangle me-2 text-danger"/>
                                <span class="fw-semibold">Rubric QC failed</span>
                            </t>
                            <t t-elif="state.rubricQcStatus === 'done'">
                                <i class="fa fa-shield me-2"/>
                                <span class="fw-semibold">Rubric QC</span>
                                <t t-if="state.rubricQcSeverity">
                                    <span class="o_atlas_rubric_qc_all_pill ms-2"
                                          t-att-style="'background: ' + rubricQcSeverityColor + ';'">
                                        <t t-esc="state.rubricQcSeverity.toUpperCase()"/>
                                    </span>
                                </t>
                                <i class="fa ms-auto"
                                   t-att-class="state.rubricQcExpanded ? 'fa-chevron-up' : 'fa-chevron-down'"/>
                            </t>
                        </div>
                        <t t-if="state.rubricQcStatus !== 'running' and state.rubricQcExpanded and state.rubricQcFeedback">
                            <div class="o_atlas_rubric_qc_all_body">
                                <div class="o_atlas_rubric_qc_all_feedback"
                                     t-out="formatQcFeedback(state.rubricQcFeedback)"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>

            <!-- Rubric Selection Popup -->
            <t t-if="state.showRubricPopup">
                <t t-call="atlas.RubricEditor.RubricPopup"/>
            </t>
        </div>
    </t>

    <t t-name="atlas.RubricEditor.InlineForm">
        <div class="o_atlas_rubric_card o_inline_form">
            <div class="mb-2">
                <input type="text" class="form-control form-control-sm"
                       t-att-value="state.form.name"
                       t-on-input="(ev) => state.form.name = ev.target.value"
                       placeholder="Describe what this criterion measures"/>
            </div>

            <div class="d-flex gap-2 mb-2 flex-wrap">
                <select class="form-select form-select-sm"
                        style="max-width: 200px;"
                        t-on-change="(ev) => state.form.category = ev.target.value">
                    <option value="factuality_hallucination" t-att-selected="state.form.category === 'factuality_hallucination'">Factuality &amp; Hallucination</option>
                    <option value="task_completion" t-att-selected="state.form.category === 'task_completion'">Task Completion</option>
                    <option value="instruction_following" t-att-selected="state.form.category === 'instruction_following'">Instruction Following</option>
                    <option value="communication_style" t-att-selected="state.form.category === 'communication_style'">Communication Style</option>
                    <option value="other" t-att-selected="state.form.category === 'other'">Other</option>
                </select>
                <select class="form-select form-select-sm"
                        style="max-width: 200px;"
                        t-on-change="(ev) => state.form.importance = ev.target.value">
                    <option value="">Importance</option>
                    <option value="critically_detrimental" t-att-selected="state.form.importance === 'critically_detrimental'">⬤ Critically Detrimental</option>
                    <option value="detrimental" t-att-selected="state.form.importance === 'detrimental'">⬤ Detrimental</option>
                    <option value="slightly_detrimental" t-att-selected="state.form.importance === 'slightly_detrimental'">⬤ Slightly Detrimental</option>
                    <option value="slightly_important" t-att-selected="state.form.importance === 'slightly_important'">⬤ Slightly Important</option>
                    <option value="important" t-att-selected="state.form.importance === 'important'">⬤ Important</option>
                    <option value="critically_important" t-att-selected="state.form.importance === 'critically_important'">⬤ Critically Important</option>
                </select>
            </div>

            <t t-if="state.form.category === 'other'">
                <div class="mb-2">
                    <input type="text" class="form-control form-control-sm"
                           t-att-value="state.form.custom_category"
                           t-on-input="(ev) => state.form.custom_category = ev.target.value"
                           placeholder="Specify custom criteria category (e.g. Safety, Domain Knowledge, Code Quality)"/>
                </div>
            </t>

            <div class="mb-2">
                <textarea class="form-control form-control-sm o_suggestion_input"
                          rows="2"
                          t-att-value="state.form.suggestion"
                          t-on-input="(ev) => state.form.suggestion = ev.target.value"
                          placeholder="Scoring suggestion — how to grade True/False for this criterion"/>
            </div>

            <div class="mb-2">
                <label class="form-label small fw-bold mb-1">Scoring Levels</label>
                <div class="o_atlas_rubric_levels">
                    <t t-foreach="state.form.levels" t-as="level" t-key="level_index">
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <span class="badge bg-secondary rounded-circle d-flex align-items-center justify-content-center"
                                  style="width: 24px; height: 24px; font-size: 11px;">
                                <t t-out="level.score"/>
                            </span>
                            <input type="text" class="form-control form-control-sm"
                                   t-att-value="level.label"
                                   t-on-input="(ev) => level.label = ev.target.value"
                                   t-att-placeholder="level.score === 0 ? 'Not Fulfilled' : level.score === 1 ? 'Partially Fulfilled' : 'Fulfilled'"/>
                            <button class="btn btn-sm btn-outline-secondary"
                                    t-on-click="() => this.onRemoveLevel(level_index)"
                                    t-att-disabled="state.form.levels.length &lt;= 2"
                                    title="Remove level">
                                <i class="fa fa-minus"/>
                            </button>
                        </div>
                    </t>
                </div>
                <button class="btn btn-link btn-sm p-0 mt-1" t-on-click="onAddLevel">
                    <i class="fa fa-plus me-1"/> Add level
                </button>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary btn-sm"
                        t-on-click="state.editingId ? onCancelEdit.bind(this) : onCancelInline.bind(this)">
                    Cancel
                </button>
                <button class="btn btn-primary btn-sm" t-on-click="onSaveCriteria">
                    Save
                </button>
            </div>
        </div>
    </t>

    <t t-name="atlas.RubricEditor.RubricPopup">
        <div class="o_rubric_popup_overlay" t-on-click="onCloseRubricPopup">
            <div class="o_rubric_popup_dialog" t-on-click.stop="">
                <div class="o_rubric_popup_header d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">
                        <t t-if="state.popupStep === 1">
                            <i class="fa fa-list-ul me-2"/>Select Rubrics
                        </t>
                        <t t-elif="state.popupStep === 2">
                            <i class="fa fa-star me-2"/>Assign Scores
                        </t>
                        <t t-else="">
                            Ran your rubric against <t t-out="getSelectedCriteria().length"/> criteria
                        </t>
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        <t t-if="state.popupStep !== 3">
                            <span class="badge bg-secondary">Step <t t-out="state.popupStep"/> of 3</span>
                        </t>
                        <button class="btn btn-sm btn-close" t-on-click="onCloseRubricPopup"/>
                    </div>
                </div>

                <!-- Step 1: Select Rubrics -->
                <t t-if="state.popupStep === 1">
                    <div class="o_rubric_popup_body o_rqc_body">
                        <t t-if="!state.criteria.length">
                            <div class="text-muted text-center py-3">No rubric criteria available.</div>
                        </t>
                        <t t-else="">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <p class="text-muted small mb-0">Choose which rubrics to score in the next step.</p>
                                <t t-if="state.selectedRubricIds.length &lt; state.criteria.length">
                                    <button class="btn btn-sm o_rqc_ghost_btn" t-on-click="onSelectAllRubrics">
                                        <i class="fa fa-check-square-o me-1"/> Select All
                                    </button>
                                </t>
                                <t t-else="">
                                    <button class="btn btn-sm o_rqc_ghost_btn" t-on-click="onDeselectAllRubrics">
                                        <i class="fa fa-square-o me-1"/> Deselect All
                                    </button>
                                </t>
                            </div>
                            <div class="o_rqc_list">
                                <t t-foreach="state.criteria" t-as="c" t-key="c.id">
                                    <div class="o_rqc_card o_rqc_select_card"
                                         t-att-class="{ 'o_rqc_accepted': isRubricSelected(c.id) }"
                                         t-on-click="() => this.onToggleRubricSelection(c.id)">
                                        <div class="o_rqc_card_main">
                                            <div class="o_rqc_headline">
                                                <t t-out="c.name"/>
                                            </div>
                                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                                <span class="o_rqc_category_chip">
                                                    <i t-att-class="'fa ' + categoryMeta(c.category).icon + ' me-1'"/>
                                                    <t t-out="categoryMeta(c.category).label"/>
                                                </span>
                                                <span class="o_rqc_importance_chip"
                                                      t-att-style="'background:' + importanceColor(c.importance) + '20; color:' + importanceColor(c.importance)">
                                                    <t t-out="importanceLabel(c.importance)"/>
                                                </span>
                                                <t t-if="c.is_negative">
                                                    <span class="o_rqc_chip_danger">Negative</span>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="o_rqc_card_actions">
                                            <input type="checkbox"
                                                   class="o_rqc_select_checkbox"
                                                   t-att-checked="isRubricSelected(c.id)"
                                                   t-on-click.stop="() => this.onToggleRubricSelection(c.id)"/>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                    <div class="o_rubric_popup_footer o_rqc_footer d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <span class="text-muted small">
                            <strong><t t-out="state.selectedRubricIds.length"/></strong> of <t t-out="state.criteria.length"/> selected
                        </span>
                        <button class="btn btn-sm o_rqc_submit_btn" t-on-click="onGoToScoring"
                                t-att-disabled="!state.selectedRubricIds.length">
                            Next: Assign Scores <i class="fa fa-arrow-right ms-1"/>
                        </button>
                    </div>
                </t>

                <!-- Step 2: Assign Scores -->
                <t t-if="state.popupStep === 2">
                    <div class="o_rubric_popup_body o_rqc_body">
                        <p class="text-muted small mb-3">Select a scoring level for each rubric.</p>
                        <div class="o_rqc_list">
                            <t t-foreach="getSelectedCriteria()" t-as="c" t-key="c.id">
                                <div class="o_rqc_card o_rqc_score_card">
                                    <div class="o_rqc_card_main">
                                        <div class="o_rqc_headline">
                                            <t t-out="c.name"/>
                                        </div>
                                        <div>
                                            <span class="o_rqc_category_chip">
                                                <i t-att-class="'fa ' + categoryMeta(c.category).icon + ' me-1'"/>
                                                <t t-out="categoryMeta(c.category).label"/>
                                            </span>
                                        </div>

                                        <div class="o_rqc_levels_panel">
                                            <div class="o_rqc_criterion_label">Choose a score:</div>
                                            <t t-if="c.levels and c.levels.length">
                                                <t t-foreach="c.levels" t-as="lv" t-key="lv.id || lv_index">
                                                    <t t-set="isPicked" t-value="getRubricScore(c.id) === lv.score"/>
                                                    <div class="o_rqc_level_row o_rqc_level_clickable"
                                                         t-att-class="{ 'o_rqc_level_active': isPicked }"
                                                         t-on-click="() => this.onSetRubricScore(c.id, lv.score)">
                                                        <span class="o_rqc_level_circle"
                                                              t-att-class="{ 'o_rqc_level_circle_active': isPicked }">
                                                            <t t-out="lv.score"/>
                                                        </span>
                                                        <span class="o_rqc_level_label">
                                                            <t t-if="lv.label"><t t-out="lv.label"/></t>
                                                            <t t-else="">\u2014</t>
                                                        </span>
                                                    </div>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <span class="text-muted small">No scoring levels defined</span>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="o_rubric_popup_footer o_rqc_footer d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <button class="btn btn-sm o_rqc_ghost_btn" t-on-click="onBackToSelection">
                            <i class="fa fa-arrow-left me-1"/> Back
                        </button>
                        <button class="btn btn-sm o_rqc_submit_btn" t-on-click="onGoToJudgement">
                            Next: Review Judgement <i class="fa fa-arrow-right ms-1"/>
                        </button>
                    </div>
                </t>

                <!-- Step 3: LLM-judged review of your scores -->
                <t t-if="state.popupStep === 3">
                    <div class="o_rubric_popup_body o_rqc_body">
                        <p class="text-muted small mb-3">
                            The AI has reviewed each of your scores against the session's responses. A tick means your score matches the evidence; a cross means it does not.
                        </p>
                        <div class="o_rqc_list">
                            <t t-foreach="getSelectedCriteria()" t-as="c" t-key="c.id">
                                <t t-set="j" t-value="getJudgement(c.id)"/>
                                <t t-set="userScore" t-value="getRubricScore(c.id)"/>
                                <div class="o_rqc_card"
                                     t-att-class="{
                                        'o_rqc_accepted': j and !j.loading and !j.error and j.verdict === 'CORRECT',
                                        'o_rqc_rejected': j and !j.loading and !j.error and j.verdict === 'INCORRECT',
                                        'o_rqc_error': j and j.error,
                                     }">
                                    <div class="o_rqc_card_main">
                                        <div class="o_rqc_headline">
                                            You scored a
                                            <span class="o_rqc_score_pill">
                                                <t t-out="userScore"/>
                                            </span>
                                            on this criteria
                                        </div>

                                        <div class="o_rqc_levels_panel">
                                            <t t-if="c.name">
                                                <div class="o_rqc_criterion_label">
                                                    <t t-out="c.name"/>
                                                </div>
                                            </t>
                                            <t t-if="c.levels and c.levels.length">
                                                <t t-foreach="c.levels" t-as="lv" t-key="lv.id || lv_index">
                                                    <t t-set="isUserPick" t-value="userScore === lv.score"/>
                                                    <div class="o_rqc_level_row"
                                                         t-att-class="{ 'o_rqc_level_active': isUserPick }">
                                                        <span class="o_rqc_level_circle"
                                                              t-att-class="{ 'o_rqc_level_circle_active': isUserPick }">
                                                            <t t-out="lv.score"/>
                                                        </span>
                                                        <span class="o_rqc_level_label">
                                                            <t t-if="lv.label"><t t-out="lv.label"/></t>
                                                            <t t-else="">—</t>
                                                        </span>
                                                        <t t-if="isUserPick">
                                                            <span class="o_rqc_level_badge o_rqc_level_badge_user">Your pick</span>
                                                        </t>
                                                    </div>
                                                </t>
                                            </t>
                                        </div>

                                        <div class="o_rqc_category_chip">
                                            <i t-att-class="'fa ' + categoryMeta(c.category).icon + ' me-1'"/>
                                            <t t-out="categoryMeta(c.category).label"/>
                                        </div>

                                        <t t-if="!j or j.loading">
                                            <div class="o_rqc_judge_status_loading">
                                                <i class="fa fa-spinner fa-spin me-2"/>
                                                <span>AI is reviewing against the session response…</span>
                                            </div>
                                        </t>
                                        <t t-elif="j.error">
                                            <div class="o_rqc_judge_status_error">
                                                <i class="fa fa-exclamation-triangle me-1"/>
                                                <t t-out="j.error"/>
                                            </div>
                                        </t>
                                        <t t-elif="j.verdict === 'CORRECT'">
                                            <div class="o_rqc_verdict_panel o_rqc_verdict_correct">
                                                <div class="o_rqc_verdict_header">
                                                    <span class="o_rqc_verdict_icon o_rqc_verdict_icon_correct">
                                                        <i class="fa fa-check"/>
                                                    </span>
                                                    <span class="o_rqc_verdict_label">AI agrees with your score</span>
                                                </div>
                                                <t t-if="j.why_correct">
                                                    <div class="o_rqc_verdict_body">
                                                        <t t-out="j.why_correct"/>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="o_rqc_verdict_panel o_rqc_verdict_incorrect">
                                                <div class="o_rqc_verdict_header">
                                                    <span class="o_rqc_verdict_icon o_rqc_verdict_icon_incorrect">
                                                        <i class="fa fa-times"/>
                                                    </span>
                                                    <span class="o_rqc_verdict_label">
                                                        AI disagrees
                                                        <t t-if="j.expected_score !== null and j.expected_score !== undefined">
                                                            — expected
                                                            <span class="o_rqc_verdict_expected"><t t-out="j.expected_score"/></span>
                                                        </t>
                                                    </span>
                                                </div>
                                                <t t-if="j.why_wrong">
                                                    <div class="o_rqc_verdict_body">
                                                        <t t-out="j.why_wrong"/>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                    </div>

                                    <div class="o_rqc_card_actions">
                                        <t t-if="j and !j.loading and !j.error">
                                            <div class="o_rqc_verdict_badge"
                                                 t-att-class="j.verdict === 'CORRECT' ? 'o_rqc_verdict_badge_correct' : 'o_rqc_verdict_badge_incorrect'"
                                                 t-att-title="j.verdict === 'CORRECT' ? 'AI marked this correct' : 'AI marked this incorrect'">
                                                <i t-att-class="'fa ' + (j.verdict === 'CORRECT' ? 'fa-check' : 'fa-times')"/>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="o_rqc_verdict_badge o_rqc_verdict_badge_pending">
                                                <i class="fa fa-spinner fa-spin"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="o_rubric_popup_footer o_rqc_footer d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <button class="btn btn-sm o_rqc_ghost_btn" t-on-click="onBackToScoring"
                                t-att-disabled="state.judgementsLoading">
                            <i class="fa fa-arrow-left me-1"/> Back
                        </button>
                        <div class="d-flex align-items-center gap-3">
                            <t t-if="state.judgementsLoading">
                                <span class="o_rqc_hint small">
                                    <i class="fa fa-spinner fa-spin me-1"/>Running AI review…
                                </span>
                            </t>
                            <t t-else="">
                                <span class="o_rqc_autosave_hint small">
                                    <i class="fa fa-check-circle me-1"/>Saved automatically
                                </span>
                            </t>
                            <button class="btn btn-sm o_rqc_ghost_btn"
                                    t-on-click="onRefreshJudgements"
                                    t-att-disabled="state.judgementsLoading">
                                <i class="fa fa-refresh me-1"/> Re-run AI review
                            </button>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
