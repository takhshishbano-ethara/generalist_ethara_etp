<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="atlas.RubricEditor">
        <div class="o_atlas_rubric_editor">
            <t t-if="state.loading">
                <div class="text-center py-3 text-muted">
                    <i class="fa fa-spinner fa-spin me-1"/> Loading criteria…
                </div>
            </t>
            <t t-elif="!taskId">
                <div class="text-muted py-3 text-center">Save the task first to add criteria.</div>
            </t>
            <t t-else="">
                <t t-if="isGenerating">
                    <div class="o_generation_progress mb-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fa fa-spinner fa-spin text-primary"/>
                            <span class="small fw-bold text-primary">
                                <t t-if="state.goalStatus === 'running' and state.rubricStatus !== 'running'">
                                    Generating goal description…
                                </t>
                                <t t-elif="state.rubricStatus === 'running' and state.goalStatus !== 'running'">
                                    Generating rubric criteria…
                                </t>
                                <t t-else="">
                                    Generating goal &amp; rubric criteria…
                                </t>
                            </span>
                        </div>
                        <div class="progress" style="height: 4px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width: 100%"/>
                        </div>
                    </div>
                </t>

                <t t-if="state.criteria.length">
                    <div class="o_atlas_rubric_cards">
                        <t t-foreach="state.criteria" t-as="c" t-key="c.id">
                            <t t-if="state.editingId === c.id">
                                <t t-call="atlas.RubricEditor.InlineForm"/>
                            </t>
                            <t t-else="">
                                <div class="o_atlas_rubric_card"
                                     t-att-class="{'o_negative': c.is_negative}">
                                    <div class="o_card_header d-flex align-items-start gap-2">
                                        <div class="o_importance_dot"
                                             t-att-style="'background:' + importanceColor(c.importance)"
                                             t-att-title="importanceLabel(c.importance)"/>
                                        <div class="flex-grow-1">
                                            <div class="o_card_title"><t t-out="c.name"/></div>
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                <span class="o_cat_badge"
                                                      t-att-style="'background:' + categoryMeta(c.category).color + '20; color:' + categoryMeta(c.category).color">
                                                    <i t-att-class="'fa ' + categoryMeta(c.category).icon + ' me-1'"/>
                                                    <t t-out="categoryMeta(c.category).label"/>
                                                </span>
                                                <span class="o_importance_badge"
                                                      t-att-style="'background:' + importanceColor(c.importance) + '20; color:' + importanceColor(c.importance)">
                                                    <t t-out="importanceLabel(c.importance)"/>
                                                </span>
                                                <t t-if="c.is_negative">
                                                    <span class="badge bg-danger">Negative</span>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="o_card_actions d-flex gap-1">
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    t-on-click="() => this.onQcCheck(c.id)"
                                                    t-att-disabled="c.qc_status === 'running'"
                                                    title="QC Check">
                                                <i t-att-class="'fa ' + (c.qc_status === 'running' ? 'fa-spinner fa-spin' : 'fa-check-square-o')"/>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    t-on-click="() => this.onEditCriteria(c.id)"
                                                    title="Edit">
                                                <i class="fa fa-pencil"/>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    t-on-click="() => this.onDeleteCriteria(c.id)"
                                                    title="Delete">
                                                <i class="fa fa-trash"/>
                                            </button>
                                        </div>
                                    </div>

                                    <t t-if="c.suggestion">
                                        <div class="o_card_suggestion mt-2">
                                            <i class="fa fa-lightbulb-o me-1"/><t t-out="c.suggestion"/>
                                        </div>
                                    </t>

                                    <t t-if="c.category === 'other' and c.custom_category">
                                        <div class="o_card_custom_cat mt-1">
                                            <i class="fa fa-tag me-1"/>Criteria: <t t-out="c.custom_category"/>
                                        </div>
                                    </t>

                                    <t t-if="c.levels and c.levels.length">
                                        <div class="o_card_levels mt-2 d-flex flex-wrap gap-1">
                                            <t t-foreach="c.levels" t-as="lv" t-key="lv.id || lv_index">
                                                <span class="o_level_chip"
                                                      t-att-class="{
                                                          'o_level_zero': lv.score === 0,
                                                          'o_level_mid': lv.score > 0 and lv.score &lt; (c.levels.length - 1),
                                                          'o_level_max': lv.score === (c.levels.length - 1),
                                                      }">
                                                    <strong><t t-out="lv.score"/></strong>
                                                    <t t-if="lv.label"> — <t t-out="lv.label"/></t>
                                                </span>
                                            </t>
                                        </div>
                                    </t>

                                    <t t-if="c.qc_status === 'done' or c.qc_status === 'error'">
                                        <div class="o_qc_result mt-2"
                                             t-att-class="{
                                                 'o_qc_pass': c.qc_severity === 'low',
                                                 'o_qc_warn': c.qc_severity === 'medium',
                                                 'o_qc_fail': c.qc_severity === 'high' or c.qc_severity === 'critical',
                                                 'o_qc_error': c.qc_status === 'error',
                                             }">
                                            <i t-att-class="'fa me-1 ' + qcStatusIcon(c.qc_status)"/>
                                            <t t-if="c.qc_severity">
                                                <strong class="me-1"><t t-out="c.qc_severity.toUpperCase()"/></strong>
                                            </t>
                                            <t t-if="c.qc_feedback">
                                                <span><t t-out="c.qc_feedback"/></span>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <t t-if="!isGenerating">
                        <div class="text-muted small py-2 text-center">No criteria defined yet.</div>
                    </t>
                </t>

                <t t-if="state.inlineAdd">
                    <t t-call="atlas.RubricEditor.InlineForm"/>
                </t>

                <t t-if="!state.inlineAdd and state.editingId === null">
                    <button class="btn btn-outline-primary btn-sm mt-3 w-100"
                            t-on-click="onAddCriteria">
                        <i class="fa fa-plus me-1"/> Add criteria
                    </button>
                </t>
            </t>
        </div>
    </t>

    <t t-name="atlas.RubricEditor.InlineForm">
        <div class="o_atlas_rubric_card o_inline_form">
            <div class="mb-2">
                <input type="text" class="form-control form-control-sm"
                       t-att-value="state.form.name"
                       t-on-input="(ev) => state.form.name = ev.target.value"
                       placeholder="Describe what this criterion measures"/>
            </div>

            <div class="d-flex gap-2 mb-2 flex-wrap">
                <select class="form-select form-select-sm"
                        style="max-width: 200px;"
                        t-on-change="(ev) => state.form.category = ev.target.value">
                    <option value="factuality_hallucination" t-att-selected="state.form.category === 'factuality_hallucination'">Factuality &amp; Hallucination</option>
                    <option value="task_completion" t-att-selected="state.form.category === 'task_completion'">Task Completion</option>
                    <option value="instruction_following" t-att-selected="state.form.category === 'instruction_following'">Instruction Following</option>
                    <option value="communication_style" t-att-selected="state.form.category === 'communication_style'">Communication Style</option>
                    <option value="other" t-att-selected="state.form.category === 'other'">Other</option>
                </select>
                <select class="form-select form-select-sm"
                        style="max-width: 200px;"
                        t-on-change="(ev) => state.form.importance = ev.target.value">
                    <option value="">Importance</option>
                    <option value="critically_detrimental" t-att-selected="state.form.importance === 'critically_detrimental'">⬤ Critically Detrimental</option>
                    <option value="detrimental" t-att-selected="state.form.importance === 'detrimental'">⬤ Detrimental</option>
                    <option value="slightly_detrimental" t-att-selected="state.form.importance === 'slightly_detrimental'">⬤ Slightly Detrimental</option>
                    <option value="slightly_important" t-att-selected="state.form.importance === 'slightly_important'">⬤ Slightly Important</option>
                    <option value="important" t-att-selected="state.form.importance === 'important'">⬤ Important</option>
                    <option value="critically_important" t-att-selected="state.form.importance === 'critically_important'">⬤ Critically Important</option>
                </select>
            </div>

            <t t-if="state.form.category === 'other'">
                <div class="mb-2">
                    <input type="text" class="form-control form-control-sm"
                           t-att-value="state.form.custom_category"
                           t-on-input="(ev) => state.form.custom_category = ev.target.value"
                           placeholder="Specify custom criteria category (e.g. Safety, Domain Knowledge, Code Quality)"/>
                </div>
            </t>

            <div class="mb-2">
                <textarea class="form-control form-control-sm o_suggestion_input"
                          rows="2"
                          t-att-value="state.form.suggestion"
                          t-on-input="(ev) => state.form.suggestion = ev.target.value"
                          placeholder="Scoring suggestion — how to grade True/False for this criterion"/>
            </div>

            <div class="mb-2">
                <label class="form-label small fw-bold mb-1">Scoring Levels</label>
                <div class="o_atlas_rubric_levels">
                    <t t-foreach="state.form.levels" t-as="level" t-key="level_index">
                        <div class="d-flex align-items-center gap-1 mb-1">
                            <span class="badge bg-secondary rounded-circle d-flex align-items-center justify-content-center"
                                  style="width: 24px; height: 24px; font-size: 11px;">
                                <t t-out="level.score"/>
                            </span>
                            <input type="text" class="form-control form-control-sm"
                                   t-att-value="level.label"
                                   t-on-input="(ev) => level.label = ev.target.value"
                                   t-att-placeholder="level.score === 0 ? 'Not Fulfilled' : level.score === 1 ? 'Partially Fulfilled' : 'Fulfilled'"/>
                            <button class="btn btn-sm btn-outline-secondary"
                                    t-on-click="() => this.onRemoveLevel(level_index)"
                                    t-att-disabled="state.form.levels.length &lt;= 2"
                                    title="Remove level">
                                <i class="fa fa-minus"/>
                            </button>
                        </div>
                    </t>
                </div>
                <button class="btn btn-link btn-sm p-0 mt-1" t-on-click="onAddLevel">
                    <i class="fa fa-plus me-1"/> Add level
                </button>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary btn-sm"
                        t-on-click="state.editingId ? onCancelEdit.bind(this) : onCancelInline.bind(this)">
                    Cancel
                </button>
                <button class="btn btn-primary btn-sm" t-on-click="onSaveCriteria">
                    Save
                </button>
            </div>
        </div>
    </t>
</templates>
