<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="atlas.TaskDashboard">
        <div class="o_atlas_dashboard">
            <!--
            ============================================================
            MODEL TAB BAR (COMMENTED OUT - only one model in use)
            Previously rendered a clickable tab strip (GLM 5, etc.) used
            to switch between multiple model sandboxes. Since MODEL_TABS
            only contains one entry, the strip adds no value. Uncomment
            this block to restore the tab bar when additional models are
            introduced.

            <div class="o_atlas_dashboard_tabs">
                <t t-foreach="modelTabs" t-as="tab" t-key="tab.type">
                    <button t-attf-class="o_atlas_dashboard_tab #{state.activeTab === tab.type ? 'active' : ''}"
                            t-on-click="() => this.onTabClick(tab.type)">
                        <i t-attf-class="fa #{tab.icon} me-1"/>
                        <span t-out="tab.label"/>
                        <t t-set="sbProps" t-value="this._buildSandboxProps(tab.type)"/>
                        <span t-if="sbProps.dockerStatus === 'running'" class="o_atlas_tab_dot running"/>
                        <span t-elif="sbProps.dockerStatus === 'starting'" class="o_atlas_tab_dot starting"/>
                        <span t-elif="sbProps.dockerStatus === 'error'" class="o_atlas_tab_dot error"/>
                    </button>
                </t>
                <div class="ms-auto d-flex align-items-center gap-2">
                    GOOGLE AUTH (COMMENTED OUT - not in use)
                    To restore, uncomment the block below and re-enable the
                    GogAuthDialog mount further down in this template.

                    t-if state.gogAuthDone : success badge + Re-auth button
                    t-else : outline-danger Google Auth button
                </div>
            </div>
            ============================================================
            -->

            <!-- All Sandbox Cards rendered simultaneously, shown/hidden via CSS -->
            <t t-foreach="modelTabs" t-as="tab" t-key="tab.type">
                <t t-set="sbProps" t-value="this._buildSandboxProps(tab.type)"/>
                <div t-attf-class="o_atlas_dashboard_body #{state.activeTab !== tab.type ? 'o_atlas_panel_hidden' : ''}">
                    <t t-if="sbProps.taskId">
                    <SandboxCard
                        sandboxId="sbProps.sandboxId"
                        taskId="sbProps.taskId"
                        taskEmail="sbProps.taskEmail"
                        modelType="sbProps.modelType"
                        modelLabel="sbProps.modelLabel"
                        dockerStatus="sbProps.dockerStatus"
                        sessionStatus="sbProps.sessionStatus"
                        dockerWsUrl="sbProps.dockerWsUrl"
                        gatewayToken="sbProps.gatewayToken"
                        dockerError="sbProps.dockerError"
                        disabled="sbProps.disabled"
                        loading="sbProps.loading"
                        record="props.record"
                        onStart.bind="onStartSandbox"
                        onStop.bind="onStopSandbox"
                    />
                    </t>
                    <div t-else="" class="p-4 text-muted text-center">
                        Save the task first to enable sandboxes.
                    </div>
                </div>
            </t>

            <!-- Shared Gog Auth Dialog -->
            <!--
            ============================================================
            GOOGLE AUTH DIALOG (COMMENTED OUT - not in use)
            <GogAuthDialog t-if="state.showGogAuth"
                taskId="this.taskId"
                email="this.taskEmail || ''"
                onClose.bind="onGogAuthClose"
                onSuccess.bind="onGogAuthSuccess"/>
            ============================================================
            -->
        </div>
    </t>
</templates>
