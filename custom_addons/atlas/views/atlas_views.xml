<odoo>
  <data>
    <record model="ir.ui.view" id="atlas_atlas_list">
      <field name="name">atlas.atlas.list</field>
      <field name="model">atlas.atlas</field>
      <field name="arch" type="xml">
        <list>
          <field name="employee_id"/>
          <field name="task_status"/>
          <field name="qc_status" widget="badge"
                 decoration-success="qc_status == 'passed'"
                 decoration-danger="qc_status == 'failed'"
                 decoration-muted="qc_status == 'pending'"/>
          <field name="glm_status" widget="badge" string="GLM"
                 decoration-success="glm_status == 'running'"
                 decoration-danger="glm_status == 'error'"
                 decoration-info="glm_status == 'starting'"
                 decoration-muted="glm_status == 'stopped'"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="atlas_atlas_form">
      <field name="name">atlas.atlas.form</field>
      <field name="model">atlas.atlas</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button class="oe_stat_button" name="action_view_turns"
                      type="object" icon="fa-history"
                      string="Turn History"/>
            </div>
            <group>
              <group string="Task Details">
                <field name="is_atlas_admin" invisible="1"/>
                <field name="task_status"/>
                <field name="qc_status" widget="badge" readonly="not is_atlas_admin"
                       decoration-success="qc_status == 'passed'"
                       decoration-danger="qc_status == 'failed'"
                       decoration-muted="qc_status == 'pending'"/>
              </group>
              <group string="Assignment">
                <field name="employee_id" readonly="not is_atlas_admin"/>
                <field name="user_id" readonly="not is_atlas_admin"/>
                <field name="email"/>
                <field name="password" string="Google Password"/>
                <field name="gog_auth" string="GOG Auth"/>
              </group>
            </group>

            <field name="sandbox_ids" invisible="1"/>
            <field name="glm_session_status" invisible="1"/>

            <div class="d-flex gap-3 mt-3" style="min-height: 500px;">
              <div class="flex-grow-1" style="flex: 1 1 50%; min-width: 0;">
                <widget name="atlas_task_dashboard"/>
              </div>

              <div class="flex-grow-1" style="flex: 1 1 50%; min-width: 0;">
                <div class="border rounded p-3 mb-3">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Goal</h5>
                    <button name="action_regenerate_description" type="object"
                            class="btn btn-sm btn-outline-secondary"
                            title="Auto-generate goal from user prompts using AI">
                      <i class="fa fa-refresh me-1"/>Regenerate
                    </button>
                  </div>
                  <p class="text-muted small mb-2">What goal does this sequence of messages serve?</p>
                  <field name="goal_description" nolabel="1"
                         placeholder="e.g. 'User asks the model to fix a TypeError in their React component's useEffect hook and iterates until the fix works.'"/>
                </div>

                <div class="border rounded p-3">
                  <h5>Scoring Criteria</h5>
                  <p class="text-muted small mb-2">Define what "good" and "bad" look like. Each criterion measures one specific thing on a numbered scale.</p>
                  <widget name="atlas_rubric_editor"/>
                </div>
              </div>
            </div>

            <notebook>
              <page string="Turn History">
                <field name="turn_ids" readonly="1">
                  <list default_order="id asc">
                    <field name="session_label" string="Session"/>
                    <field name="turn_number" string="Turn"/>
                    <field name="prompt"/>
                    <field name="response"/>
                    <field name="turn_status" widget="badge"
                           decoration-success="turn_status == 'Completed'"
                           decoration-warning="turn_status == 'Pending'"/>
                    <field name="qc_severity" string="QC Status" widget="badge"
                           decoration-danger="qc_severity == 'critical'"
                           decoration-warning="qc_severity in ('high', 'medium')"
                           decoration-success="qc_severity == 'low'"/>
                    <field name="qc_response" string="QC Feedback"/>
                    <field name="feedback" widget="badge" optional="show"
                           decoration-success="feedback == 'satisfied'"
                           decoration-danger="feedback == 'unsatisfied'"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="atlas_atlas_action_window">
      <field name="name">Atlas Tasks</field>
      <field name="res_model">atlas.atlas</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('atlas_atlas_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('atlas_atlas_form')})]"/>
    </record>

    <!-- ============ Turn Views ============ -->

    <record model="ir.ui.view" id="atlas_turn_list">
      <field name="name">atlas.turn.list</field>
      <field name="model">atlas.turn</field>
      <field name="arch" type="xml">
        <list default_order="id asc">
          <field name="session_label" string="Session"/>
          <field name="turn_number" string="Turn"/>
          <field name="prompt"/>
          <field name="response"/>
          <field name="turn_status" widget="badge"
                 decoration-success="turn_status == 'Completed'"
                 decoration-warning="turn_status == 'Pending'"/>
          <field name="qc_severity" string="QC Status" widget="badge"
                 decoration-danger="qc_severity == 'critical'"
                 decoration-warning="qc_severity in ('high', 'medium')"
                 decoration-success="qc_severity == 'low'"/>
          <field name="qc_response" string="QC Feedback" widget="text" optional="show"/>
          <field name="feedback" widget="badge" optional="show"
                 decoration-success="feedback == 'satisfied'"
                 decoration-danger="feedback == 'unsatisfied'"/>
          <field name="sandbox_id" optional="hide"/>
          <field name="atlas_id" optional="hide"/>
          <field name="employee_id" optional="hide"/>
          <field name="model_name" optional="hide"/>
          <field name="tool_names" optional="hide"/>
          <field name="qc_dismiss_reason" optional="hide"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="atlas_turn_form">
      <field name="name">atlas.turn.form</field>
      <field name="model">atlas.turn</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="sandbox_id"/>
                <field name="atlas_id"/>
                <field name="employee_id"/>
                <field name="turn_number"/>
                <field name="turn_status"/>
                <field name="model_name"/>
                <field name="prompt_timestamp"/>
                <field name="response_timestamp"/>
              </group>
            </group>
            <notebook>
              <page string="Prompt">
                <field name="prompt" nolabel="1"/>
              </page>
              <page string="Response">
                <field name="response" nolabel="1"/>
              </page>
              <page string="Tool Calls">
                <group>
                  <field name="tool_names"/>
                </group>
                <field name="tool_calls" nolabel="1" widget="text"/>
              </page>
              <page string="Raw Events">
                <field name="raw_events" nolabel="1" widget="text"/>
              </page>
              <page string="QC">
                <group>
                  <field name="qc_severity"/>
                  <field name="qc_dismiss_reason"/>
                </group>
                <field name="qc_response" nolabel="1" widget="text"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="atlas_turn_action_window">
      <field name="name">Turns</field>
      <field name="res_model">atlas.turn</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('atlas_turn_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('atlas_turn_form')})]"/>
    </record>

    <!-- ============ Sandbox Views (Admin) ============ -->

    <record model="ir.ui.view" id="atlas_sandbox_list">
      <field name="name">atlas.sandbox.list</field>
      <field name="model">atlas.sandbox</field>
      <field name="arch" type="xml">
        <list default_order="atlas_id desc, model_type">
          <field name="atlas_id"/>
          <field name="employee_id"/>
          <field name="model_type"/>
          <field name="docker_status" widget="badge"
                 decoration-success="docker_status == 'running'"
                 decoration-danger="docker_status == 'error'"
                 decoration-info="docker_status == 'starting'"
                 decoration-muted="docker_status == 'stopped'"/>
          <field name="docker_dashboard_url" widget="url"/>
          <field name="docker_port"/>
          <field name="session_status"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="atlas_sandbox_form">
      <field name="name">atlas.sandbox.form</field>
      <field name="model">atlas.sandbox</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group string="Sandbox Info">
                <field name="atlas_id"/>
                <field name="employee_id"/>
                <field name="model_type"/>
                <field name="session_status"/>
              </group>
              <group string="Docker Status">
                <field name="docker_status" widget="badge"
                       decoration-success="docker_status == 'running'"
                       decoration-danger="docker_status == 'error'"
                       decoration-info="docker_status == 'starting'"
                       decoration-muted="docker_status == 'stopped'"/>
                <field name="docker_port"/>
                <field name="docker_compose_project"/>
                <field name="docker_error"/>
              </group>
            </group>
            <group string="Container Links">
              <field name="docker_dashboard_url" widget="url"/>
              <field name="docker_ws_url" widget="url"/>
              <field name="docker_gateway_token"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="atlas_sandbox_action_window">
      <field name="name">Sandboxes</field>
      <field name="res_model">atlas.sandbox</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('atlas_sandbox_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('atlas_sandbox_form')})]"/>
    </record>

  </data>
</odoo>
