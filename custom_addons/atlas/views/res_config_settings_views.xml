<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_atlas" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.atlas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Atlas" string="Atlas" name="atlas">
                    <block title="Sandbox Deployment">
                        <setting string="Deployment Mode" help="Local mode uses Docker Compose (admin only). K8s mode creates Kubernetes resources.">
                            <field name="atlas_deployment_mode" widget="radio"/>
                        </setting>
                    </block>
                    <block title="Local Mode (Docker Compose)" invisible="atlas_deployment_mode != 'local'">
                        <setting string="Docker Status" help="Whether Docker daemon is accessible from this server.">
                            <field name="atlas_docker_available" widget="boolean_toggle" readonly="True"/>
                        </setting>
                    </block>
                    <block title="Kubernetes Mode" invisible="atlas_deployment_mode != 'k8s'">
                        <setting string="Sandbox Directory" help="Path to Sandbox directory (for reading persona files and litellm config).">
                            <field name="atlas_sandbox_dir"/>
                        </setting>
                        <setting string="OpenClaw Image" help="Container image for the OpenClaw gateway.">
                            <field name="atlas_openclaw_image"/>
                        </setting>
                        <setting string="LiteLLM Image" help="Container image for the LiteLLM proxy.">
                            <field name="atlas_litellm_image"/>
                        </setting>
                        <setting string="WS Router Host" help="Public hostname for the WebSocket router Ingress (e.g. atlas-ws.yourdomain.com). Browser uses wss://host/sandbox/task_id/ to reach the gateway.">
                            <field name="atlas_ws_router_host"/>
                        </setting>
                    </block>
                    <block title="Google Auth (Gog)">
                        <setting string="Google OAuth Client Secret (JSON)" help="Paste the full contents of client_secret.json from Google Cloud Console. Required for gog-based Google authentication.">
                            <field name="atlas_gog_client_secret" widget="text"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
