<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_atlas_reconcile_sandboxes" model="ir.cron">
            <field name="name">Atlas: Reconcile Sandbox Status</field>
            <field name="model_id" ref="model_atlas_atlas"/>
            <field name="state">code</field>
            <field name="code">model._cron_reconcile_sandboxes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_atlas_recover_stuck_generation" model="ir.cron">
            <field name="name">Atlas: Recover Stuck Generation Tasks</field>
            <field name="model_id" ref="model_atlas_atlas"/>
            <field name="state">code</field>
            <field name="code">model._cron_recover_stuck_generation()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
