<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_greythr" model="ir.module.category">
            <field name="name">greytHR Connector</field>
            <field name="sequence">96</field>
        </record>

        <record id="res_groups_privilege_greythr" model="res.groups.privilege">
            <field name="name">greytHR Connector</field>
            <field name="sequence">96</field>
            <field name="category_id" ref="module_category_greythr"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="group_greythr_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_greythr"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_greythr_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_greythr"/>
            <field name="implied_ids" eval="[(4, ref('group_greythr_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
