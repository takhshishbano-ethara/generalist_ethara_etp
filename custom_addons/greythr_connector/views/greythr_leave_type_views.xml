<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_greythr_leave_type_list" model="ir.ui.view">
        <field name="name">greythr.leave.type.list</field>
        <field name="model">greythr.leave.type</field>
        <field name="arch" type="xml">
            <list string="greytHR Leave Types" editable="bottom">
                <field name="instance_id"/>
                <field name="external_code"/>
                <field name="name"/>
                <field name="holiday_status_id"/>
                <field name="last_sync_at" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_greythr_leave_type_form" model="ir.ui.view">
        <field name="name">greythr.leave.type.form</field>
        <field name="model">greythr.leave.type</field>
        <field name="arch" type="xml">
            <form string="greytHR Leave Type">
                <sheet>
                    <group>
                        <field name="instance_id"/>
                        <field name="external_code"/>
                        <field name="name"/>
                        <field name="holiday_status_id"/>
                        <field name="last_sync_at" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_greythr_leave_type" model="ir.actions.act_window">
        <field name="name">greytHR Leave Types</field>
        <field name="res_model">greythr.leave.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
