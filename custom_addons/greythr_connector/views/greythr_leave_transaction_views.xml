<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_greythr_leave_transaction_list" model="ir.ui.view">
        <field name="name">greythr.leave.transaction.list</field>
        <field name="model">greythr.leave.transaction</field>
        <field name="arch" type="xml">
            <list string="greytHR Leave Transactions">
                <field name="external_transaction_id"/>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="greythr_employee_id"/>
                <field name="employee_id"/>
                <field name="leave_type_id"/>
                <field name="number_of_days"/>
                <field name="transaction_type"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-danger="status == 'rejected'"
                       decoration-warning="status == 'applied'"
                       decoration-muted="status == 'cancelled'"/>
                <field name="last_sync_at"/>
            </list>
        </field>
    </record>

    <record id="view_greythr_leave_transaction_form" model="ir.ui.view">
        <field name="name">greythr.leave.transaction.form</field>
        <field name="model">greythr.leave.transaction</field>
        <field name="arch" type="xml">
            <form string="greytHR Leave Transaction">
                <sheet>
                    <group>
                        <group>
                            <field name="external_transaction_id"/>
                            <field name="greythr_employee_id"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="leave_type_id"/>
                            <field name="holiday_status_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="number_of_days"/>
                            <field name="sessions"/>
                            <field name="transaction_type"/>
                            <field name="status"/>
                            <field name="last_sync_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks"/>
                        <field name="reason"/>
                    </group>
                    <group string="Raw Payload" groups="greythr_connector.group_greythr_manager">
                        <field name="raw_payload" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_greythr_leave_transaction_search" model="ir.ui.view">
        <field name="name">greythr.leave.transaction.search</field>
        <field name="model">greythr.leave.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="external_transaction_id"/>
                <field name="greythr_employee_id"/>
                <field name="employee_id"/>
                <field name="leave_type_id"/>
                <filter name="approved" string="Approved"
                        domain="[('status', '=', 'approved')]"/>
                <filter name="applied" string="Applied"
                        domain="[('status', '=', 'applied')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('status', '=', 'rejected')]"/>
                <separator/>
                <group>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_type" string="Leave Type"
                            context="{'group_by': 'leave_type_id'}"/>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'greythr_employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_greythr_leave_transaction" model="ir.actions.act_window">
        <field name="name">greytHR Leave Transactions</field>
        <field name="res_model">greythr.leave.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
