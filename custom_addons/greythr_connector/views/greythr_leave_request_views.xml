<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_greythr_leave_request_list" model="ir.ui.view">
        <field name="name">greythr.leave.request.list</field>
        <field name="model">greythr.leave.request</field>
        <field name="arch" type="xml">
            <list string="greytHR Leave Requests" default_order="from_date desc">
                <field name="direction"/>
                <field name="greythr_employee_id"/>
                <field name="leave_type_id"/>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="number_of_days"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'approved'"
                       decoration-danger="status == 'refused'"
                       decoration-warning="status == 'pending'"
                       decoration-muted="status == 'cancelled'"/>
                <field name="push_state" widget="badge"
                       decoration-success="push_state == 'sent'"
                       decoration-danger="push_state == 'failed'"/>
                <field name="external_request_id" optional="hide"/>
                <field name="last_sync_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_greythr_leave_request_form" model="ir.ui.view">
        <field name="name">greythr.leave.request.form</field>
        <field name="model">greythr.leave.request</field>
        <field name="arch" type="xml">
            <form string="greytHR Leave Request">
                <header>
                    <button name="action_push_now" type="object"
                            string="Push to greytHR"
                            invisible="direction != 'outbound'"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="direction"/>
                            <field name="greythr_employee_id"/>
                            <field name="employee_id"/>
                            <field name="leave_type_id"/>
                        </group>
                        <group>
                            <field name="external_request_id"/>
                            <field name="hr_leave_id"/>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="number_of_days"/>
                            <field name="sessions"/>
                        </group>
                    </group>
                    <group>
                        <group string="Status">
                            <field name="status"/>
                            <field name="push_state"/>
                            <field name="last_sync_at"/>
                        </group>
                        <group string="Push Error" invisible="not push_error">
                            <field name="push_error" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="reason"/>
                        <field name="remarks"/>
                    </group>
                    <group string="Raw Payload"
                           groups="greythr_connector.group_greythr_manager"
                           invisible="not raw_payload">
                        <field name="raw_payload" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_greythr_leave_request_search" model="ir.ui.view">
        <field name="name">greythr.leave.request.search</field>
        <field name="model">greythr.leave.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="greythr_employee_id"/>
                <field name="employee_id"/>
                <field name="leave_type_id"/>
                <field name="external_request_id"/>
                <filter name="outbound" string="Outbound"
                        domain="[('direction', '=', 'outbound')]"/>
                <filter name="inbound" string="Inbound"
                        domain="[('direction', '=', 'inbound')]"/>
                <separator/>
                <filter name="pending" string="Pending"
                        domain="[('status', '=', 'pending')]"/>
                <filter name="approved" string="Approved"
                        domain="[('status', '=', 'approved')]"/>
                <filter name="refused" string="Refused"
                        domain="[('status', '=', 'refused')]"/>
                <filter name="push_failed" string="Push Failed"
                        domain="[('push_state', '=', 'failed')]"/>
                <separator/>
                <group>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_direction" string="Direction"
                            context="{'group_by': 'direction'}"/>
                    <filter name="group_leave_type" string="Leave Type"
                            context="{'group_by': 'leave_type_id'}"/>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'greythr_employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_greythr_leave_request" model="ir.actions.act_window">
        <field name="name">greytHR Leave Requests</field>
        <field name="res_model">greythr.leave.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_greythr_leave_request_search"/>
    </record>
</odoo>
