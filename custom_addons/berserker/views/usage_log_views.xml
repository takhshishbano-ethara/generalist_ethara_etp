<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="berserker_usage_log_view_list" model="ir.ui.view">
        <field name="name">berserker.usage.log.list</field>
        <field name="model">berserker.usage.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="call_type"/>
                <field name="berserker_id"/>
                <field name="input_tokens"/>
                <field name="output_tokens"/>
                <field name="cached_tokens"/>
                <field name="total_tokens"/>
                <field name="cost_estimate" string="Cost ($)"/>
                <field name="duration_seconds"/>
                <field name="success"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="berserker_usage_log_view_pivot" model="ir.ui.view">
        <field name="name">berserker.usage.log.pivot</field>
        <field name="model">berserker.usage.log</field>
        <field name="arch" type="xml">
            <pivot string="Usage Analysis">
                <field name="provider" type="row"/>
                <field name="call_type" type="row"/>
                <field name="create_date" type="col" interval="week"/>
                <field name="total_tokens" type="measure"/>
                <field name="cost_estimate" type="measure"/>
                <field name="input_tokens" type="measure"/>
                <field name="output_tokens" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="berserker_usage_log_view_graph" model="ir.ui.view">
        <field name="name">berserker.usage.log.graph</field>
        <field name="model">berserker.usage.log</field>
        <field name="arch" type="xml">
            <graph string="Usage Dashboard" type="bar" stacked="1">
                <field name="provider"/>
                <field name="total_tokens" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="berserker_usage_log_view_search" model="ir.ui.view">
        <field name="name">berserker.usage.log.search</field>
        <field name="model">berserker.usage.log</field>
        <field name="arch" type="xml">
            <search string="Usage Log">
                <field name="provider"/>
                <field name="model_name"/>
                <field name="call_type"/>
                <field name="berserker_id"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="Kimi" name="kimi" domain="[('provider', '=', 'kimi')]"/>
                <filter string="Claude" name="claude" domain="[('provider', '=', 'claude')]"/>
                <filter string="Gemini" name="gemini" domain="[('provider', '=', 'gemini')]"/>
                <filter string="GPT" name="openai" domain="[('provider', '=', 'openai')]"/>
                <separator/>
                <filter string="Success" name="success" domain="[('success', '=', True)]"/>
                <filter string="Failed" name="failed" domain="[('success', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="berserker_usage_log_action" model="ir.actions.act_window">
        <field name="name">Usage Log</field>
        <field name="res_model">berserker.usage.log</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="berserker_usage_log_view_search"/>
    </record>

</odoo>
