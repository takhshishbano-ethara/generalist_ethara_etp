<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="berserker.MarkdownLatexField">
        <t t-if="props.readonly">
            <div class="o_field_markdown_latex o_field_widget o_field_markdown_latex_readonly" t-ref="container">
                <button type="button"
                    class="o_markdown_latex_copy btn btn-link btn-sm"
                    t-att-title="copyLabel"
                    t-on-click="onCopy"
                    t-att-disabled="state.copied">
                    <t t-if="state.copied">
                        <span class="o_markdown_latex_copy_text">Copied!</span>
                    </t>
                    <t t-else="">
                        <span class="o_markdown_latex_copy_text">Copy</span>
                    </t>
                </button>
                <div class="o_markdown_latex_content o_readonly_content" t-out="renderedMarkup"/>
            </div>
        </t>
        <t t-else="">
            <div class="o_field_markdown_latex o_field_widget">
                <textarea
                    class="o_input o_field_text_input"
                    t-att-id="props.id"
                    t-att-placeholder="props.placeholder"
                    t-ref="textarea"
                    rows="10"
                />
            </div>
        </t>
    </t>

</templates>
