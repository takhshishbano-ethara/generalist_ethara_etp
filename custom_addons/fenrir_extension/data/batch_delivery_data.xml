<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_fenrir_batch_delivery" model="ir.sequence">
            <field name="name">Fenrir Batch Delivery</field>
            <field name="code">fenrir.batch.delivery</field>
            <field name="prefix">FNR/BATCH/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="action_add_fenrir_tasks_to_batch" model="ir.actions.server">
            <field name="name">Add to Batch Delivery</field>
            <field name="model_id" ref="fenrir.model_fenrir_task"/>
            <field name="binding_model_id" ref="fenrir.model_fenrir_task"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Add to Batch Delivery',
    'res_model': 'fenrir.batch.delivery.add.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'active_ids': records.ids, 'active_model': 'fenrir.task'},
}
            </field>
        </record>
    </data>
</odoo>
