              "host": ["{{baseUrl}}"],
              "path": ["api","v1","etp_assessment_ext","categories"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "20"},
                {"key": "search", "value": "", "disabled": true},
                {"key": "active", "value": "true", "disabled": true},
                {"key": "sort_by", "value": "sequence", "disabled": true},
                {"key": "sort_order", "value": "asc", "disabled": true}
              ]
