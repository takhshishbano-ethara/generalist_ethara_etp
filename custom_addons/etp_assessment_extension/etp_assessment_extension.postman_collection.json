            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Frontend Eval (v2)\",\n  \"sequence\": 20,\n  \"active\": true\n}"},
            "url": {"raw": "{{baseUrl}}/api/v1/etp_assessment_ext/categories/1", "host": ["{{baseUrl}}"], "path": ["api","v1","etp_assessment_ext","categories","1"]}
