{
  "info": {
    "_postman_id": "etp-assessment-ext-001",
    "name": "ETP Assessment Extension",
    "description": "Full REST API for the ETP Assessment Extension module.\n\n**Setup:**\n1. Import this collection into Postman.\n2. Run **Auth → Get Access Token** first — it will automatically save your `accessToken` collection variable.\n3. (Optional) For Portal requests, set `candidateToken` to a per-candidate token from `GET /assessments/:id/candidates`.\n\n**Header note:** Use `Access-Token` (with dash), not `access_token` — Werkzeug header normalization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8071", "type": "string"},
    {"key": "accessToken", "value": "", "type": "string"},
    {"key": "candidateToken", "value": "", "type": "string"},
    {"key": "login", "value": "admin", "type": "string"},
    {"key": "password", "value": "admin", "type": "string"}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Access Token (auto-saves to collection)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', res.data.access_token);",
                  "  console.log('Saved accessToken:', res.data.access_token);",
                  "  pm.test('Token saved', () => pm.expect(res.data.access_token).to.be.a('string'));",
                  "} else {",
                  "  console.error('Auth failed:', res);",
                  "  pm.test('Auth returned token', () => pm.expect.fail('No access_token in response'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/v1/auth_token", "host": ["{{baseUrl}}"], "path": ["api","v1","auth_token"]}
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard Overview",
          "request": {
            "method": "GET",
            "header": [{"key": "Access-Token", "value": "{{accessToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/api/v1/etp_assessment_ext/dashboard_overview",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","etp_assessment_ext","dashboard_overview"],
              "query": [
                {"key": "assessment_id", "value": "", "disabled": true},
                {"key": "category_id", "value": "", "disabled": true},
                {"key": "state", "value": "draft", "disabled": true},
                {"key": "date_from", "value": "2026-01-01", "disabled": true},
                {"key": "date_to", "value": "2026-12-31", "disabled": true}
              ]
            }
          }
        }
      ]
    },
