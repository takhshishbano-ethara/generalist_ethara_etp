<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pax_dashboard.Showcase">
        <div class="sr-backend-showcase">
            <div class="sr-backend-header">
                <h1>Pax Dashboard</h1>
                <p>Personalized Agent Security Evaluation</p>
            </div>

            <div class="sr-backend-metrics">
                <div class="sr-backend-metric">
                    <span class="sr-backend-metric__value">30</span>
                    <span class="sr-backend-metric__label">Instances</span>
                </div>
                <div class="sr-backend-metric">
                    <span class="sr-backend-metric__value">2</span>
                    <span class="sr-backend-metric__label">Models</span>
                </div>
                <div class="sr-backend-metric">
                    <span class="sr-backend-metric__value">0.722</span>
                    <span class="sr-backend-metric__label">Best ASR</span>
                </div>
                <div class="sr-backend-metric">
                    <span class="sr-backend-metric__value">$0.06</span>
                    <span class="sr-backend-metric__label">Avg Cost</span>
                </div>
            </div>

            <div class="sr-backend-comparison">
                <div class="sr-backend-model">
                    <h3>GLM-5</h3>
                    <div class="sr-backend-model__stat">Overall ASR: <strong>0.722</strong></div>
                    <div class="sr-backend-model__stat">IPI Success Rate: <strong>80%</strong></div>
                    <div class="sr-backend-model__stat">MEM Leak Rate: <strong>90%</strong></div>
                    <div class="sr-backend-model__stat">TRD Deception Rate: <strong>30%</strong></div>
                    <div class="sr-backend-model__stat">Avg Cost: <strong>$0.06</strong></div>
                </div>
                <div class="sr-backend-model">
                    <h3>Nova-2-Lite</h3>
                    <div class="sr-backend-model__stat">Overall ASR: <strong>0.511</strong></div>
                    <div class="sr-backend-model__stat">IPI Success Rate: <strong>40%</strong></div>
                    <div class="sr-backend-model__stat">MEM Leak Rate: <strong>60%</strong></div>
                    <div class="sr-backend-model__stat">TRD Deception Rate: <strong>10%</strong></div>
                    <div class="sr-backend-model__stat">Avg Cost: <strong>$0.01</strong></div>
                </div>
            </div>

            <div class="sr-backend-links">
                <a t-att-href="state.trajectories_url" target="_blank" class="sr-backend-link">
                    &#x1F4C2; GitHub Repository
                </a>
                <a t-att-href="state.dataset_url" target="_blank" class="sr-backend-link">
                    &#x1F917; HuggingFace Dataset
                </a>
                <a href="https://arxiv.org/abs/2602.08412" target="_blank" class="sr-backend-link">
                    &#x1F4C4; Research Paper
                </a>
                <a href="/pax" target="_blank" class="sr-backend-link">
                    &#x1F310; Portal View
                </a>
            </div>
        </div>
    </t>
</templates>
