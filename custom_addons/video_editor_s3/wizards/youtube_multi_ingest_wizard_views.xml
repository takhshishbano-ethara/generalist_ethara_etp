<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_youtube_multi_ingest_wizard_form" model="ir.ui.view">
        <field name="name">video.editor.youtube.multi.ingest.wizard.form</field>
        <field name="model">video.editor.youtube.multi.ingest.wizard</field>
        <field name="arch" type="xml">
            <form string="Ingest YouTube (multi-tier)">
                <group>
                    <field name="youtube_url" placeholder="https://www.youtube.com/watch?v=..."/>
                </group>
                <group string="Resolutions to download">
                    <field name="tier_1080p"/>
                    <field name="tier_1440p"/>
                    <field name="tier_2160p"/>
                </group>
                <footer>
                    <button name="action_run" string="Download &amp; Ingest" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_youtube_multi_ingest_wizard" model="ir.actions.act_window">
        <field name="name">Ingest YouTube (multi-tier)</field>
        <field name="res_model">video.editor.youtube.multi.ingest.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
