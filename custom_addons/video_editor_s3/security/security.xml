<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="module_category_video_editor_s3" model="ir.module.category">
        <field name="name">Crowly Sourcing</field>
        <field name="description">Roles for Crowly Sourcing</field>
        <field name="sequence">36</field>
    </record>

    <record id="privilege_video_editor_s3" model="res.groups.privilege">
        <field name="name">Crowly Sourcing</field>
        <field name="sequence">36</field>
        <field name="category_id" ref="module_category_video_editor_s3"/>
    </record>

    <record id="group_video_editor_s3_user" model="res.groups">
        <field name="name">Crowly Sourcing User</field>
        <field name="privilege_id" ref="privilege_video_editor_s3"/>
        <field name="comment">Submit S3 video URLs, view own projects and renders.</field>
    </record>

    <record id="group_video_editor_s3_editor" model="res.groups">
        <field name="name">Crowly Sourcing Editor</field>
        <field name="privilege_id" ref="privilege_video_editor_s3"/>
        <field name="implied_ids" eval="[(4, ref('group_video_editor_s3_user'))]"/>
        <field name="comment">Edit, trim, crop and render S3 video projects.</field>
    </record>

    <record id="group_video_editor_s3_manager" model="res.groups">
        <field name="name">Crowly Sourcing Manager</field>
        <field name="privilege_id" ref="privilege_video_editor_s3"/>
        <field name="implied_ids" eval="[(4, ref('group_video_editor_s3_editor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Full administrative control over projects, jobs and storage.</field>
    </record>

    <record id="rule_project_user_own" model="ir.rule">
        <field name="name">Crowly Sourcing Project: users see own / assigned</field>
        <field name="model_id" ref="model_video_editor_project"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('assigned_to', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_video_editor_s3_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_project_editor_all" model="ir.rule">
        <field name="name">Crowly Sourcing Project: editors see all</field>
        <field name="model_id" ref="model_video_editor_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_video_editor_s3_editor'))]"/>
    </record>

    <record id="rule_project_manager_all" model="ir.rule">
        <field name="name">Crowly Sourcing Project: managers see all</field>
        <field name="model_id" ref="model_video_editor_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_video_editor_s3_manager'))]"/>
    </record>

    <record id="rule_job_user_via_project" model="ir.rule">
        <field name="name">Crowly Sourcing Job: scoped to project access</field>
        <field name="model_id" ref="model_video_editor_job"/>
        <field name="domain_force">['|', ('project_id.create_uid', '=', user.id), ('project_id.assigned_to', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_video_editor_s3_user'))]"/>
    </record>

    <record id="rule_job_editor_all" model="ir.rule">
        <field name="name">Crowly Sourcing Job: editors see all</field>
        <field name="model_id" ref="model_video_editor_job"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_video_editor_s3_editor'))]"/>
    </record>

</odoo>
