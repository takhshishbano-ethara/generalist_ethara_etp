<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_video_editor_sub_category_list" model="ir.ui.view">
        <field name="name">video.editor.sub.category.list</field>
        <field name="model">video.editor.sub.category</field>
        <field name="arch" type="xml">
            <list string="Sub-Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="category_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_video_editor_sub_category_form" model="ir.ui.view">
        <field name="name">video.editor.sub.category.form</field>
        <field name="model">video.editor.sub.category</field>
        <field name="arch" type="xml">
            <form string="Sub-Category">
                <sheet>
                    <group>
                        <group>
                            <field name="category_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="name" required="1"/>
                            <field name="code" required="1"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Delivery Sheet">
                        <field name="description" nolabel="1" placeholder="Description used in the Final Data delivery sheet CSV..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_video_editor_sub_category_search" model="ir.ui.view">
        <field name="name">video.editor.sub.category.search</field>
        <field name="model">video.editor.sub.category</field>
        <field name="arch" type="xml">
            <search string="Sub-Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_video_editor_sub_category" model="ir.actions.act_window">
        <field name="name">Sub-Categories</field>
        <field name="res_model">video.editor.sub.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_video_editor_sub_category_search"/>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>

    <menuitem id="menu_video_editor_s3_sub_categories"
              name="Sub-Categories"
              parent="menu_video_editor_s3_config"
              action="action_video_editor_sub_category"
              sequence="20"
              groups="video_editor_s3.group_video_editor_s3_manager"/>

</odoo>
