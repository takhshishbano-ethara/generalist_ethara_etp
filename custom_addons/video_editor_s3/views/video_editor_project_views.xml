<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_video_editor_project_list" model="ir.ui.view">
        <field name="name">video.editor.project.list</field>
        <field name="model">video.editor.project</field>
        <field name="arch" type="xml">
            <list string="Video Projects" decoration-info="state == 'draft'" decoration-warning="state in ('processing','exporting')" decoration-success="state == 'exported'" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="s3_source_url"/>
                <field name="resolution"/>
                <field name="source_fps" optional="show"/>
                <field name="duration_seconds" widget="float_time"/>
                <field name="source_size_mb" widget="float"/>
                <field name="state" widget="badge"/>
                <field name="assigned_to" widget="many2one_avatar_user"/>
                <field name="active_job_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_video_editor_project_kanban" model="ir.ui.view">
        <field name="name">video.editor.project.kanban</field>
        <field name="model">video.editor.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="state"/>
                <field name="resolution"/>
                <field name="duration_seconds"/>
                <field name="assigned_to"/>
                <field name="active_job_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                                <field name="state" widget="badge"/>
                            </div>
                            <div class="o_kanban_record_body small text-muted">
                                <div t-if="record.resolution.raw_value"><field name="resolution"/></div>
                                <div t-if="record.duration_seconds.raw_value">
                                    Duration: <field name="duration_seconds" widget="float_time"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="assigned_to" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_video_editor_project_form" model="ir.ui.view">
        <field name="name">video.editor.project.form</field>
        <field name="model">video.editor.project</field>
        <field name="arch" type="xml">
            <form string="Video Project" js_class="video_editor_s3_project_form">
                <header>
                    <button name="action_ingest_youtube" type="object" string="Process Video" class="btn-primary" invisible="not youtube_url or s3_source_url or active_job_id"/>
                    <button name="action_open_editor" type="object" string="Open Editor" class="btn-primary" invisible="not s3_source_url"/>
                    <button name="action_export" type="object" string="Export to S3" invisible="not edited_file_path or state in ('exporting', 'exported')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed,exported"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_jobs" type="object" class="oe_stat_button" icon="fa-tasks" invisible="not job_ids">
                            <field name="job_ids" widget="statinfo" string="Jobs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Project name"/></h1>
                    </div>
                    <group>
                        <group name="primary">
                            <field name="youtube_url" placeholder="https://www.youtube.com/watch?v=..."/>
                            <field name="s3_source_url" widget="video_url_preview" options="{'stream_kind': 'source'}" placeholder="s3://bucket/path/to/video.mp4 or https URL"/>
                        </group>
                        <group name="primary_right">
                            <field name="output_s3_url" widget="video_url_preview" readonly="1"/>
                            <field name="resolution" readonly="1" invisible="not resolution"/>
                            <field name="source_fps" readonly="1" invisible="not source_fps"/>
                            <field name="assigned_to" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General Information" name="general">
                            <group string="Project Details">
                                <group>
                                    <field name="project_name"/>
                                    <field name="category"/>
                                    <field name="style"/>
                                </group>
                            </group>
                            <group string="Prompt">
                                <field name="prompt" placeholder="Prompt..."/>
                            </group>
                            <group string="Prompt QC" invisible="not qc_evaluated_at">
                                <group string="Verdict">
                                    <field name="qc_quality" widget="badge" decoration-success="qc_quality == 'pass'" decoration-danger="qc_quality == 'fail'" readonly="1"/>
                                    <field name="qc_score" readonly="1"/>
                                    <field name="qc_expert_level" string="Accuracy Level" readonly="1"/>
                                </group>
                                <group string="Run">
                                    <field name="qc_evaluated_at" readonly="1"/>
                                </group>
                                <group string="Error Reason" colspan="2">
                                    <field name="qc_reason" string="Error Reason" readonly="1" placeholder="No reason provided."/>
                                </group>
                                <group string="Corrected Prompt" colspan="2">
                                    <field name="qc_corrected_prompt" string="Corrected Prompt" readonly="1" placeholder="No corrected prompt suggested."/>
                                </group>
                                <group string="Issues" colspan="2">
                                    <field name="qc_issues" string="Issues" readonly="1" placeholder="No issues."/>
                                </group>
                                <group string="Evaluated Prompt" colspan="2">
                                    <field name="qc_evaluated_prompt" string="Evaluated Prompt" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Extra Information" name="extra">
                            <group string="YouTube Metadata" invisible="not youtube_ingested_at">
                                <group>
                                    <field name="youtube_title" readonly="1"/>
                                    <field name="youtube_channel" readonly="1"/>
                                    <field name="youtube_video_id" readonly="1"/>
                                    <field name="youtube_ingested_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="youtube_duration_seconds" widget="float_time" readonly="1"/>
                                    <field name="youtube_resolution" readonly="1"/>
                                    <field name="youtube_fps" readonly="1"/>
                                    <field name="youtube_thumbnail_url" readonly="1" widget="url"/>
                                </group>
                            </group>
                            <group string="Source Details">
                                <group>
                                    <field name="s3_source_key" readonly="1"/>
                                    <field name="resolution" readonly="1"/>
                                    <field name="source_fps" readonly="1"/>
                                </group>
                                <group>
                                    <field name="duration_seconds" widget="float_time" readonly="1"/>
                                    <field name="source_size_mb" readonly="1"/>
                                </group>
                            </group>
                            <group string="Render Output" invisible="not edited_file_path">
                                <group>
                                    <field name="trim_start_seconds" widget="float_time" readonly="1"/>
                                    <field name="trim_end_seconds" widget="float_time" readonly="1"/>
                                    <field name="trim_duration_seconds" widget="float_time" readonly="1"/>
                                </group>
                                <group>
                                    <field name="edited_resolution" readonly="1"/>
                                    <field name="edited_fps" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Jobs"/>
                            <field name="job_ids" readonly="1">
                                <list decoration-info="status == 'queued'" decoration-warning="status == 'running'" decoration-success="status == 'done'" decoration-danger="status == 'failed'" decoration-muted="status == 'cancelled'">
                                    <field name="id"/>
                                    <field name="job_type"/>
                                    <field name="status" widget="badge"/>
                                    <field name="progress_text"/>
                                    <field name="started_at"/>
                                    <field name="finished_at"/>
                                    <field name="duration_ms"/>
                                    <button name="action_cancel" type="object" icon="fa-stop" invisible="status not in ('queued','running')"/>
                                    <button name="action_retry" type="object" icon="fa-refresh" invisible="status not in ('failed','cancelled')"/>
                                </list>
                            </field>
                            <separator string="Processing Logs"/>
                            <field name="processing_log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="level" widget="badge"/>
                                    <field name="operation"/>
                                    <field name="duration_ms"/>
                                    <field name="message"/>
                                </list>
                            </field>
                            <separator string="Editing Config"/>
                            <field name="editing_config" widget="text"/>
                            <separator string="Source Metadata"/>
                            <field name="source_metadata" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_video_editor_project_search" model="ir.ui.view">
        <field name="name">video.editor.project.search</field>
        <field name="model">video.editor.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="s3_source_url"/>
                <field name="assigned_to"/>
                <filter string="Draft" name="state_draft" domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="state_progress" domain="[('state','in',('processing','exporting'))]"/>
                <filter string="Processed" name="state_processed" domain="[('state','=','processed')]"/>
                <filter string="Exported" name="state_exported" domain="[('state','=','exported')]"/>
                <filter string="Failed" name="state_error" domain="[('state','=','error')]"/>
                <separator/>
                <filter string="Assigned to me" name="my_projects" domain="[('assigned_to','=',uid)]"/>
                <separator/>
                <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                <filter string="Assignee" name="group_assignee" context="{'group_by':'assigned_to'}"/>
            </search>
        </field>
    </record>

    <record id="action_video_editor_project" model="ir.actions.act_window">
        <field name="name">Crowley Sourcing</field>
        <field name="res_model">video.editor.project</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_video_editor_project_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new video project</p>
            <p>Paste an S3 URL, then open the editor to trim and export.</p>
        </field>
    </record>
</odoo>
