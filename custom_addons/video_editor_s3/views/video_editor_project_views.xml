<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_video_editor_project_list" model="ir.ui.view">
        <field name="name">video.editor.project.list</field>
        <field name="model">video.editor.project</field>
        <field name="arch" type="xml">
            <list string="Video Projects" decoration-info="state == 'draft'" decoration-warning="state in ('processing','exporting') or llm_qc_force_passed" decoration-success="state == 'exported'" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="s3_source_url"/>
                <field name="resolution"/>
                <field name="source_fps" optional="show"/>
                <field name="duration_seconds" widget="float_time"/>
                <field name="source_size_mb" widget="float"/>
                <field name="state" widget="badge"/>
                <field name="llm_qc_result" widget="badge" string="QC"
                       decoration-success="llm_qc_result == 'pass'"
                       decoration-danger="llm_qc_result == 'fail'"
                       decoration-warning="llm_qc_result == 'flag'"
                       optional="show"/>
                <field name="llm_qc_force_passed" widget="boolean_toggle" readonly="1"
                       string="Force Passed" optional="show"/>
                <field name="llm_qc_force_passed_by" string="Force-Passed By" optional="hide"/>
                <field name="llm_qc_force_passed_at" string="Force-Passed At" optional="hide"/>
                <field name="assigned_to" widget="many2one_avatar_user"/>
                <field name="active_job_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_video_editor_project_kanban" model="ir.ui.view">
        <field name="name">video.editor.project.kanban</field>
        <field name="model">video.editor.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="state"/>
                <field name="resolution"/>
                <field name="duration_seconds"/>
                <field name="assigned_to"/>
                <field name="active_job_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                                <field name="state" widget="badge"/>
                            </div>
                            <div class="o_kanban_record_body small text-muted">
                                <div t-if="record.resolution.raw_value"><field name="resolution"/></div>
                                <div t-if="record.duration_seconds.raw_value">
                                    Duration: <field name="duration_seconds" widget="float_time"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="assigned_to" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_video_editor_project_form" model="ir.ui.view">
        <field name="name">video.editor.project.form</field>
        <field name="model">video.editor.project</field>
        <field name="arch" type="xml">
            <form string="Video Project" js_class="video_editor_s3_project_form">
                <header>
                    <button name="action_ingest_youtube" type="object" string="Process Video" class="btn-primary"/>
                    <button name="action_open_editor" type="object" string="Open Editor" class="btn-primary" invisible="not s3_source_url"/>
                    <button name="action_copy_source_to_trimmed_url" type="object" string="Copy to Trimmed URL" invisible="not s3_source_url"/>
                    <button name="action_run_llm_qc" type="object" string="Run LLM QC" invisible="not output_s3_url or not prompt or not category or not style"/>
                    <button name="action_export" type="object" string="Export to S3" invisible="not edited_file_path or state in ('exporting', 'exported')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processed,exported"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_jobs" type="object" class="oe_stat_button" icon="fa-tasks" invisible="not job_ids">
                            <field name="job_ids" widget="statinfo" string="Jobs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Project name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_name"/>
                            <field name="category"/>
                            <field name="sub_category"/>
                            <field name="topic_name" required="1"/>
                            <field name="style"/>
                        </group>
                        <group>
                            <field name="youtube_url" placeholder="https://www.youtube.com/watch?v=..."/>
                            <field name="youtube_start_time" placeholder="00:06:50:000 (optional)" invisible="not youtube_url"/>
                            <field name="youtube_end_time" placeholder="00:07:03:000 (optional)" invisible="not youtube_url"/>
                            <field name="s3_source_url" widget="video_url_preview" options="{'stream_kind': 'source'}" placeholder="s3://bucket/path/to/video.mp4 or https URL"/>
                            <field name="output_s3_url" widget="video_url_preview" readonly="0"/>
                            <field name="assigned_to" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General Information" name="general">
                            <group string="Prompt">
                                <field name="prompt" placeholder="Prompt..."/>
                            </group>
                            <group string="LLM QC" col="1" invisible="not llm_evaluated_at">
                                <field name="llm_qc_force_passed" invisible="1"/>
                                <field name="llm_fixed_prompt" invisible="1"/>
                                <field name="llm_failure_reason" invisible="1"/>

                                <div class="alert alert-warning d-flex align-items-start mb-3" role="alert" invisible="not llm_qc_force_passed">
                                    <i class="fa fa-shield fa-2x me-3 text-warning"/>
                                    <div class="flex-grow-1">
                                        <h6 class="alert-heading mb-2"><strong>QC was force-passed</strong></h6>
                                        <div class="row g-2 small">
                                            <div class="col-md-4"><span class="text-muted">By:</span> <field name="llm_qc_force_passed_by" readonly="1" nolabel="1"/></div>
                                            <div class="col-md-4"><span class="text-muted">On:</span> <field name="llm_qc_force_passed_at" readonly="1" nolabel="1"/></div>
                                            <div class="col-md-4"><span class="text-muted">Reason:</span> <field name="llm_qc_force_pass_reason" readonly="1" nolabel="1" placeholder="(none provided)"/></div>
                                        </div>
                                        <div class="mt-2 text-muted small">The reviewer's original verdict is preserved below.</div>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center justify-content-between bg-light border rounded p-3 mb-3">
                                    <div>
                                        <div class="text-muted small text-uppercase fw-bold">Verdict</div>
                                        <div class="mt-1 fs-5">
                                            <field name="llm_qc_result" widget="badge"
                                                   decoration-success="llm_qc_result == 'pass'"
                                                   decoration-danger="llm_qc_result == 'fail'"
                                                   decoration-warning="llm_qc_result == 'flag'"
                                                   readonly="1" nolabel="1"/>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small text-uppercase fw-bold">Evaluated</div>
                                        <div class="mt-1"><field name="llm_evaluated_at" readonly="1" nolabel="1"/></div>
                                    </div>
                                </div>

                                <div class="border-start border-danger border-4 bg-light p-3 mb-3" invisible="not llm_failure_reason">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fa fa-exclamation-triangle text-danger me-2"/>
                                        <strong class="text-danger">Failure Reason</strong>
                                        <button name="action_run_llm_qc" type="object" string="Retry QC" icon="fa-refresh"
                                                class="btn btn-sm btn-secondary ms-auto me-2"
                                                invisible="not llm_evaluated_at or llm_qc_force_passed or llm_qc_result == 'pass'"/>
                                        <button name="action_force_pass_llm_qc" type="object" string="Force Pass" icon="fa-shield"
                                                class="btn btn-sm btn-warning me-2"
                                                confirm="This will mark the QC as PASSED while preserving the reviewer's original verdict. The override and your user are recorded in the chatter and form. Continue?"
                                                invisible="not llm_evaluated_at or llm_qc_force_passed or llm_qc_result == 'pass'"/>
                                        <button name="action_clear_llm_qc" type="object" string="Clear QC" icon="fa-trash"
                                                class="btn btn-sm btn-outline-danger"
                                                confirm="This will clear the LLM QC verdict, failure reason, fixed prompt and any force-pass record. The clearing is logged in the chatter. You can then click Run LLM QC to re-evaluate. Continue?"
                                                invisible="not llm_evaluated_at"/>
                                    </div>
                                    <field name="llm_failure_reason" nolabel="1" readonly="1" widget="text" class="w-100 d-block" placeholder="No failure reason recorded."/>
                                </div>

                                <div class="border-start border-primary border-4 bg-light p-3" invisible="not llm_fixed_prompt">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fa fa-magic text-primary me-2"/>
                                        <strong class="text-primary">Suggested Fix</strong>
                                        <button name="action_apply_fixed_prompt" type="object" string="Apply &amp; Retry" icon="fa-check"
                                                class="btn btn-sm btn-primary ms-auto"
                                                confirm="This will overwrite the project's Prompt with the reviewer's suggested fix. You can then click Retry QC to re-evaluate. Continue?"
                                                invisible="not llm_fixed_prompt"/>
                                    </div>
                                    <field name="llm_fixed_prompt" nolabel="1" readonly="1" widget="text" class="w-100 d-block" placeholder="No corrected prompt suggested."/>
                                </div>
                            </group>
                        </page>
                        <page string="Extra Information" name="extra">
                            <group string="YouTube Metadata" invisible="not youtube_ingested_at">
                                <group>
                                    <field name="youtube_title" readonly="0"/>
                                    <field name="youtube_channel" readonly="0"/>
                                    <field name="youtube_video_id" readonly="0"/>
                                    <field name="youtube_ingested_at" readonly="0"/>
                                </group>
                                <group>
                                    <field name="youtube_duration_seconds" widget="float_time" readonly="0"/>
                                    <field name="youtube_resolution" readonly="0"/>
                                    <field name="youtube_fps" readonly="0"/>
                                    <field name="youtube_thumbnail_url" readonly="0" widget="url"/>
                                </group>
                            </group>
                            <group string="Source Details">
                                <group>
                                    <field name="s3_source_key" readonly="0"/>
                                    <field name="resolution" readonly="0"/>
                                    <field name="source_fps" readonly="0"/>
                                </group>
                                <group>
                                    <field name="duration_seconds" widget="float_time" readonly="0"/>
                                    <field name="source_size_mb" readonly="0"/>
                                </group>
                            </group>
                            <group string="Render Output" invisible="not edited_file_path">
                                <group>
                                    <field name="trim_start_seconds" widget="float_time" readonly="0"/>
                                    <field name="trim_end_seconds" widget="float_time" readonly="0"/>
                                    <field name="trim_duration_seconds" widget="float_time" readonly="0"/>
                                </group>
                                <group>
                                    <field name="edited_resolution" readonly="0"/>
                                    <field name="edited_fps" readonly="0"/>
                                </group>
                            </group>
                            <separator string="Jobs"/>
                            <field name="job_ids" readonly="1">
                                <list decoration-info="status == 'queued'" decoration-warning="status == 'running'" decoration-success="status == 'done'" decoration-danger="status == 'failed'" decoration-muted="status == 'cancelled'">
                                    <field name="id"/>
                                    <field name="job_type"/>
                                    <field name="status" widget="badge"/>
                                    <field name="progress_text"/>
                                    <field name="started_at"/>
                                    <field name="finished_at"/>
                                    <field name="duration_ms"/>
                                    <button name="action_cancel" type="object" icon="fa-stop" invisible="status not in ('queued','running')"/>
                                    <button name="action_retry" type="object" icon="fa-refresh" invisible="status not in ('failed','cancelled')"/>
                                </list>
                            </field>
<!--                            <separator string="Processing Logs"/>-->
<!--                            <field name="processing_log_ids" readonly="1">-->
<!--                                <list>-->
<!--                                    <field name="create_date"/>-->
<!--                                    <field name="level" widget="badge"/>-->
<!--                                    <field name="operation"/>-->
<!--                                    <field name="duration_ms"/>-->
<!--                                    <field name="message"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                            <separator string="Editing Config"/>-->
<!--                            <field name="editing_config" widget="text"/>-->
<!--                            <separator string="Source Metadata"/>-->
<!--                            <field name="source_metadata" widget="text"/>-->
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_video_editor_project_search" model="ir.ui.view">
        <field name="name">video.editor.project.search</field>
        <field name="model">video.editor.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="s3_source_url"/>
                <field name="assigned_to"/>
                <filter string="Draft" name="state_draft" domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="state_progress" domain="[('state','in',('processing','exporting'))]"/>
                <filter string="Processed" name="state_processed" domain="[('state','=','processed')]"/>
                <filter string="Exported" name="state_exported" domain="[('state','=','exported')]"/>
                <filter string="Failed" name="state_error" domain="[('state','=','error')]"/>
                <separator/>
                <filter string="QC Pass" name="qc_pass" domain="[('llm_qc_result','=','pass')]"/>
                <filter string="QC Fail" name="qc_fail" domain="[('llm_qc_result','=','fail')]"/>
                <filter string="QC Flag" name="qc_flag" domain="[('llm_qc_result','=','flag')]"/>
                <filter string="Force Passed" name="qc_force_passed" domain="[('llm_qc_force_passed','=',True)]"/>
                <filter string="QC Fail (not force-passed)" name="qc_fail_not_forced" domain="[('llm_qc_result','=','fail'),('llm_qc_force_passed','=',False)]"/>
                <separator/>
                <filter string="Assigned to me" name="my_projects" domain="[('assigned_to','=',uid)]"/>
                <separator/>
                <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                <filter string="QC Result" name="group_qc_result" context="{'group_by':'llm_qc_result'}"/>
                <filter string="Force Passed" name="group_force_passed" context="{'group_by':'llm_qc_force_passed'}"/>
                <filter string="Assignee" name="group_assignee" context="{'group_by':'assigned_to'}"/>
            </search>
        </field>
    </record>

    <record id="action_video_editor_project" model="ir.actions.act_window">
        <field name="name">Crowley Sourcing</field>
        <field name="res_model">video.editor.project</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_video_editor_project_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new video project</p>
            <p>Paste an S3 URL, then open the editor to trim and export.</p>
        </field>
    </record>
</odoo>
