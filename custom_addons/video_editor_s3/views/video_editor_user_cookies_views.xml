<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_video_editor_user_cookies_form_self" model="ir.ui.view">
        <field name="name">video.editor.user.cookies.form.self</field>
        <field name="model">video.editor.user.cookies</field>
        <field name="arch" type="xml">
            <form string="My YouTube Cookies">
                <header>
                    <button name="action_test_cookies"
                            string="Test Cookies"
                            type="object"
                            class="btn-primary"
                            invisible="not has_cookies"/>
                    <button name="action_clear_cookies"
                            string="Remove Cookies"
                            type="object"
                            class="btn-secondary"
                            invisible="not has_cookies"
                            confirm="Remove your uploaded YouTube cookies file?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>My YouTube Cookies</h1>
                        <p class="text-muted mb-0">
                            Upload your own Netscape-format <code>cookies.txt</code> so
                            YouTube ingest jobs you trigger use <strong>your</strong>
                            signed-in session. Each user/tasker uploads their own file
                            to prevent cookie collisions when multiple people run jobs
                            from different browsers.
                        </p>
                    </div>
                    <group>
                        <group string="Upload">
                            <field name="user_id" readonly="1"/>
                            <field name="uploaded_at" readonly="1"/>
                            <field name="cookies_file"
                                   filename="cookies_filename"
                                   widget="binary"/>
                            <field name="cookies_filename" invisible="1"/>
                            <field name="has_cookies" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info mt-3" role="alert">
                        <h5 class="alert-heading">How to export a fresh cookies file</h5>
                        <ol class="mb-0">
                            <li>Open a <strong>NEW private / incognito</strong> browser window.</li>
                            <li>Log in to YouTube in that window.</li>
                            <li>Visit <code>https://www.youtube.com/robots.txt</code> in the same tab.</li>
                            <li>Export youtube.com cookies via the
                                <strong>'Get cookies.txt LOCALLY'</strong> extension (Chrome / Edge)
                                or <strong>'cookies.txt'</strong> (Firefox) to a Netscape-format
                                <code>.txt</code> file.</li>
                            <li><strong>CLOSE</strong> the incognito window — this freezes the
                                session so YouTube does not rotate the cookies.</li>
                            <li>Upload the <code>.txt</code> file above and click <em>Save</em>.</li>
                            <li>Click <em>Test Cookies</em> to verify the file is valid.</li>
                        </ol>
                    </div>
                    <div class="alert alert-warning mt-2" role="alert" invisible="has_cookies">
                        <strong>No file uploaded yet.</strong>
                        While empty, your YouTube jobs will fall back to admin-level cookies
                        (uploaded by your administrator in Settings) or the host browser.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_video_editor_user_cookies_list" model="ir.ui.view">
        <field name="name">video.editor.user.cookies.list</field>
        <field name="model">video.editor.user.cookies</field>
        <field name="arch" type="xml">
            <list string="YouTube Cookies (per user)">
                <field name="user_id"/>
                <field name="cookies_filename"/>
                <field name="has_cookies"/>
                <field name="uploaded_at"/>
            </list>
        </field>
    </record>

    <record id="action_video_editor_user_cookies_mine" model="ir.actions.server">
        <field name="name">My YouTube Cookies</field>
        <field name="model_id" ref="model_video_editor_user_cookies"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_mine()</field>
    </record>

    <record id="action_video_editor_user_cookies_all" model="ir.actions.act_window">
        <field name="name">YouTube Cookies (all users)</field>
        <field name="res_model">video.editor.user.cookies</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>
