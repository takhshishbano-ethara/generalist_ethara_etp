<odoo>
    <!-- Tree View -->
    <record id="view_s3_connector_tree" model="ir.ui.view">
        <field name="name">s3.connector.tree</field>
        <field name="model">s3.connector</field>
        <field name="arch" type="xml">
            <list string="S3 Connectors">
                <field name="name"/>
                <field name="region_name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_s3_connector_form" model="ir.ui.view">
        <field name="name">s3.connector.form</field>
        <field name="model">s3.connector</field>
        <field name="arch" type="xml">
            <form string="S3 Connector">
                <header>
                    <button name="test_connection" type="object" string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="region_name"/>
                        <field name="cdn_url"/>
                        <field name="aws_access_key_id"/>
                        <field name="aws_secret_access_key"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_s3_connector" model="ir.actions.act_window">
        <field name="name">S3 Connectors</field>
        <field name="res_model">s3.connector</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create your S3 connectors here.
            </p>
        </field>
    </record>

    <!-- Menu under Technical -->
    <menuitem id="menu_s3_root" name="S3 Connectors" />
    <menuitem id="menu_s3_connector_root" name="S3 Connectors" parent="s3_connector.menu_s3_root" action="action_s3_connector" sequence="100"/>
</odoo>
