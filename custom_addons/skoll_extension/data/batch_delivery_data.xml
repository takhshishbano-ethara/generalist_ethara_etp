<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_skoll_batch_delivery" model="ir.sequence">
            <field name="name">Skoll Batch Delivery</field>
            <field name="code">skoll.batch.delivery</field>
            <field name="prefix">SKL/BATCH/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <record id="action_add_skoll_tasks_to_batch" model="ir.actions.server">
            <field name="name">Add to Batch Delivery</field>
            <field name="model_id" ref="skoll.model_skoll_skoll"/>
            <field name="binding_model_id" ref="skoll.model_skoll_skoll"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = {
    'type': 'ir.actions.act_window',
    'name': 'Add to Batch Delivery',
    'res_model': 'skoll.batch.delivery.add.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'active_ids': records.ids, 'active_model': 'skoll.skoll'},
}
            </field>
        </record>
    </data>
</odoo>
