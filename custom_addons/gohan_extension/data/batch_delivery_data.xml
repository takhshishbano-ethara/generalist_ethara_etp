<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_gohan_batch_delivery" model="ir.sequence">
        <field name="name">Gohan Batch Delivery</field>
        <field name="code">gohan.batch.delivery</field>
        <field name="prefix">GOH/BATCH/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next_actual">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="action_gohan_job_add_to_batch_server" model="ir.actions.server">
        <field name="name">Add to Batch Delivery</field>
        <field name="model_id" ref="gohan.model_gohan_job"/>
        <field name="binding_model_id" ref="gohan.model_gohan_job"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = {
    "type": "ir.actions.act_window",
    "name": "Add to Batch Delivery",
    "res_model": "gohan.batch.delivery.add.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {
        "active_model": "gohan.job",
        "active_ids": records.ids,
        "default_job_ids": [(6, 0, records.ids)],
    },
}</field>
    </record>

</odoo>
