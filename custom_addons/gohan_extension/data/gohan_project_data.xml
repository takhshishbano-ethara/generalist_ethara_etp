<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Gohan project record itself is noupdate="1": it is auto-created on
         install, then owned by the team — re-running an upgrade must not reset
         the name or wipe the tasker / QC reviewer / lead assignments configured
         in the UI. -->
    <data noupdate="1">

        <!-- Auto-created Gohan project. Classified `internal` so the Flutter
             project detail renders the InternalOverviewTab / InternalAnalyticsTab,
             which parse the crowley-style response shape the gohan_ext
             endpoints return. (External projects render OverviewTab/AnalyticsTab,
             which expect the gohan-style `overview_dashboard`/`dashboard` shape
             and would show blank against this payload.) Internal projects are
             managed from the base Project app; assign team members (PL / QC
             reviewer / taskers) there after install so the project shows for
             non-admin users and so the role-scoped dashboards return data. -->
        <record id="project_gohan_internal" model="project.project">
            <field name="name">Gohan</field>
            <field name="project_classification">internal</field>
            <field name="connected_table">gohan.job</field>
            <field name="category_url">/v1/gohan_ext/categories</field>
            <field name="tasker_url">/v1/gohan_ext/taskers</field>
            <!-- The project list domain (_task_forge_live_domain) only returns
                 projects that are BOTH task_forge_status='live' AND
                 non_stemp_project_status='production'; without these the project
                 never appears in /projects. -->
            <field name="task_forge_status">live</field>
            <field name="non_stemp_project_status">production</field>
        </record>

    </data>

    <!-- Tab → endpoint mappings. These feed the Flutter project detail
         `tab_list` (built in api_map_ids order, which follows the model's
         `_order = sequence, id`). They are pure config-as-code, so this block is
         noupdate="0" (the default): an upgrade keeps the 6 tabs and their order
         authoritative. The order below matches the pen design:
             Overview · Team · Tasks · URLs Added · Analytics · Logs.

         Two rules every value MUST obey:
           1. table_name normalizes (lowercase, strip spaces/underscores) to a
              key the Flutter tab switch knows: overview / team / tasks /
              urlsadded / analytics / logs. An unknown name renders a blank tab.
           2. api_prefix is relative to BASE_URL (which already ends in `/api/`),
              so it starts at `/v1/...` (NOT `/api/v1`, which would 404), and
              ends with `?project_id=` so the app can append the project id and
              `&start_date=…&search=…` onto a valid query string. Without the
              `?`, the params fuse into the path and the request 404s. -->
    <data>

        <record id="api_map_gohan_overview" model="etp.external.project.api.map">
            <field name="project_id" ref="project_gohan_internal"/>
            <field name="sequence">10</field>
            <field name="table_name">Overview</field>
            <field name="field_name">overview</field>
            <field name="api_prefix">/v1/gohan_ext/dashboard_overview?project_id=</field>
        </record>

        <!-- Team tab. "Team" normalizes to the app's built-in TeamTab, which
             renders the project's members from the SHARED
             /v2/project_team_member_list endpoint by project id (it does NOT use
             this api_prefix for content). The prefix must still be a non-empty,
             200-returning path: the screen early-returns on an empty api_prefix
             before dispatching the team-members fetch, and it also issues a
             generic GET against this prefix. /v1/get_notification_grouped is the
             harmless known-good endpoint used here (same pattern as Logs). -->
        <record id="api_map_gohan_team" model="etp.external.project.api.map">
            <field name="project_id" ref="project_gohan_internal"/>
            <field name="sequence">20</field>
            <field name="table_name">Team</field>
            <field name="field_name">team</field>
            <field name="api_prefix">/v1/get_notification_grouped?project_id=</field>
        </record>

        <record id="api_map_gohan_tasks" model="etp.external.project.api.map">
            <field name="project_id" ref="project_gohan_internal"/>
            <field name="sequence">30</field>
            <field name="table_name">Tasks</field>
            <field name="field_name">tasks</field>
            <field name="api_prefix">/v1/gohan_ext/task_view_dashboard?project_id=</field>
        </record>

        <!-- URLs Added tab. URL-centric view of gohan.job (Website URL /
             Category / Added by / Assigned Tasker / Source / Date added), served
             by the dedicated /v1/gohan_ext/urls_added endpoint. -->
        <record id="api_map_gohan_urls" model="etp.external.project.api.map">
            <field name="project_id" ref="project_gohan_internal"/>
            <field name="sequence">40</field>
            <field name="table_name">URLs Added</field>
            <field name="field_name">urls</field>
            <field name="api_prefix">/v1/gohan_ext/urls_added?project_id=</field>
        </record>

        <record id="api_map_gohan_analytics" model="etp.external.project.api.map">
            <field name="project_id" ref="project_gohan_internal"/>
            <field name="sequence">50</field>
            <field name="table_name">Analytics</field>
            <field name="field_name">analytics</field>
            <field name="api_prefix">/v1/gohan_ext/analytics_dashboard?project_id=</field>
        </record>

        <!-- Logs tab. "Logs" normalizes to the app's built-in LogsTab, which
             fetches the project's grouped notification/activity feed from the
             shared /v1/get_notification_grouped endpoint by project id (it does
             NOT use this api_prefix). The prefix is set to that endpoint anyway
             for consistency. -->
        <record id="api_map_gohan_logs" model="etp.external.project.api.map">
            <field name="project_id" ref="project_gohan_internal"/>
            <field name="sequence">60</field>
            <field name="table_name">Logs</field>
            <field name="field_name">logs</field>
            <field name="api_prefix">/v1/get_notification_grouped?project_id=</field>
        </record>

    </data>
</odoo>
