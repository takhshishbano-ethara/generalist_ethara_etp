<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Per-category sequences for the dataset filename convention
        T2AV_<category>_<NNNNNNN>.mp4 (padding 7 since v19.0.1.14.0 to match
        the published 523 master/failures dataset). Each category has its own
        counter starting at 0000001. `implementation=no_gap` guarantees no
        gaps even on rollback (uses a row-level lock instead of a PG sequence)
        — critical for dataset integrity: a failed upload releases the slot.
    -->

    <record id="seq_t2av_attempt_av_sync_sound_effects" model="ir.sequence">
        <field name="name">T2AV Attempt: AV Sync Sound Effects</field>
        <field name="code">t2av.attempt.av_sync_sound_effects</field>
        <field name="padding">7</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="implementation">no_gap</field>
    </record>

