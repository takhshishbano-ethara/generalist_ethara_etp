<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
        Disabled 2026-06-10: moving fully away from ir.cron.
        Replaced by self-rescheduling RabbitMQ poll messages per attempt
        (see services/rabbitmq_service.schedule_poll and consumer.py poll handler).
        Records remain in XML for rollback only.

        <record id="ir_cron_t2av_poll_openrouter" model="ir.cron">
            <field name="name">T2AV: Poll OpenRouter Attempts</field>
            <field name="model_id" ref="model_t2av_attempt"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_openrouter()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_t2av_watchdog_enrichments" model="ir.cron">
            <field name="name">T2AV: Watchdog Stuck Enrichments</field>
            <field name="model_id" ref="model_t2av_enrichment"/>
            <field name="state">code</field>
            <field name="code">model._cron_watchdog()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        -->

        <!--
        Disabled 2026-06-10: moving away from ir.cron-based workflow.
        These three video-review crons are replaced by event-driven equivalents:
          - watchdog_reviews     -> per-record TTL message on review submit (delayed RabbitMQ msg)
          - run_queued_reviews   -> direct publish to a 't2av.review' queue on create; ThreadPool consumer handles them
          - reap_stale_stack_locks -> postcommit one-shot timer per lock (or TransientModel autovacuum)
        See chat 2026-06-10 for design. Records remain in XML for rollback only.

        <record id="ir_cron_t2av_watchdog_reviews" model="ir.cron">
            <field name="name">T2AV: Watchdog Stuck Video Reviews</field>
            <field name="model_id" ref="model_t2av_video_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_watchdog()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_t2av_run_queued_reviews" model="ir.cron">
            <field name="name">T2AV: Run Queued Video Reviews</field>
            <field name="model_id" ref="model_t2av_video_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_queued_reviews()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_t2av_reap_stale_stack_locks" model="ir.cron">
            <field name="name">T2AV: Reap Stale Stack Locks</field>
            <field name="model_id" ref="model_t2av_video_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_reap_stale_stack_locks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        -->

        <!--
        Disabled 2026-06-10: superseded by handle_poll_message (event-driven).
        Pipeline liveness no longer needs a periodic sweep.

        <record id="ir_cron_t2av_watchdog_pipeline" model="ir.cron">
            <field name="name">T2AV: Watchdog Stuck Pipelines</field>
            <field name="model_id" ref="model_t2av_generation"/>
            <field name="state">code</field>
            <field name="code">model._cron_watchdog_pipeline()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        -->
    </data>
</odoo>
