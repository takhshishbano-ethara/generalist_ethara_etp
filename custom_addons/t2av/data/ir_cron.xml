<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_t2av_poll_openrouter" model="ir.cron">
            <field name="name">T2AV: Poll OpenRouter Attempts</field>
            <field name="model_id" ref="model_t2av_attempt"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_openrouter()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_t2av_watchdog_enrichments" model="ir.cron">
            <field name="name">T2AV: Watchdog Stuck Enrichments</field>
            <field name="model_id" ref="model_t2av_enrichment"/>
            <field name="state">code</field>
            <field name="code">model._cron_watchdog()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_t2av_watchdog_reviews" model="ir.cron">
            <field name="name">T2AV: Watchdog Stuck Video Reviews</field>
            <field name="model_id" ref="model_t2av_video_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_watchdog()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_t2av_run_queued_reviews" model="ir.cron">
            <field name="name">T2AV: Run Queued Video Reviews</field>
            <field name="model_id" ref="model_t2av_video_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_queued_reviews()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
