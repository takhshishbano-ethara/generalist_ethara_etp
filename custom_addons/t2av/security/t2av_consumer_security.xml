<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_t2av_consumer" model="res.groups">
            <field name="name">Pipeline Consumer</field>
            <field name="privilege_id" ref="res_groups_privilege_t2av"/>
            <field name="implied_ids" eval="[(4, ref('group_t2av_manager'))]"/>
        </record>

        <record id="user_t2av_consumer_bot" model="res.users">
            <field name="name">T2AV Pipeline Consumer Bot</field>
            <field name="login">t2av_consumer_bot</field>
            <field name="email">t2av-bot@ethara.ai</field>
            <field name="active" eval="True"/>
            <field name="share" eval="False"/>
            <field name="group_ids" eval="[(6, 0, [ref('group_t2av_consumer')])]"/>
        </record>
    </data>
</odoo>
