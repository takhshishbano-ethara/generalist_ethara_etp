<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_t2av_enrichment_user" model="ir.rule">
            <field name="name">T2AV Enrichment: user sees own jobs only</field>
            <field name="model_id" ref="model_t2av_enrichment"/>
            <field name="domain_force">[('job_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('t2av.group_t2av_user'))]"/>
        </record>

        <record id="rule_t2av_enrichment_manager" model="ir.rule">
            <field name="name">T2AV Enrichment: manager sees company jobs</field>
            <field name="model_id" ref="model_t2av_enrichment"/>
            <field name="domain_force">[('job_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('t2av.group_t2av_manager'))]"/>
        </record>

        <record id="rule_t2av_video_review_user" model="ir.rule">
            <field name="name">T2AV Video Review: user sees own jobs only</field>
            <field name="model_id" ref="model_t2av_video_review"/>
            <field name="domain_force">[('job_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('t2av.group_t2av_user'))]"/>
        </record>

        <record id="rule_t2av_video_review_manager" model="ir.rule">
            <field name="name">T2AV Video Review: manager sees company jobs</field>
            <field name="model_id" ref="model_t2av_video_review"/>
            <field name="domain_force">[('job_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('t2av.group_t2av_manager'))]"/>
        </record>

        <!-- COMMENTED OUT for 19.0.1.19.0 hide-stack release
        <record id="rule_t2av_video_review_reviewer" model="ir.rule">
            <field name="name">T2AV Video Review: reviewer sees own assigned + queued pickable pool</field>
            <field name="model_id" ref="model_t2av_video_review"/>
            <field name="domain_force">['|', ('assigned_to_id', '=', user.id), '&amp;', '&amp;', ('provider', '=', 'human'), ('state', '=', 'queued'), ('assigned_to_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('t2av.group_t2av_reviewer'))]"/>
        </record>
        -->

    </data>
</odoo>
