<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_t2av_stack_review_wizard_form" model="ir.ui.view">
        <field name="name">t2av.stack.review.wizard.form</field>
        <field name="model">t2av.stack.review.wizard</field>
        <field name="arch" type="xml">
            <form string="T2AV Stack — Human Review">
                <header>
                    <button name="action_save_next" type="object"
                            string="Save &amp; Next" class="btn-primary"/>
                    <button name="action_save" type="object"
                            string="Save" class="btn-secondary"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="review_id" readonly="1" nolabel="1"/>
                        </h2>
                    </div>
                    <group string="Video">
                        <field name="video_url" widget="t2av_video_player" nolabel="1"
                               colspan="2" readonly="1"/>
                    </group>
                    <group>
                        <group string="Job">
                            <field name="job_id" readonly="1"/>
                            <field name="attempt_id" readonly="1"/>
                            <field name="category" readonly="1"/>
                            <field name="sub_category" readonly="1"/>
                            <field name="style" readonly="1"/>
                            <field name="priority" readonly="1"/>
                            <field name="complexity" readonly="1"/>
                            <field name="language" readonly="1"/>
                            <field name="topic" readonly="1"/>
                        </group>
                        <group string="Output">
                            <field name="duration" readonly="1"/>
                            <field name="resolution" readonly="1"/>
                            <field name="aspect_ratio" readonly="1"/>
                            <field name="fps" readonly="1"/>
                            <field name="speaker_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prompt" name="page_prompt">
                            <field name="prompt" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Enriched Prompt" name="page_enriched_prompt">
                            <field name="enriched_prompt" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Golden Prompt" name="page_golden_prompt">
                            <field name="golden_prompt" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                    <group string="Verdict">
                        <field name="qc_status" widget="radio"/>
                    </group>
                    <group string="Reviewer Notes (required)">
                        <field name="reviewer_notes" nolabel="1"
                               placeholder="Explain why this video passed or failed. Captured verbatim on the review and posted to the job's chatter."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_stack" model="ir.actions.server">
        <field name="name">T2AV Stack — Open Next</field>
        <field name="model_id" ref="model_t2av_stack_review_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env["t2av.stack.review.wizard"].open_next()</field>
    </record>

</odoo>
