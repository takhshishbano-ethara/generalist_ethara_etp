<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_t2av_sequence_sheet_export_wizard_form" model="ir.ui.view">
            <field name="name">t2av.sequence.sheet.export.wizard.form</field>
            <field name="model">t2av.sequence.sheet.export.wizard</field>
            <field name="arch" type="xml">
                <form string="Export Sequence Sheet">
                    <sheet>
                        <group>
                            <group string="Filters">
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="category"/>
                                <field name="include_passed"/>
                                <field name="include_failed"/>
                            </group>
                            <group string="Output">
                                <field name="row_count" readonly="1"/>
                                <field name="exported_file" filename="exported_filename"
                                       readonly="1" invisible="not exported_file"/>
                                <field name="exported_filename" invisible="1"/>
                            </group>
                        </group>
                        <div class="alert alert-info" role="alert"
                             invisible="exported_file">
                            <i class="fa fa-info-circle"/>
                            Select filters then click <b>Build XLSX</b>. The file
                            attaches itself for download once the build finishes.
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_build_xlsx" type="object" string="Build XLSX"
                                class="btn-primary" invisible="exported_file"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
