<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_t2av_sequence_sheet_row_list" model="ir.ui.view">
            <field name="name">t2av.sequence.sheet.row.list</field>
            <field name="model">t2av.sequence.sheet.row</field>
            <field name="arch" type="xml">
                <list string="Sequence Sheet Rows"
                      decoration-success="sheet_type == 'passed'"
                      decoration-danger="sheet_type == 'failed'">
                    <field name="item_id"/>
                    <field name="sheet_type"/>
                    <field name="category"/>
                    <field name="sub_category" optional="show"/>
                    <field name="style" optional="show"/>
                    <field name="priority" optional="hide"/>
                    <field name="language" optional="hide"/>
                    <field name="duration_seconds" optional="hide"/>
                    <field name="resolution" optional="hide"/>
                    <field name="fps" optional="hide"/>
                    <field name="speaker_count" optional="hide"/>
                    <field name="contains_dialogue" optional="hide"/>
                    <field name="issues" optional="show"/>
                    <field name="enriched_prompt" optional="hide"/>
                    <field name="create_date" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_t2av_sequence_sheet_row_form" model="ir.ui.view">
            <field name="name">t2av.sequence.sheet.row.form</field>
            <field name="model">t2av.sequence.sheet.row</field>
            <field name="arch" type="xml">
                <form string="Sequence Sheet Row">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="item_id" readonly="1"/></h1>
                            <field name="sheet_type" widget="badge"
                                   decoration-success="sheet_type == 'passed'"
                                   decoration-danger="sheet_type == 'failed'"/>
                        </div>
                        <group>
                            <group string="Identity">
                                <field name="review_id"/>
                                <field name="attempt_id"/>
                                <field name="job_id"/>
                                <field name="sequence_number"/>
                            </group>
                            <group string="Classification">
                                <field name="category"/>
                                <field name="sub_category"/>
                                <field name="style"/>
                                <field name="priority"/>
                                <field name="complexity"/>
                                <field name="language"/>
                            </group>
                        </group>
                        <group>
                            <group string="Rendering">
                                <field name="duration_seconds"/>
                                <field name="resolution"/>
                                <field name="fps"/>
                                <field name="contains_dialogue"/>
                                <field name="speaker_count"/>
                            </group>
                            <group string="Asset">
                                <field name="video_file" widget="url"/>
                                <field name="topic"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Prompt">
                                <field name="prompt" nolabel="1"/>
                            </page>
                            <page string="Enriched Prompt"
                                  invisible="not enriched_prompt">
                                <field name="enriched_prompt" nolabel="1"
                                       placeholder="Snapshot of the OpenRouter-enriched prompt (raw, pre-validator)."/>
                            </page>
                            <page string="Visual Description">
                                <field name="visual_description" nolabel="1"/>
                            </page>
                            <page string="Audio Description">
                                <field name="audio_description" nolabel="1"/>
                            </page>
                            <page string="Dialogue Transcript"
                                  invisible="not contains_dialogue">
                                <field name="dialogue_transcript" nolabel="1"/>
                            </page>
                            <page string="Issues" invisible="sheet_type != 'failed'">
                                <field name="issues" nolabel="1"
                                       placeholder="Top FATAL/MAJOR findings auto-populated; editable before export."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_t2av_sequence_sheet_row_search" model="ir.ui.view">
            <field name="name">t2av.sequence.sheet.row.search</field>
            <field name="model">t2av.sequence.sheet.row</field>
            <field name="arch" type="xml">
                <search>
                    <field name="item_id"/>
                    <field name="category"/>
                    <field name="topic"/>
                    <field name="job_id"/>
                    <filter name="filter_passed" string="Passed"
                            domain="[('sheet_type', '=', 'passed')]"/>
                    <filter name="filter_failed" string="Failed"
                            domain="[('sheet_type', '=', 'failed')]"/>
                    <separator/>
                    <group>
                        <filter name="group_sheet_type" string="Sheet Type"
                                context="{'group_by': 'sheet_type'}"/>
                        <filter name="group_category" string="Category"
                                context="{'group_by': 'category'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_t2av_sequence_sheet_row" model="ir.actions.act_window">
            <field name="name">Sequence Sheet Rows</field>
            <field name="res_model">t2av.sequence.sheet.row</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_sheet_type': 1}</field>
        </record>

        <record id="action_t2av_sequence_sheet_export" model="ir.actions.act_window">
            <field name="name">Export Sequence Sheet (.xlsx)</field>
            <field name="res_model">t2av.sequence.sheet.export.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
