<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']" position="inside">
            <CogMenu t-if="hasSelectedRecords and !env.isSmall and props.resModel === 't2av.generation'"
                     t-props="this.actionMenuProps"
                     hasSelectedRecords="hasSelectedRecords"/>
        </xpath>
    </t>

</templates>
