<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_i2i" model="ir.module.category">
            <field name="name">I2I</field>
            <field name="description">Image-to-Image QC</field>
            <field name="sequence">95</field>
        </record>

        <record id="res_groups_privilege_i2i" model="res.groups.privilege">
            <field name="name">I2I</field>
            <field name="sequence">95</field>
            <field name="category_id" ref="module_category_i2i"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="group_i2i_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_i2i"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_i2i_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_i2i"/>
            <field name="implied_ids" eval="[(4, ref('group_i2i_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
