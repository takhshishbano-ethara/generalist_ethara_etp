<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_i2i_project_user_member" model="ir.rule">
            <field name="name">I2I Project: members see their projects</field>
            <field name="model_id" ref="model_i2i_project"/>
            <field name="domain_force">['|', ('member_ids', 'in', [user.id]), ('manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_i2i_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_i2i_project_manager" model="ir.rule">
            <field name="name">I2I Project: Managers see company projects</field>
            <field name="model_id" ref="model_i2i_project"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_i2i_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_i2i_item_user" model="ir.rule">
            <field name="name">I2I Item: User sees own or assigned</field>
            <field name="model_id" ref="model_i2i_item"/>
            <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('assigned_user_id', '=', user.id), ('project_id.member_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_i2i_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_i2i_item_manager" model="ir.rule">
            <field name="name">I2I Item: Manager sees company items</field>
            <field name="model_id" ref="model_i2i_item"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_i2i_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
