<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_i2i_project_list" model="ir.ui.view">
            <field name="name">i2i.project.list</field>
            <field name="model">i2i.project</field>
            <field name="arch" type="xml">
                <list string="I2I Projects">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="manager_id"/>
                    <field name="item_count" string="Items"/>
                    <field name="items_pending_count" string="Pending"/>
                    <field name="items_approved_count" string="Approved"/>
                    <field name="items_rejected_count" string="Rejected"/>
                    <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state == 'archived'"/>
                </list>
            </field>
        </record>

        <record id="view_i2i_project_form" model="ir.ui.view">
            <field name="name">i2i.project.form</field>
            <field name="model">i2i.project</field>
            <field name="arch" type="xml">
                <form string="I2I Project">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="active,archived"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_open_items" icon="fa-list">
                                <field name="item_count" widget="statinfo" string="Items"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="Project Name"/></h1>
                            <field name="code" readonly="1"/>
                        </div>
                        <group>
                            <group>
                                <field name="default_project_type"/>
                                <field name="manager_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="items_pending_count" readonly="1"/>
                                <field name="items_approved_count" readonly="1"/>
                                <field name="items_rejected_count" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" placeholder="Project description..."/>
                            </page>
                            <page string="Members" name="members">
                                <field name="member_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            </page>
                            <page string="Items" name="items">
                                <field name="item_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="instruction"/>
                                        <field name="llm_status" widget="badge"/>
                                        <field name="state" widget="badge"/>
                                        <field name="qc_reviewer_id"/>
                                        <field name="qc_date"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_i2i_project_search" model="ir.ui.view">
            <field name="name">i2i.project.search</field>
            <field name="model">i2i.project</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="manager_id"/>
                    <field name="member_ids"/>
                    <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                    <filter string="Archived" name="filter_archived" domain="[('state', '=', 'archived')]"/>
                    <separator/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <record id="action_i2i_project" model="ir.actions.act_window">
            <field name="name">I2I Projects</field>
            <field name="res_model">i2i.project</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_i2i_project_search"/>
            <field name="context">{'search_default_filter_active': 1}</field>
        </record>
    </data>
</odoo>
