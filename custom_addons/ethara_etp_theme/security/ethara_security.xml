<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Each user may only see and manage their own favorite menus. -->
    <record id="ethara_menu_favorite_user_rule" model="ir.rule">
        <field name="name">Ethara Favorite Menu: own records only</field>
        <field name="model_id" ref="model_ethara_menu_favorite"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>
