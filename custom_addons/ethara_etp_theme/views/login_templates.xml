<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- priority="99" makes this apply after the website module's
         "Website Login Layout" (priority 20), which replaces the same
         "t[@t-call]" block. Replacing it last lets the Ethara login
         templates win on website-enabled databases too. -->
    <template id="ethara_login_layout" inherit_id="web.login_layout"
              name="Ethara Login Layout" priority="99">

        <xpath expr="t[@t-call]" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>

                <t t-set="ethara_login_tmpl"
                   t-value="request.env['ir.config_parameter'].sudo().get_param('ethara_etp_theme.login_template', 'centered')"/>
                <t t-set="ethara_login_image"
                   t-value="request.env['ir.config_parameter'].sudo().get_param('ethara_etp_theme.login_image_url', '')"/>
                <t t-set="ethara_company_name"
                   t-value="request.env['res.company'].sudo().search([], limit=1).name"/>
                <t t-set="body_classname"
                   t-value="'o_ethara_login o_ethara_login_' + ethara_login_tmpl"/>
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>

                <div class="o_ethara_login_aside">
                    <div class="o_ethara_login_media"
                         t-attf-style="#{('background-image:url(' + ethara_login_image + ');') if ethara_login_image else ''}"/>
                    <div class="o_ethara_login_overlay"/>
                    <div class="o_ethara_login_brand">
                        <img class="o_ethara_login_brand_logo"
                             t-attf-src="/web/binary/company_logo#{'?dbname=' + db if db else ''}"
                             alt="Logo"/>
                    </div>
                </div>

                <div class="container py-5">
                    <div t-attf-class="card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list" style="max-width: 300px;">
                        <div class="card-body">
                            <div class="text-center pb-3 border-bottom mb-4">
                                <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Logo" style="max-height:120px; max-width: 100%; width:auto"/>
                            </div>
                            <t t-out="0"/>
                            <div class="text-center small mt-4 pt-3 border-top text-muted">
                                <t t-esc="ethara_company_name"/>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>

    </template>

</odoo>
