<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_milobench_model_list" model="ir.ui.view">
        <field name="name">milobench.model.list</field>
        <field name="model">milobench.model</field>
        <field name="arch" type="xml">
            <list string="Milo-Bench Models" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="key"/>
                <field name="provider"/>
                <field name="provider_route" optional="hide"/>
                <field name="run_count"/>
                <field name="pass_count"/>
                <field name="pass_at_3" widget="progressbar"/>
                <field name="mean_score" widget="progressbar"/>
                <field name="total_cost_usd" sum="Total Cost"/>
            </list>
        </field>
    </record>

    <record id="view_milobench_model_form" model="ir.ui.view">
        <field name="name">milobench.model.form</field>
        <field name="model">milobench.model</field>
        <field name="arch" type="xml">
            <form string="Milo-Bench Model">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Claude Opus 4.8"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="provider"/>
                            <field name="provider_route"/>
                        </group>
                        <group>
                            <field name="color" widget="color"/>
                            <field name="sequence"/>
                            <field name="run_count"/>
                            <field name="pass_count"/>
                            <field name="pass_at_3" widget="progressbar"/>
                            <field name="mean_score" widget="progressbar"/>
                            <field name="total_cost_usd"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Runs">
                            <field name="run_ids" readonly="1">
                                <list>
                                    <field name="task_id"/>
                                    <field name="run_number"/>
                                    <field name="difficulty"/>
                                    <field name="score" widget="progressbar"/>
                                    <field name="score_binary" widget="boolean_toggle"/>
                                    <field name="cost_usd"/>
                                    <field name="n_episodes"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_milobench_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">milobench.model</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
