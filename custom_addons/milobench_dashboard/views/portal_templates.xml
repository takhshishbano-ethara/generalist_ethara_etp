<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Milo-Bench Showcase: public single-page editorial view.

    Mounted at /milo-bench-samples by controllers/main.py. The client-side
    JS fetches /milo-bench-samples/api/dataset for the 30-task viewer and
    headline KPIs.

    Layout: standalone HTML mirroring raiden's editorial section-numbered
    pattern. All DOM ids preserved for milobench_portal.js hooks; Chart.js
    canvases replace the static PNG chart figures (originals commented
    inline for rollback).
  -->
  <template id="portal_showcase" name="Milo-Bench Portal">
    <html lang="en" data-theme="">
      <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>MILO-BENCH-SAMPLES - REPRODUCIBLE AI BENCHMARKS</title>
        <meta name="description" content="Milo-Bench measures milestone-scale engineering competence across whole codebases, across eight languages, scored on a continuous scale."/>
        <!-- Inline theme sync BEFORE stylesheet loads (no FOUC).
           Order of precedence:
             System preference is authoritative (raiden parity): read
             prefers-color-scheme before stylesheet tokens resolve so there
             is no flash. The in-page toggle is a session-only override. -->
        <script>
        (function () {
          try {
            var sysDark = window.matchMedia &amp;&amp; window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-theme', sysDark ? 'dark' : 'light');
          } catch (e) {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        })();
        </script>
        <!-- Previous localStorage-first theme selector (kept for rollback):
        <script>
        (function () {
          try {
            var stored = null;
            try { stored = window.localStorage.getItem('mb-theme'); } catch (e) {}
            var theme = (stored === 'light' || stored === 'dark') ? stored
                      : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
          } catch (e) {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        })();
        </script>
        -->
        <!-- Favicon: no explicit link — falls back to /favicon.ico, i.e. the
             Ethara company/website favicon (raiden parity; company, not project). -->
        <!-- Google Fonts: DM Sans + Roboto (raiden parity) -->
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&amp;family=Roboto:wght@300;400;500;700&amp;display=swap"/>
        <!-- Portal CSS -->
        <link rel="stylesheet" t-attf-href="/milobench_dashboard/static/src/portal/css/milobench_portal.css?v=#{asset_version or ''}"/>
        <!-- Deferred JS: GSAP + ScrollTrigger + Chart.js + portal script -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer="defer"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer="defer"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js" defer="defer"></script>
        <script t-attf-src="/milobench_dashboard/static/src/portal/js/milobench_portal.js?v=#{asset_version or ''}" defer="defer"></script>
      </head>
      <body>
        <a class="skip-link" href="#mb-main">Skip to content</a>
        <!-- Scroll progress rail (fills as the page scrolls) -->
        <div class="scroll-progress" aria-hidden="true"></div>
        <!-- Theme toggle (fixed, top-right; keep id and icon markup used by CSS) -->
        <button id="mb-theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme">
          <svg class="mb-theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <svg class="mb-theme-icon-light" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/>
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
        <!-- Portal root -->
        <div id="mb-portal">
          <!-- ================= MASTHEAD ================= -->
          <header class="masthead">
            <div class="wordmark">milo-bench-samples</div>
            <div class="badge">Long-horizon software evolution</div>
            <p class="thesis">Measuring long-horizon software-engineering competence at the granularity of milestones.</p>
            <div class="byline">by 
              
              
              <a href="https://www.ethara.ai" target="_blank" rel="noopener">Ethara AI</a></div>
            <div class="hero-actions">
              <a class="mb-btn" t-att-href="github_url" target="_blank" rel="noopener">
                <svg class="mb-btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.03c-3.2.69-3.87-1.36-3.87-1.36-.52-1.32-1.28-1.67-1.28-1.67-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.35.96.11-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.12 3.06.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.4-5.26 5.69.41.36.78 1.05.78 2.12v3.15c0 .3.21.66.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
                </svg>
                <span>GitHub</span></a>
              <a class="mb-btn" t-att-href="huggingface_url" target="_blank" rel="noopener">
                <span class="mb-btn-icon" aria-hidden="true">🤗</span>
                <span>Hugging Face</span></a>
              <a class="mb-btn mb-btn-primary" href="https://www.ethara.ai/contact" target="_blank" rel="noopener">
                <span>Get in touch</span>
                <span class="mb-btn-arrow" aria-hidden="true">→</span></a></div>
          </header>
          <main id="mb-main">
            <!-- ================= 01 · Overview ================= -->
            <section class="section" id="section-overview" data-animate="fade-up">
              <div class="section-label">01 · Overview</div>
              <div class="overview-grid">
                <div class="prose">
                  <p>
                  Milo-Bench measures long-horizon software-engineering capability, not just isolated
                  coding ability. It evaluates whether an agent can complete milestone-scale engineering
                  tasks that span multiple files, languages, and architectural components while keeping
                  an existing production codebase correct — not the individual functions or short bug
                  fixes that narrower benchmarks target. Where SWE-bench and Multi-SWE-bench score
                  single-issue fixes, Milo-Bench targets whole milestones resolved across a codebase over
                  a long agent trajectory.
                </p>
                  <ul class="capabilities">
                    <li>Milestone-scale tasks spanning multiple files and architectural components</li>
                    <li>Multi-language coverage across 8 programming languages, 19 codebases</li>
                    <li>Continuous partial-credit scoring so long-task progress stays visible</li>
                    <li>Network-sealed verifier — reference solutions cannot influence a run</li>
                    <li>Three frontier models (Claude Opus 4.8, Gemini 3.1 Pro, GPT-5.5) × 3 runs each</li>
                  </ul></div>
                <aside class="glance" aria-label="At a glance">
                  <div class="glance-label">At a glance</div>
                  <ul class="glance-list">
                    <li class="glance-row">
                      <span>Tasks</span>
                      <b>
                        <span data-field="task_count">30</span>
                      </b></li>
                    <li class="glance-row">
                      <span>Difficulty tiers</span>
                      <b>5
                      
                      
                      </b></li>
                    <li class="glance-row">
                      <span>Models</span>
                      <b>
                        <span data-field="model_count">3</span>
                      </b></li>
                    <li class="glance-row">
                      <span>Runs per task</span>
                      <b>9 (3 × 3)
                      
                      
                      </b></li>
                    <li class="glance-row">
                      <span>Graded runs</span>
                      <b>
                        <span data-field="run_count">270</span>
                      </b></li>
                    <li class="glance-row">
                      <span>Languages</span>
                      <b>
                        <span data-field="language_count">8</span>
                      </b></li>
                    <li class="glance-row">
                      <span>Codebases</span>
                      <b>
                        <span data-field="codebase_count">19</span>
                      </b></li>
                    <li class="glance-row">
                      <span>Overall pass@3</span>
                      <b>
                        <span data-field="pass_rate_overall">—</span>
                      </b></li>
                    <li class="glance-row">
                      <span>Scoring</span>
                      <b>Continuous · partial credit
                      
                      
                      </b></li>
                    <li class="glance-row">
                      <span>Verifier</span>
                      <b>Network-sealed
                      
                      
                      </b></li>
                  </ul>
                </aside></div>
              <figure class="chart">
                <!-- Chart.js canvas (data-driven, mirrors raiden). Static PNG kept below as backup.
                <img class="chart-img" src="/milobench_dashboard/static/src/portal/img/pass_rate.png" alt="Per-model pass rate vs reference-patch complexity"/>
                -->
                <div class="chart-canvas chart-canvas--wide">
                  <canvas id="mb-chart-pass-rate" aria-label="Per-model Pass@3 vs reference-patch complexity"></canvas></div>
                <figcaption>Per-model pass rate vs reference-patch complexity (

                  
                  <code>src_hunks</code>).

                
                </figcaption>
              </figure>
            </section>
            <!-- ================= 02 · Difficulty tiers ================= -->
            <section class="section" id="section-tiers" data-animate="fade-up">
              <div class="section-label">02 · Difficulty tiers</div>
              <h2 class="section-title">Five outcome-based tiers</h2>
              <p class="section-desc">
              Tiers are computed from observed model performance across runs. Trivial tasks are
              solved by nearly every run; Expert tasks by none. This is what the models actually
              experienced, not any property fixed in advance.
            </p>
              <!-- Tier grid: JS-populated. Preserve id. -->
              <div id="mb-tier-grid" class="mb-tier-grid" aria-live="polite"></div>
              <div class="chart-double">
                <figure class="chart">
                  <!-- Chart.js canvas (data-driven, mirrors raiden). Static PNG kept below as backup.
                  <img class="chart-img" src="/milobench_dashboard/static/src/portal/img/pass_rate_by_tier.png" alt="Pass rate by difficulty tier"/>
                  -->
                  <div class="chart-canvas">
                    <canvas id="mb-chart-pass-tier" aria-label="Pass@3 by difficulty tier"></canvas></div>
                  <figcaption>Pass rate by difficulty tier.

                  
                  </figcaption>
                </figure>
                <figure class="chart">
                  <!-- Chart.js canvas (data-driven, mirrors raiden). Static PNG kept below as backup.
                  <img class="chart-img" src="/milobench_dashboard/static/src/portal/img/cost_by_tier.png" alt="Mean agent cost per run by difficulty tier"/>
                  -->
                  <div class="chart-canvas">
                    <canvas id="mb-chart-cost-tier" aria-label="Mean agent cost per run by difficulty tier"></canvas></div>
                  <figcaption>Mean agent cost per run by difficulty tier.

                  
                  </figcaption>
                </figure></div>
            </section>
            <!-- ================= 03 · Models ================= -->
            <section class="section" id="section-models" data-animate="fade-up">
              <div class="section-label">03 · Model comparison</div>
              <h2 class="section-title">Head-to-head, three frontier models</h2>
              <p class="section-desc">
              Pass rate captures how hard the tasks are, not how far apart the models are. Mean
              score keeps crediting partial progress where pass rate bottoms out — this can even
              flip the model ranking (GPT-5.5 leads by pass@3, Claude Opus 4.8 by mean score).
            </p>
              <div class="mb-table-wrap">
                <table id="mb-model-table" class="mb-table mb-model-table">
                  <thead>
                    <tr>
                      <th>Model</th>
                      <th>Provider</th>
                      <th class="num">Runs</th>
                      <th class="num">Pass@3</th>
                      <th class="num">Mean score</th>
                      <th class="num">Total cost</th>
                    </tr>
                  </thead>
                  <tbody>
                    <!-- JS-populated -->
                  </tbody>
                </table></div>
            </section>
            <!-- ================= 04 · Matrix (pass rate + mean score) ================= -->
            <section class="section" id="section-matrix" data-animate="fade-up">
              <div class="section-label">04 · Per-tier per-model</div>
              <h2 class="section-title">Where the models differ</h2>
              <div class="mb-matrix-grid">
                <div class="mb-matrix-block">
                  <div class="section-label">Pass@3 by tier</div>
                  <div class="mb-table-wrap">
                    <table id="mb-passrate-table" class="mb-table mb-passrate-table">
                      <thead>
                        <tr>
                          <th>Tier</th>
                        </tr>
                      </thead>
                      <tbody>
                        <!-- JS-populated -->
                      </tbody>
                    </table></div></div>
                <div class="mb-matrix-block">
                  <div class="section-label">Mean score by tier</div>
                  <div class="mb-table-wrap">
                    <table id="mb-meanscore-table" class="mb-table mb-meanscore-table">
                      <thead>
                        <tr>
                          <th>Tier</th>
                        </tr>
                      </thead>
                      <tbody>
                        <!-- JS-populated -->
                      </tbody>
                    </table></div></div></div>
            </section>
            <!-- ================= 05 · Scoring pipeline ================= -->
            <section class="section" id="section-scoring" data-animate="fade-up">
              <div class="section-label">05 · Scoring methodology</div>
              <h2 class="section-title">Network-sealed, continuous, partial credit</h2>
              <p class="section-desc">
              The verifier computes a continuous score per run:
              
                
                
                <code>score = recall × regression_factor</code>. A run solves a task only when
              score is exactly 1.0. The verifier runs network-sealed, so the reference solution
              cannot influence a run.
            </p>
              <div class="pipeline-frame">
                <div class="mb-flow" role="list" aria-label="Scoring pipeline — five sequential steps">
                  <div class="mb-flow-step" role="listitem">
                    <div class="mb-flow-marker">1</div>
                    <div class="mb-flow-body">
                      <span class="mb-flow-icon">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/>
                          <path d="M14 3v5h5"/>
                        </svg></span>
                      <h3 class="mb-flow-title">Task</h3>
                      <p class="mb-flow-desc">instruction.md + Docker environment</p></div></div>
                  <div class="mb-flow-link" aria-hidden="true">
                    <svg width="34" height="20" viewBox="0 0 34 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="1" y1="10" x2="27" y2="10"/>
                      <polyline points="22 4 30 10 22 16"/>
                    </svg></div>
                  <div class="mb-flow-step" role="listitem">
                    <div class="mb-flow-marker">2</div>
                    <div class="mb-flow-body">
                      <span class="mb-flow-icon">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="3" y="4" width="18" height="16" rx="2"/>
                          <path d="M7 9l3 3-3 3"/>
                          <line x1="13" y1="15" x2="17" y2="15"/>
                        </svg></span>
                      <h3 class="mb-flow-title">Agent</h3>
                      <p class="mb-flow-desc">long tool-use trajectory</p></div></div>
                  <div class="mb-flow-link" aria-hidden="true">
                    <svg width="34" height="20" viewBox="0 0 34 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="1" y1="10" x2="27" y2="10"/>
                      <polyline points="22 4 30 10 22 16"/>
                    </svg></div>
                  <div class="mb-flow-step" role="listitem">
                    <div class="mb-flow-marker">3</div>
                    <div class="mb-flow-body">
                      <span class="mb-flow-icon">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <polyline points="8 7 3 12 8 17"/>
                          <polyline points="16 7 21 12 16 17"/>
                        </svg></span>
                      <h3 class="mb-flow-title">Patch</h3>
                      <p class="mb-flow-desc">edits across files &amp; languages</p></div></div>
                  <div class="mb-flow-link" aria-hidden="true">
                    <svg width="34" height="20" viewBox="0 0 34 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="1" y1="10" x2="27" y2="10"/>
                      <polyline points="22 4 30 10 22 16"/>
                    </svg></div>
                  <div class="mb-flow-step" role="listitem">
                    <div class="mb-flow-marker">4</div>
                    <div class="mb-flow-body">
                      <span class="mb-flow-icon">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6z"/>
                          <path d="M9.3 12l1.9 1.9L15 10"/>
                        </svg></span>
                      <h3 class="mb-flow-title">Verifier</h3>
                      <p class="mb-flow-desc">network-sealed target tests</p></div></div>
                  <div class="mb-flow-link" aria-hidden="true">
                    <svg width="34" height="20" viewBox="0 0 34 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="1" y1="10" x2="27" y2="10"/>
                      <polyline points="22 4 30 10 22 16"/>
                    </svg></div>
                  <div class="mb-flow-step" role="listitem">
                    <div class="mb-flow-marker">5</div>
                    <div class="mb-flow-body">
                      <span class="mb-flow-icon">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="8.5"/>
                          <circle cx="12" cy="12" r="4"/>
                          <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>
                        </svg></span>
                      <h3 class="mb-flow-title">Score</h3>
                      <p class="mb-flow-desc">per-run graded result</p></div></div></div></div>
            </section>
            <!-- ================= 06 · Coverage ================= -->
            <section class="section" id="section-coverage" data-animate="fade-up">
              <div class="section-label">06 · Coverage</div>
              <h2 class="section-title">8 languages across 19 codebases</h2>
              <p class="section-desc">
              Milo-Bench spans eight programming languages drawn from nineteen production
              codebases; each language card summarises how many of the 30 tasks land in that
              language.
            </p>
              <div id="mb-lang-grid" class="mb-lang-grid" aria-live="polite">
                <!-- JS-populated --></div>
            </section>
            <!-- ================= 07 · Viewer ================= -->
            <section class="section" id="section-viewer" data-animate="fade-up">
              <div class="section-label">07 · Dataset viewer</div>
              <h2 class="section-title">Browse the 30 tasks</h2>
              <p class="section-desc">
              Filter and search the full delivery. Expand a row to see per-model, per-run
              results and links to the raw trajectory and instruction file.
            </p>
              <div class="eval-controls">
                <div class="eval-search">
                  <svg class="eval-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  </svg>
                  <input id="mb-search" class="mb-input" type="search" placeholder="Search by task, codebase or UUID…" aria-label="Search tasks"/></div>
                <div class="eval-filters">
                  <select id="mb-filter-tier" class="mb-select" aria-label="Filter by difficulty tier">
                    <option value="">All tiers</option>
                    <option value="trivial">Trivial</option>
                    <option value="easy">Easy</option>
                    <option value="medium">Medium</option>
                    <option value="hard">Hard</option>
                    <option value="expert">Expert</option>
                  </select>
                  <select id="mb-filter-lang" class="mb-select" aria-label="Filter by language">
                    <option value="">All languages</option>
                    <!-- JS populates additional options -->
                  </select>
                  <select id="mb-sort" class="mb-select" aria-label="Sort tasks">
                    <option value="task_slug">Sort: Task</option>
                    <option value="difficulty">Sort: Difficulty</option>
                    <option value="language">Sort: Language</option>
                    <option value="src_hunks">Sort: Src hunks</option>
                    <option value="pass_rate">Sort: Pass rate</option>
                    <option value="mean_score">Sort: Mean score</option>
                  </select></div>
                <div class="eval-meta">
                  <span id="mb-viewer-count">—</span></div></div>
              <div class="mb-table-wrap">
                <table id="mb-viewer-table" class="mb-table mb-viewer-table">
                  <thead>
                    <tr>
                      <th>Task</th>
                      <th>Codebase</th>
                      <th>Language</th>
                      <th>Tier</th>
                      <th class="num">Src hunks</th>
                      <th class="num">Pass rate</th>
                      <th class="num">Mean score</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <!-- JS-populated -->
                  </tbody>
                </table></div>
              <nav id="mb-pagination" class="mb-pagination" aria-label="Task pagination">
                <!-- JS-populated -->
              </nav>
            </section>
            <!-- ================= 08 · Resources ================= -->
            <section class="section" id="section-resources" data-animate="fade-up">
              <div class="section-label">08 · Resources</div>
              <h2 class="section-title">Explore the sources</h2>
              <div class="mb-resource-grid">
                <a class="mb-resource-card" t-att-href="github_url" target="_blank" rel="noopener">
                  <div class="mb-resource-kicker">Repository</div>
                  <div class="mb-resource-title">GitHub</div>
                  <p class="mb-resource-desc">Full dataset, trajectories, verifier configuration and reproduction notes.</p></a>
                <a class="mb-resource-card" t-att-href="huggingface_url" target="_blank" rel="noopener">
                  <div class="mb-resource-kicker">Dataset</div>
                  <div class="mb-resource-title">HuggingFace</div>
                  <p class="mb-resource-desc">Structured dataset card with feature schema, splits, and download stats.</p></a></div>
            </section>
          </main>
          <footer class="mb-footer">
            <div class="mb-footer-inner">
              <span class="mb-footer-note">Ethara.ai · milo-bench-samples</span></div>
          </footer></div>
      </body>
    </html>
  </template>
</odoo>
