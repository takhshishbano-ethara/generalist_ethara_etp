<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="milobench_showcase_action" model="ir.actions.client">
        <field name="name">Milo-Bench Overview</field>
        <field name="tag">milobench_dashboard.showcase</field>
    </record>

    <menuitem id="milobench_menu_root"
              name="Milo-Bench"
              sequence="204"
              web_icon="milobench_dashboard,static/description/icon.png"/>

    <menuitem id="milobench_menu_overview"
              name="Overview"
              parent="milobench_menu_root"
              action="milobench_showcase_action"
              sequence="10"/>

    <menuitem id="milobench_menu_tasks"
              name="Tasks"
              parent="milobench_menu_root"
              action="action_milobench_task"
              sequence="20"/>

    <menuitem id="milobench_menu_runs"
              name="Runs"
              parent="milobench_menu_root"
              action="action_milobench_run"
              sequence="30"/>

    <menuitem id="milobench_menu_models"
              name="Models"
              parent="milobench_menu_root"
              action="action_milobench_model"
              sequence="40"/>

    <menuitem id="milobench_menu_settings"
              name="Settings"
              parent="milobench_menu_root"
              action="action_milobench_settings"
              sequence="90"
              groups="base.group_system"/>
</odoo>
