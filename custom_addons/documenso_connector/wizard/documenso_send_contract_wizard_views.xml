<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_documenso_send_contract_wizard_form" model="ir.ui.view">
        <field name="name">documenso.send.contract.wizard.form</field>
        <field name="model">documenso.send.contract.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Documenso Contract">
                <group>
                    <group>
                        <field name="employee_id" options="{'no_create': True}"/>
                        <field name="employee_email" readonly="1"/>
                    </group>
                    <group>
                        <field name="existing_contract_id" readonly="1"/>
                        <field name="distribute"/>
                    </group>
                </group>
                <group>
                    <field name="doc_class" widget="radio" options="{'horizontal': true}"/>
                    <field name="template_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="title_override" placeholder="Optional custom document title"/>
                </group>
                <group string="Advanced" name="advanced">
                    <field name="extra_prefill_json"
                           placeholder='{"custom_label": "value"}'/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_documenso_send_contract_wizard" model="ir.actions.act_window">
        <field name="name">Send Documenso Contract</field>
        <field name="res_model">documenso.send.contract.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
