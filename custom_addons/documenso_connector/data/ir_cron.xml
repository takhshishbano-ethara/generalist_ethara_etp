<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_documenso_contract" model="ir.sequence">
            <field name="name">Documenso Contract</field>
            <field name="code">documenso.contract</field>
            <field name="prefix">DOC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="ir_cron_documenso_sync_contracts" model="ir.cron">
            <field name="name">Documenso: Sync Signed Contracts</field>
            <field name="model_id" ref="model_documenso_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_completed()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
