<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_applicant_form_documenso" model="ir.ui.view">
        <field name="name">hr.applicant.form.documenso</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_documenso_view_documents" type="object"
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="documenso_contract_count" widget="statinfo" string="Documenso"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_documenso_send_document" type="object"
                        string="Send Documenso Doc" class="btn-secondary"
                        icon="fa-paper-plane"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Documenso" name="documenso_applicant_group">
                    <field name="documenso_last_status" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_documenso_send_applicant_bulk_server" model="ir.actions.server">
        <field name="name">Send Documenso Document</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Send Documenso Document',
    'res_model': 'documenso.send.applicant.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'default_applicant_ids': [(6, 0, records.ids)]},
}
        </field>
    </record>

</odoo>
