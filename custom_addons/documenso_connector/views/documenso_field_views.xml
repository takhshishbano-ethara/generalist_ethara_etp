<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_documenso_field_list" model="ir.ui.view">
        <field name="name">documenso.field.list</field>
        <field name="model">documenso.field</field>
        <field name="arch" type="xml">
            <list string="Fields">
                <field name="document_id"/>
                <field name="page"/>
                <field name="field_type"/>
                <field name="recipient_email"/>
                <field name="inserted"/>
                <field name="value"/>
            </list>
        </field>
    </record>

    <record id="view_documenso_field_form" model="ir.ui.view">
        <field name="name">documenso.field.form</field>
        <field name="model">documenso.field</field>
        <field name="arch" type="xml">
            <form string="Field">
                <sheet>
                    <group>
                        <group>
                            <field name="document_id" readonly="1"/>
                            <field name="documenso_id" readonly="1"/>
                            <field name="field_type" readonly="1"/>
                            <field name="page" readonly="1"/>
                        </group>
                        <group>
                            <field name="recipient_email" readonly="1"/>
                            <field name="inserted" readonly="1"/>
                            <field name="value" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_documenso_field" model="ir.actions.act_window">
        <field name="name">Fields</field>
        <field name="res_model">documenso.field</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
