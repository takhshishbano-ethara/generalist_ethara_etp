<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_form_documenso" model="ir.ui.view">
        <field name="name">hr.employee.form.documenso</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_documenso_view_contracts" type="object"
                        class="oe_stat_button" icon="fa-file-text-o">
                    <field name="documenso_contract_count" widget="statinfo" string="Documenso"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Documenso" name="documenso_group">
                    <field name="documenso_last_status" readonly="1"/>
                    <button name="action_documenso_send_contract" type="object"
                            string="Send Documenso Contract" class="btn-primary"
                            icon="fa-paper-plane"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
