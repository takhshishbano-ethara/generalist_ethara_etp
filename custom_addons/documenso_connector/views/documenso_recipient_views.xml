<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_documenso_recipient_list" model="ir.ui.view">
        <field name="name">documenso.recipient.list</field>
        <field name="model">documenso.recipient</field>
        <field name="arch" type="xml">
            <list string="Recipients">
                <field name="document_id"/>
                <field name="signing_order"/>
                <field name="name"/>
                <field name="email"/>
                <field name="role"/>
                <field name="signing_status" widget="badge"
                       decoration-success="signing_status == 'SIGNED'"
                       decoration-info="signing_status in ('OPENED','SENT')"
                       decoration-danger="signing_status == 'REJECTED'"/>
                <field name="signed_at"/>
            </list>
        </field>
    </record>

    <record id="view_documenso_recipient_form" model="ir.ui.view">
        <field name="name">documenso.recipient.form</field>
        <field name="model">documenso.recipient</field>
        <field name="arch" type="xml">
            <form string="Recipient">
                <sheet>
                    <group>
                        <group>
                            <field name="document_id" readonly="1"/>
                            <field name="documenso_id" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="email" readonly="1"/>
                        </group>
                        <group>
                            <field name="role" readonly="1"/>
                            <field name="signing_status" readonly="1"/>
                            <field name="signing_order" readonly="1"/>
                            <field name="signed_at" readonly="1"/>
                            <field name="signing_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_documenso_recipient" model="ir.actions.act_window">
        <field name="name">Recipients</field>
        <field name="res_model">documenso.recipient</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
