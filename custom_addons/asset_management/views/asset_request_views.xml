<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_request_list" model="ir.ui.view">
        <field name="name">asset.request.list</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <list string="Asset Requests"
                  decoration-info="state=='submitted'"
                  decoration-success="state=='fulfilled'"
                  decoration-danger="state=='rejected'"
                  decoration-muted="state=='draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="category_id"/>
                <field name="preferred_model"/>
                <field name="project_id"/>
                <field name="quantity"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_asset_request_form" model="ir.ui.view">
        <field name="name">asset.request.form</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <form string="Asset Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="asset_management.group_asset_manager"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'"
                            groups="asset_management.group_asset_manager"
                            confirm="Reject this request? Make sure you've entered a rejection reason below."/>
                    <button name="action_fulfil" type="object" string="Fulfil"
                            class="btn-primary"
                            invisible="state != 'approved'"
                            groups="asset_management.group_asset_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,fulfilled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assignment" type="object"
                                class="oe_stat_button" icon="fa-link"
                                invisible="not assignment_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Assignment</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="project_id"/>
                            <field name="category_id"/>
                            <field name="asset_type" invisible="not asset_type"/>
                            <field name="preferred_model"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="requested_by"/>
                            <field name="replace_assignment_id"/>
                            <field name="asset_id"
                                   invisible="state not in ('approved','fulfilled')"
                                   required="state == 'approved'"/>
                            <field name="approved_by" readonly="1" invisible="state not in ('approved','fulfilled')"/>
                            <field name="approval_date" readonly="1" invisible="state not in ('approved','fulfilled')"/>
                        </group>
                    </group>
                    <group string="Employee Snapshot" invisible="not employee_id">
                        <group>
                            <field name="employee_work_email" readonly="1"/>
                            <field name="employee_work_phone" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="job_id" readonly="1"/>
                            <field name="employee_manager_id" readonly="1"/>
                            <field name="employee_active_assignment_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Justification">
                            <field name="justification" nolabel="1"/>
                        </page>
                        <page string="Currently Held Assets"
                              invisible="employee_active_assignment_count == 0">
                            <field name="employee_active_assignment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="asset_id"/>
                                    <field name="project_id"/>
                                    <field name="assigned_date"/>
                                    <field name="expected_return_date"/>
                                    <field name="duration_days"/>
                                </list>
                            </field>
                        </page>
                        <page string="Active Projects"
                              invisible="not employee_active_project_ids">
                            <field name="employee_active_project_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rejection Reason"
                              invisible="state != 'rejected' and not rejection_reason">
                            <field name="rejection_reason" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_request_search" model="ir.ui.view">
        <field name="name">asset.request.search</field>
        <field name="model">asset.request</field>
        <field name="arch" type="xml">
            <search string="Asset Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="category_id"/>
                <field name="project_id"/>
                <filter string="My Requests" name="my_requests"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                <filter string="Fulfilled" name="fulfilled" domain="[('state','=','fulfilled')]"/>
                <group>
                    <filter string="Category" name="grp_cat" context="{'group_by': 'category_id'}"/>
                    <filter string="Project" name="grp_proj" context="{'group_by': 'project_id'}"/>
                    <filter string="State" name="grp_state" context="{'group_by': 'state'}"/>
                    <filter string="Employee" name="grp_emp" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_request" model="ir.actions.act_window">
        <field name="name">Requests</field>
        <field name="res_model">asset.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
