<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_assignment_list" model="ir.ui.view">
        <field name="name">asset.assignment.list</field>
        <field name="model">asset.assignment</field>
        <field name="arch" type="xml">
            <list string="Asset Assignments"
                  decoration-warning="is_overdue"
                  decoration-muted="not is_active">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="assigned_date"/>
                <field name="expected_return_date"/>
                <field name="actual_return_date"/>
                <field name="duration_days"/>
                <field name="is_active"/>
                <field name="is_overdue" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_asset_assignment_form" model="ir.ui.view">
        <field name="name">asset.assignment.form</field>
        <field name="model">asset.assignment</field>
        <field name="arch" type="xml">
            <form string="Assignment">
                <header>
                    <button name="action_return" type="object" string="Mark Returned"
                            class="btn-primary" invisible="not is_active"
                            groups="asset_management.group_asset_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="employee_id"/>
                            <field name="project_id"/>
                            <field name="request_id" readonly="1"/>
                            <field name="assigned_by" readonly="1"/>
                        </group>
                        <group>
                            <field name="assigned_date"/>
                            <field name="expected_return_date"/>
                            <field name="actual_return_date" readonly="1"/>
                            <field name="duration_days" readonly="1"/>
                            <field name="is_active" readonly="1"/>
                            <field name="is_overdue" readonly="1"/>
                            <field name="condition_in"/>
                            <field name="condition_out" readonly="is_active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_assignment_search" model="ir.ui.view">
        <field name="name">asset.assignment.search</field>
        <field name="model">asset.assignment</field>
        <field name="arch" type="xml">
            <search string="Assignments">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <filter string="Active" name="active" domain="[('is_active','=',True)]"/>
                <filter string="Closed" name="closed" domain="[('is_active','=',False)]"/>
                <filter string="Overdue" name="overdue"
                        domain="[('actual_return_date','=',False),('expected_return_date','!=',False),('expected_return_date','&lt;',context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Employee" name="grp_emp" context="{'group_by': 'employee_id'}"/>
                    <filter string="Asset" name="grp_asset" context="{'group_by': 'asset_id'}"/>
                    <filter string="Project" name="grp_proj" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">asset.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
