<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_asset_list" model="ir.ui.view">
        <field name="name">asset.asset.list</field>
        <field name="model">asset.asset</field>
        <field name="arch" type="xml">
            <list string="Assets"
                  decoration-success="state=='available'"
                  decoration-info="state=='assigned'"
                  decoration-warning="state=='maintenance'"
                  decoration-muted="state=='retired'">
                <field name="asset_code"/>
                <field name="model"/>
                <field name="category_id"/>
                <field name="asset_type"/>
                <field name="serial_number"/>
                <field name="state"/>
                <field name="current_employee_id"/>
            </list>
        </field>
    </record>

    <record id="view_asset_asset_form" model="ir.ui.view">
        <field name="name">asset.asset.form</field>
        <field name="model">asset.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button name="action_set_available" type="object" string="Set Available"
                            class="btn-primary" invisible="state == 'available'"/>
                    <button name="action_set_maintenance" type="object" string="Send to Maintenance"
                            invisible="state == 'maintenance'"/>
                    <button name="action_retire" type="object" string="Retire"
                            invisible="state == 'retired'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,assigned,maintenance,retired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assignments" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="assignment_count == 0">
                            <field name="assignment_count" widget="statinfo" string="History"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="asset_code" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="asset_type"/>
                            <field name="model"/>
                            <field name="serial_number"/>
                            <field name="vendor"/>
                        </group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="warranty_expiry"/>
                            <field name="renewal_date" invisible="asset_type != 'subscription'"/>
                            <field name="value"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="current_employee_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="History">
                            <field name="assignment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="employee_id"/>
                                    <field name="project_id"/>
                                    <field name="assigned_date"/>
                                    <field name="actual_return_date"/>
                                    <field name="duration_days"/>
                                    <field name="is_active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asset_asset_search" model="ir.ui.view">
        <field name="name">asset.asset.search</field>
        <field name="model">asset.asset</field>
        <field name="arch" type="xml">
            <search string="Assets">
                <field name="asset_code"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="category_id"/>
                <field name="current_employee_id"/>
                <filter string="Available" name="available" domain="[('state','=','available')]"/>
                <filter string="Assigned" name="assigned" domain="[('state','=','assigned')]"/>
                <filter string="Maintenance" name="maintenance" domain="[('state','=','maintenance')]"/>
                <filter string="Retired" name="retired" domain="[('state','=','retired')]"/>
                <group>
                    <filter string="Category" name="grp_cat" context="{'group_by': 'category_id'}"/>
                    <filter string="State" name="grp_state" context="{'group_by': 'state'}"/>
                    <filter string="Asset Type" name="grp_type" context="{'group_by': 'asset_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_asset" model="ir.actions.act_window">
        <field name="name">Inventory</field>
        <field name="res_model">asset.asset</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
