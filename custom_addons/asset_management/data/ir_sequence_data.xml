<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_asset_asset" model="ir.sequence">
            <field name="name">Asset Code</field>
            <field name="code">asset.asset</field>
            <field name="prefix">AST/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_asset_request" model="ir.sequence">
            <field name="name">Asset Request</field>
            <field name="code">asset.request</field>
            <field name="prefix">AREQ/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_asset_assignment" model="ir.sequence">
            <field name="name">Asset Assignment</field>
            <field name="code">asset.assignment</field>
            <field name="prefix">AASG/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
