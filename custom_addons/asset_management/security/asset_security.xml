<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_asset_management" model="ir.module.category">
            <field name="name">Asset Management</field>
            <field name="description">Manage company assets, requests and assignments</field>
            <field name="sequence">22</field>
        </record>

        <record id="res_groups_privilege_asset_management" model="res.groups.privilege">
            <field name="name">Access Level</field>
            <field name="sequence">22</field>
            <field name="category_id" ref="module_category_asset_management"/>
        </record>

    </data>

    <data noupdate="1">

        <record id="group_asset_user" model="res.groups">
            <field name="name">Asset User</field>
            <field name="privilege_id" ref="res_groups_privilege_asset_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_asset_manager" model="res.groups">
            <field name="name">Asset Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_asset_management"/>
            <field name="implied_ids" eval="[(4, ref('group_asset_user'))]"/>
        </record>

    </data>

    <data noupdate="0">

        <!-- Record rules -->

        <record id="rule_asset_request_user_own" model="ir.rule">
            <field name="name">Asset Request: own only</field>
            <field name="model_id" ref="model_asset_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_asset_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_asset_request_manager_all" model="ir.rule">
            <field name="name">Asset Request: manager all</field>
            <field name="model_id" ref="model_asset_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_manager'))]"/>
        </record>

        <record id="rule_asset_assignment_user_own" model="ir.rule">
            <field name="name">Asset Assignment: own only</field>
            <field name="model_id" ref="model_asset_assignment"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_asset_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_asset_assignment_manager_all" model="ir.rule">
            <field name="name">Asset Assignment: manager all</field>
            <field name="model_id" ref="model_asset_assignment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_manager'))]"/>
        </record>

        <record id="rule_asset_asset_user_read" model="ir.rule">
            <field name="name">Asset: user read</field>
            <field name="model_id" ref="model_asset_asset"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_asset_asset_manager_all" model="ir.rule">
            <field name="name">Asset: manager all</field>
            <field name="model_id" ref="model_asset_asset"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_manager'))]"/>
        </record>

        <record id="rule_asset_category_user_read" model="ir.rule">
            <field name="name">Asset Category: user read</field>
            <field name="model_id" ref="model_asset_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_asset_category_manager_all" model="ir.rule">
            <field name="name">Asset Category: manager all</field>
            <field name="model_id" ref="model_asset_category"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_asset_manager'))]"/>
        </record>

    </data>
</odoo>
