<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_project_project" model="ir.sequence">
            <field name="name">Project Sequence</field>
            <field name="code">project.project</field>
            <field name="prefix">PRJ</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_project_task" model="ir.sequence">
            <field name="name">Project Task</field>
            <field name="code">project.task</field>
            <field name="prefix">TSK</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_base_project_task" model="ir.sequence">
            <field name="name">Base Project Task</field>
            <field name="code">base.project.task</field>
            <field name="prefix">TSK</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
