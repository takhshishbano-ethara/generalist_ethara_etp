<odoo>
    <record id="edit_project_inherit_extension" model="ir.ui.view">
        <field name="name">project.project.form.inherit.extension</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="internal_project_name"/>
                <field name="client_name"/>
                <field name="internal_client_name"/>
                <field name="project_category" options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Technical Team" name="technical_team">
                    <group>
                        <group string="Engineering">
                            <field name="project_lead" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="project_aire" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="project_swe" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="project_qc_reviewer" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="project_tasker" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="assigned_team_ids" widget="many2many_tags"/>
                            <field name="project_attachments" widget="many2many_tags"/>
                        </group>
                        <group string="Project Specs">
                            <field name="project_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="sample_task_number"/>
                        </group>
                    </group>
                </page>

                <page string="Kick-Off Email" name="kick_off_details">
                    <group>
                        <field name="kick_off_to_mails" placeholder="email@example.com, email2@example.com"/>
                        <field name="kick_off_subject"/>
                        <field name="kick_off_body" widget="html" options="{'style-inline': true}"/>
                    </group>
                </page>
                <page string="Communication" name="communication">
                    <group string="Whatsapp Group">
                        <field name="whatsapp_group_name"/>
                        <field name="whatsapp_group_members" widget="many2many_tags"/>
                    </group>
                    <group string="Slack Group">
                        <field name="slack_channel_name"/>
                        <field name="slack_channel_id"/>
                        <field name="slack_channels_id"/>
                        <field name="slack_members" widget="many2many_tags"/>
                    </group>
                    <group string="Google Drive">
                        <field name="google_drive_id"/>
                    </group>
                </page>

                <page string="Project Task" name="attachments">
                    <field name="base_project_task">
                        <list >
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="status"/>
                            <field name="priority"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="is_sample_task"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <field name="name"/>
                                    <field name="sequence"/>
                                    <field name="status"/>
                                    <field name="priority"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="is_sample_task"/>
                                    <field name="assignee_ids" widget="many2many_tags"/>
                                    <field name="tags" widget="many2many_tags"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>

                <page string="Member History" name="member_history">
                    <field name="member_history_ids" readonly="1">
                        <list decoration-danger="state == 'offboarded'" decoration-success="state == 'active'">
                            <field name="employee_id"/>
                            <field name="role"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-danger="state == 'offboarded'"/>
                            <field name="offboard_reason"/>
                            <field name="reason_id"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>

                <page string="Rubrics &amp; Justification" name="rubrics_config">
                    <group>
                        <group>
                            <field name="is_rubrics_required"/>
                            <field name="is_justification_required"/>
                        </group>
                    </group>
                    <field name="rubric_category_ids" invisible="not is_rubrics_required">
<!--                        <list editable="bottom">-->
                        <list >
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <field name="name"/>
                                    <field name="sequence"/>
                                </group>
                                <notebook>
                                    <page string="Options">
                                        <field name="option_ids">
                                            <list editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="name"/>
                                                <field name="value"/>
                                                <field name="is_temp" string="Temp" readonly="1"/>
                                                <button name="action_approve_temp" type="object" string="✓" title="Approve" class="btn-success btn-sm" invisible="not is_temp"/>
                                                <button name="action_reject_temp" type="object" string="✗" title="Reject" class="btn-danger btn-sm" invisible="not is_temp" confirm="Delete this temp option?"/>
                                            </list>
                                        </field>
                                    </page>
                                    <page string="Dimensions">
                                        <field name="dimension_ids">
                                            <list editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="name"/>
                                                <field name="description"/>
                                                <field name="is_temp" string="Temp" readonly="1"/>
                                                <button name="action_approve_temp" type="object" string="✓" title="Approve" class="btn-success btn-sm" invisible="not is_temp"/>
                                                <button name="action_reject_temp" type="object" string="✗" title="Reject" class="btn-danger btn-sm" invisible="not is_temp" confirm="Delete this temp dimension and its options?"/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_project_category" model="ir.actions.act_window">
        <field name="name">Project Categories</field>
        <field name="res_model">project.category</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_project_category"
              name="Project Categories"
              parent="project.menu_project_config"
              action="action_project_category"
              sequence="50"/>
</odoo>
