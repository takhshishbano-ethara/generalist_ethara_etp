<odoo>
    <record id="view_whatsapp_group_members_tree" model="ir.ui.view">
        <field name="name">whatsapp.group.members.tree</field>
        <field name="model">whatsapp.group.members</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="email"/>
                <field name="country_code"/>
                <field name="phone_number"/>
            </list>
        </field>
    </record>
    <record id="action_whatsapp_group_members" model="ir.actions.act_window">
        <field name="name">Whatsapp Group Members</field>
        <field name="res_model">whatsapp.group.members</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_employee_designation_tree" model="ir.ui.view">
        <field name="name">hr.employee.designation.tree</field>
        <field name="model">hr.employee.designation</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    <record id="action_hr_employee_designation" model="ir.actions.act_window">
        <field name="name">Employee Designation</field>
        <field name="res_model">hr.employee.designation</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_hr_employee_designation"
              name="Employee Designation"
              parent="hr.menu_hr_root"
              action="action_hr_employee_designation"
              sequence="50"/>

    <menuitem id="menu_whatsapp_group_members"
              name="Whatsapp Members"
              parent="hr.menu_hr_root"
              action="action_whatsapp_group_members"
              sequence="50"/>

    <record id="view_employee_form_inherit_designation" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.designation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="designation_id" placeholder="Select Designation..."/>
                <field name="whatsapp_number" />
            </xpath>
        </field>
    </record>

    <record id="view_hr_job_form_inherit_designation" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.designation</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="designation_id"/>
            </xpath>
        </field>
    </record>
</odoo>
