<odoo>

    <record id="view_task_template_type_tree" model="ir.ui.view">
        <field name="name">task.template.type.list</field>
        <field name="model">task.template.type</field>
        <field name="arch" type="xml">
            <list string="Project Template Type" editable="bottom">
                <field name="name" required="1"/>
                <field name="project_key" required="1"/>
                <field name="model_name" required="1"/>
                <field name="mapping_field_name" required="1"/>
            </list>
        </field>
    </record>

    <record id="action_task_template_type" model="ir.actions.act_window">
        <field name="name">Project Template Type</field>
        <field name="res_model">task.template.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Task Template
            </p>
        </field>
    </record>

    <menuitem id="menu_task_template_type_root"
              name="Project Template"
              parent="hr.menu_hr_root"
              action="action_task_template_type"
              sequence="50"/>

</odoo>