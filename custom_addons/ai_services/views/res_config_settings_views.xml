<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_ai_services" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai_services</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Services" string="AI Services"
                     data-key="ai_services">
                    <block title="AWS Bedrock Configuration"
                           help="Configure the AWS Bedrock API credentials for AI-powered document extraction.">
                        <setting string="Bedrock API Key"
                                 help="API key for authenticating with AWS Bedrock (starts with ABSK...).">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_services_bedrock_api_key"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="ai_services_bedrock_api_key"
                                           class="col-lg-9"
                                           widget="CopyClipboardChar"
                                           placeholder="ABSKQmVkcm9ja0FQSUtleS0..."/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Inference Profile ARN"
                                 help="Full ARN of the Bedrock application inference profile for Kimi K2.5.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_services_bedrock_inference_arn"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="ai_services_bedrock_inference_arn"
                                           class="col-lg-9"
                                           placeholder="arn:aws:bedrock:ap-south-1:ACCOUNT:application-inference-profile/ID"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="AWS Region"
                                 help="AWS region where Bedrock is available.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_services_bedrock_region"
                                           class="col-lg-3 o_light_label"/>
                                    <field name="ai_services_bedrock_region"
                                           class="col-lg-9"
                                           placeholder="ap-south-1"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
