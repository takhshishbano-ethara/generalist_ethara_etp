<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Bedrock configuration keys (empty — set via Settings) -->
        <record id="config_bedrock_api_key" model="ir.config_parameter">
            <field name="key">ai_services.bedrock_api_key</field>
            <field name="value"></field>
        </record>
        <record id="config_bedrock_inference_arn" model="ir.config_parameter">
            <field name="key">ai_services.bedrock_inference_arn</field>
            <field name="value"></field>
        </record>
        <record id="config_bedrock_region" model="ir.config_parameter">
            <field name="key">ai_services.bedrock_region</field>
            <field name="value">ap-south-1</field>
        </record>

        <!-- Sequence for extraction references -->
        <record id="seq_ai_document_extraction" model="ir.sequence">
            <field name="name">AI Document Extraction</field>
            <field name="code">ai.document.extraction</field>
            <field name="prefix">AI-EXT/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
