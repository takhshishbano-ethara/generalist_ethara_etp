FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# System dependencies for Odoo (minimal — no LibreOffice/Playwright/wkhtmltopdf)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    postgresql-client \
    build-essential gcc g++ \
    libffi-dev libssl-dev libpq-dev \
    libxml2-dev libxslt1-dev \
    libldap2-dev libsasl2-dev \
    zlib1g-dev libjpeg-dev \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# kubectl (arm64-aware)
RUN ARCH=$(dpkg --print-architecture) \
    && curl -fsSL "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/${ARCH}/kubectl" \
       -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl

WORKDIR /opt/ethara/app

# Install Odoo core deps first (from src/requirements.txt)
COPY src/requirements.txt /tmp/odoo-requirements.txt
RUN grep -v -E "python-ldap|pyusb|pyserial|language-tool-python" /tmp/odoo-requirements.txt \
        > /tmp/filtered.txt \
    && pip install --upgrade pip setuptools wheel \
    && pip install Babel>=2.9.1 \
    && pip install psycopg2-binary==2.9.9 \
    && pip install -r /tmp/filtered.txt 2>/dev/null || true \
    && rm /tmp/odoo-requirements.txt /tmp/filtered.txt

# Install kensei-specific deps on top
RUN pip install \
    kubernetes==36.0.0 \
    docker>=7.0.0 \
    python-dotenv>=1.0.0 \
    boto3>=1.34.0 \
    websockets>=15.0 \
    pika>=1.3.0 \
    litellm>=1.40.0 \
    PyGithub>=2.1.0 \
    unidiff>=0.7.0 \
    dataclasses-json>=0.6.0 \
    GitPython>=3.1.0

# Strip build deps to save space
RUN apt-get purge -y build-essential gcc g++ \
        libffi-dev libssl-dev libpq-dev \
        libxml2-dev libxslt1-dev \
        libldap2-dev libsasl2-dev \
        zlib1g-dev libjpeg-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Copy Odoo source + custom addons
COPY src/ .
COPY custom_addons/ ./custom_addons/
COPY .env .env

RUN chmod +x odoo-bin

EXPOSE 8069 8072

CMD ["python", "odoo-bin", "--config=/etc/odoo/odoo.conf"]
