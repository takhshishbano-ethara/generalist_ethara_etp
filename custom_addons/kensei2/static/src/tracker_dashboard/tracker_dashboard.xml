<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="kensei2.TrackerDashboard">
        <div class="o_kensei2_tracker_dashboard">

            <!-- Top bar -->
            <div class="o_ktd_topbar">
                <div class="o_ktd_topbar_titles">
                    <span class="o_ktd_title">
                        <i class="fa fa-line-chart me-2"/>Kensei2-RL Dashboard
                    </span>
                    <span class="o_ktd_subtitle">
                        Reinforcement Learning pipeline
                        <t t-if="state.lastUpdated">· Updated <t t-out="state.lastUpdated"/></t>
                    </span>
                </div>
                <t t-call="kensei2.DashboardFilterBar"/>
            </div>

            <!-- ===================== TEAM COMPOSITION ===================== -->
            <div class="o_ktd_section">
                <div class="o_ktd_section_header">
                    <i class="fa fa-users me-2"/>TEAM COMPOSITION
                </div>
                <div class="o_ktd_cards">
                    <t t-foreach="state.teamComposition" t-as="card" t-key="card.key">
                        <div t-attf-class="o_ktd_metric_card o_ktd_clickable o_ktd_metric_#{card.key}"
                             t-on-click="() => this.onCompositionClick(card)"
                             t-on-keydown="(ev) => this.onCardKeydown(ev, () => this.onCompositionClick(card))"
                             tabindex="0" role="button"
                             title="View these members">
                            <div class="o_ktd_metric_label"><t t-out="card.label"/></div>
                            <div class="o_ktd_metric_value">
                                <t t-out="fmt(card.value)"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- ===================== RL PIPELINE FUNNEL ===================== -->
            <div class="o_ktd_section">
                <div class="o_ktd_section_header">
                    <i class="fa fa-filter me-2"/>RL PIPELINE FUNNEL
                </div>
                <div class="o_ktd_cards">
                    <t t-foreach="state.funnel" t-as="card" t-key="card.key">
                        <div t-attf-class="o_ktd_funnel_card o_ktd_clickable o_ktd_funnel_#{card.key}"
                             t-on-click="() => this.onStatusCardClick(card)"
                             t-on-keydown="(ev) => this.onCardKeydown(ev, () => this.onStatusCardClick(card))"
                             tabindex="0" role="button"
                             title="View these tasks">
                            <div class="o_ktd_metric_label"><t t-out="card.label"/></div>
                            <div class="o_ktd_metric_value"><t t-out="fmt(card.value)"/></div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- ===================== STATS ===================== -->
            <div class="o_ktd_section">
                <div class="o_ktd_section_header">
                    <i class="fa fa-bar-chart me-2"/>STATS
                </div>
                <div class="o_ktd_cards">
                    <t t-foreach="state.stats" t-as="card" t-key="card.key">
                        <!-- only drillable stats are focusable: a tab stop on a card
                             that does nothing when activated is worse than no tab stop -->
                        <div t-attf-class="o_ktd_metric_card o_ktd_metric_#{card.key}"
                             t-att-class="{ 'o_ktd_clickable': card.statuses and card.statuses.length }"
                             t-on-click="() => this.onStatusCardClick(card)"
                             t-on-keydown="(ev) => this.onCardKeydown(ev, () => this.onStatusCardClick(card))"
                             t-att-tabindex="card.statuses and card.statuses.length ? 0 : undefined"
                             t-att-role="card.statuses and card.statuses.length ? 'button' : undefined">
                            <div class="o_ktd_metric_label"><t t-out="card.label"/></div>
                            <div class="o_ktd_metric_value">
                                <t t-out="fmt(card.value)"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- ===================== PROGRESS =====================
                 One table, two axes. WHO to group by (PL / QL / Tasker) and WHICH
                 stage to count. Every row counts STAGE records, not tasks: a stage
                 is the unit of a person's work, so both taskers of a handed-off
                 task keep the credit for the stage they actually did.
            -->
            <div class="o_ktd_section">
                <div class="o_ktd_section_header o_ktd_section_header_split">
                    <span><i class="fa fa-list-ol me-2"/>PROGRESS</span>
                    <div class="o_ktd_segments">
                        <div class="o_ktd_segment" role="group" aria-label="Group by">
                            <t t-foreach="groups" t-as="g" t-key="g.key">
                                <button class="o_ktd_segment_btn" type="button"
                                        t-att-class="{ 'o_ktd_segment_active': state.groupBy === g.key }"
                                        t-att-aria-pressed="state.groupBy === g.key"
                                        t-on-click="() => this.setGroupBy(g.key)">
                                    <t t-out="g.label"/>
                                </button>
                            </t>
                        </div>
                        <div class="o_ktd_segment" role="group" aria-label="Stage">
                            <t t-foreach="stages" t-as="s" t-key="s.key">
                                <button class="o_ktd_segment_btn" type="button"
                                        t-att-class="{ 'o_ktd_segment_active': state.stage === s.value }"
                                        t-att-aria-pressed="state.stage === s.value"
                                        t-on-click="() => this.setStage(s.value)">
                                    <t t-out="s.label"/>
                                </button>
                            </t>
                        </div>
                    </div>
                </div>
                <ProgressTable rows="state.rows" head="group.label"
                               onRowClick="row => this.onRowClick(row)"/>
            </div>

        </div>
    </t>
</templates>
