<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="kensei2.CostingDashboard">
        <div class="o_kensei2_costing">
            <div class="o_kensei2_costing_header">
                <div class="o_kensei2_costing_title_row">
                    <h2 class="o_kensei2_costing_title">Token Usage</h2>
                    <span class="o_kensei2_costing_date_range" t-out="dateRangeLabel"/>
                </div>
                <div class="o_kensei2_costing_periods">
                    <t t-foreach="periods" t-as="p" t-key="p.key">
                        <button t-attf-class="o_kensei2_period_btn #{state.period === p.key ? 'active' : ''}"
                                t-on-click="() => this.onPeriodChange(p.key)">
                            <t t-out="p.label"/>
                        </button>
                    </t>
                </div>
            </div>

            <div t-if="state.totals" class="o_kensei2_costing_summary">
                <div class="o_kensei2_summary_card">
                    <div class="o_kensei2_summary_icon"><i class="fa fa-comments"/></div>
                    <div class="o_kensei2_summary_label">Claude</div>
                    <div class="o_kensei2_summary_value sandbox" t-out="formatNumber(state.totals.claude_total)"/>
                    <div class="o_kensei2_summary_sub">
                        <span>In: <strong t-out="formatNumber(state.totals.claude_input)"/></span>
                        <span>Out: <strong t-out="formatNumber(state.totals.claude_output)"/></span>
                    </div>
                    <div class="o_kensei2_summary_badge trajectory">Sandbox</div>
                </div>
                <div class="o_kensei2_summary_card">
                    <div class="o_kensei2_summary_icon"><i class="fa fa-comments"/></div>
                    <div class="o_kensei2_summary_label">GPT</div>
                    <div class="o_kensei2_summary_value sandbox" t-out="formatNumber(state.totals.gpt_total)"/>
                    <div class="o_kensei2_summary_sub">
                        <span>In: <strong t-out="formatNumber(state.totals.gpt_input)"/></span>
                        <span>Out: <strong t-out="formatNumber(state.totals.gpt_output)"/></span>
                    </div>
                    <div class="o_kensei2_summary_badge trajectory">Sandbox</div>
                </div>
                <div class="o_kensei2_summary_card grand">
                    <div class="o_kensei2_summary_icon"><i class="fa fa-tachometer"/></div>
                    <div class="o_kensei2_summary_label">Total Tokens</div>
                    <div class="o_kensei2_summary_value grand" t-out="formatNumber(state.totals.grand_total)"/>
                    <div class="o_kensei2_summary_sub">
                        <span>Claude: <strong t-out="formatNumber(state.totals.claude_total)"/></span>
                        <span>GPT: <strong t-out="formatNumber(state.totals.gpt_total)"/></span>
                    </div>
                </div>
            </div>

            <div t-if="state.loading" class="o_kensei2_costing_loading">
                <i class="fa fa-spinner fa-spin fa-2x"/>
            </div>

            <div t-elif="state.rows.length === 0" class="o_kensei2_costing_empty">
                <i class="fa fa-bar-chart fa-3x mb-3"/>
                <p>No token usage data for this period.</p>
            </div>

            <div t-else="" class="o_kensei2_costing_table_wrap">
                <table class="o_kensei2_costing_table">
                    <thead>
                        <tr class="o_kensei2_col_group_row">
                            <th class="col-employee" rowspan="2" t-on-click="() => this.onSort('employee_name')">
                                Employee <i t-attf-class="fa #{sortIcon('employee_name')} ms-1"/>
                            </th>
                            <th class="col-group-header col-group-claude" colspan="3">Claude</th>
                            <th class="col-group-header col-group-gpt" colspan="3">GPT</th>
                            <th class="col-group-header col-group-tests" colspan="3">Tests</th>
                            <th class="col-grand" rowspan="2" t-on-click="() => this.onSort('grand_total')">
                                Total <i t-attf-class="fa #{sortIcon('grand_total')} ms-1"/>
                            </th>
                        </tr>
                        <tr>
                            <th class="col-num col-claude" t-on-click="() => this.onSort('claude_input')">In</th>
                            <th class="col-num col-claude" t-on-click="() => this.onSort('claude_output')">Out</th>
                            <th class="col-num col-claude col-subtotal" t-on-click="() => this.onSort('claude_total')">Σ</th>

                            <th class="col-num col-gpt" t-on-click="() => this.onSort('gpt_input')">In</th>
                            <th class="col-num col-gpt" t-on-click="() => this.onSort('gpt_output')">Out</th>
                            <th class="col-num col-gpt col-subtotal" t-on-click="() => this.onSort('gpt_total')">Σ</th>

                            <th class="col-num col-tests">Total</th>
                            <th class="col-num col-tests">Pass</th>
                            <th class="col-num col-tests col-subtotal">Fail</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="sortedRows" t-as="row" t-key="row.employee_id">
                            <tr class="o_kensei2_emp_row" t-on-click="() => this.onToggleEmployee(row.employee_id)">
                                <td class="col-employee">
                                    <i t-attf-class="fa #{isExpanded(row.employee_id) ? 'fa-caret-down' : 'fa-caret-right'} me-2 o_kensei2_caret"/>
                                    <i class="fa fa-user-circle me-2"/>
                                    <t t-out="row.employee_name"/>
                                    <span t-if="row.tasks and row.tasks.length" class="ms-2 text-muted small">
                                        (<t t-out="row.tasks.length"/> task<t t-if="row.tasks.length !== 1">s</t>)
                                    </span>
                                </td>
                                <td class="col-num col-claude" t-out="formatNumber(row.claude_input)"/>
                                <td class="col-num col-claude" t-out="formatNumber(row.claude_output)"/>
                                <td class="col-num col-claude col-subtotal" t-out="formatNumber(row.claude_total)"/>

                                <td class="col-num col-gpt" t-out="formatNumber(row.gpt_input)"/>
                                <td class="col-num col-gpt" t-out="formatNumber(row.gpt_output)"/>
                                <td class="col-num col-gpt col-subtotal" t-out="formatNumber(row.gpt_total)"/>

                                <td class="col-num col-tests" t-out="formatNumber(row.tests_total || 0)"/>
                                <td class="col-num col-tests" t-out="formatNumber(row.tests_passed || 0)"/>
                                <td class="col-num col-tests col-subtotal" t-out="formatNumber(row.tests_failed || 0)"/>

                                <td class="col-num col-grand" t-out="formatNumber(row.grand_total)"/>
                            </tr>
                            <t t-if="isExpanded(row.employee_id)">
                                <t t-foreach="row.tasks" t-as="task" t-key="task.task_id">
                                    <tr class="o_kensei2_task_row" t-on-click="() => this.onToggleTask(task.task_id)">
                                        <td class="col-employee o_kensei2_task_cell">
                                            <span class="o_kensei2_task_indent"/>
                                            <i t-attf-class="fa #{this.isTaskExpanded(task.task_id) ? 'fa-caret-down' : 'fa-caret-right'} me-2 o_kensei2_caret"/>
                                            <i class="fa fa-file-text-o me-2 text-muted"/>
                                            <t t-out="task.task_name"/>
                                            <span class="ms-2 text-muted small">#<t t-out="task.task_id"/></span>
                                            <span t-if="task.trajectories and task.trajectories.length" class="ms-2 o_kensei2_traj_pill">
                                                <t t-out="task.trajectories.length"/> traj
                                            </span>
                                        </td>
                                        <td class="col-num col-claude" t-out="formatNumber(task.claude_input)"/>
                                        <td class="col-num col-claude" t-out="formatNumber(task.claude_output)"/>
                                        <td class="col-num col-claude col-subtotal" t-out="formatNumber(task.claude_total)"/>

                                        <td class="col-num col-gpt" t-out="formatNumber(task.gpt_input)"/>
                                        <td class="col-num col-gpt" t-out="formatNumber(task.gpt_output)"/>
                                        <td class="col-num col-gpt col-subtotal" t-out="formatNumber(task.gpt_total)"/>

                                        <td class="col-num col-tests" t-out="formatNumber(task.tests_total || 0)"/>
                                        <td class="col-num col-tests" t-out="formatNumber(task.tests_passed || 0)"/>
                                        <td class="col-num col-tests col-subtotal" t-out="formatNumber(task.tests_failed || 0)"/>

                                        <td class="col-num col-grand" t-out="formatNumber(task.grand_total)"/>
                                    </tr>
                                    <!-- Trajectory Breakdown Bars -->
                                    <t t-if="this.isTaskExpanded(task.task_id) and task.trajectories and task.trajectories.length">
                                        <tr class="o_kensei2_traj_header_row">
                                            <td colspan="11" class="o_kensei2_traj_container">
                                                <div class="o_kensei2_traj_breakdown">
                                                    <!-- Left: Trajectory Bars -->
                                                    <div class="o_kensei2_traj_bars">
                                                        <div class="o_kensei2_traj_breakdown_title">
                                                            Per-Trajectory Token Usage
                                                        </div>
                                                        <t t-foreach="task.trajectories" t-as="traj" t-key="traj.model + '_' + traj.index">
                                                            <div class="o_kensei2_traj_bar_row">
                                                                <div class="o_kensei2_traj_bar_label">
                                                                    <span class="o_kensei2_traj_bar_dot" t-attf-style="background: #{this.getModelColor(traj.model)}"/>
                                                                    <span class="o_kensei2_traj_bar_model"><t t-out="traj.model"/></span>
                                                                    <span class="o_kensei2_traj_bar_index">#<t t-out="traj.index"/></span>
                                                                </div>
                                                                <div class="o_kensei2_traj_bar_track">
                                                                    <div class="o_kensei2_traj_bar_fill" t-attf-style="width: #{this.getTrajectoryBarWidth(traj.tokens_total, task)}%; background: #{this.getModelColor(traj.model)}"/>
                                                                </div>
                                                                <div class="o_kensei2_traj_bar_values">
                                                                    <span class="o_kensei2_traj_bar_in"><t t-out="formatNumber(traj.tokens_in)"/> in</span>
                                                                    <span class="o_kensei2_traj_bar_out"><t t-out="formatNumber(traj.tokens_out)"/> out</span>
                                                                    <span class="o_kensei2_traj_bar_total"><t t-out="formatNumber(traj.tokens_total)"/></span>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </div>

                                                    <!-- Right: Test Results side-by-side -->
                                                    <t t-if="task.test_results and Object.keys(task.test_results).length > 0">
                                                        <div class="o_kensei2_traj_test_section">
                                                            <div class="o_kensei2_traj_breakdown_title">
                                                                Test Cases Generated
                                                            </div>
                                                            <div class="o_kensei2_traj_test_models">
                                                                <t t-foreach="Object.keys(task.test_results)" t-as="modelKey" t-key="modelKey">
                                                                    <div class="o_kensei2_traj_test_model_group">
                                                                        <div class="o_kensei2_traj_test_model_label">
                                                                            <span class="o_kensei2_traj_bar_dot" t-attf-style="background: #{this.getModelColor(modelKey)}"/>
                                                                            <span><t t-out="modelKey"/></span>
                                                                            <span class="o_kensei2_traj_test_model_count">
                                                                                <t t-out="task.test_results[modelKey].length"/> run(s)
                                                                            </span>
                                                                        </div>
                                                                        <div class="o_kensei2_traj_test_items">
                                                                            <t t-foreach="task.test_results[modelKey]" t-as="tr" t-key="tr.id">
                                                                                <div class="o_kensei2_traj_test_item">
                                                                                    <span t-attf-class="o_kensei2_traj_test_status o_kensei2_traj_test_status_#{tr.status}">
                                                                                        <t t-if="tr.status === 'passed'"><i class="fa fa-check"/></t>
                                                                                        <t t-elif="tr.status === 'failed'"><i class="fa fa-times"/></t>
                                                                                        <t t-elif="tr.status === 'error'"><i class="fa fa-exclamation"/></t>
                                                                                        <t t-else=""><i class="fa fa-spinner fa-spin"/></t>
                                                                                    </span>
                                                                                    <span class="o_kensei2_traj_test_name" t-out="tr.model_used || 'Test'"/>
                                                                                    <span class="o_kensei2_traj_test_counts">
                                                                                        <span class="o_kensei2_traj_tc_pass"><t t-out="tr.tests_passed"/></span>/<span class="o_kensei2_traj_tc_total"><t t-out="tr.tests_total"/></span>
                                                                                    </span>
                                                                                    <span t-if="tr.tests_failed > 0" class="o_kensei2_traj_tc_fail_badge">
                                                                                        <t t-out="tr.tests_failed"/> fail
                                                                                    </span>
                                                                                    <span t-if="tr.tests_errored > 0" class="o_kensei2_traj_tc_error_badge">
                                                                                        <t t-out="tr.tests_errored"/> err
                                                                                    </span>
                                                                                    <span class="o_kensei2_traj_test_time">
                                                                                        <t t-out="Math.round(tr.duration_exec_ms / 1000 * 10) / 10"/>s
                                                                                    </span>
                                                                                </div>
                                                                            </t>
                                                                        </div>
                                                                    </div>
                                                                </t>
                                                            </div>
                                                        </div>
                                                    </t>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        </t>
                    </tbody>
                    <tfoot t-if="state.totals">
                        <tr>
                            <td class="col-employee"><strong>Totals</strong></td>
                            <td class="col-num col-claude" t-out="formatNumber(state.totals.claude_input)"/>
                            <td class="col-num col-claude" t-out="formatNumber(state.totals.claude_output)"/>
                            <td class="col-num col-claude col-subtotal" t-out="formatNumber(state.totals.claude_total)"/>

                            <td class="col-num col-gpt" t-out="formatNumber(state.totals.gpt_input)"/>
                            <td class="col-num col-gpt" t-out="formatNumber(state.totals.gpt_output)"/>
                            <td class="col-num col-gpt col-subtotal" t-out="formatNumber(state.totals.gpt_total)"/>

                            <td class="col-num col-tests" t-out="formatNumber(state.totals.tests_total || 0)"/>
                            <td class="col-num col-tests" t-out="formatNumber(state.totals.tests_passed || 0)"/>
                            <td class="col-num col-tests col-subtotal" t-out="formatNumber(state.totals.tests_failed || 0)"/>

                            <td class="col-num col-grand" t-out="formatNumber(state.totals.grand_total)"/>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </t>
</templates>
