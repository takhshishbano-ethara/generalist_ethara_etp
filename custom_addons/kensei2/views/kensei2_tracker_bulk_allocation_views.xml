<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="kensei2_tracker_bulk_allocation_form" model="ir.ui.view">
      <field name="name">kensei2.tracker.bulk.allocation.form</field>
      <field name="model">kensei2.tracker.bulk.allocation</field>
      <field name="arch" type="xml">
        <form string="Bulk Allocation" class="o_kensei2_tracker_form">
          <field name="state" invisible="1"/>

          <!-- ===== Step 1 — Source + configure ===== -->
          <div invisible="state != 'draft'">
            <div class="alert alert-info" role="alert">
              Choose a <b>Persona Source</b>, then pick the taskers, method and
              limit, and Preview. Existing personas are reused; new ones (file
              mode) are created.
            </div>
            <group>
              <group string="Source">
                <field name="source_mode" widget="radio"/>
                <field name="csv_file" filename="filename" widget="binary"
                       string="Persona Names File"
                       invisible="source_mode != 'file'"
                       required="source_mode == 'file'"/>
                <field name="filename" invisible="1"/>
                <div class="mt-1" colspan="2" invisible="source_mode != 'file'">
                  <a href="/kensei2/tracker/persona/sample_csv">
                    <i class="fa fa-download me-1"/>Download sample file
                  </a>
                </div>
                <field name="unassigned_available" invisible="source_mode != 'unassigned'"/>
              </group>
              <group string="Allocation">
                <field name="allocation_method" widget="radio"/>
                <field name="limit_mode" widget="radio"/>
                <field name="allocation_limit"
                       invisible="limit_mode != 'limited'"
                       required="limit_mode == 'limited'"/>
              </group>
            </group>
            <div class="alert alert-secondary py-1 px-2" role="alert"
                 invisible="source_mode != 'unassigned'">
              <i class="fa fa-info-circle me-1" title="Info"/>
              Allocates <field name="unassigned_available" class="fw-bold"/>
              existing persona(s) that are not yet assigned to any tasker.
            </div>
            <separator string="Taskers"/>
            <field name="tasker_line_ids">
              <list editable="bottom" create="false" delete="false">
                <!-- required on the model; kept in the payload but hidden -->
                <field name="member_id" column_invisible="1"/>
                <field name="selected" widget="boolean_toggle"/>
                <field name="member_name" readonly="1"/>
                <field name="email" readonly="1"/>
                <field name="current_count" readonly="1"/>
              </list>
            </field>
          </div>

          <!-- ===== Step 2 — Summary before saving ===== -->
          <div invisible="state != 'preview'">
            <div class="alert alert-secondary" role="alert">
              Review the plan below. Nothing is saved yet — click
              <b>Start Allocation</b> to create the allocations.
            </div>
            <group>
              <group string="Personas">
                <field name="total_personas"/>
                <field name="existing_personas"/>
                <field name="new_personas"/>
                <field name="skipped_personas"/>
              </group>
              <group string="Plan">
                <field name="selected_taskers"/>
                <field name="allocation_method" readonly="1"/>
                <field name="limit_mode" readonly="1"/>
                <field name="allocation_limit" readonly="1"
                       invisible="limit_mode != 'limited'"/>
                <field name="expected_assignments"/>
                <field name="unallocated_expected"
                       decoration-danger="unallocated_expected &gt; 0"/>
              </group>
            </group>
            <div class="alert alert-warning" role="alert"
                 invisible="unallocated_expected == 0">
              <i class="fa fa-exclamation-triangle me-1" title="Warning"/>
              <field name="unallocated_expected" class="fw-bold"/> persona(s)
              cannot be allocated with the current limit / tasker selection and
              will be reported as unallocated.
            </div>
          </div>

          <!-- ===== Step 3 — Report ===== -->
          <div invisible="state != 'done'">
            <div class="row text-center">
              <div class="col-3"><h3 class="text-success mb-0"><field name="assigned_count"/></h3><small>Assigned</small></div>
              <div class="col-3"><h3 class="text-primary mb-0"><field name="created_count"/></h3><small>Created</small></div>
              <div class="col-3"><h3 class="text-muted mb-0"><field name="skipped_count"/></h3><small>Skipped</small></div>
              <div class="col-3"><h3 class="text-danger mb-0"><field name="unallocated_count"/></h3><small>Unallocated</small></div>
            </div>
            <div class="mt-3"><field name="result_html"/></div>
          </div>

          <footer>
            <button string="Preview" name="action_preview" type="object"
                    class="btn-primary" invisible="state != 'draft'"/>
            <button string="Start Allocation" name="action_start" type="object"
                    class="btn-primary" invisible="state != 'preview'"/>
            <button string="Back" name="action_back" type="object"
                    class="btn-secondary" invisible="state != 'preview'"/>
            <button string="Close" special="cancel" class="btn-primary"
                    invisible="state != 'done'"/>
            <button string="Cancel" special="cancel" class="btn-secondary"
                    invisible="state == 'done'"/>
          </footer>
        </form>
      </field>
    </record>

    <record id="action_kensei2_tracker_bulk_allocation" model="ir.actions.act_window">
      <field name="name">Bulk Allocation</field>
      <field name="res_model">kensei2.tracker.bulk.allocation</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

  </data>
</odoo>
