<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_kensei2" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kensei2</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Kensei2" string="Kensei2" name="kensei2">
                    <block title="Bedrock LLM Configuration">
                        <setting
                            string="Inference Profile ARN"
                            help="Full ARN of the AWS Bedrock application inference profile for server-side LLM calls (QC, hints)."
                        >
                            <field name="kensei2_bedrock_inference_arn" />
                        </setting>
                        <setting
                            string="Bedrock Region"
                            help="AWS region for the Bedrock endpoint."
                        >
                            <field name="kensei2_bedrock_region" />
                        </setting>
                    </block>
                    <block title="Moonshot (Kimi K2.6)">
                        <setting
                            string="Moonshot API Key"
                            help="API key for Moonshot (Kimi K2.6) used in sandbox trajectory generation. Get from platform.moonshot.ai."
                        >
                            <field
                                name="kensei2_moonshot_api_key"
                                password="True"
                            />
                        </setting>
                    </block>
                    <block title="Sandbox Deployment">
                        <setting
                            string="Deployment Mode"
                            help="Local mode uses Docker Compose (admin only). K8s mode creates Kubernetes resources."
                        >
                            <field
                                name="kensei2_deployment_mode"
                                widget="radio"
                            />
                        </setting>
                    </block>
                    <block
                        title="Local Mode (Docker Compose)"
                        invisible="kensei2_deployment_mode != 'local'"
                    >
                        <setting
                            string="Docker Status"
                            help="Whether Docker daemon is accessible from this server."
                        >
                            <field
                                name="kensei2_docker_available"
                                widget="boolean_toggle"
                                readonly="True"
                            />
                        </setting>
                    </block>
                    <block
                        title="Kubernetes Mode"
                        invisible="kensei2_deployment_mode != 'k8s'"
                    >
                        <setting
                            string="Sandbox Directory"
                            help="Path to Sandbox directory (for reading persona files and litellm config)."
                        >
                            <field name="kensei2_sandbox_dir" />
                        </setting>
                        <setting
                            string="OpenClaw Image"
                            help="Container image for the OpenClaw gateway."
                        >
                            <field name="kensei2_openclaw_image" />
                        </setting>
                        <setting
                            string="LiteLLM Image"
                            help="Container image for the LiteLLM proxy."
                        >
                            <field name="kensei2_litellm_image" />
                        </setting>
                        <setting
                            string="WS Router Host"
                            help="Public hostname for the WebSocket router Ingress (e.g. kensei2-ws.yourdomain.com). Browser uses wss://host/sandbox/task_id/ to reach the gateway."
                        >
                            <field name="kensei2_ws_router_host" />
                        </setting>
                        <setting
                            string="ECR Registry"
                            help="AWS ECR registry prefix for mock API images (e.g. 426628337772.dkr.ecr.ap-south-1.amazonaws.com)."
                        >
                            <field name="kensei2_ecr_registry" />
                        </setting>
                        <setting
                            string="Mock Image Tag"
                            help="Docker image tag for mock API containers (e.g. latest, v1.0.0, git SHA)."
                        >
                            <field name="kensei2_mock_image_tag" />
                        </setting>
                    </block>
                    <block title="Batch Execution">
                        <setting
                            string="Pods Per Model"
                            help="Number of sandbox pods per model type. E.g. 2 = 2 Claude + 2 GPT = 4 total. Set low for resource-constrained environments."
                        >
                            <field name="kensei2_batch_size" />
                        </setting>
                    </block>
                    <block title="AWS &amp; Provider Credentials">
                        <setting
                            string="AWS Bearer Token (Bedrock)"
                            help="AWS bearer token for Bedrock API access inside sandbox containers."
                        >
                            <field
                                name="kensei2_aws_bearer_token"
                                password="True"
                            />
                        </setting>
                        <setting string="AWS Region">
                            <field name="kensei2_aws_region" />
                        </setting>
                        <setting
                            string="Bedrock Model ARN"
                            help="ARN for the Bedrock model used inside OpenClaw containers."
                        >
                            <field name="kensei2_bedrock_model_arn" />
                        </setting>
                        <setting
                            string="LiteLLM Master Key"
                            help="Master key for the LiteLLM proxy sidecar."
                        >
                            <field
                                name="kensei2_litellm_master_key"
                                password="True"
                            />
                        </setting>
                        <setting
                            string="LiteLLM DB Password"
                            help="PostgreSQL password for the LiteLLM database."
                        >
                            <field
                                name="kensei2_litellm_db_password"
                                password="True"
                            />
                        </setting>
                    </block>
                    <block title="Google Auth (Gog)">
                        <setting
                            string="Google OAuth Client Secret (JSON)"
                            help="Paste the full contents of client_secret.json from Google Cloud Console. Required for gog-based Google authentication."
                        >
                            <field
                                name="kensei2_gog_client_secret"
                                widget="text"
                            />
                        </setting>
                        <setting
                            string="Gog Keyring Password"
                            help="Password to encrypt the gog file-based keyring. Used for storing Google OAuth tokens securely."
                        >
                            <field
                                name="kensei2_gog_keyring_password"
                                password="True"
                            />
                        </setting>
                    </block>
                    <block title="QC &amp; Validation (Debug)">
                        <setting
                            string="Disable Prompt QC"
                            help="Skip LLM-powered prompt quality checks. Enable this for testing and debugging only."
                        >
                            <field
                                name="kensei2_disable_prompt_qc"
                                widget="boolean_toggle"
                            />
                        </setting>
                        <setting
                            string="Disable Trajectory QC"
                            help="Skip trajectory validation and LLM-powered trajectory QC. Enable this for testing and debugging only."
                        >
                            <field
                                name="kensei2_disable_trajectory_qc"
                                widget="boolean_toggle"
                            />
                        </setting>
                        <setting
                            string="Disable Auto-Hint"
                            help="Skip automated hint evaluation and generation. Enable this for testing and debugging only."
                            invisible="1"
                        >
                            <field
                                name="kensei2_disable_auto_hint"
                                widget="boolean_toggle"
                            />
                        </setting>
                    </block>
                    <block title="Test Generation">
                        <setting
                            string="Enable Test Generation"
                            help="Auto-generate pytest test cases from mock API audit logs when a sandbox stops."
                        >
                            <field
                                name="kensei2_test_gen_enabled"
                                widget="boolean_toggle"
                            />
                        </setting>
                        <setting
                            string="Test Gen Inference ARN"
                            help="Bedrock inference ARN for test generation (Sonnet 4.6). Falls back to the main Bedrock ARN if empty."
                        >
                            <field name="kensei2_test_gen_inference_arn" />
                        </setting>
                    </block>
                    <block title="S3 Storage (Attachments)">
                        <setting
                            string="S3 Bucket"
                            help="AWS S3 bucket name for storing chat attachments and session backups."
                        >
                            <field name="kensei2_s3_bucket" />
                        </setting>
                        <setting
                            string="S3 Key Prefix (Folder)"
                            help="Prefix for S3 object keys (e.g. 'Kensei2'). Attachments stored at: {prefix}/input/tasks/{task_id}/{file}"
                        >
                            <field name="kensei2_s3_prefix" />
                        </setting>
                        <setting
                            string="S3 Region"
                            help="AWS region for the S3 bucket."
                        >
                            <field name="kensei2_s3_region" />
                        </setting>
                        <setting
                            string="S3 Credentials"
                            help="Access Key ID and Secret are read from .env (AWS_SECRET_KEY, AWS_ACCESS_SECRET_KEY). Not configurable here."
                        >
                            <div class="text-muted">Credentials loaded from .env file</div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
