        <p class="kpi-sub mono">10 aws s3 · 30 aws dynamodb</p>
      </div>
      <div class="kpi-card">
        <p class="kpi-label">Held-out Tests</p>
        <p class="kpi-value"><span class="kpi-big">3,404</span></p>
        <p class="kpi-sub mono">626 aws s3 · 2,778 aws dynamodb</p>
      </div>
