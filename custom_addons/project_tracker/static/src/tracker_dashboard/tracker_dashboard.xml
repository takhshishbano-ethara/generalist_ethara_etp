<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="project_tracker.TrackerDashboard">
        <div class="o_project_tracker_dashboard">

            <!-- Top bar -->
            <div class="o_ktd_topbar">
                <div class="o_ktd_topbar_titles">
                    <span class="o_ktd_title">
                        <i class="fa fa-tachometer me-2"/>Project Tracker
                    </span>
                    <span class="o_ktd_subtitle">
                        Task allocation pipeline
                        <t t-if="state.lastUpdated">· Updated <t t-out="state.lastUpdated"/></t>
                    </span>
                </div>
                <t t-call="project_tracker.DashboardFilterBar"/>
            </div>

            <!-- Overview / Charts toggle -->
            <div class="o_ktd_viewtabs" role="tablist">
                <button class="o_ktd_viewtab" type="button" role="tab"
                        t-att-class="{ 'o_ktd_viewtab_active': state.viewMode === 'overview' }"
                        t-att-aria-selected="state.viewMode === 'overview'"
                        t-on-click="() => this.setViewMode('overview')">
                    <i class="fa fa-th-list me-1"/>Overview
                </button>
                <button class="o_ktd_viewtab" type="button" role="tab"
                        t-att-class="{ 'o_ktd_viewtab_active': state.viewMode === 'charts' }"
                        t-att-aria-selected="state.viewMode === 'charts'"
                        t-on-click="() => this.setViewMode('charts')">
                    <i class="fa fa-pie-chart me-1"/>Charts
                </button>
            </div>

            <!-- ===================== KPI STRIP (both views) ===================== -->
            <div class="o_ktd_kpis">
                <t t-foreach="state.kpis" t-as="k" t-key="k.key">
                    <div t-attf-class="o_ktd_kpi o_ktd_kpi_#{k.key}"
                         t-att-class="{ 'o_ktd_clickable': k.statuses and k.statuses.length }"
                         t-on-click="() => this.onStatusCardClick(k)"
                         t-on-keydown="(ev) => this.onCardKeydown(ev, () => this.onStatusCardClick(k))"
                         t-att-tabindex="k.statuses and k.statuses.length ? 0 : undefined"
                         t-att-role="k.statuses and k.statuses.length ? 'button' : undefined">
                        <div class="o_ktd_kpi_label"><t t-out="k.label"/></div>
                        <div class="o_ktd_kpi_value">
                            <t t-if="k.value === null or k.value === undefined">—</t>
                            <t t-else=""><t t-out="fmt(k.value)"/><span t-if="k.suffix" class="o_ktd_kpi_suffix"><t t-out="k.suffix"/></span></t>
                        </div>
                    </div>
                </t>
            </div>

            <!-- ============================ OVERVIEW ============================ -->
            <t t-if="state.viewMode === 'overview'">

                <!-- Team stats -->
                <div class="o_ktd_section">
                    <div class="o_ktd_section_header">
                        <i class="fa fa-users me-2"/>TEAM
                    </div>
                    <div class="o_ktd_cards">
                        <t t-foreach="state.teamComposition" t-as="card" t-key="card.key">
                            <div t-attf-class="o_ktd_metric_card o_ktd_clickable o_ktd_metric_#{card.key}"
                                 t-on-click="() => this.onCompositionClick(card)"
                                 t-on-keydown="(ev) => this.onCardKeydown(ev, () => this.onCompositionClick(card))"
                                 tabindex="0" role="button" title="View these members">
                                <div class="o_ktd_metric_label"><t t-out="card.label"/></div>
                                <div class="o_ktd_metric_value"><t t-out="fmt(card.value)"/></div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Pipeline (cards) -->
                <div class="o_ktd_section">
                    <div class="o_ktd_section_header">
                        <i class="fa fa-filter me-2"/>PIPELINE
                    </div>
                    <div class="o_ktd_cards">
                        <t t-foreach="state.funnel" t-as="card" t-key="card.key">
                            <div t-attf-class="o_ktd_funnel_card o_ktd_clickable o_ktd_funnel_#{card.key}"
                                 t-on-click="() => this.onStatusCardClick(card)"
                                 t-on-keydown="(ev) => this.onCardKeydown(ev, () => this.onStatusCardClick(card))"
                                 tabindex="0" role="button" title="View these tasks">
                                <div class="o_ktd_metric_label"><t t-out="card.label"/></div>
                                <div class="o_ktd_metric_value"><t t-out="fmt(card.value)"/></div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Progress table (detailed per-person breakdown) -->
                <div class="o_ktd_section">
                    <div class="o_ktd_section_header o_ktd_section_header_split">
                        <span><i class="fa fa-list-ol me-2"/>PROGRESS</span>
                        <div class="o_ktd_segments">
                            <div class="o_ktd_segment" role="group" aria-label="Group by">
                                <t t-foreach="groups" t-as="g" t-key="g.key">
                                    <button class="o_ktd_segment_btn" type="button"
                                            t-att-class="{ 'o_ktd_segment_active': state.groupBy === g.key }"
                                            t-att-aria-pressed="state.groupBy === g.key"
                                            t-on-click="() => this.setGroupBy(g.key)">
                                        <t t-out="g.label"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                    </div>
                    <ProgressTable rows="state.rows" head="group.label"
                                   onRowClick="row => this.onRowClick(row)"/>
                </div>
            </t>

            <!-- ============================= CHARTS ============================= -->
            <t t-if="state.viewMode === 'charts'">
                <div class="o_ktd_chart_grid">
                    <div class="o_ktd_chart_panel o_ktd_chart_wide">
                        <div class="o_ktd_chart_title">Tasks Delivered per Day</div>
                        <div class="o_ktd_chart_body">
                            <PtChart type="'bar'" data="trendComboChartData" options="comboOptions"/>
                        </div>
                    </div>

                    <div class="o_ktd_chart_panel">
                        <div class="o_ktd_chart_title">Delivery Success Rate</div>
                        <div class="o_ktd_chart_body o_ktd_chart_body_sm o_ktd_gauge">
                            <PtChart type="'doughnut'" data="gaugeChartData" options="gaugeOptions"/>
                            <div class="o_ktd_gauge_value">
                                <t t-if="gaugeValue === null">—</t>
                                <t t-else=""><t t-out="gaugeValue"/>%</t>
                            </div>
                        </div>
                    </div>

                    <div class="o_ktd_chart_panel">
                        <div class="o_ktd_chart_title">Tasks by Stage</div>
                        <div class="o_ktd_chart_body o_ktd_chart_body_sm">
                            <PtChart type="'doughnut'" data="stageMixChartData"
                                     options="doughnutOptions"
                                     onClick="(i) => this.onStageClick(i)"/>
                        </div>
                    </div>

                    <div class="o_ktd_chart_panel">
                        <div class="o_ktd_chart_title">Tasks by Pipeline Stage</div>
                        <div class="o_ktd_chart_body">
                            <PtChart type="'doughnut'" data="pipelineChartData"
                                     options="pipelineChartOptions"
                                     onClick="(i) => this.onPipelineClick(i)"/>
                        </div>
                    </div>

                    <div class="o_ktd_chart_panel">
                        <div class="o_ktd_chart_title">Tasks by Project</div>
                        <div class="o_ktd_chart_body">
                            <PtChart type="'bar'" data="byProjectChartData"
                                     options="byProjectChartOptions"
                                     onClick="(i) => this.onByProjectClick(i)"/>
                        </div>
                    </div>

                    <div class="o_ktd_chart_panel o_ktd_chart_wide">
                        <div class="o_ktd_chart_title">Workload per Tasker</div>
                        <div class="o_ktd_chart_body">
                            <PtChart type="'bar'" data="workloadChartData"
                                     options="workloadChartOptions"
                                     onClick="(i) => this.onWorkloadClick(i)"/>
                        </div>
                    </div>

                    <div class="o_ktd_chart_panel">
                        <div class="o_ktd_chart_title">Feedback Outcomes</div>
                        <div class="o_ktd_chart_body o_ktd_chart_body_sm">
                            <PtChart type="'doughnut'" data="feedbackChartData"
                                     options="doughnutOptions"
                                     onClick="(i) => this.onFeedbackClick(i)"/>
                        </div>
                    </div>

                    <div class="o_ktd_chart_panel">
                        <div class="o_ktd_chart_title">Persona Availability</div>
                        <div class="o_ktd_chart_body o_ktd_chart_body_sm">
                            <PtChart type="'doughnut'" data="personaPoolChartData"
                                     options="doughnutOptions"
                                     onClick="(i) => this.onPersonaPoolClick(i)"/>
                        </div>
                    </div>
                </div>
            </t>

        </div>
    </t>
</templates>
