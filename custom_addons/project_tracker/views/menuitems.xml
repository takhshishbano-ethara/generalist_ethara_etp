<odoo>

    <menuitem name="Project Tracker" id="menu_project_tracker_root"
              groups="project_tracker.group_project_tracker_tasker,base.group_system"/>

    <!-- Landing for QL/PL/admin: the project cards. Opening a card drops you
         INTO that project (allocations, personas, team, dashboard all scoped).
         First in sequence, so the app opens here. -->
    <menuitem name="Projects" id="menu_project_tracker_projects"
              parent="menu_project_tracker_root"
              action="project_tracker_project_action" sequence="5"
              groups="project_tracker.group_project_tracker_ql,base.group_system"/>

    <!-- Cross-project overview. For a plain tasker this is their landing (they
         can't see Projects) and renders their personal dashboard; for QL/PL/admin
         it's the all-projects org view (filter by project inside it). -->
    <menuitem name="Dashboard" id="menu_project_tracker_dashboard"
              parent="menu_project_tracker_root"
              action="project_tracker_main_dashboard_action" sequence="10"
              groups="project_tracker.group_project_tracker_tasker,base.group_system"/>
    <menuitem name="Daily Tracker" id="menu_project_tracker_daily"
              parent="menu_project_tracker_root"
              action="project_tracker_daily_action" sequence="25"
              groups="project_tracker.group_project_tracker_ql,base.group_system"/>

    <!-- Task Allocation, Personas and Team Management are no longer flat
         top-level entries — they live INSIDE a project (its workspace tabs and
         smart buttons), so work can never span projects by accident. -->

</odoo>
