<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record model="ir.ui.view" id="project_tracker_project_list">
      <field name="name">project.tracker.project.list</field>
      <field name="model">project.tracker.project</field>
      <field name="arch" type="xml">
        <list string="Projects" sample="1">
          <field name="name"/>
          <field name="code" optional="show"/>
          <field name="allocation_count" string="Allocations"/>
          <field name="description" optional="hide"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="project_tracker_project_form">
      <field name="name">project.tracker.project.form</field>
      <field name="model">project.tracker.project</field>
      <field name="arch" type="xml">
        <form string="Project">
          <sheet>
            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                    invisible="active"/>
            <div class="oe_button_box" name="button_box">
              <button name="action_view_allocations" type="object"
                      class="oe_stat_button" icon="fa-tasks">
                <field name="allocation_count" widget="statinfo" string="Allocations"/>
              </button>
            </div>
            <group>
              <field name="active" invisible="1"/>
              <field name="name"/>
              <field name="code"/>
              <field name="description"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.ui.view" id="project_tracker_project_search">
      <field name="name">project.tracker.project.search</field>
      <field name="model">project.tracker.project</field>
      <field name="arch" type="xml">
        <search string="Projects">
          <field name="name"/>
          <field name="code"/>
          <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
        </search>
      </field>
    </record>

    <record model="ir.actions.act_window" id="project_tracker_project_action">
      <field name="name">Projects</field>
      <field name="res_model">project.tracker.project</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="project_tracker_project_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Create your first project</p>
        <p>Projects slice the Tracker — every allocation, dashboard and daily
           report can be filtered by project.</p>
      </field>
    </record>

  </data>
</odoo>
