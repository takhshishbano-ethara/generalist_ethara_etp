<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ===================== Projects: List ===================== -->
    <!-- Projects are lightweight labels used to slice allocations. They are
         created/edited here; there is no "open the project to work inside it"
         plane any more — Personas, Team and Task Allocation are all top-level
         and cross-project. -->
    <record model="ir.ui.view" id="project_tracker_project_list">
      <field name="name">project.tracker.project.list</field>
      <field name="model">project.tracker.project</field>
      <field name="arch" type="xml">
        <list string="Projects" sample="1" editable="bottom">
          <field name="name"/>
          <field name="project_type" string="Type"/>
          <field name="code" optional="show"/>
          <field name="allocation_count" string="Allocations"/>
          <field name="team_count" string="Team" optional="show"/>
          <field name="description" optional="hide"/>
        </list>
      </field>
    </record>

    <!-- ===================== Projects: Form (plain manager) ===================== -->
    <record model="ir.ui.view" id="project_tracker_project_form">
      <field name="name">project.tracker.project.form</field>
      <field name="model">project.tracker.project</field>
      <field name="arch" type="xml">
        <form string="Project">
          <sheet>
            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                    invisible="active"/>
            <div class="oe_title">
              <label for="name"/>
              <h1><field name="name" placeholder="e.g. Kensei SFT"/></h1>
            </div>
            <group>
              <field name="active" invisible="1"/>
              <field name="code" placeholder="e.g. KEN-SFT"/>
              <field name="project_type"/>
              <field name="description" placeholder="What this project covers…"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.ui.view" id="project_tracker_project_search">
      <field name="name">project.tracker.project.search</field>
      <field name="model">project.tracker.project</field>
      <field name="arch" type="xml">
        <search string="Projects">
          <field name="name"/>
          <field name="code"/>
          <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
          <group>
            <filter name="g_type" string="Type" context="{'group_by': 'project_type'}"/>
          </group>
        </search>
      </field>
    </record>

    <record model="ir.actions.act_window" id="project_tracker_project_action">
      <field name="name">Projects</field>
      <field name="res_model">project.tracker.project</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="project_tracker_project_search"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Create your first project</p>
        <p>A project is a label used to slice allocations. Create one here, then
           allocate work to it from <b>Task Allocation</b> — filter that list by
           project to see everything under it.</p>
      </field>
    </record>

  </data>
</odoo>
