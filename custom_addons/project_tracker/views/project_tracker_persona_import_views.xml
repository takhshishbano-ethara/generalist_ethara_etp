<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record model="ir.ui.view" id="project_tracker_persona_import_form">
      <field name="name">project.tracker.persona.import.form</field>
      <field name="model">project.tracker.persona.import</field>
      <field name="arch" type="xml">
        <form string="Bulk Upload Personas" class="o_project_tracker_form">

          <!-- ===== Step 1: upload ===== -->
          <div invisible="state == 'done'">
            <field name="project_type" invisible="1"/>
            <div class="alert alert-info" role="alert">
              Upload a CSV of persona names for
              <b><field name="pt_project_id" readonly="1" nolabel="1"
                        class="d-inline-block" options="{'no_open': True}"/></b>.
              Personas that already exist are <b>reused, not duplicated</b>, and
              are stamped with this project. Imported personas are left
              <b>unassigned</b> — distribute them afterwards with
              <b>Bulk Allocation → Load Unassigned Personas</b>.
              <!-- Columns follow the project type: SFT uses Domain/Agent Type,
                   RLHF uses L1/L2. -->
              <div class="mt-2" invisible="project_type == 'rlhf'">
                <b>Columns:</b> <code>Persona Name</code> (required),
                <code>Domain</code>, <code>Agent Type</code> (optional). A header
                row is optional — a single-column file of names works too.
                <a href="/project_tracker/persona/sample_csv" class="ms-2">
                  <i class="fa fa-download me-1"/>Download sample CSV
                </a>
              </div>
              <div class="mt-2" invisible="project_type != 'rlhf'">
                <b>Columns:</b> <code>Persona Name</code> (required),
                <code>L1</code>, <code>L2</code> (optional). A header row is
                optional — a single-column file of names works too.
                <a href="/project_tracker/persona/sample_csv?type=rlhf" class="ms-2">
                  <i class="fa fa-download me-1"/>Download sample CSV
                </a>
              </div>
            </div>
            <group>
              <field name="csv_file" filename="filename" widget="binary"/>
              <field name="filename" invisible="1"/>
            </group>
          </div>

          <!-- ===== Step 2: result ===== -->
          <div invisible="state != 'done'">
            <group>
              <group>
                <field name="total_count" readonly="1"/>
                <field name="created_count" readonly="1"/>
                <field name="reused_count" readonly="1"/>
              </group>
            </group>
            <field name="result_html" nolabel="1" readonly="1"/>
          </div>

          <field name="state" invisible="1"/>

          <footer>
            <button name="action_import" type="object" string="Import Personas"
                    class="btn-primary" invisible="state == 'done'"
                    data-hotkey="q"/>
            <button name="action_open_bulk_allocation" type="object"
                    string="Allocate Them Now" class="btn-primary"
                    invisible="state != 'done'"/>
            <button string="Close" class="btn-secondary" special="cancel"
                    data-hotkey="x"/>
          </footer>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="action_project_tracker_persona_import">
      <field name="name">Bulk Upload Personas</field>
      <field name="res_model">project.tracker.persona.import</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

  </data>
</odoo>
