<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ===================== Tracker Persona: List ===================== -->
    <!-- Distinct from the generic Personas list under the Kensei2 app: this one is
         about ALLOCATION — is this persona in play, who has it, and where is it. -->
    <record model="ir.ui.view" id="project_tracker_persona_list">
      <field name="name">project.tracker.persona.list</field>
      <field name="model">kensei2.persona</field>
      <field name="arch" type="xml">
        <!-- Unassigned personas are the actionable ones (they are waiting to be
             allocated), so they stay at normal weight; assigned ones recede. -->
        <list string="Personas" sample="1" multi_edit="1" js_class="project_tracker_stats_list"
              decoration-muted="pt_assignment_status == 'assigned'">
          <header>
            <!-- Forward the project we're scoped to (set by the project's
                 Personas smart button) so the wizards stamp imports with it and
                 pick the right taxonomy columns. -->
            <button name="%(action_project_tracker_persona_import)d" type="action"
                    string="Upload Personas" class="btn-primary text-nowrap"
                    icon="fa-upload" display="always"
                    context="{'default_pt_project_id': context.get('default_pt_project_id')}"
                    groups="project_tracker.group_project_tracker_ql"/>
            <button name="%(action_project_tracker_bulk_allocation)d" type="action"
                    string="Bulk Allocation" class="btn-secondary text-nowrap"
                    icon="fa-random" display="always"
                    context="{'default_pt_project_id': context.get('default_pt_project_id')}"
                    groups="project_tracker.group_project_tracker_ql"/>
          </header>

          <field name="name"/>
          <field name="pt_project_id" string="Project" optional="show"/>
          <!-- Columns follow the project type carried in context (set by a
               project's Personas smart button): RLHF shows L1/L2, SFT shows
               Domain/Agent Type. -->
          <field name="l1_category" string="L1 Category"
                 column_invisible="context.get('pt_project_type') != 'rlhf'"/>
          <field name="l2_category" string="L2 Category"
                 column_invisible="context.get('pt_project_type') != 'rlhf'"/>
          <field name="pt_domain" string="Domain"
                 column_invisible="context.get('pt_project_type') == 'rlhf'"/>
          <field name="pt_agent_type" string="Agent Type"
                 column_invisible="context.get('pt_project_type') == 'rlhf'"/>

          <field name="pt_assignment_status" widget="badge"
                 decoration-success="pt_assignment_status == 'assigned'"
                 decoration-warning="pt_assignment_status == 'unassigned'"/>

          <!-- Who has it, and where it is -->
          <field name="pt_current_task_ref" string="Task ID" optional="show"/>
          <field name="pt_current_stage" string="Stage" optional="show"/>
          <field name="pt_current_tasker_id" string="Tasker" optional="show"/>
          <field name="pt_current_pl_id" string="PL" optional="show"/>
          <field name="pt_current_status" string="Task Status" widget="badge"
                 optional="show"
                 decoration-success="pt_current_status == 'deliverable'"
                 decoration-danger="pt_current_status == 'failed'"
                 decoration-warning="pt_current_status in ('manual_qc','ready_next_stage')"/>
          <field name="pt_allocation_count" string="Allocations" optional="hide"/>

          <button name="action_view_pt_allocations" type="object"
                  string="Allocations" icon="fa-list"
                  invisible="pt_allocation_count == 0"/>
        </list>
      </field>
    </record>

    <!-- ===================== Tracker Persona: Search ===================== -->
    <record model="ir.ui.view" id="project_tracker_persona_search">
      <field name="name">project.tracker.persona.search</field>
      <field name="model">kensei2.persona</field>
      <field name="arch" type="xml">
        <search string="Personas">
          <field name="name"/>
          <field name="pt_project_id" string="Project"/>
          <field name="l1_category"/>
          <field name="l2_category"/>
          <field name="pt_current_task_ref" string="Task ID"/>
          <field name="pt_current_tasker_id" string="Tasker"/>

          <!-- Unassigned first: that is the queue to act on. -->
          <filter name="f_unassigned" string="Unassigned"
                  domain="[('pt_assignment_status', '=', 'unassigned')]"/>
          <filter name="f_assigned" string="Assigned"
                  domain="[('pt_assignment_status', '=', 'assigned')]"/>
          <separator/>
          <filter name="f_in_flight" string="In Flight"
                  domain="[('pt_current_status', 'not in', ('deliverable', 'failed')),
                           ('pt_assignment_status', '=', 'assigned')]"/>
          <filter name="f_delivered" string="Delivered"
                  domain="[('pt_current_status', '=', 'deliverable')]"/>
          <filter name="f_failed" string="Failed"
                  domain="[('pt_current_status', '=', 'failed')]"/>
          <separator/>
          <filter name="f_archived" string="Archived" domain="[('active', '=', False)]"/>

          <group>
            <filter name="g_project" string="Project"
                    context="{'group_by': 'pt_project_id'}"/>
            <filter name="g_assignment" string="Assignment"
                    context="{'group_by': 'pt_assignment_status'}"/>
            <filter name="g_status" string="Task Status"
                    context="{'group_by': 'pt_current_status'}"/>
            <filter name="g_tasker" string="Tasker"
                    context="{'group_by': 'pt_current_tasker_id'}"/>
            <filter name="g_pl" string="PL" context="{'group_by': 'pt_current_pl_id'}"/>
            <filter name="g_l1" string="L1 Category" context="{'group_by': 'l1_category'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ===================== Action ===================== -->
    <record model="ir.actions.act_window" id="project_tracker_persona_action">
      <field name="name">Personas</field>
      <field name="res_model">kensei2.persona</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="project_tracker_persona_search"/>
      <!-- Bind the tracker-specific LIST while reusing the existing persona form. -->
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('project_tracker_persona_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('kensei2.kensei2_persona_form')})]"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No personas yet</p>
        <p>Use <b>Bulk Upload Personas</b> to import them from a CSV, then
           <b>Bulk Allocation</b> to distribute them to taskers.</p>
      </field>
    </record>

    <!-- ===================== Persona form: Tracker fields ===================== -->
    <!-- Add the project link + the RLHF taxonomy (Domain / Agent Type) next to
         the SFT L1/L2 on the shared kensei2 persona form, so a persona's
         attributes are editable wherever it is opened. -->
    <record model="ir.ui.view" id="kensei2_persona_form_pt_fields">
      <field name="name">kensei2.persona.form.project.tracker</field>
      <field name="model">kensei2.persona</field>
      <field name="inherit_id" ref="kensei2.kensei2_persona_form"/>
      <field name="arch" type="xml">
        <!-- Append inside the sheet rather than anchoring on l1/l2 — those fields
             may not exist on every deployment's persona form, and a missing
             anchor makes the whole module fail to install. Every form has a
             <sheet>, so this is safe everywhere. -->
        <xpath expr="//sheet" position="inside">
          <group string="Project Tracker" name="pt_group">
            <field name="pt_project_id" options="{'no_create_edit': True}"/>
            <field name="pt_domain"/>
            <field name="pt_agent_type"/>
          </group>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
