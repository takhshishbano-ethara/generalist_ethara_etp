<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ===================== Tracker Persona: List ===================== -->
    <!-- The GLOBAL persona pool. A persona is just a reusable name — no project,
         no taxonomy. The same persona can be allocated on any project, to any
         number of taskers. Taxonomy (L1/L2, Agent Type) is TASK-specific and
         lives on the allocation, filled by the tasker. -->
    <record model="ir.ui.view" id="project_tracker_persona_list">
      <field name="name">project.tracker.persona.list</field>
      <field name="model">kensei2.persona</field>
      <field name="arch" type="xml">
        <!-- Unassigned personas are the actionable ones (they are waiting to be
             allocated), so they stay at normal weight; assigned ones recede. -->
        <list string="Personas" sample="1" multi_edit="1" editable="bottom"
              js_class="project_tracker_stats_list"
              decoration-muted="pt_assignment_status == 'assigned'">
          <header>
            <!-- Only importing into the pool lives here. Allocation (bulk or
                 otherwise) is a Task Allocation concern, not a persona-pool one. -->
            <button name="%(action_project_tracker_persona_import)d" type="action"
                    string="Upload Personas" class="btn-primary text-nowrap"
                    icon="fa-upload" display="always"
                    groups="project_tracker.group_project_tracker_ql"/>
          </header>

          <field name="name"/>
          <field name="pt_domain" string="Domain" placeholder="e.g. coding"
                 optional="show"/>
          <field name="pt_source_url" string="Source URL" widget="url"
                 placeholder="https://…" optional="show"/>
          <!-- The persona pool only shows whether a persona is IN USE (allocated
               to at least one task). No taxonomy, no task detail — a persona is
               global and can be in many allocations at once. -->
          <field name="pt_assignment_status" string="In Use" widget="badge"
                 decoration-success="pt_assignment_status == 'assigned'"
                 decoration-warning="pt_assignment_status == 'unassigned'"/>
          <field name="pt_allocation_count" string="Allocations" optional="show"/>

          <button name="action_view_pt_allocations" type="object"
                  string="Allocations" icon="fa-list"
                  invisible="pt_allocation_count == 0"/>
        </list>
      </field>
    </record>

    <!-- ===================== Tracker Persona: Search ===================== -->
    <record model="ir.ui.view" id="project_tracker_persona_search">
      <field name="name">project.tracker.persona.search</field>
      <field name="model">kensei2.persona</field>
      <field name="arch" type="xml">
        <search string="Personas">
          <field name="name"/>
          <field name="pt_domain" string="Domain"/>
          <field name="pt_source_url" string="Source URL"/>

          <!-- Availability only — the persona pool is about what is free to
               allocate, not the state of any particular task using it. -->
          <filter name="f_unassigned" string="Available"
                  domain="[('pt_assignment_status', '=', 'unassigned')]"/>
          <filter name="f_assigned" string="In Use"
                  domain="[('pt_assignment_status', '=', 'assigned')]"/>
          <separator/>
          <filter name="f_archived" string="Archived" domain="[('active', '=', False)]"/>

          <group>
            <filter name="g_assignment" string="In Use"
                    context="{'group_by': 'pt_assignment_status'}"/>
            <filter name="g_domain" string="Domain"
                    context="{'group_by': 'pt_domain'}"/>
          </group>
        </search>
      </field>
    </record>

    <!-- ===================== Action ===================== -->
    <record model="ir.actions.act_window" id="project_tracker_persona_action">
      <field name="name">Personas</field>
      <field name="res_model">kensei2.persona</field>
      <!-- LIST ONLY. No form is bound, so a row click never opens the full
           kensei2 persona detail (MD, docker, all its fields) — the pool is just
           a flat list, editable inline for quick fixes. -->
      <field name="view_mode">list</field>
      <field name="search_view_id" ref="project_tracker_persona_search"/>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('project_tracker_persona_list')})]"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No personas yet</p>
        <p>Use <b>Upload Personas</b> to import them from a CSV, then
           <b>Bulk Allocation</b> to distribute them to taskers.</p>
      </field>
    </record>

  </data>
</odoo>
