<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record model="ir.ui.view" id="project_tracker_stage_handoff_form">
      <field name="name">project.tracker.stage.handoff.form</field>
      <field name="model">project.tracker.stage.handoff</field>
      <field name="arch" type="xml">
        <form string="Hand off to Next Stage" class="o_project_tracker_form">
          <field name="allocation_id" invisible="1"/>
          <div class="alert alert-info" role="alert">
            Stage <b><field name="current_stage_no" readonly="1" nolabel="1" class="oe_inline"/></b>
            is complete. The next stage keeps the same <b>Task ID</b> and
            <b>Persona</b>, and starts fresh at <b>In Progress</b> for the tasker
            you pick below.
          </div>
          <group>
            <group string="Task">
              <field name="task_id" readonly="1"/>
              <field name="persona_id" readonly="1" options="{'no_open': True}"/>
              <field name="current_tasker_id" readonly="1" options="{'no_open': True}"/>
            </group>
            <group string="Next Stage">
              <field name="next_stage_no" readonly="1"/>
              <field name="tasker_member_id"
                     options="{'no_create': True, 'no_open': True}"
                     placeholder="Search a team member by name or email…"/>
              <field name="assigned_date"/>
            </group>
          </group>
          <footer>
            <button name="action_confirm" type="object" string="Allocate Next Stage"
                    class="btn-primary" data-hotkey="q"/>
            <button string="Cancel" class="btn-secondary" special="cancel"
                    data-hotkey="x"/>
          </footer>
        </form>
      </field>
    </record>

  </data>
</odoo>
