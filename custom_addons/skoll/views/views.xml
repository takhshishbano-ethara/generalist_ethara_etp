<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="skoll_view_list" model="ir.ui.view">
        <field name="name">skoll.skoll.list</field>
        <field name="model">skoll.skoll</field>
        <field name="arch" type="xml">
            <list>
                <field name="task_id"/>
                <field name="persona_id"/>
                <field name="life_domain_ids" widget="many2many_tags" optional="show"/>
                <field name="cluster_ids" widget="many2many_tags" optional="show"/>
                <field name="task_type_ids" widget="many2many_tags" optional="show"/>
                <field name="pattern_taxonomy_ids" widget="many2many_tags" optional="hide"/>
                <field name="mode"/>
                <field name="qc_status" decoration-success="qc_status == 'pass'"
                       decoration-danger="qc_status in ('fail', 'error')"
                       decoration-warning="qc_status == 'needs_revision'"
                       decoration-info="qc_status == 'running'" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="skoll_view_form" model="ir.ui.view">
        <field name="name">skoll.skoll.form</field>
        <field name="model">skoll.skoll</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="task_id"/>
                        <h1>
                            <field name="task_id" placeholder="Task ID"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="persona_id" readonly="1"/>
                            <field name="employee_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="mode" widget="radio"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Task Metadata">
                        <group>
                            <field name="life_domain_ids" widget="many2many_tags" readonly="1"/>
                            <field name="cluster_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group>
                            <field name="task_type_ids" widget="many2many_tags" readonly="1"/>
                            <field name="pattern_taxonomy_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <group string="Credentials" invisible="not credential and not password">
                        <group>
                            <field name="credential" readonly="1"/>
                        </group>
                        <group>
                            <field name="password" readonly="1"/>
                        </group>
                    </group>
                    <div class="w-100 mb-3" invisible="not prerequisites">
                        <label for="prerequisites" string="Prerequisites" class="fw-bold mb-1"/>
                        <field name="prerequisites" widget="skoll_markdown" readonly="1"/>
                    </div>
                    <group string="Task Context" invisible="not spawned_agents">
                        <field name="spawned_agents" readonly="1" nolabel="1"
                               placeholder="No spawned agents" colspan="2"
                               invisible="not spawned_agents"/>
                    </group>

                    <field name="is_skoll_admin" invisible="1"/>
                    <field name="is_ql_or_pl" invisible="1"/>

                    <div class="w-100 mb-3">
                        <label for="seed_prompt" string="Seed Prompt" class="fw-bold mb-1"/>
                        <field name="seed_prompt" widget="skoll_markdown" readonly="1"/>
                    </div>
                    <div class="d-flex gap-3 w-100 mb-3 o_skoll_md_row">
                        <div class="flex-fill" style="min-width: 0; flex: 1;">
                            <label for="agent_md" string="Agent MD" class="fw-bold mb-1"/>
                            <field name="agent_md" widget="skoll_markdown" readonly="1" class="o_skoll_md_scroll"/>
                        </div>
                        <div class="flex-fill" style="min-width: 0; flex: 1;">
                            <label for="soul_md" string="Soul MD" class="fw-bold mb-1"/>
                            <field name="soul_md" widget="skoll_markdown" readonly="1" class="o_skoll_md_scroll"/>
                        </div>
                        <div class="flex-fill" style="min-width: 0; flex: 1;">
                            <label for="memory_md" string="Memory MD" class="fw-bold mb-1"/>
                            <field name="memory_md" widget="skoll_markdown" readonly="1" class="o_skoll_md_scroll"/>
                        </div>
                    </div>

                    <separator string="Prompt"/>
                    <field name="prompt" widget="skoll_prompt" placeholder="Enter your prompt here..."/>

                    <separator string="Golden Trajectory"/>
                    <field name="content" widget="skoll_json" force_save="1"/>

                    <separator string="Spawn Tree"/>
                    <field name="spawn_tree" widget="skoll_spawn_tree" readonly="1" force_save="1"/>

                    <separator string="Quality Check"/>
                    <group>
                        <group>
                            <field name="qc_status" readonly="1" force_save="1" widget="badge"
                                   decoration-success="qc_status == 'pass'"
                                   decoration-danger="qc_status in ('fail', 'error')"
                                   decoration-warning="qc_status == 'needs_revision'"
                                   decoration-info="qc_status == 'running'"/>
                        </group>
                    </group>
                    <notebook invisible="not qc_structural_result and not qc_result">
                        <page string="Structural Validation" name="qc_structural"
                              invisible="not qc_structural_result">
                            <field name="qc_structural_result" readonly="1" widget="text"/>
                        </page>
                        <page string="LLM QC Review" name="qc_result"
                              invisible="not qc_result">
                            <field name="qc_result" readonly="1" force_save="1" widget="skoll_qc_result"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="skoll_action_window" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">skoll.skoll</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Skoll" id="skoll.menu_root"/>
    <menuitem name="Tasks" id="skoll.menu_tasks" parent="skoll.menu_root"
              action="skoll_action_window"/>
    <menuitem name="Personas" id="skoll.menu_personas" parent="skoll.menu_root"
              action="skoll_persona_action"/>
    <menuitem name="Costing" id="skoll.menu_costing" parent="skoll.menu_root"
              groups="group_skoll_ql"/>
    <menuitem name="Trajectory" id="skoll.menu_costing_traj" parent="skoll.menu_costing"
              action="skoll_generation_traj_action"/>
    <menuitem name="QC" id="skoll.menu_costing_qc" parent="skoll.menu_costing"
              action="skoll_generation_qc_action"/>
    <menuitem name="Improve" id="skoll.menu_costing_improve" parent="skoll.menu_costing"
              action="skoll_generation_improve_action"/>
    <menuitem name="Combined" id="skoll.menu_costing_combined" parent="skoll.menu_costing"
              action="skoll_generation_dashboard_action"/>
    <menuitem name="All Logs" id="skoll.menu_generation_logs" parent="skoll.menu_costing"
              action="skoll_generation_action"/>

</odoo>
