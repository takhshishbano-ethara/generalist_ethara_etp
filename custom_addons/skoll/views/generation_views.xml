<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="skoll_generation_view_list" model="ir.ui.view">
        <field name="name">skoll.generation.list</field>
        <field name="model">skoll.generation</field>
        <field name="arch" type="xml">
            <list string="Generation Logs" default_order="create_date desc" create="0" edit="0">
                <field name="create_date" string="Date"/>
                <field name="call_type"/>
                <field name="task_ref"/>
                <field name="user_id"/>
                <field name="persona_id" optional="show"/>
                <field name="input_tokens" sum="Total Input"/>
                <field name="output_tokens" sum="Total Output"/>
                <field name="total_tokens" sum="Total Tokens" decoration-bf="1"/>
                <field name="total_cost" sum="Total Cost" widget="float" digits="[12,4]" decoration-bf="1"/>
                <field name="duration_s" optional="hide" avg="Avg Duration"/>
                <field name="status" decoration-success="status == 'success'" decoration-danger="status == 'error'"/>
                <field name="model_arn" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="skoll_generation_view_form" model="ir.ui.view">
        <field name="name">skoll.generation.form</field>
        <field name="model">skoll.generation</field>
        <field name="arch" type="xml">
            <form string="Generation Log" create="0" edit="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(skoll_action_window)d" type="action" class="oe_stat_button"
                                icon="fa-tasks" string="Task" invisible="not task_id"/>
                    </div>
                    <group>
                        <group>
                            <field name="task_ref"/>
                            <field name="task_id"/>
                            <field name="user_id"/>
                            <field name="persona_id"/>
                            <field name="create_date" string="Date"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="model_arn"/>
                            <field name="duration_s"/>
                        </group>
                    </group>
                    <group string="Token Usage &amp; Cost">
                        <group>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                            <field name="total_tokens"/>
                        </group>
                        <group>
                            <field name="input_cost" widget="float" digits="[12,6]"/>
                            <field name="output_cost" widget="float" digits="[12,6]"/>
                            <field name="total_cost" widget="float" digits="[12,6]"/>
                        </group>
                    </group>
                    <group string="Error" invisible="status != 'error'">
                        <field name="error_message" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="skoll_generation_view_search" model="ir.ui.view">
        <field name="name">skoll.generation.search</field>
        <field name="model">skoll.generation</field>
        <field name="arch" type="xml">
            <search string="Generation Logs">
                <field name="task_ref" string="Task ID"/>
                <field name="user_id"/>
                <field name="persona_id"/>
                <filter name="success" string="Success" domain="[('status', '=', 'success')]"/>
                <filter name="errors" string="Errors" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter name="type_generate" string="Generate" domain="[('call_type', '=', 'generate')]"/>
                <filter name="type_qc" string="QC" domain="[('call_type', '=', 'qc')]"/>
                <filter name="type_improve" string="Improve" domain="[('call_type', '=', 'improve')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('create_date', '>=', (context_today()).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="this_week" string="This Week" domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="this_month" string="This Month" domain="[('create_date', '>=', (context_today()).strftime('%%Y-%%m-01'))]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_task" string="Task" context="{'group_by': 'task_ref'}"/>
                    <filter name="group_persona" string="Persona" context="{'group_by': 'persona_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
                    <filter name="group_week" string="Week" context="{'group_by': 'create_date:week'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="skoll_generation_view_pivot" model="ir.ui.view">
        <field name="name">skoll.generation.pivot</field>
        <field name="model">skoll.generation</field>
        <field name="arch" type="xml">
            <pivot string="Generation Costs" sample="1">
                <field name="user_id" type="row"/>
                <field name="task_ref" type="row"/>
                <field name="total_tokens" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="input_tokens" type="measure"/>
                <field name="output_tokens" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="skoll_generation_view_graph" model="ir.ui.view">
        <field name="name">skoll.generation.graph</field>
        <field name="model">skoll.generation</field>
        <field name="arch" type="xml">
            <graph string="Generation Costs" type="bar" sample="1">
                <field name="user_id"/>
                <field name="total_cost" type="measure"/>
                <field name="total_tokens" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ====== Actions ====== -->

    <!-- All logs (unfiltered) -->
    <record id="skoll_generation_action" model="ir.actions.act_window">
        <field name="name">All Generation Logs</field>
        <field name="res_model">skoll.generation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="skoll_generation_view_search"/>
    </record>

    <!-- Trajectory only -->
    <record id="skoll_generation_traj_action" model="ir.actions.act_window">
        <field name="name">Trajectory Costing</field>
        <field name="res_model">skoll.generation</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="skoll_generation_view_search"/>
        <field name="domain">[('call_type', '=', 'generate')]</field>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_user': 1}</field>
    </record>

    <!-- QC only -->
    <record id="skoll_generation_qc_action" model="ir.actions.act_window">
        <field name="name">QC Costing</field>
        <field name="res_model">skoll.generation</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="skoll_generation_view_search"/>
        <field name="domain">[('call_type', '=', 'qc')]</field>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_user': 1}</field>
    </record>

    <!-- Improve only -->
    <record id="skoll_generation_improve_action" model="ir.actions.act_window">
        <field name="name">Improve Costing</field>
        <field name="res_model">skoll.generation</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="skoll_generation_view_search"/>
        <field name="domain">[('call_type', '=', 'improve')]</field>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_user': 1}</field>
    </record>

    <!-- Combined dashboard (all) -->
    <record id="skoll_generation_dashboard_action" model="ir.actions.act_window">
        <field name="name">Combined Costing</field>
        <field name="res_model">skoll.generation</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="skoll_generation_view_search"/>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_user': 1}</field>
    </record>

</odoo>
