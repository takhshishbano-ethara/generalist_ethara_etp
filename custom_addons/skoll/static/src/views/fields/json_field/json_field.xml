<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="skoll.JsonField">
        <div class="o_field_skoll_json o_field_widget" t-att-class="{'o_field_skoll_json_readonly': isReadonly || isAiMode}">

            <!-- Streaming state (AI mode) -->
            <t t-if="state.streaming">
                <div class="skoll-json-viewer skoll-json-viewer-streaming">
                    <div class="skoll-json-viewer-header">
                        <span class="skoll-json-viewer-label">
                            <i class="fa fa-circle skoll-streaming-dot"/> Streaming
                        </span>
                    </div>
                    <div class="skoll-json-viewer-body" t-ref="streamBody" t-out="streamHighlightedHtml"/>
                </div>
            </t>

            <!-- Manual mode + form edit = always show direct textarea -->
            <t t-elif="isManualEdit">
                <div class="skoll-json-manual-container">
                    <div class="skoll-json-viewer-header">
                        <span class="skoll-json-viewer-label">
                            <i class="fa fa-pencil-square-o"/> Golden Trajectory
                        </span>
                        <div class="skoll-json-header-actions">
                            <button t-if="hasContent" class="skoll-copy-btn" t-on-click="onCopyJson" title="Copy JSON">
                                <t t-if="state.copied">
                                    <i class="fa fa-check"/> Copied
                                </t>
                                <t t-else="">
                                    <i class="fa fa-clipboard"/> Copy
                                </t>
                            </button>
                            <button t-if="canRunQc and !state.qcRunning"
                                    class="skoll-qc-btn"
                                    t-on-click="onRunQc"
                                    title="Run QC on trajectory">
                                <i class="fa fa-check-circle"/> Run QC
                            </button>
                            <button t-if="hasContent and !state.buildingTree"
                                    class="skoll-spawn-tree-btn"
                                    t-on-click="onBuildSpawnTree"
                                    title="Generate spawn tree visualization">
                                <i class="fa fa-sitemap"/> Spawn Tree
                            </button>
                            <span t-if="state.buildingTree" class="skoll-spawn-tree-building">
                                <i class="fa fa-spinner fa-spin"/> Building Tree...
                            </span>
                            <span t-if="state.qcRunning" class="skoll-qc-running">
                                <i class="fa fa-spinner fa-spin"/> QC Running...
                            </span>
                            <span t-if="state.improving" class="skoll-improve-running">
                                <i class="fa fa-spinner fa-spin"/> Improving...
                            </span>
                        </div>
                    </div>
                    <textarea class="skoll-json-edit-textarea skoll-json-manual-textarea"
                              t-ref="editTextarea"
                              t-att-value="manualValue"
                              t-on-input="onManualInput"
                              placeholder="Paste or type your golden trajectory JSON here..."
                              spellcheck="false"/>
                </div>
            </t>

            <!-- AI edit mode -->
            <t t-elif="state.aiEditing">
                <div class="skoll-json-viewer skoll-json-ai-edit">
                    <div class="skoll-json-viewer-header">
                        <span class="skoll-json-viewer-label">
                            <i class="fa fa-pencil"/> Editing Trajectory
                        </span>
                        <div class="skoll-json-header-actions">
                            <button class="skoll-ai-edit-save-btn" t-on-click="onSaveAiEdit" title="Save changes">
                                <i class="fa fa-check"/> Save
                            </button>
                            <button class="skoll-ai-edit-cancel-btn" t-on-click="onCancelAiEdit" title="Discard changes">
                                <i class="fa fa-times"/> Cancel
                            </button>
                        </div>
                    </div>
                    <textarea class="skoll-json-edit-textarea skoll-json-ai-edit-textarea"
                              t-att-value="state.aiEditBuffer"
                              t-on-input="onAiEditInput"
                              spellcheck="false"/>
                </div>
            </t>

            <!-- Read-only viewer (AI mode or readonly manual with content) -->
            <t t-elif="hasContent">
                <div class="skoll-json-viewer">
                    <div class="skoll-json-viewer-header">
                        <span class="skoll-json-viewer-label">
                            <i class="fa fa-code"/> Golden Trajectory
                        </span>
                        <div class="skoll-json-header-actions">
                            <button class="skoll-copy-btn" t-on-click="onCopyJson" title="Copy JSON">
                                <t t-if="state.copied">
                                    <i class="fa fa-check"/> Copied
                                </t>
                                <t t-else="">
                                    <i class="fa fa-clipboard"/> Copy
                                </t>
                            </button>
                            <button t-if="isAiMode and !isReadonly"
                                    class="skoll-edit-btn"
                                    t-on-click="onStartAiEdit"
                                    title="Edit trajectory">
                                <i class="fa fa-pencil"/> Edit
                            </button>
                            <button t-if="canRunQc and !state.qcRunning"
                                    class="skoll-qc-btn"
                                    t-on-click="onRunQc"
                                    title="Run QC on trajectory">
                                <i class="fa fa-check-circle"/> Run QC
                            </button>
                            <button class="skoll-improve-btn"
                                    t-on-click="onImprove"
                                    title="Improve trajectory based on QC feedback">
                                <i class="fa fa-magic"/> Improve
                            </button>
                            <button t-if="!state.buildingTree"
                                    class="skoll-spawn-tree-btn"
                                    t-on-click="onBuildSpawnTree"
                                    title="Generate spawn tree visualization">
                                <i class="fa fa-sitemap"/> Spawn Tree
                            </button>
                            <span t-if="state.buildingTree" class="skoll-spawn-tree-building">
                                <i class="fa fa-spinner fa-spin"/> Building Tree...
                            </span>
                            <span t-if="state.qcRunning" class="skoll-qc-running">
                                <i class="fa fa-spinner fa-spin"/> QC Running...
                            </span>
                            <span t-if="state.improving" class="skoll-improve-running">
                                <i class="fa fa-spinner fa-spin"/> Improving...
                            </span>
                        </div>
                    </div>
                    <t t-if="state.truncated">
                        <div class="skoll-truncation-banner">
                            <i class="fa fa-exclamation-triangle"/>
                            Output truncated — the model hit the max token limit. The trajectory JSON is incomplete and will fail structural validation.
                        </div>
                    </t>
                    <div class="skoll-json-viewer-body" t-out="state.highlightedHtml"/>
                </div>
            </t>

            <!-- Empty state -->
            <t t-else="">
                <div class="skoll-json-empty">
                    <i class="fa fa-file-code-o"/> No content yet
                </div>
            </t>

        </div>
    </t>

</templates>
