<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="skoll.PromptField">
        <div class="o_field_skoll_prompt o_field_widget">

            <div class="skoll-prompt-container">
                <div class="skoll-prompt-header">
                    <span class="skoll-prompt-label">
                        <i class="fa fa-terminal"/> Prompt
                    </span>
                    <t t-if="isAiMode and !isReadonly">
                        <div class="skoll-prompt-actions">
                            <t t-if="state.generating">
                                <button class="skoll-prompt-stop-btn"
                                        t-on-click="onStopGenerate">
                                    <i class="fa fa-stop"/> Stop
                                </button>
                            </t>
                            <t t-else="">
                                <button class="skoll-prompt-generate-btn"
                                        t-att-disabled="!canGenerate"
                                        t-on-click="onGenerate">
                                    <i class="fa fa-magic"/> Generate
                                </button>
                            </t>
                        </div>
                    </t>
                </div>

                <t t-if="isReadonly">
                    <div class="skoll-prompt-readonly">
                        <t t-if="state.value">
                            <t t-esc="state.value"/>
                        </t>
                        <t t-else="">
                            <span class="text-muted">No prompt</span>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <textarea class="skoll-prompt-textarea"
                              t-ref="promptTextarea"
                              t-att-value="state.value"
                              t-on-input="onInput"
                              t-att-placeholder="props.placeholder || 'Enter your prompt here...'"
                              t-att-disabled="state.generating"
                              spellcheck="false"/>
                </t>
            </div>

        </div>
    </t>

</templates>
