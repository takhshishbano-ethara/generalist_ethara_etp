<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_lynceus_prompt_tasker_own" model="ir.rule">
            <field name="name">Lynceus Prompt: Tasker sees only their own assigned prompts</field>
            <field name="model_id" ref="model_lynceus_prompt"/>
            <field name="domain_force">[('assigned_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_lynceus_tasker'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_lynceus_prompt_manager" model="ir.rule">
            <field name="name">Lynceus Prompt: Manager sees company-wide</field>
            <field name="model_id" ref="model_lynceus_prompt"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_lynceus_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_lynceus_batch_manager_only" model="ir.rule">
            <field name="name">Lynceus Batch: Manager-only</field>
            <field name="model_id" ref="model_lynceus_batch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_lynceus_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_lynceus_history_manager_only" model="ir.rule">
            <field name="name">Lynceus History: Manager-only</field>
            <field name="model_id" ref="model_lynceus_history"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_lynceus_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_lynceus_assignment_log_manager_only" model="ir.rule">
            <field name="name">Lynceus Assignment Log: Manager-only</field>
            <field name="model_id" ref="model_lynceus_assignment_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_lynceus_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
