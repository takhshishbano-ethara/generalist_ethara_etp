<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_lynceus" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lynceus</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Lynceus" string="Lynceus" name="lynceus" groups="lynceus.group_lynceus_manager">
                    <block title="Vertex AI (Gemini)" name="lynceus_vertex_block">
                        <setting id="lynceus_vertex_key_setting" string="API Key"
                                 help="Stored encrypted. Once set, the field shows a mask - submit a new value to rotate.">
                            <field name="lynceus_vertex_api_key"
                                   password="True"
                                   placeholder="AIza..."/>
                            <div invisible="not lynceus_vertex_api_key_is_set">
                                <span class="badge text-bg-success">API key configured</span>
                            </div>
                        </setting>
                        <setting id="lynceus_vertex_model_setting" string="Model"
                                 help="Gemini model ID as exposed by Vertex AI Express endpoint, e.g. gemini-3.5-flash.">
                            <field name="lynceus_vertex_model"/>
                        </setting>
                        <setting id="lynceus_vertex_base_url_setting" string="Base URL">
                            <field name="lynceus_vertex_base_url"/>
                        </setting>
                        <setting id="lynceus_vertex_retries_setting" string="Max Retries">
                            <field name="lynceus_vertex_max_retries"/>
                        </setting>
                        <setting id="lynceus_batch_call_size_setting" string="Prompts per LLM Call"
                                 help="How many prompts a single Gemini call returns. Each parsed prompt becomes one DB record.">
                            <field name="lynceus_batch_call_size"/>
                        </setting>
                        <setting id="lynceus_vertex_max_tokens_setting" string="Max Output Tokens / Call">
                            <field name="lynceus_vertex_max_output_tokens"/>
                        </setting>
                    </block>

                    <block title="Defaults" name="lynceus_defaults_block">
                        <setting id="lynceus_default_batch_size_setting" string="Default Batch Size (N)">
                            <field name="lynceus_default_batch_size"/>
                        </setting>
                        <setting id="lynceus_default_quota_setting" string="Default Per-Tasker Quota">
                            <field name="lynceus_default_tasker_quota"/>
                        </setting>
                        <setting id="lynceus_reclaim_hours_setting" string="Reclaim Window (hours)">
                            <field name="lynceus_reclaim_hours"/>
                        </setting>
                        <setting id="lynceus_pool_depletion_setting" string="Pool Depletion Threshold">
                            <field name="lynceus_pool_depletion_threshold"/>
                        </setting>
                    </block>

                    <block title="Performance" name="lynceus_performance_block">
                        <setting id="lynceus_parallel_setting" string="Parallel API Calls"
                                 help="Max concurrent HTTP requests during batch generation. Higher = faster, but check Vertex AI rate limits.">
                            <field name="lynceus_parallel_calls"/>
                        </setting>
                        <setting id="lynceus_bulk_insert_setting" string="Bulk Insert Chunk Size"
                                 help="How many generated prompts to commit at once. 50 balances commit frequency vs write throughput.">
                            <field name="lynceus_bulk_insert_chunk"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_lynceus_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module' : 'lynceus'}</field>
    </record>
</odoo>
