<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lynceus_batch_list" model="ir.ui.view">
        <field name="name">lynceus.batch.list</field>
        <field name="model">lynceus.batch</field>
        <field name="arch" type="xml">
            <list string="Lynceus Batches">
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state == 'pending'"
                       decoration-info="state == 'running'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"/>
                <field name="target_n"/>
                <field name="generated_count"/>
                <field name="dedup_rejected"/>
                <field name="api_calls"/>
                <field name="cost_usd" widget="monetary" optional="show"/>
                <field name="triggered_by_id"/>
                <field name="started_at"/>
                <field name="finished_at"/>
            </list>
        </field>
    </record>

    <record id="view_lynceus_batch_form" model="ir.ui.view">
        <field name="name">lynceus.batch.form</field>
        <field name="model">lynceus.batch</field>
        <field name="arch" type="xml">
            <form string="Lynceus Batch">
                <header>
                    <button name="action_queue" string="Queue" type="object"
                            class="btn-primary" invisible="state not in ('draft','failed')"
                            confirm="Queue this batch? It will start shortly."/>
                    <button name="action_mark_failed" string="Mark as Failed (Force)"
                            type="object" class="btn-danger"
                            invisible="not is_stuck"
                            groups="base.group_system"
                            confirm="Force-release this batch? Auto-recovery has already failed - generated prompts remain in the pool."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Plan">
                            <field name="target_n" readonly="state != 'draft'"/>
                            <field name="triggered_by_id" readonly="1"/>
                        </group>
                        <group string="Result">
                            <field name="progress_pct" widget="progressbar"
                                   invisible="state in ('draft','pending')"/>
                            <field name="generated_count" readonly="1"/>
                            <field name="dedup_rejected" readonly="1"/>
                            <field name="llm_returned_total" readonly="1"/>
                            <field name="parse_loss" readonly="1"/>
                            <field name="api_calls" readonly="1"/>
                            <field name="cost_usd" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="state != 'pending'">
                        <i class="fa fa-clock-o"/>
                        Batch is queued. It will start shortly and progress will appear here automatically.
                        You can refresh this page periodically to watch progress.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'running' or is_recovering or is_stuck">
                        <i class="fa fa-cog fa-spin"/>
                        Generation in progress. Counters and progress bar update every 25 prompts.
                        Refresh this page to see the latest numbers.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not is_recovering">
                        <h4><i class="fa fa-spinner fa-spin"/> Batch paused - auto-recovery in progress</h4>
                        <p>
                            The orchestrator stopped writing progress momentarily. It will resume shortly from
                            <field name="generated_count" readonly="1" nolabel="1" class="oe_inline"/>
                            /
                            <field name="target_n" readonly="1" nolabel="1" class="oe_inline"/>.
                            Keep this page open and refresh - progress will continue automatically.
                        </p>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="not is_stuck"
                         groups="base.group_system">
                        <h4><i class="fa fa-exclamation-triangle"/> Batch is Stuck - Auto-Recovery Failed</h4>
                        <p>
                            This batch has been in <strong>running</strong> state with no heartbeat for
                            <field name="seconds_since_last_activity" readonly="1" nolabel="1" class="oe_inline"/>
                            seconds. Auto-recovery via Postgres advisory-lock + cron should have fired within 1-2 minutes - see diagnosis below.
                        </p>
                        <field name="stuck_diagnosis" widget="text" readonly="1" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Generated Prompts" name="generated_prompts">
                            <field name="prompt_ids" readonly="1">
                                <list>
                                    <field name="lynceus_id"/>
                                    <field name="state"/>
                                    <field name="tier"/>
                                    <field name="archetype"/>
                                    <field name="assigned_user_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Error Log" name="error_log" invisible="not error_log">
                            <field name="error_log" widget="text" readonly="1"/>
                        </page>
                        <page string="LLM Call Details" name="llm_call_details" groups="base.group_system">
                            <field name="llm_call_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="model"/>
                                    <field name="requested_count"/>
                                    <field name="returned_count"/>
                                    <field name="input_tokens"/>
                                    <field name="output_tokens"/>
                                    <field name="thoughts_tokens"/>
                                    <field name="cost_usd"/>
                                    <field name="finish_reason"/>
                                    <field name="create_date"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group string="Metadata">
                                                <field name="sequence"/>
                                                <field name="model"/>
                                                <field name="seed"/>
                                                <field name="finish_reason"/>
                                                <field name="create_date"/>
                                            </group>
                                            <group string="Counts &amp; Tokens">
                                                <field name="requested_count"/>
                                                <field name="returned_count"/>
                                                <field name="input_tokens"/>
                                                <field name="output_tokens"/>
                                                <field name="thoughts_tokens"/>
                                                <field name="cost_usd"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="Parse Errors" name="parse_errors_page">
                                                <field name="parse_errors" widget="text" nolabel="1"/>
                                            </page>
                                            <page string="Raw Response JSON" name="raw_response_page">
                                                <field name="raw_response" widget="text" nolabel="1"/>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lynceus_batch" model="ir.actions.act_window">
        <field name="name">Batches</field>
        <field name="res_model">lynceus.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
