<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_form_task_forge" model="ir.ui.view">
        <field name="name">project.project.form.task.forge</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Task Forge" name="task_forge_page">
                    <group>
                        <group>
                            <field name="task_forge_status"/>
                            <field name="task_forge_platform"/>
                        </group>
                    </group>
                    <field name="task_forge_allocation_ids">
                        <list editable="bottom">
                            <field name="employee_id"/>
                            <field name="allocated_by_id"/>
                            <field name="is_tested"/>
                            <field name="is_visible_on_multimango"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
