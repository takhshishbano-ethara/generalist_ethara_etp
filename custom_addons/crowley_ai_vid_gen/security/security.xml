<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_crowley_ai_vid_gen" model="ir.module.category">
            <field name="name">Crowley AI Vid Gen</field>
            <field name="description">AI Video Generation (ByteDance Seedance 2.0 via OpenRouter)</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_crowley_ai_vid_gen" model="res.groups.privilege">
            <field name="name">Crowley AI Vid Gen</field>
            <field name="category_id" ref="module_category_crowley_ai_vid_gen"/>
        </record>

        <record id="group_crowley_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_crowley_ai_vid_gen"/>
            <field name="comment">Can view their own video-generation jobs.</field>
        </record>

        <record id="group_crowley_creator" model="res.groups">
            <field name="name">Creator</field>
            <field name="privilege_id" ref="privilege_crowley_ai_vid_gen"/>
            <field name="implied_ids" eval="[(4, ref('group_crowley_user'))]"/>
            <field name="comment">Can create, edit, and download their own jobs.</field>
        </record>

        <record id="group_crowley_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_crowley_ai_vid_gen"/>
            <field name="implied_ids" eval="[(4, ref('group_crowley_creator'))]"/>
            <field name="comment">Sees all jobs in company; can configure settings.</field>
        </record>

        <record id="rule_crowley_job_user_own" model="ir.rule">
            <field name="name">Crowley AI Vid Gen: User sees own jobs only</field>
            <field name="model_id" ref="model_crowley_ai_vid_gen_job"/>
            <field name="domain_force">[('user_id','=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_crowley_user'))]"/>
            <field name="perm_read">True</field>
            <field name="perm_write">True</field>
            <field name="perm_create">True</field>
            <field name="perm_unlink">True</field>
        </record>

        <record id="rule_crowley_job_manager_company" model="ir.rule">
            <field name="name">Crowley AI Vid Gen: Manager sees company jobs</field>
            <field name="model_id" ref="model_crowley_ai_vid_gen_job"/>
            <field name="domain_force">[('company_id','in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_crowley_manager'))]"/>
            <field name="perm_read">True</field>
            <field name="perm_write">True</field>
            <field name="perm_create">True</field>
            <field name="perm_unlink">True</field>
        </record>

        <record id="rule_crowley_attempt_user_own" model="ir.rule">
            <field name="name">Crowley AI Vid Gen Attempt: user sees own job's attempts</field>
            <field name="model_id" ref="model_crowley_ai_vid_gen_attempt"/>
            <field name="domain_force">[('job_id.user_id','=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_crowley_user'))]"/>
            <field name="perm_read">True</field>
            <field name="perm_write">True</field>
            <field name="perm_create">True</field>
            <field name="perm_unlink">True</field>
        </record>

        <record id="rule_crowley_attempt_manager_company" model="ir.rule">
            <field name="name">Crowley AI Vid Gen Attempt: manager sees company attempts</field>
            <field name="model_id" ref="model_crowley_ai_vid_gen_attempt"/>
            <field name="domain_force">[('job_id.company_id','in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_crowley_manager'))]"/>
            <field name="perm_read">True</field>
            <field name="perm_write">True</field>
            <field name="perm_create">True</field>
            <field name="perm_unlink">True</field>
        </record>

    </data>
</odoo>
