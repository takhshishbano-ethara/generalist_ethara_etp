<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="talos.CostingDashboard">
        <div class="o_talos_costing">
            <div class="o_talos_costing_header">
                <div class="o_talos_costing_title_row">
                    <h2 class="o_talos_costing_title">Token Usage</h2>
                    <span class="o_talos_costing_date_range" t-out="dateRangeLabel"/>
                </div>
                <div class="o_talos_costing_periods">
                    <t t-foreach="periods" t-as="p" t-key="p.key">
                        <button t-attf-class="o_talos_period_btn #{state.period === p.key ? 'active' : ''}"
                                t-on-click="() => this.onPeriodChange(p.key)">
                            <t t-out="p.label"/>
                        </button>
                    </t>
                </div>
            </div>

            <div t-if="state.totals" class="o_talos_costing_summary">
                <div class="o_talos_summary_card">
                    <div class="o_talos_summary_icon"><i class="fa fa-check-circle"/></div>
                    <div class="o_talos_summary_label">Bedrock QC</div>
                    <div class="o_talos_summary_value bedrock" t-out="formatNumber(state.totals.bedrock_total)"/>
                    <div class="o_talos_summary_sub">
                        <span>In: <strong t-out="formatNumber(state.totals.bedrock_input)"/></span>
                        <span>Out: <strong t-out="formatNumber(state.totals.bedrock_output)"/></span>
                    </div>
                    <div class="o_talos_summary_badge qc">QC</div>
                </div>
                <div class="o_talos_summary_card">
                    <div class="o_talos_summary_icon"><i class="fa fa-bolt"/></div>
                    <div class="o_talos_summary_label">Claude Trajectory</div>
                    <div class="o_talos_summary_value claude" t-out="formatNumber(state.totals.claude_total)"/>
                    <div class="o_talos_summary_sub">
                        <span>In: <strong t-out="formatNumber(state.totals.claude_input)"/></span>
                        <span>Out: <strong t-out="formatNumber(state.totals.claude_output)"/></span>
                    </div>
                    <div class="o_talos_summary_badge trajectory">Trajectory</div>
                </div>
                <div class="o_talos_summary_card">
                    <div class="o_talos_summary_icon"><i class="fa fa-cube"/></div>
                    <div class="o_talos_summary_label">GLM Trajectory</div>
                    <div class="o_talos_summary_value glm" t-out="formatNumber(state.totals.glm_total)"/>
                    <div class="o_talos_summary_sub">
                        <span>In: <strong t-out="formatNumber(state.totals.glm_input)"/></span>
                        <span>Out: <strong t-out="formatNumber(state.totals.glm_output)"/></span>
                    </div>
                    <div class="o_talos_summary_badge trajectory">Trajectory</div>
                </div>
                <div class="o_talos_summary_card grand">
                    <div class="o_talos_summary_icon"><i class="fa fa-tachometer"/></div>
                    <div class="o_talos_summary_label">Total Tokens</div>
                    <div class="o_talos_summary_value grand" t-out="formatNumber(state.totals.grand_total)"/>
                    <div class="o_talos_summary_sub">
                        <span>QC: <strong t-out="formatNumber(state.totals.bedrock_total)"/></span>
                        <span>Traj: <strong t-out="formatNumber(state.totals.claude_total + state.totals.glm_total)"/></span>
                    </div>
                </div>
            </div>

            <div t-if="state.loading" class="o_talos_costing_loading">
                <i class="fa fa-spinner fa-spin fa-2x"/>
            </div>

            <div t-elif="state.rows.length === 0" class="o_talos_costing_empty">
                <i class="fa fa-bar-chart fa-3x mb-3"/>
                <p>No token usage data for this period.</p>
            </div>

            <div t-else="" class="o_talos_costing_table_wrap">
                <table class="o_talos_costing_table">
                    <thead>
                        <tr class="o_talos_col_group_row">
                            <th class="col-employee" rowspan="2" t-on-click="() => this.onSort('employee_name')">
                                Employee <i t-attf-class="fa #{sortIcon('employee_name')} ms-1"/>
                            </th>
                            <th class="col-group-header col-group-bedrock" colspan="3">
                                <i class="fa fa-check-circle me-1"/>Bedrock QC
                            </th>
                            <th class="col-group-header col-group-claude" colspan="3">
                                <i class="fa fa-bolt me-1"/>Claude Trajectory
                            </th>
                            <th class="col-group-header col-group-glm" colspan="3">
                                <i class="fa fa-cube me-1"/>GLM Trajectory
                            </th>
                            <th class="col-grand" rowspan="2" t-on-click="() => this.onSort('grand_total')">
                                Grand Total <i t-attf-class="fa #{sortIcon('grand_total')} ms-1"/>
                            </th>
                        </tr>
                        <tr>
                            <th class="col-num col-bedrock" t-on-click="() => this.onSort('bedrock_input')">
                                In <i t-attf-class="fa #{sortIcon('bedrock_input')} ms-1"/>
                            </th>
                            <th class="col-num col-bedrock" t-on-click="() => this.onSort('bedrock_output')">
                                Out <i t-attf-class="fa #{sortIcon('bedrock_output')} ms-1"/>
                            </th>
                            <th class="col-num col-subtotal col-bedrock" t-on-click="() => this.onSort('bedrock_total')">
                                Total <i t-attf-class="fa #{sortIcon('bedrock_total')} ms-1"/>
                            </th>
                            <th class="col-num col-claude" t-on-click="() => this.onSort('claude_input')">
                                In <i t-attf-class="fa #{sortIcon('claude_input')} ms-1"/>
                            </th>
                            <th class="col-num col-claude" t-on-click="() => this.onSort('claude_output')">
                                Out <i t-attf-class="fa #{sortIcon('claude_output')} ms-1"/>
                            </th>
                            <th class="col-num col-subtotal col-claude" t-on-click="() => this.onSort('claude_total')">
                                Total <i t-attf-class="fa #{sortIcon('claude_total')} ms-1"/>
                            </th>
                            <th class="col-num col-glm" t-on-click="() => this.onSort('glm_input')">
                                In <i t-attf-class="fa #{sortIcon('glm_input')} ms-1"/>
                            </th>
                            <th class="col-num col-glm" t-on-click="() => this.onSort('glm_output')">
                                Out <i t-attf-class="fa #{sortIcon('glm_output')} ms-1"/>
                            </th>
                            <th class="col-num col-subtotal col-glm" t-on-click="() => this.onSort('glm_total')">
                                Total <i t-attf-class="fa #{sortIcon('glm_total')} ms-1"/>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="sortedRows" t-as="row" t-key="row.employee_id">
                            <tr>
                                <td class="col-employee">
                                    <i class="fa fa-user-circle me-2"/>
                                    <t t-out="row.employee_name"/>
                                </td>
                                <td class="col-num col-bedrock" t-out="formatNumber(row.bedrock_input)"/>
                                <td class="col-num col-bedrock" t-out="formatNumber(row.bedrock_output)"/>
                                <td class="col-num col-subtotal col-bedrock" t-out="formatNumber(row.bedrock_total)"/>
                                <td class="col-num col-claude" t-out="formatNumber(row.claude_input)"/>
                                <td class="col-num col-claude" t-out="formatNumber(row.claude_output)"/>
                                <td class="col-num col-subtotal col-claude" t-out="formatNumber(row.claude_total)"/>
                                <td class="col-num col-glm" t-out="formatNumber(row.glm_input)"/>
                                <td class="col-num col-glm" t-out="formatNumber(row.glm_output)"/>
                                <td class="col-num col-subtotal col-glm" t-out="formatNumber(row.glm_total)"/>
                                <td class="col-num col-grand" t-out="formatNumber(row.grand_total)"/>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot t-if="state.totals">
                        <tr>
                            <td class="col-employee"><strong>Totals</strong></td>
                            <td class="col-num col-bedrock" t-out="formatNumber(state.totals.bedrock_input)"/>
                            <td class="col-num col-bedrock" t-out="formatNumber(state.totals.bedrock_output)"/>
                            <td class="col-num col-subtotal col-bedrock" t-out="formatNumber(state.totals.bedrock_total)"/>
                            <td class="col-num col-claude" t-out="formatNumber(state.totals.claude_input)"/>
                            <td class="col-num col-claude" t-out="formatNumber(state.totals.claude_output)"/>
                            <td class="col-num col-subtotal col-claude" t-out="formatNumber(state.totals.claude_total)"/>
                            <td class="col-num col-glm" t-out="formatNumber(state.totals.glm_input)"/>
                            <td class="col-num col-glm" t-out="formatNumber(state.totals.glm_output)"/>
                            <td class="col-num col-subtotal col-glm" t-out="formatNumber(state.totals.glm_total)"/>
                            <td class="col-num col-grand" t-out="formatNumber(state.totals.grand_total)"/>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </t>
</templates>
