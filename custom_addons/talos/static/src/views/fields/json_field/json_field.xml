<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="talos.JsonField">
        <t t-if="props.readonly">
            <div class="o_field_talos_json o_field_widget o_field_talos_json_readonly">
                <t t-if="hasEntries">
                    <t t-foreach="state.entries" t-as="entry" t-key="entry.index">
                        <div class="talos-json-entry">
                            <div class="talos-json-entry-header">
                                <span class="talos-json-session-label">
                                    Session <t t-esc="entry.index + 1"/>
                                    <t t-if="entry.timestamp">
                                        <span class="talos-json-timestamp"> — <t t-esc="entry.timestamp"/></span>
                                    </t>
                                </span>
                                <button class="talos-json-delete-btn"
                                        t-att-disabled="state.deleting === entry.index"
                                        t-on-click="() => this.onDeleteEntry(entry.index)"
                                        title="Delete this trajectory">
                                    <t t-if="state.deleting === entry.index">
                                        <i class="fa fa-spinner fa-spin"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-times"/>
                                    </t>
                                </button>
                            </div>
                            <div class="talos-json-entry-body" t-out="entry.html"/>
                        </div>
                        <t t-if="!entry_last">
                            <hr class="talos-json-divider"/>
                        </t>
                    </t>
                </t>
                <t t-else="">
                    <div class="text-muted p-3">No trajectory data</div>
                </t>
            </div>
        </t>
        <t t-else="">
            <div class="o_field_talos_json o_field_widget">
                <textarea
                    class="o_input o_field_text_input"
                    t-att-id="props.id"
                    t-att-placeholder="props.placeholder"
                    t-ref="textarea"
                    rows="10"
                />
            </div>
        </t>
    </t>

</templates>
