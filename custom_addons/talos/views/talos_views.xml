<odoo>
  <data>
    <record model="ir.ui.view" id="talos_talos_list">
      <field name="name">talos.talos.list</field>
      <field name="model">talos.talos</field>
      <field name="arch" type="xml">
        <list>
          <field name="task_id"/>
          <field name="parsona"/>
          <field name="persona_id"/>
          <field name="employee_id"/>
          <field name="task_status"/>
          <field name="docker_status" widget="badge"
                 decoration-success="docker_status == 'running'"
                 decoration-danger="docker_status == 'error'"
                 decoration-info="docker_status == 'starting'"
                 decoration-muted="docker_status == 'stopped'"/>
          <field name="docker_port"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="talos_talos_form">
      <field name="name">talos.talos.form</field>
      <field name="model">talos.talos</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_start_sandbox" type="object"
                    string="Start Sandbox" class="oe_highlight"
                    invisible="docker_status == 'running'"/>
            <button name="action_stop_sandbox" type="object"
                    string="Stop Sandbox" class="btn-danger"
                    invisible="docker_status != 'running'"/>
          </header>
          <sheet>
            <group>
              <group>
                <field name="task_id"/>
                <field name="parsona"/>
                <field name="persona_id"/>
                <field name="task_status"/>
              </group>
              <group>
                <field name="employee_id"/>
                <field name="user_id"/>
              </group>
            </group>
            <notebook>
              <page string="Chat">
                <field name="docker_port" invisible="1"/>
                <field name="docker_gateway_token" invisible="1"/>
                <field name="docker_status" invisible="1"/>
                <field name="docker_ws_url" invisible="1"/>
                <widget name="talos_chat"/>
              </page>
              <page string="OpenClaw Dashboard">
                <field name="docker_dashboard_url" widget="sandbox_iframe"/>
              </page>
              <page string="Turns">
                <field name="turn_ids">
                  <list editable="bottom">
                    <field name="turn_number"/>
                    <field name="turn_status"/>
                    <field name="prompt"/>
                    <field name="response"/>
                    <field name="model_name"/>
                  </list>
                </field>
              </page>
              <page string="Sandbox">
                <group>
                  <group string="Configuration">
                    <field name="docker_status" widget="badge"
                           decoration-success="docker_status == 'running'"
                           decoration-danger="docker_status == 'error'"
                           decoration-info="docker_status == 'starting'"
                           decoration-muted="docker_status == 'stopped'"/>
                  </group>
                  <group string="Runtime">
                    <field name="docker_compose_project"/>
                    <field name="docker_port"/>
                    <field name="docker_litellm_port"/>
                    <field name="docker_gateway_token"/>
                  </group>
                </group>
                <group invisible="not docker_error">
                  <field name="docker_error"/>
                </group>
                <div class="mt-3">
                  <field name="docker_dashboard_url" widget="sandbox_iframe" nolabel="1"/>
                </div>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="talos_talos_action_window">
      <field name="name">Talos Tasks</field>
      <field name="res_model">talos.talos</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('talos_talos_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('talos_talos_form')})]"/>
    </record>

  </data>
</odoo>
