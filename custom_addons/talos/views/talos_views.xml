<odoo>
  <data>
    <!-- ============ talos.talos views ============ -->
    <record model="ir.ui.view" id="talos_talos_list">
      <field name="name">talos.talos.list</field>
      <field name="model">talos.talos</field>
      <field name="arch" type="xml">
        <list>
          <field name="task_id"/>
          <field name="parsona"/>
          <field name="employee_id"/>
          <field name="task_status"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="talos_talos_form">
      <field name="name">talos.talos.form</field>
      <field name="model">talos.talos</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="task_id"/>
                <field name="parsona"/>
                <field name="task_status"/>
              </group>
              <group>
                <field name="employee_id"/>
                <field name="user_id"/>
              </group>
            </group>
            <notebook>
              <page string="Turns">
                <field name="turn_ids">
                  <list editable="bottom">
                    <field name="turn_number"/>
                    <field name="turn_status"/>
                    <field name="prompt"/>
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="talos_talos_action_window">
      <field name="name">Talos Tasks</field>
      <field name="res_model">talos.talos</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('talos_talos_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('talos_talos_form')})]"/>
    </record>

  </data>
</odoo>
