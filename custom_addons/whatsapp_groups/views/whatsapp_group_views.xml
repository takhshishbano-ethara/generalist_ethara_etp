<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- WhatsApp Group: Form View                                     -->
    <!-- ============================================================ -->
    <record id="whatsapp_group_view_form" model="ir.ui.view">
        <field name="name">whatsapp.group.form</field>
        <field name="model">whatsapp.group</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Group">
                <header>
                    <button name="action_create_group" type="object"
                            string="Create on WhatsApp"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_refresh_invite_link" type="object"
                            string="Refresh Link"
                            invisible="state != 'active'"/>
                    <button name="action_reset_invite_link" type="object"
                            string="Reset Link"
                            invisible="state != 'active'"
                            confirm="This will invalidate the current invite link. Continue?"/>
                    <button name="action_delete_group" type="object"
                            string="Delete Group"
                            class="btn-danger"
                            invisible="state != 'active'"
                            confirm="This will permanently delete the group on WhatsApp. Continue?"/>
                    <button name="action_set_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'deleted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="subject"/>
                        <h1>
                            <field name="subject" placeholder="Group Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="join_approval_mode"/>
                            <field name="wa_group_id"
                                   invisible="not wa_group_id"/>
                        </group>
                        <group>
                            <field name="invite_link" widget="url"
                                   invisible="not invite_link"/>
                            <button name="action_copy_invite_link" type="object"
                                    string="Open Invite Link"
                                    class="btn-link"
                                    icon="fa-external-link"
                                    invisible="not invite_link"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"
                                   placeholder="Describe the purpose of this group..."/>
                        </page>
                        <page string="Participants" name="participants">
                            <field name="participant_ids">
                                <list editable="bottom">
                                    <field name="wa_id"/>
                                    <field name="display_name"/>
                                    <field name="partner_id"/>
                                    <field name="role"/>
                                    <field name="joined_at"/>
                                    <button name="action_remove_from_group"
                                            type="object"
                                            string="Remove"
                                            icon="fa-trash"
                                            class="btn-danger"
                                            confirm="Remove this participant from the group?"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- WhatsApp Group: List View                                     -->
    <!-- ============================================================ -->
    <record id="whatsapp_group_view_list" model="ir.ui.view">
        <field name="name">whatsapp.group.list</field>
        <field name="model">whatsapp.group</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Groups"
                  decoration-muted="state == 'deleted'"
                  decoration-success="state == 'active'">
                <field name="subject"/>
                <field name="account_id"/>
                <field name="wa_group_id"/>
                <field name="join_approval_mode"/>
                <field name="participant_count" string="Participants"/>
                <field name="state"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'deleted'"
                       decoration-info="state == 'draft'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- WhatsApp Group: Search View                                   -->
    <!-- ============================================================ -->
    <record id="whatsapp_group_view_search" model="ir.ui.view">
        <field name="name">whatsapp.group.search</field>
        <field name="model">whatsapp.group</field>
        <field name="arch" type="xml">
            <search string="Search Groups">
                <field name="subject"/>
                <field name="wa_group_id"/>
                <field name="account_id"/>
                <filter name="filter_active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <separator/>
                <group>
                    <filter name="group_by_account" string="Account"
                            context="{'group_by': 'account_id'}"/>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- WhatsApp Group: Action -->
    <record id="whatsapp_group_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Groups</field>
        <field name="res_model">whatsapp.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="whatsapp_group_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WhatsApp Group
            </p>
            <p>
                Create groups, generate invite links, and manage
                participants — all through the official Meta Cloud API.
            </p>
        </field>
    </record>

</odoo>
