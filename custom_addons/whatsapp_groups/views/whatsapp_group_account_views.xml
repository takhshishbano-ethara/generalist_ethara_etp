<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- WhatsApp Group Account: Form View                             -->
    <!-- ============================================================ -->
    <record id="whatsapp_group_account_view_form" model="ir.ui.view">
        <field name="name">whatsapp.group.account.form</field>
        <field name="model">whatsapp.group.account</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Account">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_groups" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="group_count" widget="statinfo"
                                   string="Groups"/>
                        </button>
                    </div>
                    <group>
                        <group string="Account Details">
                            <field name="name"/>
                            <field name="phone_number_id"/>
                            <field name="access_token" password="True"/>
                        </group>
                        <group string="Webhook Configuration">
                            <field name="app_id"/>
                            <field name="webhook_verify_token"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WhatsApp Group Account: List View -->
    <record id="whatsapp_group_account_view_list" model="ir.ui.view">
        <field name="name">whatsapp.group.account.list</field>
        <field name="model">whatsapp.group.account</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Accounts">
                <field name="name"/>
                <field name="phone_number_id"/>
                <field name="group_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- WhatsApp Group Account: Action -->
    <record id="whatsapp_group_account_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Accounts</field>
        <field name="res_model">whatsapp.group.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a WhatsApp Business Account
            </p>
            <p>
                Configure your Meta WhatsApp Business API credentials
                to start creating and managing WhatsApp groups.
            </p>
        </field>
    </record>

</odoo>
