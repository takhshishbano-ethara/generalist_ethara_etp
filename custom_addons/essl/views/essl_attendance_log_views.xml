<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_essl_attendance_log_list" model="ir.ui.view">
        <field name="name">essl.attendance.log.list</field>
        <field name="model">essl.attendance.log</field>
        <field name="arch" type="xml">
            <list string="Attendance Logs" default_order="punch_timestamp desc">
                <field name="punch_timestamp"/>
                <field name="device_id"/>
                <field name="device_user_id"/>
                <field name="employee_id"/>
                <field name="status"/>
                <field name="attendance_id"/>
                <field name="error_note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_essl_attendance_log_form" model="ir.ui.view">
        <field name="name">essl.attendance.log.form</field>
        <field name="model">essl.attendance.log</field>
        <field name="arch" type="xml">
            <form string="Attendance Log">
                <sheet>
                    <group>
                        <group string="Punch">
                            <field name="device_id"/>
                            <field name="device_user_id"/>
                            <field name="punch_timestamp"/>
                            <field name="status"/>
                            <field name="verify_method"/>
                        </group>
                        <group string="Processing">
                            <field name="employee_id"/>
                            <field name="attendance_id"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_note">
                        <field name="error_note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_essl_attendance_log_search" model="ir.ui.view">
        <field name="name">essl.attendance.log.search</field>
        <field name="model">essl.attendance.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">
                <field name="device_id"/>
                <field name="employee_id"/>
                <field name="device_user_id"/>
                <filter string="Has Error" name="has_error" domain="[('error_note', '!=', False)]"/>
                <filter string="Unmapped" name="unmapped" domain="[('employee_id', '=', False)]"/>
                <separator/>
                <group>
                    <filter string="Device" name="group_device" context="{'group_by': 'device_id'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_essl_attendance_log" model="ir.actions.act_window">
        <field name="name">Attendance Logs</field>
        <field name="res_model">essl.attendance.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_essl_attendance_log_search"/>
    </record>

</odoo>
