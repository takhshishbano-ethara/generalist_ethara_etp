    </div>

    <div class="confidence-strip" data-animate="fade-up">
      <span class="rd-confidence-big">1.92 / 4.0</span>
      <span class="confidence-lbl mono">Claude-Sonnet-4.6 · best mean dense score</span>
    </div>
  </section>

