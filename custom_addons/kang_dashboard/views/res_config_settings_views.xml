<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_kang_dashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kang_dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Kang Dashboard" string="Kang Dashboard" name="kang_dashboard">
                    <block title="Showcase Link Buttons">
                        <setting string="Repository URL"
                                 help="Override the Repository button link. Leave empty to use the default GitHub URL.">
                            <field name="kang_trajectories_url"
                                   placeholder="https://github.com/EtharaOrion/kang-samples.git"/>
                        </setting>
                        <setting string="Dataset URL"
                                 help="Override the Dataset button link. Leave empty to use the default HuggingFace URL.">
                            <field name="kang_dataset_url"
                                   placeholder="https://huggingface.co/datasets/ethara/kang"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
