<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_epo" model="ir.module.category">
            <field name="name">Project OS</field>
            <field name="description">Ethara Project OS — projects, pods, allocation, tasking.</field>
            <field name="sequence">95</field>
        </record>

        <!-- The privilege name must differ from the category name, otherwise Odoo 19
             renders both under the same header on the Users form and the module looks
             duplicated in the access-rights tree. -->
        <record id="res_groups_privilege_epo" model="res.groups.privilege">
            <field name="name">Access Level</field>
            <field name="sequence">95</field>
            <field name="category_id" ref="module_category_epo"/>
        </record>

    </data>

    <data noupdate="1">

        <!-- ============================================================
             THE FOUR ROLES.

             A strict ladder: each higher role implies the one below, so a
             GPM can do everything a Pod Lead can and an Admin everything a
             GPM can. The record rules in epo_rules.xml then *narrow* what
             each level may see:

               PM    → self only
               PL    → self + their pod
               GPM   → org-wide
               Admin → everything, including audit and correction

             The group is the enforcement. A person's operational role is
             also written to epo.role.assignment, which is effective-dated,
             so "who was PL when this was reviewed?" has an answer a mutable
             group membership could never give.
             ============================================================ -->

        <record id="group_epo_member" model="res.groups">
            <field name="name">PM — Pod Member</field>
            <field name="privilege_id" ref="res_groups_privilege_epo"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Fills the stagelist and the feedback form for the project they are allocated to, after completing onboarding. Sees only their own records.</field>
        </record>

        <record id="group_epo_pod_lead" model="res.groups">
            <field name="name">PL — Pod Lead</field>
            <field name="privilege_id" ref="res_groups_privilege_epo"/>
            <field name="implied_ids" eval="[(4, ref('group_epo_member'))]"/>
            <field name="comment">Owns the daily roster of their pod: status, project, presence. Approves their pod's leave and reviews their pod's submissions.</field>
        </record>

        <record id="group_epo_manager" model="res.groups">
            <field name="name">GPM — General Program Management</field>
            <field name="privilege_id" ref="res_groups_privilege_epo"/>
            <field name="implied_ids" eval="[(4, ref('group_epo_pod_lead'))]"/>
            <field name="comment">Creates projects, fills the knowledge folder, sets training, links the external assessment, builds and publishes forms, allocates people, reads org-wide analytics.</field>
        </record>

        <record id="group_epo_admin" model="res.groups">
            <field name="name">Admin — Full Control</field>
            <field name="privilege_id" ref="res_groups_privilege_epo"/>
            <field name="implied_ids" eval="[(4, ref('group_epo_manager'))]"/>
            <field name="comment">Full control. The only role that may void submissions, unlock payroll-locked roster days, waive onboarding and read the audit log.</field>
        </record>

    </data>
</odoo>
