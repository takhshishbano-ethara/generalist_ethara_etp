<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Project OS views over project.project (data model v2 §4.2).

         Odoo's Project app and three other modules already ship views for this model.
         These are separate records at priority 100 so they never become the default
         for anyone else — the action below binds them explicitly and filters to
         is_project_os, so opening "Project OS → Projects" gets the delivery view and
         the Project app is untouched. -->

    <record id="view_epo_project_list" model="ir.ui.view">
        <field name="name">project.project.list.ethara</field>
        <field name="model">project.project</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list decoration-muted="ethara_state == 'archived'"
                  decoration-warning="ethara_state == 'setup'"
                  decoration-success="ethara_state == 'active'">
                <field name="code"/>
                <field name="name"/>
                <field name="ethara_project_type"/>
                <field name="pm_id" optional="show"/>
                <field name="ethara_state" widget="badge"/>
                <field name="gate_blockers" string="Blocked by"/>
                <field name="min_assessment_score" string="Min score" optional="hide"/>
                <field name="allocated_today" string="People"/>
                <field name="onboarding_count" string="Onboarding"/>
                <field name="tasking_count" string="Tasking today"/>
                <field name="submission_count" string="Submissions"/>
            </list>
        </field>
    </record>

    <record id="view_epo_project_kanban" model="ir.ui.view">
        <field name="name">project.project.kanban.ethara</field>
        <field name="model">project.project</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban default_group_by="ethara_state">
                <field name="gate_blockers"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong><field name="name"/></strong>
                            <div class="text-muted">
                                <field name="code"/> · <field name="ethara_project_type"/>
                            </div>
                            <div class="mt-2">
                                <span class="badge text-bg-secondary">
                                    <field name="allocated_today"/> allocated
                                </span>
                                <span class="badge text-bg-secondary">
                                    <field name="submission_count"/> submissions
                                </span>
                            </div>
                            <div t-if="record.gate_blockers.raw_value"
                                 class="text-warning mt-2">
                                ⚠ missing <field name="gate_blockers"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_epo_project_form" model="ir.ui.view">
        <field name="name">project.project.form.ethara</field>
        <field name="model">project.project</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="ethara_state == 'active'"/>
                    <field name="ethara_state" widget="statusbar"
                           statusbar_visible="setup,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_team" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="allocated_today" widget="statinfo"
                                   string="Allocated"/>
                        </button>
                        <button name="action_open_history" type="object"
                                class="oe_stat_button" icon="fa-history">
                            <span class="o_stat_text">History</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Project name"/></h1>
                        <h3><field name="code" placeholder="leave blank — EPR/2026/0001 on save"/></h3>
                    </div>
                    <!-- The delivery pipeline is opt-in per project: the registry also
                         holds projects that only ever run through budgeting, and those
                         must not be told they are missing an SOP. -->
                    <div class="alert alert-info" role="alert"
                         invisible="is_project_os">
                        This project is not in the Project OS pipeline. Tick
                        <b>Project OS</b> to give it a knowledge folder, a go-live gate
                        and allocation.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_project_os or ethara_state != 'setup' or not gate_blockers">
                        Not live yet — still missing:
                        <field name="gate_blockers" readonly="1"/>.
                        A project cannot take anybody until it has an SOP and a published
                        stagelist.
                    </div>
                    <group>
                        <group>
                            <field name="is_project_os"/>
                            <field name="ethara_project_type"/>
                            <field name="pm_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date"/>
                            <field name="stage_id" string="Kanban stage"/>
                            <field name="created_by_emp_id" readonly="1"
                                   invisible="not created_by_emp_id"/>
                            <field name="activated_at" readonly="1"
                                   invisible="not activated_at"/>
                            <field name="archived_at" readonly="1"
                                   invisible="not archived_at"/>
                        </group>
                    </group>
                    <!-- Full width, and NOT inside a <group>. A group reserves a label
                         column even with nolabel="1", which left the textarea indented
                         and pushed the heading below it. A <separator> plus the field
                         directly in the sheet is the pattern used elsewhere in this
                         codebase (see argus, aurora) and lands flush left. -->
                    <separator string="Brief"/>
                    <field name="description" nolabel="1"
                           placeholder="What this project is, in the PM's words."
                           style="min-height: 90px;"/>
                    <group string="Kickoff gate" invisible="not is_project_os">
                        <group>
                            <field name="has_sop" readonly="1"/>
                            <field name="has_stagelist" readonly="1"/>
                        </group>
                        <group>
                            <field name="has_training" readonly="1"/>
                            <field name="has_assessment" readonly="1"/>
                        </group>
                    </group>
                    <notebook invisible="not is_project_os">
                        <page string="Knowledge" name="knowledge">
                            <div class="text-muted mb-2">
                                A fixed shape on every project — <b>SOP · Common Errors ·
                                Task Videos · Other</b> — so "read the SOP" means the same
                                thing everywhere. Pick the folder per document below.
                            </div>
                            <field name="knowledge_doc_ids" context="{'epo_category_root': 'knowledge'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <!-- One column, not two. Type is what a person picks;
                                         it files the document in this project's matching
                                         folder. Folder itself is kept only as a hidden
                                         fallback for documents sitting in a folder someone
                                         created by hand, which has no type. -->
                                    <field name="category" string="Type" required="1"/>
                                    <field name="folder_id" string="Folder" optional="hide"
                                           domain="[('project_id', '=', parent.id),
                                                    ('root', '=', 'knowledge')]"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="name"/>
                                    <field name="doc_type"/>
                                    <field name="url" widget="url"/>
                                    <field name="file_data" filename="file_name"
                                           string="Upload"/>
                                    <field name="file_name" column_invisible="True"/>
                                    <field name="storage" readonly="1"/>
                                    <field name="is_mandatory"/>
                                </list>
                            </field>
                        </page>
                        <page string="Management" name="management"
                              groups="ethara_project_os.group_epo_pm">
                            <div class="text-muted mb-2">
                                Client documents and commercial paperwork. Not visible to
                                Pod Leads or Taskers — enforced by record rule, not
                                just by hiding this tab.
                            </div>
                            <field name="management_doc_ids" context="{'epo_category_root': 'management'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="category" string="Type" required="1"/>
                                    <field name="folder_id" string="Folder" optional="hide"
                                           domain="[('project_id', '=', parent.id),
                                                    ('root', '=', 'management')]"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="name"/>
                                    <field name="doc_type"/>
                                    <field name="url" widget="url"/>
                                    <field name="file_data" filename="file_name"
                                           string="Upload"/>
                                    <field name="file_name" column_invisible="True"/>
                                    <field name="storage" readonly="1"/>
                                    <field name="file_size" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Training" name="training">
                            <field name="training_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="mode"/>
                                    <field name="scheduled_at"/>
                                    <field name="url" widget="url"/>
                                    <field name="trainer_id"/>
                                    <field name="is_mandatory"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assessment" name="assessment">
                            <div class="text-muted mb-2">
                                <button name="action_send_to_assessment" type="object"
                                        string="Send SOP + training to assessment"
                                        class="btn-primary btn-sm"
                                        groups="ethara_project_os.group_epo_pm"
                                        confirm="This creates a prompt in the assessment app from this project's knowledge folder and training. Skills, questions and the paper itself are then built over there."/>
                                <span class="ms-2" invisible="not etp_prompt_id">
                                    Sent as <field name="etp_prompt_id" readonly="1"
                                                   class="oe_inline"/>
                                    on <field name="assessment_sent_at" readonly="1"
                                              class="oe_inline"/>
                                    by <field name="assessment_sent_by_id" readonly="1"
                                              class="oe_inline"/>
                                </span>
                            </div>
                            <div class="text-muted mb-2">
                                The paper lives in an external application. Odoo stores
                                the link only — a Tasker reads the result there and verifies
                                it on the tasker's Onboarding record.
                            </div>
                            <field name="ethara_assessment_ids">
                                <list editable="bottom">
                                    <field name="title"/>
                                    <field name="provider"/>
                                    <field name="url" widget="url"/>
                                    <field name="pass_score" string="Pass mark (info)"/>
                                    <field name="is_mandatory"/>
                                </list>
                            </field>
                        </page>
                        <page string="Forms" name="forms">
                            <div class="text-muted mb-2">
                                The two forms this project runs on: the
                                <b>Stagelist</b> a Tasker fills per task, and the
                                <b>Feedback Taker</b> that records what the client said
                                on their platform. A published stagelist is half the
                                kickoff gate — until one exists the project cannot go
                                live.
                            </div>
                            <!-- Build full page, never in a popup. Publish and New
                                 version are object methods and the Fields tab points
                                 sections at real ids — none of which an x2many dialog
                                 can hand a line that exists only in memory. That is why
                                 the old "Add a line" asked for a Project it should have
                                 known: it was opening the standalone form. These two
                                 buttons are the prototype's kickoff Build buttons
                                 (public/js/app.js buildSL / buildFB); they reuse an
                                 existing draft rather than making a second one. -->
                            <div class="mb-3" invisible="not id">
                                <button name="action_build_form" type="object"
                                        class="btn btn-primary btn-sm"
                                        context="{'epo_form_type': 'stagelist'}"
                                        string="Build stagelist"/>
                                <button name="action_build_form" type="object"
                                        class="btn btn-secondary btn-sm ms-2"
                                        context="{'epo_form_type': 'feedback'}"
                                        string="Build feedback form"/>
                            </div>
                            <field name="template_ids">
                                <list create="false" edit="false" delete="false"
                                      decoration-success="state == 'published'"
                                      decoration-muted="state == 'archived'">
                                    <field name="form_type"/>
                                    <field name="name"/>
                                    <field name="version"/>
                                    <field name="state" widget="badge"/>
                                    <field name="entry_count"/>
                                    <field name="published_at"/>
                                    <button name="action_open_builder" type="object"
                                            icon="fa-external-link" title="Open"/>
                                </list>
                                <!-- The dialog a row opens is deliberately a summary,
                                     not the builder: it exists so clicking a row does
                                     not land somebody in the standalone form, Project
                                     picker and all. -->
                                <form>
                                    <div class="alert alert-info" role="alert">
                                        This is a summary. Sections, fields and
                                        publishing live on the form's own page.
                                    </div>
                                    <group>
                                        <group>
                                            <field name="form_type" readonly="1"/>
                                            <field name="name" readonly="1"/>
                                            <field name="version" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="state" readonly="1"/>
                                            <field name="entry_count" readonly="1"/>
                                            <field name="published_at" readonly="1"/>
                                        </group>
                                    </group>
                                    <field name="description" readonly="1"
                                           invisible="not description"/>
                                    <footer>
                                        <button name="action_open_builder" type="object"
                                                string="Open form" class="btn-primary"/>
                                        <button string="Close" special="cancel"/>
                                    </footer>
                                </form>
                            </field>
                        </page>
                        <page string="Team" name="team">
                            <group>
                                <field name="min_assessment_score"
                                       help="The staffing bar. Only people whose best verified score is at or above this show on the candidate shortlist. 0 means no bar."/>
                            </group>
                            <field name="allocation_ids" readonly="1">
                                <list decoration-muted="not is_open"
                                      decoration-info="is_open and current_phase != 'tasking'">
                                    <field name="employee_id"/>
                                    <field name="pod_id"/>
                                    <field name="role_on_project"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="current_phase"/>
                                    <field name="days_total" string="Days"/>
                                    <field name="days_onboarding" string="Onboard"/>
                                    <field name="days_training" string="Train"/>
                                    <field name="days_tasking" string="Task"/>
                                    <field name="days_to_productive" string="To productive"/>
                                    <field name="submission_count" string="Submissions"/>
                                    <field name="is_open" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Onboarding" name="onboarding">
                            <div class="text-muted mb-2">
                                Open a row to mark the SOP or training, verify the
                                external assessment result, or waive the gate. Rows are
                                created when somebody is allocated — they are never
                                added by hand.
                            </div>
                            <field name="onboarding_ids" create="false" delete="false">
                                <list decoration-success="unlocked"
                                      decoration-warning="not unlocked">
                                    <field name="employee_id"/>
                                    <field name="sop_done"/>
                                    <field name="training_done"/>
                                    <field name="assessment_passed"/>
                                    <field name="assessment_score" optional="show"/>
                                    <field name="assessment_verified_by" optional="hide"/>
                                    <field name="unlocked"/>
                                    <field name="blockers"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_epo_project_search" model="ir.ui.view">
        <field name="name">project.project.search.ethara</field>
        <field name="model">project.project</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="pm_id"/>
                <filter name="live" string="Live" domain="[('ethara_state', '=', 'active')]"/>
                <filter name="setup" string="In setup" domain="[('ethara_state', '=', 'setup')]"/>
                <filter name="blocked" string="Blocked from go-live"
                        domain="[('ethara_state', '=', 'setup'),
                                 '|', ('has_sop', '=', False),
                                      ('has_stagelist', '=', False)]"/>
                <filter name="has_bar" string="Has a minimum score"
                        domain="[('min_assessment_score', '&gt;', 0)]"/>
                <group>
                    <filter name="group_state" string="Delivery state"
                            context="{'group_by': 'ethara_state'}"/>
                    <filter name="group_pm" string="PM"
                            context="{'group_by': 'pm_id'}"/>
                    <filter name="group_type" string="Type"
                            context="{'group_by': 'ethara_project_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_epo_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <!-- Scoped to the pipeline: the registry also holds budget-only projects, and
             showing them here would offer a PM an Activate button on a record that
             has no knowledge folder. -->
        <field name="domain">[('is_project_os', '=', True)]</field>
        <field name="context">{'search_default_live': 1, 'default_is_project_os': True}</field>
        <field name="search_view_id" ref="view_epo_project_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 10, 'view_mode': 'kanban', 'view_id': ref('view_epo_project_kanban')}),
            (0, 0, {'sequence': 20, 'view_mode': 'list', 'view_id': ref('view_epo_project_list')}),
            (0, 0, {'sequence': 30, 'view_mode': 'form', 'view_id': ref('view_epo_project_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first project</p>
            <p>A project goes live once it has an SOP in its knowledge folder and a
               published stagelist. Until then it stays in setup and nobody can be
               allocated to it.</p>
        </field>
    </record>


</odoo>
