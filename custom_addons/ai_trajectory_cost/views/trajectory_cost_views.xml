<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_trajectory_cost_list" model="ir.ui.view">
        <field name="name">trajectory.cost.list</field>
        <field name="model">trajectory.cost</field>
        <field name="arch" type="xml">
            <list string="Trajectories">
                <field name="trajectory_id"/>
                <field name="project_key"/>
                <field name="model_count"/>
                <field name="input_tokens" sum="Input"/>
                <field name="output_tokens" sum="Output"/>
                <field name="cache_tokens" sum="Cache"/>
                <field name="total_tokens" sum="Total"/>
                <field name="cost" sum="Cost"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_trajectory_cost_form" model="ir.ui.view">
        <field name="name">trajectory.cost.form</field>
        <field name="model">trajectory.cost</field>
        <field name="arch" type="xml">
            <form string="Trajectory">
                <sheet>
                    <div class="oe_title">
                        <label for="trajectory_id"/>
                        <h1><field name="trajectory_id" placeholder="trajectory id"/></h1>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="project_key"/>
                            <field name="trajectory_id"/>
                        </group>
                        <group string="Totals (aggregated)">
                            <field name="model_count" readonly="1"/>
                            <field name="input_tokens" readonly="1"/>
                            <field name="output_tokens" readonly="1"/>
                            <field name="cache_tokens" readonly="1"/>
                            <field name="total_tokens" readonly="1"/>
                            <field name="cost" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Per-Model Usage">
                            <field name="model_usage_ids">
                                <list editable="bottom">
                                    <field name="model_name"/>
                                    <field name="input_tokens" sum="Input"/>
                                    <field name="output_tokens" sum="Output"/>
                                    <field name="cache_tokens" sum="Cache"/>
                                    <field name="total_tokens" sum="Total"/>
                                    <field name="cost" sum="Cost"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trajectory_cost_search" model="ir.ui.view">
        <field name="name">trajectory.cost.search</field>
        <field name="model">trajectory.cost</field>
        <field name="arch" type="xml">
            <search string="Trajectories">
                <field name="trajectory_id"/>
                <field name="project_key"/>
                <field name="model_usage_ids" string="Model" filter_domain="[('model_usage_ids.model_name', 'ilike', self)]"/>
                <group>
                    <filter string="Project Key" name="group_project_key" context="{'group_by': 'project_key'}"/>
                    <filter string="Trajectory" name="group_trajectory_id" context="{'group_by': 'trajectory_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_trajectory_cost" model="ir.actions.act_window">
        <field name="name">Trajectories</field>
        <field name="res_model">trajectory.cost</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_trajectory_cost_model_usage_list" model="ir.ui.view">
        <field name="name">trajectory.cost.model.usage.list</field>
        <field name="model">trajectory.cost.model.usage</field>
        <field name="arch" type="xml">
            <list string="Per-Model Usage">
                <field name="trajectory_id"/>
                <field name="project_key"/>
                <field name="model_name"/>
                <field name="input_tokens" sum="Input"/>
                <field name="output_tokens" sum="Output"/>
                <field name="cache_tokens" sum="Cache"/>
                <field name="total_tokens" sum="Total"/>
                <field name="cost" sum="Cost"/>
            </list>
        </field>
    </record>

    <record id="view_trajectory_cost_model_usage_search" model="ir.ui.view">
        <field name="name">trajectory.cost.model.usage.search</field>
        <field name="model">trajectory.cost.model.usage</field>
        <field name="arch" type="xml">
            <search string="Per-Model Usage">
                <field name="trajectory_id"/>
                <field name="project_key"/>
                <field name="model_name"/>
                <group>
                    <filter string="Project Key" name="group_project_key" context="{'group_by': 'project_key'}"/>
                    <filter string="Model" name="group_model_name" context="{'group_by': 'model_name'}"/>
                    <filter string="Trajectory" name="group_trajectory_id" context="{'group_by': 'trajectory_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_trajectory_cost_model_usage" model="ir.actions.act_window">
        <field name="name">Per-Model Usage</field>
        <field name="res_model">trajectory.cost.model.usage</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
