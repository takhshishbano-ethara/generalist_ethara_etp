        <table class="matrix" id="matrix" aria-describedby="matrix-desc">
          <caption id="matrix-desc" class="sr-only">Pass/Fail matrix of 20 instances evaluated against two models: Kimi K2.5 and Nova 2 Lite. Filled cell means the model's patch resolved the issue.</caption>
          <thead>
            <tr>
              <th scope="col" class="matrix-th-id">Instance</th>
              <th scope="col" class="matrix-th-meta">Lang</th>
