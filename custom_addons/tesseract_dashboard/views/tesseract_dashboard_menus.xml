<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Backend client action: mounts the OWL TesseractShowcase component
      at a top-level menu. Public portal visitors reach the same content
      at /tesseract via portal_templates.xml.
    -->
    <record id="tesseract_dashboard_action" model="ir.actions.client">
        <field name="name">Tesseract Showcase</field>
        <field name="tag">tesseract_dashboard.showcase</field>
    </record>

    <menuitem id="tesseract_dashboard_menu_root"
              name="Tesseract Showcase"
              action="tesseract_dashboard_action"
              sequence="202"/>

</odoo>
