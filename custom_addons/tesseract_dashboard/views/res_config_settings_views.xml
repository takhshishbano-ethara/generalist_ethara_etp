<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_tesseract_dashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tesseract_dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Tesseract Showcase" string="Tesseract Showcase" name="tesseract_dashboard">
                    <block title="Showcase Link Buttons">
                        <setting string="Trajectories URL"
                                 help="Override the Trajectories button link. Leave empty to use the default GitHub URL.">
                            <field name="tesseract_trajectories_url"
                                   placeholder="https://github.com/Ethara-Ai/tesseract"/>
                        </setting>
                        <setting string="Dataset URL"
                                 help="Override the Dataset button link. Leave empty to use the default HuggingFace URL.">
                            <field name="tesseract_dataset_url"
                                   placeholder="https://huggingface.co/datasets/ethara/tesseract"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
