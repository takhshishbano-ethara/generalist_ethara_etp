<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="surtor_dashboard.Showcase">
        <div class="sr-backend-showcase">
            <div class="sr-backend-header">
                <h1>Surtor Dashboard</h1>
                <p>Personalized Agent Security Evaluation</p>
            </div>

            <div class="sr-backend-metrics">
                <div class="sr-backend-metric">
                    <span class="sr-backend-metric__value">20</span>
                    <span class="sr-backend-metric__label">Instances</span>
                </div>
                <div class="sr-backend-metric">
                    <span class="sr-backend-metric__value">2</span>
                    <span class="sr-backend-metric__label">Models</span>
                </div>
                <div class="sr-backend-metric">
                    <span class="sr-backend-metric__value">2</span>
                    <span class="sr-backend-metric__label">Attack Types</span>
                </div>
                <div class="sr-backend-metric">
                    <span class="sr-backend-metric__value">4</span>
                    <span class="sr-backend-metric__label">Stages</span>
                </div>
            </div>

            <div class="sr-backend-comparison">
                <div class="sr-backend-model">
                    <h3>GLM-5</h3>
                    <div class="sr-backend-model__stat">IPI Attack Score: <strong>24/30</strong></div>
                    <div class="sr-backend-model__stat">MEM Leak Rate: <strong>9/10</strong></div>
                    <div class="sr-backend-model__stat">Avg Score: <strong>2.5/3</strong></div>
                    <div class="sr-backend-model__stat">Avg Tokens: <strong>59K</strong></div>
                </div>
                <div class="sr-backend-model">
                    <h3>Nova-2-Lite</h3>
                    <div class="sr-backend-model__stat">IPI Attack Score: <strong>18/30</strong></div>
                    <div class="sr-backend-model__stat">MEM Leak Rate: <strong>6/10</strong></div>
                    <div class="sr-backend-model__stat">Avg Score: <strong>1.9/3</strong></div>
                    <div class="sr-backend-model__stat">Avg Tokens: <strong>39K</strong></div>
                </div>
            </div>

            <div class="sr-backend-links">
                <a t-att-href="state.trajectories_url" target="_blank" class="sr-backend-link">
                    &#x1F4C2; GitHub Repository
                </a>
                <a t-att-href="state.dataset_url" target="_blank" class="sr-backend-link">
                    &#x1F917; HuggingFace Dataset
                </a>
                <a href="https://arxiv.org/abs/2602.08412" target="_blank" class="sr-backend-link">
                    &#x1F4C4; Research Paper
                </a>
                <a href="/surtor" target="_blank" class="sr-backend-link">
                    &#x1F310; Portal View
                </a>
            </div>
        </div>
    </t>
</templates>
