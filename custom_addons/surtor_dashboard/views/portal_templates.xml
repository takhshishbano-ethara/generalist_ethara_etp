          <div class="glance-row"><dt>MEM Leak Rate</dt><dd><b>9/10</b></dd></div>
          <div class="glance-row"><dt>Avg Score</dt><dd><b>2.5/3</b></dd></div>
          <div class="glance-row"><dt>Total Cost</dt><dd><b>$1.20</b></dd></div>
