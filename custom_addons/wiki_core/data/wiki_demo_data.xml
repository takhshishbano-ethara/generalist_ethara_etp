    <!-- ── Foundation articles ────────────────────────── -->
    <record id="article_core_values" model="wiki.article">
        <field name="sequence">10</field>
        <field name="name">Core Values</field>
        <field name="slug">core_values</field>
        <field name="icon">flag</field>
        <field name="meta">Updated 11 Jun 2026 · HR · v3</field>
        <field name="description">The six principles that guide how we work and make decisions at Ethara.</field>
    </record>
    <record id="article_core_values_s1" model="wiki.article.section">
        <field name="article_id" ref="article_core_values"/><field name="sequence">10</field>
        <field name="heading">Purpose</field>
        <field name="body">This Code sets the standard for how everyone at Ethara treats colleagues, customers, and partners. It applies to all employees, contractors, and interns, on and off company premises during work.</field>
    </record>
    <record id="article_core_values_s2" model="wiki.article.section">
        <field name="article_id" ref="article_core_values"/><field name="sequence">20</field>
        <field name="heading">Expected conduct</field>
        <field name="body">Act with integrity and respect. Protect confidential information. Avoid conflicts of interest and disclose them promptly. Use company resources responsibly and comply with all applicable laws.</field>
    </record>
    <record id="article_core_values_s3" model="wiki.article.section">
        <field name="article_id" ref="article_core_values"/><field name="sequence">30</field>
        <field name="heading">Anti-harassment</field>
        <field name="body">Ethara has zero tolerance for harassment or discrimination of any kind. Concerns are handled confidentially by the Internal Committee under the POSH Act, with no retaliation against anyone who reports in good faith.</field>
    </record>

