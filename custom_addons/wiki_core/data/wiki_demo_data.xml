<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ── FAQs ───────────────────────────────────────── -->
    <record id="faq_detail_form" model="wiki.faq">
        <field name="group">Getting started</field>
        <field name="group_sequence">10</field>
        <field name="sequence">10</field>
        <field name="name">How do I complete my employee detail form?</field>
        <field name="answer">Go to My Records → Detail Form. Complete all 6 steps and upload each supporting document. Your progress is saved as a draft so you can finish across sessions.</field>
    </record>
    <record id="faq_employee_code" model="wiki.faq">
        <field name="group">Getting started</field>
        <field name="group_sequence">10</field>
        <field name="sequence">20</field>
        <field name="name">Where do I find my employee code?</field>
        <field name="answer">Your employee code (e.g. EMP-1042) is on your offer letter and your dashboard profile.</field>
    </record>
    <record id="faq_reporting_manager" model="wiki.faq">
        <field name="group">Getting started</field>
        <field name="group_sequence">10</field>
        <field name="sequence">30</field>
        <field name="name">Who is my reporting manager?</field>
        <field name="answer">Your manager is shown on your profile and approves leave, regularization, and reimbursements.</field>
    </record>
    <record id="faq_contact_details" model="wiki.faq">
        <field name="group">Getting started</field>
        <field name="group_sequence">10</field>
        <field name="sequence">40</field>
        <field name="name">How do I update my contact details?</field>
        <field name="answer">Open your profile from the avatar (top-right), then Edit profile. You can change email and phone yourself; name and statutory IDs are updated by HR.</field>
    </record>
    <record id="faq_leave_count" model="wiki.faq">
        <field name="group">Leave &amp; attendance</field>
        <field name="group_sequence">20</field>
        <field name="sequence">10</field>
        <field name="name">How many leaves do I get?</field>
        <field name="answer">Paid 18 · Casual 7 · Sick 7 · Earned 2 per year. See the Leave Policy page for accrual and carry-forward rules.</field>
    </record>
    <record id="faq_apply_leave" model="wiki.faq">
        <field name="group">Leave &amp; attendance</field>
        <field name="group_sequence">20</field>
        <field name="sequence">15</field>
        <field name="name">How do I apply for leave?</field>
        <field name="answer">Use Apply for leave on the dashboard or the Leave Policy page. Pick a type and dates; we check your balance and route the request to your manager.</field>
    </record>
    <record id="faq_fix_absent" model="wiki.faq">
        <field name="group">Leave &amp; attendance</field>
        <field name="group_sequence">20</field>
        <field name="sequence">20</field>
        <field name="name">How do I fix an Absent day?</field>
        <field name="answer">Open My Records → Attendance, find the Absent or Half-Day row, and click Request regularization. It routes to your manager.</field>
    </record>
    <record id="faq_working_hours" model="wiki.faq">
        <field name="group">Leave &amp; attendance</field>
        <field name="group_sequence">20</field>
        <field name="sequence">30</field>
        <field name="name">What are the working hours?</field>
        <field name="answer">Standard hours are 9:30–18:30, Monday to Friday. Shift workers follow their roster.</field>
    </record>
    <record id="faq_reimbursement_time" model="wiki.faq">
        <field name="group">Reimbursements &amp; pay</field>
        <field name="group_sequence">30</field>
        <field name="sequence">10</field>
        <field name="name">How long does a reimbursement take?</field>
        <field name="answer">Once your manager approves a claim, it is paid with the next payroll cycle — usually within 7–10 working days.</field>
    </record>
    <record id="faq_claim_rejected" model="wiki.faq">
        <field name="group">Reimbursements &amp; pay</field>
        <field name="group_sequence">30</field>
        <field name="sequence">20</field>
        <field name="name">Why was my claim rejected?</field>
        <field name="answer">The most common reasons are a missing or unclear receipt, an amount above the policy limit, or a duplicate claim. The rejection note explains the specific reason — fix it and resubmit.</field>
    </record>
    <record id="faq_payslips" model="wiki.faq">
        <field name="group">Reimbursements &amp; pay</field>
        <field name="group_sequence">30</field>
        <field name="sequence">30</field>
        <field name="name">Where are my payslips?</field>
        <field name="answer">Payslips are issued on the 1st of each month. The latest is summarised on your dashboard. Full payslip access is rolling out soon.</field>
    </record>
    <record id="faq_documents_upload" model="wiki.faq">
        <field name="group">Documents &amp; compliance</field>
        <field name="group_sequence">40</field>
        <field name="sequence">10</field>
        <field name="name">Which documents do I need to upload?</field>
        <field name="answer">Your Documents page shows a checklist by category (Identity, Statutory, Education, Employment). Anything marked Not uploaded is outstanding.</field>
    </record>
    <record id="faq_compliance_forms" model="wiki.faq">
        <field name="group">Documents &amp; compliance</field>
        <field name="group_sequence">40</field>
        <field name="sequence">20</field>
        <field name="name">What are the compliance forms?</field>
        <field name="answer">Statutory forms such as PF Form 2, Form 12BB, and policy acknowledgements. Open each from the Compliance page and e-sign.</field>
    </record>

