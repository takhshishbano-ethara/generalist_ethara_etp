<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="valor.ActionButton">
        <div class="o_valor_action_button w-100" t-ref="root">
            <button
                type="button"
                class="btn btn-primary w-100"
                t-att-disabled="state.loading"
                t-on-click="onClick">
                <t t-if="state.loading">
                    <span class="fa fa-spinner fa-spin"/> <t t-esc="loadingLabel"/>
                </t>
                <t t-else="">
                    <span class="fa fa-docs"/> <t t-esc="buttonLabel"/>
                </t>
            </button>
        </div>
    </t>
</templates>
