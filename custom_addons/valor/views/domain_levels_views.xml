<odoo>
  <data>
    <record model="ir.ui.view" id="domain_level_list">
      <field name="name">domain.level.list</field>
      <field name="model">domain.level</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="parent_id"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="domain_level_form">
      <field name="name">domain.level.form</field>
      <field name="model">domain.level</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
              <group>
                  <group>
                      <field name="name"/>
                      <field name="parent_id"/>
                  </group>
              </group>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="domain_level_action_window">
      <field name="name">Domain Level</field>
      <field name="res_model">domain.level</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('domain_level_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('domain_level_form')})]"/>

    </record>
  </data>
</odoo>
