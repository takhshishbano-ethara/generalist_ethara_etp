<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_skoll" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.skoll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Skoll" string="Skoll" name="skoll_project">
                    <block title="Deployment">
                        <setting string="Deployment Mode">
                            <field name="skoll_deployment_mode" widget="radio"/>
                        </setting>
                    </block>
                    <block title="Bedrock Model ARNs">
                        <setting string="Sonnet ARN">
                            <field name="skoll_sonnet_arn" />
                        </setting>
                        <setting string="Kimi ARN">
                            <field name="skoll_kimi_arn" />
                        </setting>
                        <setting string="Opus ARN">
                            <field name="skoll_opus_arn" />
                        </setting>
                    </block>
                    <block title="OpenClaw Sandbox">
                        <setting string="OpenClaw Image">
                            <field name="skoll_openclaw_image" />
                        </setting>
                        <setting string="Web Search Provider">
                            <field name="skoll_web_search_provider" widget="radio"/>
                        </setting>
                        <setting string="Brave API Key" help="Required when Web Search Provider is Brave. Get a key at https://api.search.brave.com (Search plan).">
                            <field name="skoll_brave_api_key" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
