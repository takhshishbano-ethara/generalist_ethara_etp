<odoo>
  <data>
    <record model="ir.ui.view" id="skoll_skoll_list">
      <field name="name">skoll.skoll.list</field>
      <field name="model">skoll.skoll</field>
      <field name="arch" type="xml">
        <list>
          <field name="task_id"/>
          <field name="persona_id"/>
          <field name="employee_id"/>
          <field name="task_status"/>
          <field name="qc_status" widget="badge"
                 decoration-success="qc_status == 'passed'"
                 decoration-danger="qc_status == 'failed'"
                 decoration-muted="qc_status == 'pending'"/>
          <field name="auto_process_status" widget="badge" string="Auto"
                 decoration-success="auto_process_status == 'done'"
                 decoration-danger="auto_process_status == 'failed'"
                 decoration-info="auto_process_status == 'processing'"
                 decoration-warning="auto_process_status == 'queued'"
                 decoration-muted="auto_process_status == 'none'"
                 optional="show"/>
          <field name="claude_status" widget="badge" string="Claude"
                 decoration-success="claude_status == 'running'"
                 decoration-danger="claude_status == 'error'"
                 decoration-info="claude_status == 'starting'"
                 decoration-muted="claude_status == 'stopped'"/>
          <field name="glm_status" widget="badge" string="Kimi"
                 decoration-success="glm_status == 'running'"
                 decoration-danger="glm_status == 'error'"
                 decoration-info="glm_status == 'starting'"
                 decoration-muted="glm_status == 'stopped'"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="skoll_skoll_form">
      <field name="name">skoll.skoll.form</field>
      <field name="model">skoll.skoll</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <div class="oe_button_box" name="button_box">
              <button class="oe_stat_button" name="action_generate_golden_trajectory"
                      type="object" icon="fa-magic"
                      string="Generate Golden"
                      invisible="golden_input_mode != 'ai'"
                      confirm="This will call the LLM to generate golden trajectories. Continue?"/>
              <button class="oe_stat_button" name="action_upload_trajectories"
                      type="object" icon="fa-cloud-upload"
                      string="Upload Trajectories"
                      confirm="Upload all non-empty trajectory fields to S3?"/>
            </div>
            <group>
              <group string="Task Details">
                <field name="is_skoll_admin" invisible="1"/>
                <field name="is_ql_or_pl" invisible="1"/>
                <field name="task_id" readonly="not is_skoll_admin"/>
                <field name="persona_id" readonly="not is_skoll_admin" options="{'no_open': True}"/>
                <field name="task_status"/>
                <field name="qc_status" widget="badge" readonly="not is_skoll_admin"
                       decoration-success="qc_status == 'passed'"
                       decoration-danger="qc_status == 'failed'"
                       decoration-muted="qc_status == 'pending'"/>
                <field name="auto_process_status" widget="badge" readonly="1"
                       decoration-success="auto_process_status == 'done'"
                       decoration-danger="auto_process_status == 'failed'"
                       decoration-info="auto_process_status == 'processing'"
                       decoration-warning="auto_process_status == 'queued'"
                       decoration-muted="auto_process_status == 'none'"/>
                <field name="auto_process_error" readonly="1"
                       invisible="auto_process_status != 'failed'"/>
              </group>
              <group string="Task Metadata">
                <group>
                  <field name="life_domain_ids" widget="many2many_tags" readonly="1"/>
                  <field name="cluster_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <group>
                  <field name="task_type_ids" widget="many2many_tags" readonly="1"/>
                  <field name="pattern_taxonomy_ids" widget="many2many_tags" readonly="1"/>
                </group>
              </group>
              <group string="Assignment">
                <field name="employee_id" readonly="not is_skoll_admin"/>
                <field name="user_id" readonly="not is_skoll_admin"/>
                <field name="email" readonly="not is_skoll_admin"/>
                <field name="password" readonly="not is_skoll_admin" string="Google Password"/>
                <field name="gog_auth" readonly="not is_skoll_admin" string="GOG Auth"/>
                <field name="outlook_username" readonly="not is_skoll_admin"/>
                <field name="outlook_password" readonly="not is_skoll_admin"/>
                <field name="eventbrite_username" readonly="not is_skoll_admin"/>
                <field name="eventbrite_password" readonly="not is_skoll_admin"/>
                <field name="strava_username" readonly="not is_skoll_admin"/>
                <field name="strava_password" readonly="not is_skoll_admin"/>
                <field name="oura_username" readonly="not is_skoll_admin"/>
                <field name="oura_password" readonly="not is_skoll_admin"/>
                <field name="instagram_username" readonly="not is_skoll_admin"/>
                <field name="instagram_password" readonly="not is_skoll_admin"/>
                <field name="facebook_username" readonly="not is_skoll_admin"/>
                <field name="facebook_password" readonly="not is_skoll_admin"/>
                <field name="threads_username" readonly="not is_skoll_admin"/>
                <field name="threads_password" readonly="not is_skoll_admin"/>
              </group>
            </group>

            <field name="system_prompt" invisible="1"/>
            <div class="w-100 mb-3">
              <label for="seed_prompt" string="Prompt" class="fw-bold mb-1"/>
              <field name="seed_prompt" widget="skoll_markdown" readonly="1"/>
            </div>
            <div class="d-flex gap-3 w-100 mb-3 o_skoll_md_row">
              <div class="flex-fill" style="min-width: 0; flex: 1;">
                <label for="agent_md" string="Agent MD" class="fw-bold mb-1"/>
                <field name="agent_md" widget="skoll_markdown" readonly="1" class="o_skoll_md_scroll"/>
              </div>
              <div class="flex-fill" style="min-width: 0; flex: 1;">
                <label for="soul_md" string="Soul MD" class="fw-bold mb-1"/>
                <field name="soul_md" widget="skoll_markdown" readonly="1" class="o_skoll_md_scroll"/>
              </div>
              <div class="flex-fill" style="min-width: 0; flex: 1;">
                <label for="memory_md" string="Memory MD" class="fw-bold mb-1"/>
                <field name="memory_md" widget="skoll_markdown" readonly="1" class="o_skoll_md_scroll"/>
              </div>
            </div>

            <field name="sandbox_ids" invisible="1"/>
            <field name="claude_session_status" invisible="1"/>
            <field name="glm_session_status" invisible="1"/>

            <widget name="skoll_task_dashboard"/>

            <group string="Trajectories" colspan="2">
              <separator string="Claude 4.7 Trajectory" colspan="2"/>
              <field name="claude_trajectory" widget="skoll_json" nolabel="1" placeholder="Claude 4.7 Trajectory" colspan="2"/>
            </group>
            <field name="golden_status" invisible="1"/>
            <field name="golden_error" invisible="1"/>
            <field name="golden_started_at" invisible="1"/>
            <group string="Golden Trajectory">
              <field name="golden_input_mode" widget="radio" options="{'horizontal': true}" colspan="2"/>

              <!-- AI mode: generate golden from Claude 4.7 trajectory -->
              <div colspan="2" invisible="golden_input_mode != 'ai'">
                <field name="golden_prompt" widget="skoll_prompt" nolabel="1"/>
                <separator string="Generated Golden Trajectory"/>
                <field name="golden_trajectory" widget="skoll_json" nolabel="1"
                       placeholder="Golden Trajectory (AI)" readonly="1" force_save="1"/>
              </div>

              <!-- Manual mode: text input for pasting -->
              <div colspan="2" invisible="golden_input_mode != 'manual'">
                <label for="golden_trajectory_manual" string="Paste Golden Trajectory JSON" class="fw-bold mb-1"/>
                <field name="golden_trajectory_manual" widget="text" nolabel="1"
                       placeholder='Paste your golden trajectory JSON here...'/>
              </div>
            </group>

            <!-- Spawn Tree -->
            <group string="Spawn Tree" invisible="not golden_spawn_tree">
              <field name="golden_spawn_tree" widget="skoll_spawn_tree" nolabel="1"
                     colspan="2" force_save="1"/>
            </group>

            <!-- Quality Check -->
            <group string="Quality Check">
              <group>
                <field name="golden_qc_status" widget="badge"
                       decoration-success="golden_qc_status == 'pass'"
                       decoration-danger="golden_qc_status in ('fail', 'error')"
                       decoration-warning="golden_qc_status == 'needs_revision'"
                       decoration-info="golden_qc_status == 'running'"
                       decoration-muted="golden_qc_status == 'pending'"/>
              </group>
              <notebook colspan="2">
                <page string="Structural Validation" invisible="not golden_structural_result">
                  <field name="golden_structural_result" widget="text" nolabel="1" readonly="1"/>
                </page>
                <page string="LLM QC Review" invisible="not golden_qc_result">
                  <field name="golden_qc_result" widget="skoll_qc_result" nolabel="1"
                         force_save="1"/>
                </page>
              </notebook>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="skoll_skoll_action_window">
      <field name="name">Skoll Tasks</field>
      <field name="res_model">skoll.skoll</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('skoll_skoll_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('skoll_skoll_form')})]"/>
    </record>

    <record model="ir.actions.server" id="skoll_action_auto_process">
      <field name="name">Auto Process Selected</field>
      <field name="model_id" ref="model_skoll_skoll"/>
      <field name="binding_model_id" ref="model_skoll_skoll"/>
      <field name="binding_view_types">list</field>
      <field name="state">code</field>
      <field name="code">
action = records.action_publish_auto_process()
      </field>
    </record>

    <record model="ir.actions.server" id="skoll_action_upload_trajectories">
      <field name="name">Upload Trajectories to S3</field>
      <field name="model_id" ref="model_skoll_skoll"/>
      <field name="binding_model_id" ref="model_skoll_skoll"/>
      <field name="binding_view_types">list</field>
      <field name="state">code</field>
      <field name="code">
action = records.action_mass_upload_trajectories()
      </field>
    </record>

    <record model="ir.ui.view" id="skoll_taxonomy_list">
      <field name="name">skoll.taxonomy.list</field>
      <field name="model">skoll.taxonomy</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="skoll_taxonomy_form">
      <field name="name">skoll.taxonomy.form</field>
      <field name="model">skoll.taxonomy</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
              <group>
                  <group>
                      <field name="name"/>
                  </group>
              </group>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="skoll_taxonomy_action_window">
      <field name="name">Taxonomy</field>
      <field name="res_model">skoll.taxonomy</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('skoll_taxonomy_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('skoll_taxonomy_form')})]"/>

    </record>

    <!-- ============ Turn Views ============ -->

    <record model="ir.ui.view" id="skoll_turn_list">
      <field name="name">skoll.turn.list</field>
      <field name="model">skoll.turn</field>
      <field name="arch" type="xml">
        <list default_order="turn_number asc, id asc">
          <field name="sandbox_id"/>
          <field name="skoll_id"/>
          <field name="employee_id"/>
          <field name="turn_number"/>
          <field name="turn_status" widget="badge"
                 decoration-success="turn_status == 'Completed'"
                 decoration-warning="turn_status == 'Pending'"/>
          <field name="prompt_timestamp"/>
          <field name="response_timestamp"/>
          <field name="prompt"/>
          <field name="response"/>
          <field name="model_name"/>
          <field name="tool_names"/>
          <field name="tool_calls" optional="hide" widget="text"/>
          <field name="qc_severity" optional="show" widget="badge"
                 decoration-danger="qc_severity == 'critical'"
                 decoration-warning="qc_severity in ('high', 'medium')"
                 decoration-success="qc_severity == 'low'"/>
          <field name="qc_dismiss_reason" optional="hide"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="skoll_turn_form">
      <field name="name">skoll.turn.form</field>
      <field name="model">skoll.turn</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="sandbox_id"/>
                <field name="skoll_id"/>
                <field name="employee_id"/>
                <field name="turn_number"/>
                <field name="turn_status"/>
                <field name="model_name"/>
                <field name="prompt_timestamp"/>
                <field name="response_timestamp"/>
              </group>
            </group>
            <notebook>
              <page string="Prompt">
                <field name="prompt" nolabel="1"/>
              </page>
              <page string="Response">
                <field name="response" nolabel="1"/>
              </page>
              <page string="Tool Calls">
                <group>
                  <field name="tool_names"/>
                </group>
                <field name="tool_calls" nolabel="1" widget="text"/>
              </page>
              <page string="Raw Events">
                <field name="raw_events" nolabel="1" widget="text"/>
              </page>
              <page string="Trajectory">
                <field name="trajectory_messages" nolabel="1" widget="text"/>
              </page>
              <page string="QC">
                <group>
                  <field name="qc_severity"/>
                  <field name="qc_dismiss_reason"/>
                </group>
                <field name="qc_response" nolabel="1" widget="text"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="skoll_turn_action_window">
      <field name="name">Turns</field>
      <field name="res_model">skoll.turn</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('skoll_turn_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('skoll_turn_form')})]"/>
    </record>

    <!-- ============ Sandbox Views (Admin) ============ -->

    <record model="ir.ui.view" id="skoll_sandbox_list">
      <field name="name">skoll.sandbox.list</field>
      <field name="model">skoll.sandbox</field>
      <field name="arch" type="xml">
        <list default_order="skoll_id desc, model_type">
          <field name="skoll_id"/>
          <field name="employee_id"/>
          <field name="model_type"/>
          <field name="docker_status" widget="badge"
                 decoration-success="docker_status == 'running'"
                 decoration-danger="docker_status == 'error'"
                 decoration-info="docker_status == 'starting'"
                 decoration-muted="docker_status == 'stopped'"/>
          <field name="docker_dashboard_url" widget="url"/>
          <field name="docker_port"/>
          <field name="session_status"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="skoll_sandbox_form">
      <field name="name">skoll.sandbox.form</field>
      <field name="model">skoll.sandbox</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group string="Sandbox Info">
                <field name="skoll_id"/>
                <field name="employee_id"/>
                <field name="model_type"/>
                <field name="session_status"/>
              </group>
              <group string="Docker Status">
                <field name="docker_status" widget="badge"
                       decoration-success="docker_status == 'running'"
                       decoration-danger="docker_status == 'error'"
                       decoration-info="docker_status == 'starting'"
                       decoration-muted="docker_status == 'stopped'"/>
                <field name="docker_port"/>
                <field name="docker_compose_project"/>
                <field name="docker_error"/>
              </group>
            </group>
            <group string="Container Links">
              <field name="docker_dashboard_url" widget="url"/>
              <field name="docker_ws_url" widget="url"/>
              <field name="docker_gateway_token"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="skoll_sandbox_action_window">
      <field name="name">Sandboxes</field>
      <field name="res_model">skoll.sandbox</field>
      <field name="view_mode">list,form</field>
      <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('skoll_sandbox_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('skoll_sandbox_form')})]"/>
    </record>

  </data>
</odoo>
