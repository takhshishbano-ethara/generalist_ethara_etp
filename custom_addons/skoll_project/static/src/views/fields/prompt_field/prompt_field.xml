<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="skoll.PromptField">
        <div class="o_field_skoll_prompt o_field_widget">

            <div class="skoll-prompt-container">
                <div class="skoll-prompt-header">
                    <span class="skoll-prompt-label">
                        <i class="fa fa-magic"/> Golden Trajectory Generation
                    </span>
                    <t t-if="isAiMode and !isReadonly">
                        <div class="skoll-prompt-actions">
                            <t t-if="state.generating">
                                <button class="skoll-prompt-stop-btn"
                                        t-on-click="onStopGenerate">
                                    <i class="fa fa-stop"/> Stop
                                </button>
                            </t>
                            <t t-else="">
                                <button class="skoll-prompt-generate-btn"
                                        t-att-disabled="!canGenerate"
                                        t-on-click="onGenerate">
                                    <i class="fa fa-magic"/> Generate from Claude 4.7 Trajectory
                                </button>
                            </t>
                        </div>
                    </t>
                </div>

                <div class="skoll-prompt-source-info">
                    <t t-if="hasClaudeTrajectory">
                        <div class="skoll-prompt-source-ready">
                            <i class="fa fa-check-circle"/> Claude 4.7 trajectory available as generation source
                        </div>
                    </t>
                    <t t-else="">
                        <div class="skoll-prompt-source-missing">
                            <i class="fa fa-exclamation-triangle"/> No Claude 4.7 trajectory available. Generate or capture a Claude trajectory first.
                        </div>
                    </t>
                </div>
            </div>

        </div>
    </t>

</templates>
