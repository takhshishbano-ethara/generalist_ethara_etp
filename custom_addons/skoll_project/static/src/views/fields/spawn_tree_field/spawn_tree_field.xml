<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="skoll.SpawnTreeField">
        <div class="o_field_skoll_spawn_tree o_field_widget">

            <t t-if="hasTree">
                <div class="skoll-spawn-tree-viewer">
                    <div class="skoll-spawn-tree-header">
                        <span class="skoll-spawn-tree-label">
                            <i class="fa fa-sitemap"/> Spawn Tree
                        </span>
                        <div class="skoll-spawn-tree-actions">
                            <button class="skoll-spawn-tree-copy-btn"
                                    t-on-click="onCopy"
                                    t-att-title="state.copied ? 'Copied!' : 'Copy to clipboard'">
                                <i t-att-class="state.copied ? 'fa fa-check' : 'fa fa-clipboard'"/>
                                <t t-if="state.copied"> Copied</t>
                                <t t-else=""> Copy</t>
                            </button>
                            <button t-if="!state.loading"
                                    class="skoll-spawn-tree-refresh-btn"
                                    t-on-click="onRefreshTree"
                                    title="Regenerate spawn tree">
                                <i class="fa fa-refresh"/> Refresh
                            </button>
                            <span t-if="state.loading" class="skoll-spawn-tree-loading">
                                <i class="fa fa-spinner fa-spin"/> Building...
                            </span>
                        </div>
                    </div>
                    <pre class="skoll-spawn-tree-body"><t t-esc="state.treeText"/></pre>
                </div>
            </t>

            <t t-else="">
                <div class="skoll-spawn-tree-empty">
                    <i class="fa fa-sitemap"/> No spawn tree generated yet
                </div>
            </t>

        </div>
    </t>

</templates>
