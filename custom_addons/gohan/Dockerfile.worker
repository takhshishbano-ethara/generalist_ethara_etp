# Gohan local-k8s container image (single-image design).
# Serves both the Odoo server and the gohan-worker daemon — each runs the same
# image with a different command (Odoo: odoo-bin; worker: worker/run_prd.py).
# Mirrors custom_addons/vegeta/Dockerfile.worker pattern.
#
# Build context: project root (../../..)
#
# Build:
#   docker build --platform linux/arm64 \
#     -f custom_addons/gohan/Dockerfile.worker \
#     -t gohan-prd-worker:latest .

FROM python:3.12-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libpq-dev \
    libxml2-dev libxslt1-dev \
    libssl-dev libffi-dev \
    libjpeg62-turbo-dev zlib1g-dev \
    build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY custom_addons/gohan/worker/requirements.txt /tmp/worker-requirements.txt

RUN pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /tmp/worker-requirements.txt

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/odoo:/opt/odoo/custom_addons

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    libpq5 \
    libxml2 libxslt1.1 \
    libssl3 \
    libffi8 \
    libjpeg62-turbo \
    zlib1g \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /opt/odoo

COPY src/ /opt/odoo/
COPY custom_addons/gohan/ /opt/odoo/custom_addons/gohan/
COPY custom_addons/etp_user_roles/ /opt/odoo/custom_addons/etp_user_roles/

RUN chmod +x /opt/odoo/odoo-bin 2>/dev/null || true

RUN useradd -r -u 1000 -m -d /opt/odoo -s /usr/sbin/nologin odoo \
    && chown -R odoo:odoo /opt/odoo \
    && mkdir -p /tmp/odoo-data \
    && chown -R odoo:odoo /tmp/odoo-data

USER odoo

CMD ["python", "/opt/odoo/custom_addons/gohan/worker/run_prd.py"]
