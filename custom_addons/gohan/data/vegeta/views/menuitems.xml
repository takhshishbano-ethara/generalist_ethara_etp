<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_vegeta_root"
              name="Vegeta"
              sequence="100"
              groups="group_vegeta_user"
              web_icon="vegeta,static/description/icon.png"/>

    <!-- Admin sees "All Tasks" (all, can create) -->
    <menuitem id="menu_vegeta_jobs_admin"
              name="All Tasks"
              parent="menu_vegeta_root"
              action="action_vegeta_job"
              sequence="10"
              groups="group_vegeta_admin"/>

    <!-- Tasker sees "My Tasks" (own tasks, Start Task button in list header) -->
    <menuitem id="menu_vegeta_jobs_tasker"
              name="My Tasks"
              parent="menu_vegeta_root"
              action="action_vegeta_job_tasker"
              sequence="11"
              groups="group_vegeta_user"/>

    <menuitem id="menu_vegeta_config"
              name="Configuration"
              parent="menu_vegeta_root"
              sequence="90"
              groups="group_vegeta_admin"/>

    <menuitem id="menu_vegeta_import"
              name="Import URLs"
              parent="menu_vegeta_config"
              action="action_vegeta_import_wizard"
              sequence="5"/>

    <menuitem id="menu_vegeta_settings"
              name="Settings"
              parent="menu_vegeta_config"
              action="base_setup.action_general_configuration"
              sequence="10"/>
</odoo>
