<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Taskers can only see their own assigned tasks -->
        <record id="rule_gohan_job_user" model="ir.rule">
            <field name="name">Gohan Task: User sees own tasks</field>
            <field name="model_id" ref="model_gohan_job"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gohan_user'))]"/>
        </record>

        <!-- Admins can see all tasks -->
        <record id="rule_gohan_job_admin" model="ir.rule">
            <field name="name">Gohan Task: Admin sees all</field>
            <field name="model_id" ref="model_gohan_job"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gohan_admin'))]"/>
        </record>

        <!-- =========================================================== -->
        <!-- Upload Data rules                                            -->
        <!-- =========================================================== -->

        <!-- Tasker: read only sheets, and only ones still active.
             Detailed line visibility is enforced by the line rule below. -->
        <record id="rule_gohan_website_sheet_user" model="ir.rule">
            <field name="name">Upload Data: User sees active sheets</field>
            <field name="model_id" ref="model_gohan_website_sheet"/>
            <field name="domain_force">[('state', '=', 'active')]</field>
            <field name="groups" eval="[(4, ref('group_gohan_user'))]"/>
        </record>

        <record id="rule_gohan_website_sheet_admin" model="ir.rule">
            <field name="name">Upload Data: Admin sees all</field>
            <field name="model_id" ref="model_gohan_website_sheet"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gohan_admin'))]"/>
        </record>

        <!-- Tasker: sees lines they hold. Claim logic runs in sudo so it
             can find unassigned lines outside this filter. -->
        <record id="rule_gohan_website_sheet_line_user" model="ir.rule">
            <field name="name">Upload Data Line: User sees own</field>
            <field name="model_id" ref="model_gohan_website_sheet_line"/>
            <field name="domain_force">[('assigned_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_gohan_user'))]"/>
        </record>

        <record id="rule_gohan_website_sheet_line_admin" model="ir.rule">
            <field name="name">Upload Data Line: Admin sees all</field>
            <field name="model_id" ref="model_gohan_website_sheet_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_gohan_admin'))]"/>
        </record>
    </data>
</odoo>
