<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_gohan" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.gohan</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Gohan" string="Gohan" name="gohan">
                    <block title="API Gateway (Spec-compliant trigger + webhook)">
                        <setting string="API Gateway" help="Used by gohan.job.action_run_pipeline() to POST {url}/run with X-Api-Key. Leave empty to disable; the direct boto3 path still works.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_lambda_api_url" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_lambda_api_url" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_lambda_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_lambda_api_key" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Webhook HMAC Secret" help="Shared secret used to verify the X-Gohan-Signature header on /gohan/webhook callbacks (hex HMAC-SHA256 of raw body). Must match the value baked into the Lambda's environment.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_hmac_secret" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_hmac_secret" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Extraction Lambda">
                        <setting string="Lambda Function" help="AWS Lambda function name or ARN. Used with boto3 lambda:Invoke (async).">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_lambda_function_name" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_lambda_function_name" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_lambda_region" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_lambda_region" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_batch_concurrency" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_batch_concurrency" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Extraction AWS Credentials" help="Leave empty to use EKS pod IAM role (IRSA).">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_extraction_access_key_id" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_extraction_access_key_id" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_extraction_secret_access_key" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_extraction_secret_access_key" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="AWS Bedrock (LLM)">
                        <setting string="Bedrock Inference ARN">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_bedrock_inference_arn" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_bedrock_inference_arn" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_bedrock_region" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_bedrock_region" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_max_llm_attempts" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_max_llm_attempts" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Bedrock AWS Credentials">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_bedrock_access_key_id" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_bedrock_access_key_id" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_bedrock_secret_access_key" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_bedrock_secret_access_key" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="S3 Storage">
                        <setting string="S3 Bucket">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_s3_bucket" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_s3_bucket" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_s3_region" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_s3_region" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_s3_folder" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_s3_folder" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_s3_cdn_url" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_s3_cdn_url" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="S3 AWS Credentials">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_s3_access_key_id" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_s3_access_key_id" class="oe_inline"/>
                                </div>
                                <div class="row mt16">
                                    <label for="gohan_s3_secret_access_key" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_s3_secret_access_key" class="oe_inline" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Prompts">
                        <setting string="PRD System Prompt" help="Upload a .md file to override the built-in PRD generation prompt. Leave empty to use the default (prd_agent_spec.md).">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_prd_prompt_file" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_prd_prompt_file" filename="gohan_prd_prompt_filename" class="oe_inline"/>
                                    <field name="gohan_prd_prompt_filename" invisible="1"/>
                                </div>
                                <div class="row">
                                    <div class="col-lg-3"/>
                                    <field name="gohan_prd_prompt_status" class="text-muted"/>
                                </div>
                                <div class="row mt8">
                                    <div class="col-lg-3"/>
                                    <button name="action_clear_prd_prompt" type="object" string="Reset to Default" class="btn-link btn-sm" icon="fa-undo"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="QC Review Prompt" help="Upload a .md file to override the built-in QC review prompt. Leave empty to use the default.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_qc_prompt_file" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_qc_prompt_file" filename="gohan_qc_prompt_filename" class="oe_inline"/>
                                    <field name="gohan_qc_prompt_filename" invisible="1"/>
                                </div>
                                <div class="row">
                                    <div class="col-lg-3"/>
                                    <field name="gohan_qc_prompt_status" class="text-muted"/>
                                </div>
                                <div class="row mt8">
                                    <div class="col-lg-3"/>
                                    <button name="action_clear_qc_prompt" type="object" string="Reset to Default" class="btn-link btn-sm" icon="fa-undo"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Limits">
                        <setting string="Max Active Tasks per Tasker" help="Maximum active tasks per tasker. 0 = unlimited.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="gohan_max_jobs_per_user" class="col-lg-3 o_light_label"/>
                                    <field name="gohan_max_jobs_per_user" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
