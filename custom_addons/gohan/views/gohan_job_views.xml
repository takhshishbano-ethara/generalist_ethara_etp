<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- WIZARDS                                                      -->
    <!-- ============================================================ -->

    <!-- Start Task Wizard -->
    <record id="gohan_start_task_wizard_view" model="ir.ui.view">
        <field name="name">gohan.start.task.wizard.form</field>
        <field name="model">gohan.start.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Start Task">
                <group>
                    <div class="alert alert-info" role="alert">
                        <p class="mb-0">Pick a category to get a matching task, or leave empty for any available task.</p>
                    </div>
                    <field name="category_id" placeholder="Any category"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Start Task" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gohan_start_task_wizard" model="ir.actions.act_window">
        <field name="name">Start Task</field>
        <field name="res_model">gohan.start.task.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Rerun Wizard (with asset/score context) -->
    <record id="gohan_rerun_wizard_view" model="ir.ui.view">
        <field name="name">gohan.rerun.wizard.form</field>
        <field name="model">gohan.rerun.wizard</field>
        <field name="arch" type="xml">
            <form string="Rerun Pipeline">
                <group>
                    <div class="alert alert-info" role="alert">
                        <strong>Rerun Pipeline</strong>
                        <p class="mt-2 mb-0">Do you want to re-extract the website?</p>
                    </div>

                    <!-- Current extraction status -->
                    <div class="alert alert-light border" role="status">
                        <div class="row">
                            <div class="col-6">
                                <strong>Extraction:</strong>
                                <field name="asset_summary" class="ms-1"/>
                            </div>
                            <div class="col-3">
                                <strong>Score:</strong>
                                <field name="job_score_display" class="ms-1"/>
                            </div>
                            <div class="col-3">
                                <strong>QC:</strong>
                                <field name="job_qc_verdict" class="ms-1"/>
                            </div>
                        </div>
                    </div>
                </group>
                <footer>
                    <button name="action_rerun_generate_only" type="object"
                            string="Regenerate PRD Only" class="oe_highlight"
                            invisible="not has_assets and not has_screenshots"/>
                    <button name="action_rerun_full" type="object"
                            string="Re-extract Everything" class="btn-secondary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Import Wizard -->
    <record id="gohan_import_wizard_view" model="ir.ui.view">
        <field name="name">gohan.import.wizard.form</field>
        <field name="model">gohan.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import URLs">
                <group>
                    <div class="alert alert-info" role="alert">
                        <p class="mb-1">Upload a CSV file with website URLs to create tasks.</p>
                        <p class="mb-0"><strong>Required column:</strong> <code>url</code><br/>
                        <strong>Optional column:</strong> <code>category</code> (must match an existing category name)</p>
                    </div>
                    <field name="csv_file" filename="csv_filename"/>
                    <field name="csv_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gohan_import_wizard" model="ir.actions.act_window">
        <field name="name">Import URLs</field>
        <field name="res_model">gohan.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Bulk Assign Wizard -->
    <record id="gohan_bulk_assign_wizard_view" model="ir.ui.view">
        <field name="name">gohan.bulk.assign.wizard.form</field>
        <field name="model">gohan.bulk.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Assign Tasks">
                <group>
                    <field name="task_count" readonly="1"/>
                    <field name="user_id" domain="[('all_group_ids', 'in', %(gohan.group_gohan_user)d)]"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_gohan_bulk_assign" model="ir.actions.act_window">
        <field name="name">Bulk Assign</field>
        <field name="res_model">gohan.bulk.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_gohan_job"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- ============================================================ -->
    <!-- LIST VIEWS                                                   -->
    <!-- ============================================================ -->

    <!-- Admin List View -->
    <record id="gohan_job_view_tree" model="ir.ui.view">
        <field name="name">gohan.job.list</field>
        <field name="model">gohan.job</field>
        <field name="arch" type="xml">
            <list js_class="gohan_list" decoration-danger="state == 'failed'" decoration-muted="state in ('not_assigned','discarded')" decoration-success="state == 'done'" decoration-bf="state == 'submitted'">
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="site_name"/>
                <field name="category_id"/>
                <field name="state" widget="badge" decoration-info="state in ('extracting','generating','scoring')" decoration-warning="state in ('extracted','generated','scored')" decoration-success="state in ('done','submitted')" decoration-danger="state == 'failed'" decoration-muted="state in ('not_assigned','discarded')"/>
                <field name="qc_verdict"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Tasker List View -->
    <record id="gohan_job_tasker_view_tree" model="ir.ui.view">
        <field name="name">gohan.job.tasker.list</field>
        <field name="model">gohan.job</field>
        <field name="arch" type="xml">
            <list js_class="gohan_list" decoration-danger="state == 'failed'" decoration-muted="state == 'discarded'" decoration-success="state == 'done'" decoration-bf="state == 'submitted'">
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="site_name"/>
                <field name="category_id"/>
                <field name="state" widget="badge" decoration-info="state in ('extracting','generating','scoring')" decoration-warning="state in ('extracted','generated','scored')" decoration-success="state in ('done','submitted')" decoration-danger="state == 'failed'" decoration-muted="state == 'discarded'"/>
                <field name="qc_verdict"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- FORM VIEW                                                    -->
    <!-- ============================================================ -->

    <record id="gohan_job_view_form" model="ir.ui.view">
        <field name="name">gohan.job.form</field>
        <field name="model">gohan.job</field>
        <field name="arch" type="xml">
            <form>
                <field name="is_admin" invisible="1"/>
                <field name="has_pipeline_data" invisible="1"/>
                <field name="prd_text" invisible="1"/>
                <field name="screenshot_keys" invisible="1"/>
                <field name="asset_keys" invisible="1"/>
                <field name="error_message" invisible="1"/>
                <field name="extraction_warnings" invisible="1"/>
                <header>
                    <!-- =================================================== -->
                    <!-- HEADER BUTTONS                                      -->
                    <!-- Start Task is LIST-VIEW ONLY (via js_class button)  -->
                    <!-- Run buttons hide once a task has pipeline data —    -->
                    <!-- operators must use Rerun Pipeline on those.         -->
                    <!-- =================================================== -->

                    <!-- DRAFT / NOT ASSIGNED: Run the pipeline (only on clean tasks) -->
                    <button name="action_run" type="object"
                            string="Run Pipeline" class="oe_highlight"
                            invisible="state not in ('draft', 'not_assigned') or has_pipeline_data"
                            help="Disabled when the task already has pipeline data — use Rerun Pipeline instead."/>
                    <button name="action_run_pipeline" type="object"
                            string="Run via API Gateway" class="btn-secondary"
                            invisible="state not in ('draft', 'not_assigned') or not is_admin or has_pipeline_data"
                            help="Spec-compliant trigger: POST /run with X-Api-Key. Configure gohan.lambda_api_url + gohan.lambda_api_key first. Hidden when the task already has pipeline data — use Rerun Pipeline instead."/>

                    <!-- EXTRACTED: manual review gate — tasker triggers PRD generation -->
                    <!-- "Generate PRD" runs the whole rest (generate→score→QC→done). -->
                    <button name="action_generate_prd" type="object"
                            string="Generate PRD" class="oe_highlight"
                            invisible="state != 'extracted'"
                            help="Review the extraction assets in the Extraction Review tab, then generate the PRD from the ticked assets."/>

                    <!-- Staged run: step through Generate → Score → Run QC one
                         stage at a time, each pausing for review. -->
                    <button name="action_stage_generate" type="object"
                            string="Generate" class="btn-primary"
                            invisible="state != 'extracted'"
                            help="Staged run: generate the PRD only, then pause at 'Generated' for you to Score."/>
                    <button name="action_stage_score" type="object"
                            string="Score" class="oe_highlight"
                            invisible="state != 'generated'"
                            help="Score the generated PRD against the rubric, then pause at 'Scored'."/>
                    <button name="action_stage_qc" type="object"
                            string="Run QC" class="oe_highlight"
                            invisible="state != 'scored'"
                            help="Run QC on the scored PRD, then complete the job."/>

                    <!-- DONE: Primary actions -->
                    <button name="action_download_zip" type="object"
                            string="Download ZIP" class="oe_highlight"
                            invisible="state != 'done' or not prd_text"/>
                    <button name="action_mark_submitted" type="object"
                            string="Submit" class="btn-success"
                            invisible="state != 'done'"
                            confirm="Submit this task? This is final and cannot be undone."/>

                    <!-- DONE: Rerun (opens wizard with extraction context) -->
                    <button name="action_open_rerun_wizard" type="object"
                            string="Rerun Pipeline" class="btn-secondary"
                            invisible="state != 'done'"/>

                    <!-- FAILED / CANCELLED: Retry -->
                    <button name="action_retry" type="object"
                            string="Retry" class="oe_highlight"
                            invisible="state != 'failed'"/>

                    <!-- DISCARD: any state except already-discarded; both admin and tasker -->
                    <button name="action_discard" type="object"
                            string="Discard" class="btn-secondary"
                            invisible="state == 'discarded'"
                            confirm="Discard this task as unusable? Terminal — but it can be brought back via Assign."/>

                    <!-- CANCEL / RESET: while running OR parked mid-staged-run -->
                    <button name="action_cancel" type="object"
                            string="Cancel / Reset"
                            invisible="state not in ('extracting','generating','scoring','generated','scored')"
                            confirm="Stop this task and return it to Draft?"/>

                    <!-- ASSIGN: bring a discarded task back as a Draft -->
                    <button name="action_reopen" type="object"
                            string="Assign" class="oe_highlight"
                            invisible="state != 'discarded'"/>

                    <button name="action_release_task" type="object"
                            string="Release Task" class="btn-secondary"
                            invisible="not is_admin or state not in ('draft', 'done', 'failed')"
                            confirm="Release this task back to the unassigned pool?"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,extracting,extracted,generating,generated,scoring,scored,done,submitted"/>
                </header>

                <!-- Pipeline progress (timing indicator) -->
                <field name="stage_progress_html" readonly="1" nolabel="1"
                       invisible="state not in ('extracting','generating','scoring','done','submitted','failed')"
                       class="w-100 px-3 pt-2"/>

                <sheet>
                    <!-- ===== STATE BANNERS ===== -->

                    <!-- Not Assigned -->
                    <div class="alert alert-secondary" role="alert" invisible="state != 'not_assigned'">
                        <strong>Unassigned</strong> -- Click <em>Run Pipeline</em> to claim and process, or assign a user below.
                    </div>

                    <!-- In Progress -->
                    <div class="alert alert-info" role="alert" invisible="state not in ('extracting','generating','scoring')">
                        <strong>Pipeline Running</strong> -- The system is processing this task. This page will update automatically.
                    </div>

                    <!-- Partial extraction: warnings, NOT a failure -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not extraction_warnings or state in ('failed','discarded','not_assigned')">
                        <strong>Partial Extraction</strong> -- extraction succeeded with warnings; the tasker may need to supply assets manually:
                        <field name="extraction_warnings" readonly="1" nolabel="1" class="d-block mt-1"/>
                    </div>

                    <!-- Extracted: manual review gate -->
                    <div class="alert alert-warning" role="alert" invisible="state != 'extracted'">
                        <strong>Awaiting Review</strong> -- extraction is complete. Open the
                        <em>Extraction Review</em> tab to verify the screenshots and SVG icons:
                        remove anything unwanted, upload your own SVGs, then click
                        <em>Generate PRD</em>. The PRD will <strong>not</strong> generate automatically.
                    </div>

                    <!-- Done: QC Passed -->
                    <div class="alert alert-success" role="alert" invisible="state != 'done' or qc_verdict != 'shippable'">
                        <strong>Ready for Review</strong> -- QC passed. Review the PRD, then Download ZIP or Submit.
                    </div>

                    <!-- Done: QC Failed -->
                    <div class="alert alert-warning" role="alert" invisible="state != 'done' or qc_verdict == 'shippable'">
                        <strong>QC Failed</strong> -- PRD needs work. Edit it directly, regenerate using QC feedback, or rerun the pipeline.
                    </div>

                    <!-- Failed -->
                    <div class="alert alert-danger" role="alert" invisible="state != 'failed'">
                        <strong>Failed</strong> -- <field name="error_message" readonly="1" nolabel="1" class="d-inline"/>
                        <span class="ms-2">Click <em>Retry</em> to try again.</span>
                    </div>


                    <!-- Submitted (locked) -->
                    <div class="alert alert-success" role="alert" invisible="state != 'submitted'">
                        <strong>Submitted</strong> -- This task has been delivered. No further changes allowed.
                    </div>

                    <!-- Discarded (terminal) -->
                    <div class="alert alert-dark" role="alert" invisible="state != 'discarded'">
                        <strong>Discarded</strong> -- marked unusable (nothing extracted or site unsuitable).
                        Use <em>Assign</em> to bring it back into the workflow.
                    </div>

                    <!-- ===== TITLE + SUMMARY ===== -->
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group>
                            <!-- URL: tasker always readonly; admin always editable -->
                            <field name="url" widget="url" readonly="not is_admin and id"/>
                            <field name="site_name" readonly="1"/>
                            <!-- Category: editable for both admin and tasker at all times -->
                            <field name="category_id"/>
                            <field name="target_resolution" readonly="not is_admin"/>
                            <field name="auth_gated" readonly="not is_admin"/>
                            <field name="marketing_url_pass" widget="url" readonly="not is_admin" invisible="not auth_gated"/>
                            <field name="user_id"
                                   readonly="not is_admin or state not in ('not_assigned', 'draft')"
                                   options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="notes" placeholder="Internal notes — not sent to the pipeline." readonly="not is_admin"/>
                        </group>
                        <group>
                            <field name="score_display" readonly="1"/>
                            <field name="score_max" readonly="1"/>
                            <field name="grade" readonly="1"/>
                            <field name="qc_verdict" readonly="1"/>
                            <field name="eq_tier" readonly="1"/>
                            <field name="mode" readonly="1"/>
                            <field name="duration_seconds" readonly="1" string="Duration (s)"/>
                            <field name="ready_for_submission" readonly="1" invisible="state != 'done'"/>
                        </group>
                    </group>

                    <!-- ===== TABS ===== -->
                    <notebook>

                        <!-- ============================== -->
                        <!-- TAB 1: PRD                     -->
                        <!-- ============================== -->
                        <page string="PRD" invisible="not prd_text">
                            <!-- Action buttons: only on done state -->
                            <div class="mb-2" invisible="state != 'done'">
                                <button name="action_regenerate_with_qc_feedback" type="object"
                                        string="Regenerate PRD" class="btn btn-sm btn-warning me-1"
                                        confirm="Regenerate PRD using QC feedback? Current PRD will be replaced."/>
                            </div>

                            <!-- Formatted PRD: read-only, rendered from the Markdown below -->
                            <separator string="PRD (Formatted)"/>
                            <field name="prd_text_html" widget="html" readonly="1" nolabel="1"/>

                            <!-- Markdown PRD: the editable source. Edit here and Save;
                                 the formatted view above re-renders from it. -->
                            <separator string="PRD (Markdown - editable)"/>
                            <field name="prd_text" readonly="state != 'done'" nolabel="1"
                                   placeholder="Markdown PRD source."/>
                        </page>

                        <!-- ============================== -->
                        <!-- TAB 2: Quality                 -->
                        <!-- ============================== -->
                        <page string="Quality" invisible="not qc_report">
                            <!-- Action buttons: both admin and tasker on done -->
                            <div class="mb-3" invisible="state != 'done'">
                                <button name="action_rerun_qc" type="object"
                                        string="Rerun QC" class="btn btn-sm btn-info me-1"
                                        confirm="Re-evaluate QC on the current PRD?"/>
                                <button name="action_regenerate_with_qc_feedback" type="object"
                                        string="Regenerate PRD with Feedback" class="btn btn-sm btn-warning me-1"
                                        invisible="qc_verdict == 'shippable'"
                                        confirm="Regenerate PRD using QC feedback?"/>
                            </div>

                            <!-- QC Verdict Banners -->
                            <div class="alert alert-success mb-3" role="alert" invisible="qc_verdict != 'shippable'">
                                <strong>SHIPPABLE</strong> -- PRD passed all quality checks.
                            </div>
                            <div class="alert alert-danger mb-3" role="alert" invisible="qc_verdict != 'not_shippable'">
                                <strong>NOT SHIPPABLE</strong> -- Review the issues below and regenerate or edit.
                            </div>

                            <!-- QC Report (markdown rendered to HTML) -->
                            <field name="qc_report_html" readonly="1" nolabel="1"
                                   invisible="not qc_report"/>
                        </page>

                        <!-- ============================== -->
                        <!-- TAB 3: Routes                   -->
                        <!-- ============================== -->
                        <!-- Shows the product's discovered route map: the
                             same-site URL surface (path, screen type, title)
                             extracted by the Lambda, rendered as one table.
                             The frontend "Assets" tab below is intentionally
                             kept invisible-when-empty so blocked-site jobs
                             (Turo) don't show it. -->
                        <page string="Routes" invisible="not routes_html">
                            <div class="mb-3" invisible="state != 'done'">
                                <button name="action_open_rerun_wizard" type="object"
                                        string="Re-extract Website" class="btn btn-sm btn-secondary"
                                        confirm="Re-extract this website? Opens the rerun wizard."/>
                            </div>
                            <field name="routes_html" widget="html"
                                   readonly="1" nolabel="1" sanitize="False"/>
                        </page>

                        <!-- ============================== -->
                        <!-- TAB 4: Assets (frontend, optional) -->
                        <!-- ============================== -->
                        <!-- ====================================== -->
                        <!-- Extraction Review — manual curation gate -->
                        <!-- ====================================== -->
                        <page string="Extraction Review" name="extraction_review"
                              invisible="state in ('not_assigned','draft','extracting')">
                            <div class="alert alert-info" role="status"
                                 invisible="state != 'extracted'">
                                Verify the screenshots and SVG icons captured by the extraction Lambda.
                                Remove anything unwanted with the <strong>✕</strong> on its row, or use
                                <strong>Add a line</strong> to upload your own SVG icons. Only rows with
                                <strong>Use in PRD</strong> ticked are sent to PRD generation — when the
                                assets look right, click <strong>Generate PRD</strong> in the header.
                            </div>
                            <field name="asset_ids" readonly="state != 'extracted'">
                                <list editable="bottom" decoration-muted="not include_in_prd">
                                    <field name="sequence" widget="handle"/>
                                    <field name="preview_html" widget="html" readonly="1" string="Preview"/>
                                    <field name="name"/>
                                    <field name="asset_type"/>
                                    <field name="source" readonly="1" optional="show"/>
                                    <field name="is_copyright_safe" readonly="1" optional="hide"/>
                                    <field name="file_name" column_invisible="1"/>
                                    <field name="file_data" filename="file_name" string="Upload"/>
                                    <field name="content_text" column_invisible="1"/>
                                    <field name="notes" optional="hide"/>
                                    <field name="include_in_prd" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>

                        <page string="Assets" invisible="not screenshot_keys and not asset_keys">
                            <!-- Re-extract: available to both admin and tasker on done -->
                            <div class="mb-3" invisible="state != 'done'">
                                <button name="action_open_rerun_wizard" type="object"
                                        string="Re-extract Website" class="btn btn-sm btn-secondary"
                                        confirm="Re-extract this website? Opens the rerun wizard."/>
                            </div>

                            <!-- Extraction Summary (like Quality tab score breakdown) -->
                            <field name="asset_score_html" readonly="1" nolabel="1"
                                   invisible="not screenshot_keys and not asset_keys"/>

                            <group string="Screenshots" invisible="not screenshot_keys">
                                <field name="screenshot_urls_html" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Collected Assets" invisible="not asset_keys">
                                <field name="asset_urls_html" readonly="1" nolabel="1"/>
                            </group>
                        </page>

                        <!-- ============================== -->
                        <!-- TAB 4: Pipeline (admin only)   -->
                        <!-- ============================== -->
                        <page string="Pipeline" invisible="not is_admin">
                            <group>
                                <group string="Timing">
                                    <field name="started_at" readonly="1"/>
                                    <field name="completed_at" readonly="1"/>
                                    <field name="duration_seconds" readonly="1"/>
                                    <field name="last_heartbeat" readonly="1"/>
                                </group>
                                <group string="Extraction">
                                    <field name="page_count" readonly="1"/>
                                    <field name="tech_stack" readonly="1"/>
                                    <field name="llm_attempts" readonly="1"/>
                                    <field name="via_batch" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <group string="Run Metadata (spec)">
                                    <field name="lambda_request_id" readonly="1"/>
                                    <field name="s3_artifact_prefix" readonly="1"/>
                                </group>
                                <group string="QC Breakdown" invisible="state != 'done'">
                                    <field name="qc_critical_count" readonly="1"/>
                                    <field name="qc_high_count" readonly="1"/>
                                    <field name="qc_medium_count" readonly="1"/>
                                </group>
                            </group>
                            <group string="Deliverable (spec)" invisible="state not in ('done', 'submitted')">
                                <field name="word_count" readonly="1"/>
                                <field name="references_count" readonly="1"/>
                                <field name="page_assets_count" readonly="1"/>
                                <field name="s3_zip_url" widget="url" readonly="1"/>
                            </group>
                            <group string="Links" invisible="not prd_url and not deliverables_url">
                                <field name="prd_url" widget="url" readonly="1"/>
                                <field name="deliverables_url" widget="url" readonly="1"/>
                            </group>
                            <group string="Error" invisible="not error_message">
                                <field name="error_message" readonly="1" nolabel="1"/>
                            </group>
                            <!-- Extraction Data (sent to LLM) — rendered as Markdown HTML.
                                 Raw prd_prompt field is kept hidden so the
                                 `invisible="not prd_prompt"` conditions still resolve. -->
                            <field name="prd_prompt" invisible="1"/>
                            <separator string="Extraction Data (sent to LLM)" invisible="not prd_prompt"/>
                            <field name="prd_prompt_html" widget="html" readonly="1" nolabel="1" invisible="not prd_prompt"/>
                            <separator string="Site Discovery" invisible="not site_discovery_json"/>
                            <field name="site_discovery_json" widget="json_pretty" readonly="1" nolabel="1" invisible="not site_discovery_json"/>

                            <!-- Monitoring: what the Lambda + LLM actually did -->
                            <separator string="Pipeline Log — step-by-step journal of every phase" invisible="not pipeline_log_json"/>
                            <field name="pipeline_log_json" widget="json_pretty" readonly="1" nolabel="1" invisible="not pipeline_log_json"/>
                            <separator string="Extraction Warnings" invisible="not extraction_warnings"/>
                            <field name="extraction_warnings" widget="json_pretty" readonly="1" nolabel="1" invisible="not extraction_warnings"/>
                            <separator string="Lambda Callback — status, phase log, extraction summary" invisible="not lambda_callback_json"/>
                            <field name="lambda_callback_json" widget="json_pretty" readonly="1" nolabel="1" invisible="not lambda_callback_json"/>
                            <separator string="LLM Trace — every PRD attempt + QC" invisible="not llm_trace_json"/>
                            <field name="llm_trace_json" widget="json_pretty" readonly="1" nolabel="1" invisible="not llm_trace_json"/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SEARCH VIEW                                                  -->
    <!-- ============================================================ -->

    <record id="gohan_job_view_search" model="ir.ui.view">
        <field name="name">gohan.job.search</field>
        <field name="model">gohan.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="url"/>
                <field name="site_name"/>
                <field name="category_id"/>
                <filter name="my_tasks" string="My Tasks" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="not_assigned" string="Not Assigned" domain="[('state','=','not_assigned')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','in',('extracting','generating','scoring'))]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="qc_failed" string="QC Failed" domain="[('qc_verdict','=','not_shippable')]"/>
                <filter name="qc_pending" string="QC Pending" domain="[('qc_verdict','=','pending')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <separator/>
                <filter name="auth_gated" string="Auth-Gated" domain="[('auth_gated','=',True)]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_category" string="Category" context="{'group_by':'category_id'}"/>
                    <filter name="group_user" string="Tasker" context="{'group_by':'user_id'}"/>
                    <filter name="group_qc" string="QC Verdict" context="{'group_by':'qc_verdict'}"/>
                    <filter name="group_eq_tier" string="EQ Tier" context="{'group_by':'eq_tier'}"/>
                    <filter name="group_mode" string="Mode" context="{'group_by':'mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- WINDOW ACTIONS                                               -->
    <!-- ============================================================ -->

    <!-- Admin: All Tasks -->
    <record id="action_gohan_job" model="ir.actions.act_window">
        <field name="name">All Tasks</field>
        <field name="res_model">gohan.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="gohan_job_view_search"/>
        <field name="context">{}</field>
    </record>

    <!-- Tasker: My Tasks -->
    <record id="action_gohan_job_tasker" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">gohan.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="gohan_job_view_search"/>
        <field name="context">{'search_default_my_tasks': 1, 'default_user_id': uid}</field>
    </record>

    <!-- Bind tasker list view -->
    <record id="action_gohan_job_tasker_tree" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="gohan_job_tasker_view_tree"/>
        <field name="act_window_id" ref="action_gohan_job_tasker"/>
    </record>

    <!-- ============================================================ -->
    <!-- SERVER ACTIONS (gear menu)                                   -->
    <!-- ============================================================ -->

    <!-- Run Selected as Concurrent Batch (admin, list) -->
    <record id="action_gohan_run_batch_concurrent" model="ir.actions.server">
        <field name="name">Run Batch (Parallel)</field>
        <field name="model_id" ref="model_gohan_job"/>
        <field name="binding_model_id" ref="model_gohan_job"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_run_batch_concurrent()</field>
        <field name="group_ids" eval="[(4, ref('gohan.group_gohan_admin'))]"/>
    </record>

    <!-- Reset Selected (admin, list) -->
    <record id="action_gohan_reset_selected" model="ir.actions.server">
        <field name="name">Reset Selected</field>
        <field name="model_id" ref="model_gohan_job"/>
        <field name="binding_model_id" ref="model_gohan_job"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_reset_selected()</field>
        <field name="group_ids" eval="[(4, ref('gohan.group_gohan_admin'))]"/>
    </record>

    <!-- Retry Failed Selected (admin, list) — smart retry preserving tasker -->
    <record id="action_gohan_retry_failed_batch" model="ir.actions.server">
        <field name="name">Retry Failed</field>
        <field name="model_id" ref="model_gohan_job"/>
        <field name="binding_model_id" ref="model_gohan_job"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_retry_failed_batch()</field>
        <field name="group_ids" eval="[(4, ref('gohan.group_gohan_admin'))]"/>
    </record>

</odoo>
