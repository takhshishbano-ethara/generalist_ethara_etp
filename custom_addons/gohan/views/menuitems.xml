<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_gohan_root"
              name="Gohan"
              sequence="100"
              groups="group_gohan_user"
              web_icon="gohan,static/description/icon.png"/>

    <!-- Admin sees "All Tasks" (all, can create) -->
    <menuitem id="menu_gohan_jobs_admin"
              name="All Tasks"
              parent="menu_gohan_root"
              action="action_gohan_job"
              sequence="10"
              groups="group_gohan_admin"/>

    <!-- Tasker sees "My Tasks" (own tasks, Start Task button in list header) -->
    <menuitem id="menu_gohan_jobs_tasker"
              name="My Tasks"
              parent="menu_gohan_root"
              action="action_gohan_job_tasker"
              sequence="11"
              groups="group_gohan_user"/>

    <!-- "New Task" — pick a category, get a website auto-assigned.
         Odoo 19's menuitem parser does NOT support the "!group" negation
         syntax that works for view fields, so we cannot mechanically hide
         this from admins who inherit group_gohan_user via implied_ids.
         Admin sees this entry too — harmless (clicking it just creates a
         draft gohan.job for them as well). To hide it from admin we'd need
         a separate non-inherited "tasker-only" group. -->
    <menuitem id="menu_gohan_website_pick"
              name="New Task"
              parent="menu_gohan_root"
              action="action_gohan_website_pick_wizard"
              sequence="15"
              groups="group_gohan_user"/>

    <!-- Admin-only: single "Upload Data" tab.
         Opens the sheets list — admin sees status counts per sheet, drills
         into any sheet to manage individual URLs, and uses the "Upload Sheet"
         header button (on the list view) to launch the upload wizard. -->
    <menuitem id="menu_gohan_website_sheets_root"
              name="Upload Data"
              parent="menu_gohan_root"
              action="action_gohan_website_sheet"
              sequence="20"
              groups="group_gohan_admin"/>

    <menuitem id="menu_gohan_config"
              name="Configuration"
              parent="menu_gohan_root"
              sequence="90"
              groups="group_gohan_admin"/>

    <menuitem id="menu_gohan_import"
              name="Import URLs"
              parent="menu_gohan_config"
              action="action_gohan_import_wizard"
              sequence="5"/>

    <menuitem id="menu_gohan_add_category"
              name="Add Category"
              parent="menu_gohan_config"
              action="action_gohan_category_new"
              sequence="7"/>

    <menuitem id="menu_gohan_settings"
              name="Settings"
              parent="menu_gohan_config"
              action="base_setup.action_general_configuration"
              sequence="10"/>
</odoo>
