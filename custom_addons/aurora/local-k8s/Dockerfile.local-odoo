FROM aurora-worker:local

USER root

RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ make && rm -rf /var/lib/apt/lists/*

COPY odoo-requirements.txt /tmp/odoo-requirements.txt
RUN pip install --no-cache-dir -r /tmp/odoo-requirements.txt && rm /tmp/odoo-requirements.txt

USER odoo

CMD ["python", "/opt/odoo/odoo-bin", "--config=/etc/odoo/odoo.conf"]
