FROM aurora-worker:local

USER root

# Install full Odoo runtime deps from src/requirements.txt
COPY src/requirements.txt /tmp/odoo-src-requirements.txt

RUN grep -v -E "python-ldap|pyusb|pyserial|language-tool-python|psycopg2==" /tmp/odoo-src-requirements.txt > /tmp/filtered-requirements.txt \
    && pip install --no-cache-dir -r /tmp/filtered-requirements.txt \
    && rm /tmp/odoo-src-requirements.txt /tmp/filtered-requirements.txt

USER odoo

CMD ["python", "/opt/odoo/odoo-bin", "--config=/etc/odoo/odoo.conf"]