<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--                    Module Category                           -->
    <!-- ============================================================ -->
    <data noupdate="0">
        <record id="module_category_aurora" model="ir.module.category">
            <field name="name">Aurora Pipeline</field>
            <field name="sequence">120</field>
        </record>

        <record id="aurora_privilege" model="res.groups.privilege">
            <field name="name">Aurora Pipeline</field>
            <field name="category_id" ref="module_category_aurora"/>
            <field name="sequence">1</field>
        </record>
    </data>

    <!-- ============================================================ -->
    <!--                    Security Groups                           -->
    <!-- ============================================================ -->
    <data noupdate="1">
        <record id="group_aurora_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="aurora_privilege"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_aurora_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="aurora_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_aurora_user'))]"/>
        </record>
    </data>

    <!-- ============================================================ -->
    <!--                    Record Rules                              -->
    <!-- ============================================================ -->
    <data noupdate="1">
        <record id="aurora_pipeline_rule_user" model="ir.rule">
            <field name="name">Aurora Pipeline: User sees own</field>
            <field name="model_id" ref="model_aurora_pipeline"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_aurora_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="aurora_pipeline_rule_admin" model="ir.rule">
            <field name="name">Aurora Pipeline: Admin sees all</field>
            <field name="model_id" ref="model_aurora_pipeline"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_aurora_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>

</odoo>
