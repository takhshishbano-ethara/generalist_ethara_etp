<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="aurora.AuroraStatusbar">
        <div class="aurora-progress-bar">
            <div class="aurora-progress-track">
                <div class="aurora-progress-fill" t-attf-style="width: {{progressPercent}}%"/>
            </div>
            <div class="aurora-progress-steps">
                <t t-foreach="steps" t-as="step" t-key="step.value">
                    <div t-attf-class="aurora-progress-step aurora-progress-step-{{stepState(step)}}">
                        <div class="aurora-progress-dot">
                            <i t-if="stepState(step) === 'done'" class="fa fa-check" title="Done"/>
                            <i t-elif="stepState(step) === 'current'" class="fa fa-circle" title="Current"/>
                            <i t-elif="stepState(step) === 'failed'" class="fa fa-times" title="Failed"/>
                            <span t-else="" class="aurora-progress-dot-num" t-esc="step_index + 1"/>
                        </div>
                        <span class="aurora-progress-label" t-esc="step.label"/>
                    </div>
                </t>
            </div>
            <div t-if="isFailed" class="aurora-progress-failed-badge">
                <i class="fa fa-exclamation-triangle" title="Failed"/> Failed
            </div>
        </div>
    </t>
</templates>
