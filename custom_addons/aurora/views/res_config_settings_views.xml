<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aurora_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">aurora.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Aurora Pipeline"
                     string="Aurora Pipeline"
                     name="aurora"
                     groups="aurora.group_aurora_admin">

                    <block title="Output &amp; Cache">
                        <setting string="Output Directory"
                                 help="Filesystem path for intermediate JSONL files.">
                            <field name="aurora_output_dir"/>
                        </setting>
                        <setting string="Clone Cache Directory"
                                 help="Bare-clone cache used by git operations.">
                            <field name="aurora_cache_dir"/>
                        </setting>
                    </block>

                    <block title="Pipeline Tunables">
                        <setting string="Delay on Error (seconds)">
                            <field name="aurora_delay_on_error"/>
                        </setting>
                        <setting string="Retry Attempts">
                            <field name="aurora_retry_attempts"/>
                        </setting>
                        <setting string="Max Tags">
                            <field name="aurora_max_tags"/>
                        </setting>
                        <setting string="Window Days"
                                 help="Date-range fallback window for PR-to-tag attribution.">
                            <field name="aurora_window_days"/>
                        </setting>
                    </block>

                    <block title="Language Detection">
                        <setting string="Detection Mode"
                                 help="Automatic: detect the repo's primary language via GitHub API when pipeline starts. Manual: use the dropdown below.">
                            <field name="aurora_lang_detection_mode" widget="radio"/>
                        </setting>
                        <setting string="Language Label"
                                 help="Used only when Detection Mode is Manual."
                                 invisible="aurora_lang_detection_mode == 'automatic'">
                            <field name="aurora_lang"/>
                        </setting>
                    </block>

                    <block title="Concurrency">
                        <setting string="Max Active Pipeline Runs">
                            <field name="aurora_max_active_tasks"/>
                        </setting>
                    </block>

                    <block title="Webhook">
                        <setting string="Webhook Base URL"
                                 help="Base URL where k8s worker pods POST pipeline progress. Must be reachable from K8s pods. Falls back to web.base.url if not set. Can also be set via AURORA_WEBHOOK_URL env var (takes priority).">
                            <field name="aurora_webhook_url" placeholder="http://odoo-service.aurora.svc.cluster.local:8069"/>
                        </setting>
                    </block>

                    <block title="Harness Git Sync">
                        <setting string="Harness Git Repo"
                                 help="owner/repo slug for the multi-swe-bench harness. UI uploads are committed here; worker pods sync from here.">
                            <field name="aurora_harness_git_repo" placeholder="EtharaAI/multi-swe-bench"/>
                        </setting>
                        <setting string="Harness Git Branch"
                                 help="Branch of the harness repo to read and write.">
                            <field name="aurora_harness_git_branch" placeholder="main"/>
                        </setting>
                        <setting string="GitHub Registry Write Token"
                                 help="GitHub Personal Access Token (PAT) with contents:write scope on the harness repo. Used to commit UI-uploaded registry files. Encrypted at rest.">
                            <field name="aurora_github_registry_write_token" password="True"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>
</odoo>
