<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="aurora_import_dataset_wizard_form" model="ir.ui.view">
        <field name="name">aurora.import.dataset.wizard.form</field>
        <field name="model">aurora.import.dataset.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Dataset JSONL">
                <group>
                    <field name="evaluation_id" invisible="1"/>
                    <field name="jsonl_file" widget="binary" filename="jsonl_filename"
                           help="Upload a .jsonl file. Each line must be a valid JSON object."/>
                    <field name="jsonl_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
