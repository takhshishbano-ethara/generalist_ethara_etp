<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="aurora_pipeline_view_list" model="ir.ui.view">
        <field name="name">aurora.pipeline.list</field>
        <field name="model">aurora.pipeline</field>
        <field name="arch" type="xml">
            <list string="Pipeline Runs" default_order="id desc"
                  decoration-success="stage == 'done'"
                  decoration-danger="stage == 'failed'"
                  decoration-info="stage not in ('draft','done','failed')">
                <field name="name"/>
                <field name="github_org"/>
                <field name="github_repo"/>
                <field name="detected_lang" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="stage" widget="badge"
                       decoration-success="stage == 'done'"
                       decoration-danger="stage == 'failed'"
                       decoration-info="stage not in ('draft','done','failed')"
                       decoration-muted="stage == 'draft'"/>
                <field name="phase1_status" widget="badge" string="P1"
                       decoration-success="phase1_status == 'done'"
                       decoration-danger="phase1_status == 'failed'"
                       decoration-info="phase1_status == 'running'"
                       optional="show"/>
                <field name="dataset_count" optional="hide"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="aurora_pipeline_view_form" model="ir.ui.view">
        <field name="name">aurora.pipeline.form</field>
        <field name="model">aurora.pipeline</field>
        <field name="arch" type="xml">
            <form string="Pipeline Run" class="aurora-pipeline-form">
                <header>
                    <button name="action_run_pipeline" string="Run Pipeline" type="object"
                            class="btn-primary" invisible="stage != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            class="btn-secondary" invisible="stage in ('draft', 'done', 'failed')" confirm="Cancel this pipeline run?"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            class="btn-secondary" invisible="stage not in ('done', 'failed')"/>
                    <field name="stage" widget="aurora_statusbar"
                           statusbar_visible="draft,fetch_prs,filter_prs,discover_tags,group_prs,fetch_issues,build_dataset,done"/>
                </header>

                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="is_admin" invisible="1"/>
                    <field name="use_s3" invisible="1"/>
                    <field name="phase2_has_registry" invisible="1"/>
                    <field name="step1_file" invisible="1"/>
                    <field name="step2_file" invisible="1"/>
                    <field name="step3_file" invisible="1"/>
                    <field name="step4_file" invisible="1"/>
                    <field name="step5_file" invisible="1"/>
                    <field name="step6_file" invisible="1"/>
                    <field name="stage" widget="aurora_auto_refresh" nolabel="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-download"
                                type="object" name="action_download_dataset"
                                invisible="not dataset_url">
                            <field name="dataset_count" string="Records" widget="statinfo"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Failed" bg_color="text-bg-danger" invisible="stage != 'failed'"/>
                    <widget name="web_ribbon" title="Done" bg_color="text-bg-success" invisible="stage != 'done'"/>

                    <div class="oe_title mb-3">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Done banner -->
                    <div class="aurora-done-banner" invisible="stage != 'done'">
                        <div class="aurora-done-icon"><i class="fa fa-check" title="Done"/></div>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#ecfdf5">Pipeline Complete</div>
                            <div style="font-size:12px;color:#6ee7b7">All steps finished. Download the dataset below.</div>
                        </div>
                    </div>

                    <!-- Failed banner -->
                    <div class="aurora-failed-banner" invisible="stage != 'failed'">
                        <div class="aurora-failed-icon"><i class="fa fa-times" title="Failed"/></div>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#fef2f2">Pipeline Failed</div>
                            <div style="font-size:12px;color:#fca5a5">Check the execution log below for details.</div>
                        </div>
                    </div>

                    <!-- Running banner -->
                    <div class="aurora-running-banner" invisible="stage in ('draft', 'done', 'failed')">
                        <div class="aurora-running-icon"><i class="fa fa-cog" title="Running"/></div>
                        <div class="aurora-running-text">
                            <div class="aurora-running-title"><field name="progress_text" nolabel="1" class="d-inline"/></div>
                            <div class="aurora-running-detail">Last heartbeat: <field name="last_heartbeat" nolabel="1" widget="datetime" class="d-inline"/></div>
                        </div>
                    </div>

                    <!-- ═══ STEP TIMELINE (6 steps) ═══ -->
                    <div class="aurora-pipe-timeline" invisible="stage == 'draft'">

                        <!-- Step 1: Fetch PRs -->
                        <div class="aurora-pipe-step aurora-pipe-step-locked" invisible="step1_status != 'idle'">
                            <div class="aurora-pipe-step-num">1</div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Fetch PRs</div>
                                <div class="aurora-pipe-step-sub">Waiting</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-active" invisible="step1_status != 'running'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-cog fa-spin" title="Running"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Fetch PRs</div>
                                <div class="aurora-pipe-step-sub"><field name="pr_count" nolabel="1" class="d-inline"/> PRs found</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-done" invisible="step1_status != 'done'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-check" title="Done"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Fetch PRs</div>
                                <div class="aurora-pipe-step-sub"><field name="pr_count" nolabel="1" class="d-inline"/> PRs</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-failed" invisible="step1_status != 'failed'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-times" title="Failed"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Fetch PRs</div>
                                <div class="aurora-pipe-step-sub">Failed</div>
                            </div>
                        </div>

                        <!-- Step 2: Filter PRs -->
                        <div class="aurora-pipe-step aurora-pipe-step-locked" invisible="step2_status != 'idle'">
                            <div class="aurora-pipe-step-num">2</div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Filter PRs</div>
                                <div class="aurora-pipe-step-sub">Waiting</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-active" invisible="step2_status != 'running'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-cog fa-spin" title="Running"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Filter PRs</div>
                                <div class="aurora-pipe-step-sub">Filtering…</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-done" invisible="step2_status != 'done'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-check" title="Done"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Filter PRs</div>
                                <div class="aurora-pipe-step-sub"><field name="filtered_pr_count" nolabel="1" class="d-inline"/> filtered</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-failed" invisible="step2_status != 'failed'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-times" title="Failed"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Filter PRs</div>
                                <div class="aurora-pipe-step-sub">Failed</div>
                            </div>
                        </div>

                        <!-- Step 3: Discover Tags -->
                        <div class="aurora-pipe-step aurora-pipe-step-locked" invisible="step3_status != 'idle'">
                            <div class="aurora-pipe-step-num">3</div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Discover Tags</div>
                                <div class="aurora-pipe-step-sub">Waiting</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-active" invisible="step3_status != 'running'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-cog fa-spin" title="Running"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Discover Tags</div>
                                <div class="aurora-pipe-step-sub">Scanning…</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-done" invisible="step3_status != 'done'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-check" title="Done"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Discover Tags</div>
                                <div class="aurora-pipe-step-sub"><field name="tag_count" nolabel="1" class="d-inline"/> tags</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-failed" invisible="step3_status != 'failed'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-times" title="Failed"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Discover Tags</div>
                                <div class="aurora-pipe-step-sub">Failed</div>
                            </div>
                        </div>

                        <!-- Step 4: Group PRs -->
                        <div class="aurora-pipe-step aurora-pipe-step-locked" invisible="step4_status != 'idle'">
                            <div class="aurora-pipe-step-num">4</div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Group PRs</div>
                                <div class="aurora-pipe-step-sub">Waiting</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-active" invisible="step4_status != 'running'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-cog fa-spin" title="Running"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Group PRs</div>
                                <div class="aurora-pipe-step-sub">Grouping…</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-done" invisible="step4_status != 'done'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-check" title="Done"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Group PRs</div>
                                <div class="aurora-pipe-step-sub"><field name="group_count" nolabel="1" class="d-inline"/> groups</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-failed" invisible="step4_status != 'failed'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-times" title="Failed"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Group PRs</div>
                                <div class="aurora-pipe-step-sub">Failed</div>
                            </div>
                        </div>

                        <!-- Step 5: Fetch Issues -->
                        <div class="aurora-pipe-step aurora-pipe-step-locked" invisible="step5_status != 'idle'">
                            <div class="aurora-pipe-step-num">5</div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Fetch Issues</div>
                                <div class="aurora-pipe-step-sub">Waiting</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-active" invisible="step5_status != 'running'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-cog fa-spin" title="Running"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Fetch Issues</div>
                                <div class="aurora-pipe-step-sub">Fetching…</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-done" invisible="step5_status != 'done'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-check" title="Done"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Fetch Issues</div>
                                <div class="aurora-pipe-step-sub"><field name="issue_count" nolabel="1" class="d-inline"/> issues</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-failed" invisible="step5_status != 'failed'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-times" title="Failed"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Fetch Issues</div>
                                <div class="aurora-pipe-step-sub">Failed</div>
                            </div>
                        </div>

                        <!-- Step 6: Build Dataset -->
                        <div class="aurora-pipe-step aurora-pipe-step-locked" invisible="step6_status != 'idle'">
                            <div class="aurora-pipe-step-num">6</div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Build Dataset</div>
                                <div class="aurora-pipe-step-sub">Waiting</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-active" invisible="step6_status != 'running'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-cog fa-spin" title="Running"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Build Dataset</div>
                                <div class="aurora-pipe-step-sub">Building…</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-done" invisible="step6_status != 'done'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-check" title="Done"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Build Dataset</div>
                                <div class="aurora-pipe-step-sub"><field name="dataset_count" nolabel="1" class="d-inline"/> records</div>
                            </div>
                        </div>
                        <div class="aurora-pipe-step aurora-pipe-step-failed" invisible="step6_status != 'failed'">
                            <div class="aurora-pipe-step-num"><i class="fa fa-times" title="Failed"/></div>
                            <div class="aurora-pipe-step-content">
                                <div class="aurora-pipe-step-title">Build Dataset</div>
                                <div class="aurora-pipe-step-sub">Failed</div>
                            </div>
                        </div>
                    </div>

                    <!-- ═══ FINAL DATASET (done) ═══ -->
                    <div class="aurora-config-panel" invisible="stage != 'done'">
                        <div class="aurora-config-header"><i class="fa fa-download" title="Download"/> Final Dataset</div>
                        <div class="aurora-config-body">
                            <group>
                                <field name="dataset_url" widget="url"/>
                                <field name="dataset_filename"/>
                            </group>
                        </div>
                    </div>

                    <!-- ═══ CONFIGURATION ═══ -->
                    <div class="aurora-config-panel">
                        <div class="aurora-config-header"><i class="fa fa-sliders" title="Configuration"/> Configuration</div>
                        <div class="aurora-config-body">
                            <group>
                                <group string="Repository">
                                    <field name="github_org"/>
                                    <field name="github_repo"/>
                                    <field name="skip_pr_fetch"/>
                                    <field name="detected_lang" invisible="stage == 'draft'"/>
                                </group>
                                <group string="Assignment">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </group>
                            </group>
                        </div>
                    </div>

                    <!-- ═══ EXECUTION LOG ═══ -->
                    <div class="aurora-eval-log" invisible="stage == 'draft'">
                        <div class="aurora-eval-log-header"><i class="fa fa-terminal" title="Log"/> Execution Log</div>
                        <div class="aurora-eval-log-body">
                            <field name="log" widget="text" readonly="1" nolabel="1"/>
                        </div>
                    </div>

                    <!-- ═══ OUTPUT PATHS ═══ -->
                    <div class="aurora-paths-panel" invisible="stage == 'draft'">
                        <div class="aurora-paths-header"><i class="fa fa-folder-open-o" title="Paths"/> Output Paths</div>
                        <div class="aurora-paths-body">
                            <group>
                                <field name="output_dir"/>
                                <field name="job_name" invisible="not is_admin or not job_name"/>
                                <field name="dataset_url" widget="url" invisible="not dataset_url"/>
                                <field name="dataset_filename" invisible="not dataset_filename"/>
                            </group>
                        </div>
                    </div>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="aurora_pipeline_view_search" model="ir.ui.view">
        <field name="name">aurora.pipeline.search</field>
        <field name="model">aurora.pipeline</field>
        <field name="arch" type="xml">
            <search string="Aurora Pipeline">
                <field name="name"/>
                <field name="github_org"/>
                <field name="github_repo"/>
                <field name="user_id"/>
                <filter string="My Runs" name="my_runs" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Running" name="running" domain="[('stage', 'not in', ['draft', 'done', 'failed'])]"/>
                <filter string="Done" name="done" domain="[('stage', '=', 'done')]"/>
                <filter string="Failed" name="failed" domain="[('stage', '=', 'failed')]"/>
                <group>
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage'}"/>
                    <filter string="Assigned To" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Organisation" name="group_org" context="{'group_by': 'github_org'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="aurora_pipeline_action" model="ir.actions.act_window">
        <field name="name">Pipeline Runs</field>
        <field name="res_model">aurora.pipeline</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="aurora_pipeline_view_search"/>
        <field name="domain">[('stage', 'in', ['draft', 'fetch_prs', 'filter_prs', 'discover_tags', 'group_prs', 'fetch_issues', 'build_dataset', 'done', 'failed'])]</field>
        <field name="context">{'search_default_my_runs': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start a new Aurora Pipeline run</p>
            <p>Configure a GitHub org/repo and run the full data-collection pipeline (Phase 1).</p>
        </field>
    </record>

</odoo>
