# Aurora pipeline worker — production EKS image (amd64).
# Minimal build: only Odoo core + Aurora deps. No PDF, image, LDAP, hardware.
# Build context: project root (../../..)
#
# Build:
#   docker build --platform linux/amd64 \
#     -f custom_addons/aurora/Dockerfile.worker \
#     -t 426628337772.dkr.ecr.ap-south-1.amazonaws.com/aurora-worker:latest .
#
# Push:
#   aws ecr get-login-password --region ap-south-1 | \
#     docker login --username AWS --password-stdin 426628337772.dkr.ecr.ap-south-1.amazonaws.com
#   docker push 426628337772.dkr.ecr.ap-south-1.amazonaws.com/aurora-worker:latest

FROM python:3.12-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libpq-dev \
    libxml2-dev libxslt1-dev \
    libssl-dev libffi-dev \
    libjpeg62-turbo-dev zlib1g-dev \
    build-essential gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN pip install --upgrade pip setuptools wheel \
    && pip install \
    'Babel>=2.9.1' \
    'chardet>=5.0' \
    'charset-normalizer>=3.0' \
    'docutils>=0.20' \
    'gevent>=24.2' \
    'greenlet>=3.0' \
    'idna>=3.6' \
    'Jinja2>=3.1' \
    'lxml>=5.2' \
    'MarkupSafe>=2.1' \
    'platformdirs>=4.0' \
    'polib>=1.1' \
    'psutil>=5.9' \
    'psycopg2-binary>=2.9' \
    'python-dateutil>=2.8' \
    'pytz>=2024.1' \
    'requests>=2.31' \
    'six>=1.17' \
    'typing_extensions>=4.10' \
    'urllib3>=2.0' \
    'Werkzeug>=3.0' \
    'certifi>=2024.2' \
    'passlib>=1.7' \
    'Pillow>=10.0' \
    'PyGithub>=2.1.0' \
    'unidiff>=0.7.0' \
    'boto3>=1.34' \
    'cryptography>=42.0' \
    'docker>=7.0' \
    'kubernetes>=29.0' \
    'tqdm>=4.60' \
    'GitPython>=3.1' \
    'dataclasses_json>=0.6' \
    'python-dotenv>=1.0' \
    'openpyxl>=3.1' \
    'packaging>=23.0'

# ---------- runtime stage ----------
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/odoo

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    postgresql-client \
    libpq5 \
    libxml2 libxslt1.1 \
    libssl3 \
    libffi8 \
    libjpeg62-turbo \
    zlib1g \
    ca-certificates \
    curl \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-buildx-plugin \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /opt/odoo

COPY src/ /opt/odoo/
COPY custom_addons/aurora/ /opt/odoo/custom_addons/aurora/

RUN chmod +x /opt/odoo/odoo-bin 2>/dev/null || true

RUN useradd -r -u 1000 -m -d /opt/odoo -s /usr/sbin/nologin odoo \
    && chown -R odoo:odoo /opt/odoo \
    && mkdir -p /tmp/repo_cache /tmp/aurora_output /tmp/odoo-data \
       /opt/multi-swe-bench/multi_swe_bench/harness/repos \
    && chown -R odoo:odoo /tmp/repo_cache /tmp/aurora_output /tmp/odoo-data \
       /opt/multi-swe-bench

USER odoo

CMD ["python", "/opt/odoo/custom_addons/aurora/worker/run_pipeline.py"]
