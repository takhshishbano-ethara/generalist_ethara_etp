# Aurora pipeline worker — production EKS image (amd64).
# Slim build: no wkhtmltopdf, playwright, libreoffice, or ML packages.
# Build context: project root (../../..)
#
# Build:
#   docker build --platform linux/amd64 \
#     -f custom_addons/aurora/Dockerfile.worker \
#     -t 426628337772.dkr.ecr.ap-south-1.amazonaws.com/aurora-worker:latest .
#
# Push:
#   aws ecr get-login-password --region ap-south-1 | \
#     docker login --username AWS --password-stdin 426628337772.dkr.ecr.ap-south-1.amazonaws.com
#   docker push 426628337772.dkr.ecr.ap-south-1.amazonaws.com/aurora-worker:latest

FROM python:3.12-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libpq-dev \
    libxml2-dev libxslt1-dev \
    libldap2-dev libsasl2-dev \
    libssl-dev libffi-dev \
    build-essential gcc \
    libjpeg-dev zlib1g-dev libpng-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY src/requirements.txt /tmp/requirements-full.txt
RUN grep -v -E '^(torch|playwright|transformers|tokenizers|datasets|evaluate|bert-score|safetensors|pyarrow|google-|langchain|langgraph|langsmith|anthropic|openai|Pikka|pika|tesseract|pytesseract|PyMuPDF|graphviz|svgling|svgwrite|tree-sitter|sympy|matplotlib|nltk|httpx\[|language.tool|--extra-index-url)' \
        /tmp/requirements-full.txt > /tmp/requirements.txt \
    && pip install --upgrade pip setuptools wheel \
    && pip install Babel>=2.9.1 \
    && pip install -r /tmp/requirements.txt

# ---------- runtime stage ----------
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/odoo

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    postgresql-client \
    libpq5 \
    libxml2 libxslt1.1 \
    libldap-2.5-0 libsasl2-2 \
    libssl3 \
    libjpeg62-turbo zlib1g libpng16-16 \
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /opt/odoo

COPY src/ /opt/odoo/
COPY custom_addons/aurora/ /opt/odoo/custom_addons/aurora/

RUN chmod +x /opt/odoo/odoo-bin 2>/dev/null || true

RUN useradd -r -m -d /opt/odoo -s /usr/sbin/nologin odoo \
    && chown -R odoo:odoo /opt/odoo \
    && mkdir -p /tmp/repo_cache /tmp/aurora_output /tmp/odoo-data \
    && chown -R odoo:odoo /tmp/repo_cache /tmp/aurora_output /tmp/odoo-data

USER odoo

CMD ["python", "/opt/odoo/custom_addons/aurora/worker/run_pipeline.py"]
