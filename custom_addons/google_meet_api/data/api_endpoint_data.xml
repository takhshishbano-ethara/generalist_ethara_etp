<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="endpoint_google_meet_config" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/config</field>
            <field name="note">Google Meet OAuth credentials + token status (GET/POST)</field>
        </record>
        <record id="endpoint_google_meet_authenticate" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/authenticate</field>
            <field name="note">Return the Google OAuth consent URL to open in a browser</field>
        </record>
        <record id="endpoint_google_meet_refresh_token" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/refresh_token</field>
            <field name="note">Refresh the Google API access token using the stored refresh token</field>
        </record>
        <record id="endpoint_google_meet_events" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/events</field>
            <field name="note">Calendar events with Google Meet (GET list / POST create)</field>
        </record>
        <record id="endpoint_google_meet_events_by_eid" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/events/&lt;int:eid&gt;</field>
            <field name="note">Calendar event detail (GET / PUT / DELETE)</field>
        </record>
        <record id="endpoint_google_meet_event_score" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/events/&lt;int:eid&gt;/score</field>
            <field name="note">Score-only update — skips Google Calendar sync (fixes 30s timeout when Google auth stale)</field>
        </record>
        <record id="endpoint_google_meet_interviews_schedule" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/interviews/schedule</field>
            <field name="note">Schedule an interview: creates event, generates Meet link, sends invite mails</field>
        </record>
        <record id="endpoint_google_meet_interview_reschedule" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/interviews/&lt;int:eid&gt;/reschedule</field>
            <field name="note">Reschedule an interview: update start/stop, notify attendees</field>
        </record>
        <record id="endpoint_google_meet_interview_cancel" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/interviews/&lt;int:eid&gt;/cancel</field>
            <field name="note">Cancel an interview: notify attendees + delete event (also removes from Google Calendar)</field>
        </record>
        <record id="endpoint_google_meet_candidates" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/candidates</field>
            <field name="note">List hr.applicant candidates (default: shortlisted via resume scan)</field>
        </record>
        <record id="endpoint_google_meet_interviewees" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/interviewees</field>
            <field name="note">List candidates who PASSED the assessment (ready for personal interview)</field>
        </record>
        <record id="endpoint_google_meet_interviewers" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/interviewers</field>
            <field name="note">List employees eligible to conduct interviews (filters: department_id, search)</field>
        </record>
        <record id="endpoint_google_meet_candidate_interviews" model="api.endpoint">
            <field name="url_pattern">/api/v1/google_meet/candidates/&lt;int:cid&gt;/interviews</field>
            <field name="note">Per-candidate interview history: past + upcoming events with Meet links, scores, rounds</field>
        </record>
        <record id="endpoint_evaluations" model="api.endpoint">
            <field name="url_pattern">/api/v1/evaluations</field>
            <field name="note">HRMS-clone: list + assign evaluations</field>
        </record>
        <record id="endpoint_evaluations_by_id" model="api.endpoint">
            <field name="url_pattern">/api/v1/evaluations/&lt;int:eid&gt;</field>
            <field name="note">HRMS-clone: evaluation detail</field>
        </record>
        <record id="endpoint_evaluations_submit" model="api.endpoint">
            <field name="url_pattern">/api/v1/evaluations/&lt;int:eid&gt;/submit</field>
            <field name="note">HRMS-clone: submit 5-dim scores + recommendation</field>
        </record>
        <record id="endpoint_evaluations_complete" model="api.endpoint">
            <field name="url_pattern">/api/v1/evaluations/&lt;int:eid&gt;/complete</field>
            <field name="note">HRMS-clone: complete PI round, set pi_score + final_verdict</field>
        </record>
        <record id="endpoint_evaluations_pms_score" model="api.endpoint">
            <field name="url_pattern">/api/v1/evaluations/&lt;int:eid&gt;/pms-score</field>
            <field name="note">HRMS-clone: set final PMS hiring score</field>
        </record>
        <record id="endpoint_evaluations_pi_bypass" model="api.endpoint">
            <field name="url_pattern">/api/v1/evaluations/&lt;int:eid&gt;/pi-bypass</field>
            <field name="note">HRMS-clone: bypass PI rounds</field>
        </record>
        <record id="endpoint_candidates_pi_bypass" model="api.endpoint">
            <field name="url_pattern">/api/v1/candidates/&lt;int:cid&gt;/pi-bypass</field>
            <field name="note">HRMS-clone: bypass PI by candidate id (creates evaluation if missing)</field>
        </record>
        <record id="endpoint_candidates_performance" model="api.endpoint">
            <field name="url_pattern">/api/v1/candidates/&lt;int:cid&gt;/performance</field>
            <field name="note">Performance tab: assessment + PI KPIs, final verdict, all assessments and PI rounds for a candidate</field>
        </record>
        <record id="endpoint_audit_logs" model="api.endpoint">
            <field name="url_pattern">/api/v1/audit-logs</field>
            <field name="note">HRMS-clone: audit trail of evaluation actions</field>
        </record>
        <record id="endpoint_pms_evaluations" model="api.endpoint">
            <field name="url_pattern">/api/v1/pms-evaluations</field>
            <field name="note">HRMS-clone: post-hire PMS reviews (list + create)</field>
        </record>
        <record id="endpoint_pms_evaluations_submit" model="api.endpoint">
            <field name="url_pattern">/api/v1/pms-evaluations/&lt;int:pid&gt;/submit</field>
            <field name="note">HRMS-clone: submit 12-metric PMS review</field>
        </record>
    </data>
</odoo>
