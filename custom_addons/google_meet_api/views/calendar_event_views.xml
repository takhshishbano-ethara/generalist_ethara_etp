<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_calendar_event_form_gm_actions" model="ir.ui.view">
        <field name="name">calendar.event.form.gm.actions</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(google_meet_api.action_google_meet_reschedule_wizard)d"
                            string="Reschedule"
                            type="action"
                            class="btn-primary"
                            context="{'default_event_id': id}"/>
                    <button name="%(google_meet_api.action_google_meet_cancel_wizard)d"
                            string="Cancel Interview"
                            type="action"
                            class="btn-danger"
                            context="{'default_event_id': id}"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Evaluation" invisible="not candidate_id">
                    <group>
                        <field name="candidate_id" readonly="1"/>
                        <field name="interview_round" readonly="1"/>
                        <field name="overall_score" widget="float" readonly="1"/>
                    </group>
                    <group string="Scores (1-10 each)">
                        <field name="technical_skills_score"/>
                        <field name="communication_score"/>
                        <field name="problem_solving_score"/>
                        <field name="cultural_fit_score"/>
                        <field name="attitude_motivation_score"/>
                    </group>
                    <group string="Notes">
                        <field name="evaluation_notes" nolabel="1" placeholder="Evaluation notes..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
