<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_meet_cancel_wizard_form" model="ir.ui.view">
        <field name="name">google.meet.cancel.wizard.form</field>
        <field name="model">google.meet.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Interview">
                <sheet>
                    <group>
                        <field name="event_id" readonly="1"/>
                        <field name="event_name" readonly="1"/>
                        <field name="event_start" readonly="1"/>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="comment" placeholder="Additional details (optional)"/>
                        <field name="notify_attendees"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cancel Interview" name="action_cancel" type="object" class="btn-danger" confirm="This will delete the event and remove it from Google Calendar. Continue?"/>
                    <button string="Keep it" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_google_meet_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Interview</field>
        <field name="res_model">google.meet.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="calendar.model_calendar_event"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
