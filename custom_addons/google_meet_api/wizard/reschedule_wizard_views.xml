<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_meet_reschedule_wizard_form" model="ir.ui.view">
        <field name="name">google.meet.reschedule.wizard.form</field>
        <field name="model">google.meet.reschedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Reschedule Interview">
                <sheet>
                    <group>
                        <field name="event_id" readonly="1"/>
                        <field name="current_start" readonly="1"/>
                    </group>
                    <group string="New Schedule">
                        <field name="new_scheduled_at"/>
                        <field name="new_duration_minutes"/>
                    </group>
                    <group>
                        <field name="notify_attendees"/>
                        <field name="reason" placeholder="Optional — will be sent to attendees"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Reschedule" name="action_reschedule" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_google_meet_reschedule_wizard" model="ir.actions.act_window">
        <field name="name">Reschedule Interview</field>
        <field name="res_model">google.meet.reschedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="calendar.model_calendar_event"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
