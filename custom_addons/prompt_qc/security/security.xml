<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_prompt_qc" model="ir.module.category">
        <field name="name">Prompt QC</field>
        <field name="sequence">22</field>
    </record>

    <record id="privilege_prompt_qc" model="res.groups.privilege">
        <field name="name">Prompt QC</field>
        <field name="category_id" ref="module_category_prompt_qc"/>
    </record>

    <record id="group_prompt_qc_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_prompt_qc"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create and run Prompt QC on own runs.</field>
    </record>

    <record id="group_prompt_qc_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_prompt_qc"/>
        <field name="implied_ids" eval="[(4, ref('group_prompt_qc_user'))]"/>
        <field name="comment">Full access: see and manage all Prompt QC runs.</field>
    </record>

    <!-- Give the base admin the admin group out of the box. -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('prompt_qc.group_prompt_qc_admin'))]"/>
    </record>

    <!-- Record rules: users see their own runs; admins see all. -->
    <record id="rule_prompt_qc_run_user_own" model="ir.rule">
        <field name="name">Prompt QC Run: user sees own</field>
        <field name="model_id" ref="model_prompt_qc_run"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_prompt_qc_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_prompt_qc_run_admin" model="ir.rule">
        <field name="name">Prompt QC Run: admin full access</field>
        <field name="model_id" ref="model_prompt_qc_run"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_prompt_qc_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
