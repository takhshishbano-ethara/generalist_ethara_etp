<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="prompt_qc.MarkdownField">
        <t t-if="props.readonly">
            <div class="o_field_prompt_qc_markdown o_field_widget o_field_prompt_qc_markdown_readonly">
                <div class="o_prompt_qc_markdown_content" t-out="renderedMarkup"/>
            </div>
        </t>
        <t t-else="">
            <div class="o_field_prompt_qc_markdown o_field_widget">
                <textarea
                    class="o_input o_field_text_input o_prompt_qc_markdown_input"
                    t-att-id="props.id"
                    t-att-placeholder="props.placeholder"
                    t-ref="textarea"
                    rows="10"
                />
            </div>
        </t>
    </t>

</templates>
