<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Runs every day at 11:00 AM IST (= 05:30 UTC; Odoo crons run in UTC). -->
        <record id="cron_daily_late_coming_report" model="ir.cron">
            <field name="name">Late Coming: Daily Report &amp; HR Alerts (11:00 IST)</field>
            <field name="model_id" ref="model_late_coming_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily_late_report()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:30:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- Runs every day at 11:30 AM IST (= 06:00 UTC). Alerts HR about
             employees who have exceeded the monthly late limit. -->
        <record id="cron_daily_late_limit_alert" model="ir.cron">
            <field name="name">Late Coming: Monthly Limit Exceeded Alert (11:30 IST)</field>
            <field name="model_id" ref="model_late_coming_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_late_limit_alert()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 06:00:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- Monthly late allowance (employee is "over limit" when lates &gt; this). -->
        <record id="param_max_late_per_month" model="ir.config_parameter">
            <field name="key">late_coming_report.max_late_per_month</field>
            <field name="value">3</field>
        </record>

    </data>
</odoo>
