<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="project_leviathan_external" model="project.project">
            <field name="name">Leviathan</field>
            <field name="project_classification">external</field>
            <field name="connected_table">leviathan.job</field>
            <field name="task_forge_status">live</field>
            <field name="non_stemp_project_status">production</field>
        </record>

        <record id="api_map_leviathan_overview" model="etp.external.project.api.map">
            <field name="project_id" ref="project_leviathan_external"/>
            <field name="table_name">Overview</field>
            <field name="field_name">overview</field>
            <field name="api_prefix">/v1/leviathan_ext/analytics/overview_dashboard?project_id=</field>
        </record>

        <record id="api_map_leviathan_team" model="etp.external.project.api.map">
            <field name="project_id" ref="project_leviathan_external"/>
            <field name="table_name">Team</field>
            <field name="field_name">team</field>
            <field name="api_prefix">/v1/leviathan_ext/leviathan_team_view?project_id=</field>
        </record>

        <record id="api_map_leviathan_analytics" model="etp.external.project.api.map">
            <field name="project_id" ref="project_leviathan_external"/>
            <field name="table_name">Analytics</field>
            <field name="field_name">analytics</field>
            <field name="api_prefix">/v1/leviathan_ext/analytics/dashboard?project_id=</field>
        </record>

        <record id="api_map_leviathan_tasks" model="etp.external.project.api.map">
            <field name="project_id" ref="project_leviathan_external"/>
            <field name="table_name">Tasks</field>
            <field name="field_name">tasks</field>
            <field name="api_prefix">/v1/leviathan_ext/leviathan_task_view?project_id=</field>
        </record>

        <record id="api_map_leviathan_urls_added" model="etp.external.project.api.map">
            <field name="project_id" ref="project_leviathan_external"/>
            <field name="table_name">URLs Added</field>
            <field name="field_name">urls_added</field>
            <field name="api_prefix">/v1/leviathan_ext/leviathan_urls_added_task_view?project_id=</field>
        </record>

        <record id="api_map_leviathan_logs" model="etp.external.project.api.map">
            <field name="project_id" ref="project_leviathan_external"/>
            <field name="table_name">Logs</field>
            <field name="field_name">logs</field>
            <field name="api_prefix">/v1/get_notification_grouped?project_id=</field>
        </record>

    </data>
</odoo>
