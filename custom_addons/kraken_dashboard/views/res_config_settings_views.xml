<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_kraken" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kraken.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Kraken Dashboard" string="Kraken Dashboard" name="kraken_dashboard">
                    <block title="Kraken Dashboard Settings">
                        <setting string="Trajectories URL"
                                 help="URL pointing to the Kraken trajectories repository">
                            <field name="kraken_trajectories_url"/>
                        </setting>
                        <setting string="Dataset URL"
                                 help="URL pointing to the Kraken dataset on HuggingFace">
                            <field name="kraken_dataset_url"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
