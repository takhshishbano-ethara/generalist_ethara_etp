          <div class="glance-row"><dt>Language</dt><dd><b>Python</b></dd></div>
          <div class="glance-row"><dt>Models evaluated</dt><dd><b>2</b></dd></div>
          <div class="glance-row"><dt>Methodology</dt><dd>SWE-fficiency</dd></div>
          <div class="glance-row"><dt>Difficulty levels</dt><dd><b>4</b></dd></div>
        </dl>
