<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="cron_monthly_leave_accrual" model="ir.cron">
            <field name="name">Ethara: Monthly Leave Accrual (SL/CL/EL)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_monthly_leave_accrual()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_yearly_leave_lapse" model="ir.cron">
            <field name="name">Ethara: Yearly Leave Lapse (SL/CL expire, EL cap at 7)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_yearly_leave_lapse()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_monthly_late_penalty" model="ir.cron">
            <field name="name">Ethara: Monthly Late Arrival Penalty Processing</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_late_penalties()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_daily_absence_check" model="ir.cron">
            <field name="name">Ethara: Daily Unauthorized Absence Alert (5+ days)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_unauthorized_absence()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_daily_medical_cert_check" model="ir.cron">
            <field name="name">Ethara: Medical Certificate Deadline Check</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_medical_certificates()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 03:00:00')"/>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

    </data>
</odoo>
