<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Employee form: smart button + "Leave Balances" page         -->
    <!-- ============================================================ -->
    <record id="view_employee_form_leave_mgmt" model="ir.ui.view">
        <field name="name">hr.employee.form.leave.mgmt</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_leave_balances" type="object"
                        class="oe_stat_button" icon="fa-suitcase">
                    <field name="ethara_leave_type_count" widget="statinfo"
                           string="Leave Buckets"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Leave Balances" name="ethara_leave_balances">
                    <field name="ethara_allocation_ids" readonly="1">
                        <list string="Leave Allocations" create="false" edit="false">
                            <field name="holiday_status_id" string="Leave Type"/>
                            <field name="number_of_days" string="Allocated"/>
                            <field name="leaves_taken" string="Taken"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Employee-wise leave management list                         -->
    <!-- ============================================================ -->
    <record id="view_leave_mgmt_employee_list" model="ir.ui.view">
        <field name="name">hr.employee.list.leave.mgmt</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <!-- Editable grid: every leave type is its own inline-editable column.
                 Edit a cell to allocate/adjust that employee's balance directly. -->
            <list string="Employees — Leave Balances" create="false" editable="bottom"
                  multi_edit="1">
                <field name="name" readonly="1"/>
                <field name="work_email" readonly="1" string="Email"/>
                <field name="department_id" readonly="1" optional="show"/>
                <field name="ethara_bal_sl" string="Sick"/>
                <field name="ethara_bal_cl" string="Casual"/>
                <field name="ethara_bal_el" string="Earned"/>
                <field name="ethara_bal_lop" string="LOP"/>
                <field name="ethara_bal_marriage" string="Marriage"/>
                <field name="ethara_bal_maternity" string="Maternity"/>
                <field name="ethara_bal_bereavement" string="Bereavement"/>
                <field name="ethara_bal_comp_off" string="Comp-Off"/>
                <field name="ethara_bal_wfh" string="WFH"/>
                <field name="ethara_bal_menstrual" string="Menstrual"/>
                <field name="ethara_bal_restricted" string="Restricted"/>
                <button name="action_open_leave_balances" type="object"
                        string="Cards" icon="fa-th-large" class="btn-link"
                        help="View this employee's leave buckets as cards"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Per-employee leave buckets as CARDS (view-only)             -->
    <!-- ============================================================ -->
    <record id="view_leave_bucket_kanban" model="ir.ui.view">
        <field name="name">hr.leave.bucket.kanban</field>
        <field name="model">hr.leave.bucket</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" create="false" edit="false"
                    group_create="false" default_group_by="employee_id">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content p-2">
                            <div class="o_kanban_record_title mb-2">
                                <field class="fw-bold fs-5" name="leave_type_id"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-end">
                                <div>
                                    <div class="text-muted small">Remaining</div>
                                    <span class="fs-2 fw-bold"><field name="remaining"/></span>
                                </div>
                                <div class="text-end">
                                    <div class="text-muted small">Can still give</div>
                                    <span class="fs-4 text-success"><field name="can_give"/></span>
                                </div>
                            </div>
                            <hr class="my-2"/>
                            <div class="d-flex justify-content-between small">
                                <span>Allocated:
                                    <b><field name="allocated"/></b> / <field name="entitlement"/>
                                </span>
                                <span>Taken: <b><field name="taken"/></b></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_leave_bucket_list" model="ir.ui.view">
        <field name="name">hr.leave.bucket.list</field>
        <field name="model">hr.leave.bucket</field>
        <field name="arch" type="xml">
            <list string="Leave Buckets" create="false" edit="false">
                <field name="employee_id"/>
                <field name="leave_type_id"/>
                <field name="entitlement"/>
                <field name="allocated"/>
                <field name="taken"/>
                <field name="remaining"/>
                <field name="can_give"/>
            </list>
        </field>
    </record>

    <record id="act_leave_bucket_cards" model="ir.actions.act_window">
        <field name="name">Leave Balances</field>
        <field name="res_model">hr.leave.bucket</field>
        <field name="view_mode">kanban,list</field>
        <field name="view_id" ref="view_leave_bucket_kanban"/>
    </record>

    <record id="act_leave_mgmt_employees" model="ir.actions.act_window">
        <field name="name">Leave Management</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_leave_mgmt_employee_list"/>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No employees found.</p>
            <p>Click an employee to view and assign their leave buckets.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Allocations (assign / view all, grouped by employee)        -->
    <!-- ============================================================ -->
    <record id="act_leave_mgmt_allocations" model="ir.actions.act_window">
        <field name="name">Leave Allocations</field>
        <field name="res_model">hr.leave.allocation</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_group_employee': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No allocations yet.</p>
            <p>Use "New" to assign a leave type and day count to an employee.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!--  Bulk upload wizard                                          -->
    <!-- ============================================================ -->
    <record id="view_leave_bulk_upload_form" model="ir.ui.view">
        <field name="name">hr.leave.allocation.bulk.upload.form</field>
        <field name="model">hr.leave.allocation.bulk.upload</field>
        <field name="arch" type="xml">
            <form string="Bulk Upload Leave Allocations">
                <sheet>
                    <!-- Step 1: download the empty Excel template -->
                    <div class="oe_title">
                        <h2>Bulk Upload Leave Allocations</h2>
                    </div>
                    <group>
                        <div colspan="2" class="mb-2">
                            <span class="badge text-bg-primary me-1">Step 1</span>
                            <b>Download the Excel sheet</b> — same layout as the
                            Employees list: one row per employee, one column per leave type.
                        </div>
                        <button name="action_download_template" type="object"
                                string="Download Excel Template" icon="fa-download"
                                class="btn-primary" colspan="2"/>
                        <div colspan="2" class="text-muted small mt-1">
                            Columns: <b>Employee (email or ID)</b>, then
                            <b>Sick · Casual · Earned · LOP · Marriage · Maternity ·
                            Bereavement · Comp-Off · WFH · Menstrual · Restricted</b>.
                            Fill the day count under each leave type; leave a cell blank
                            to keep that balance unchanged.
                        </div>
                    </group>
                    <!-- Step 2: upload the filled sheet -->
                    <group>
                        <div colspan="2" class="mt-3 mb-2">
                            <span class="badge text-bg-primary me-1">Step 2</span>
                            <b>Upload the filled sheet</b> and click Import.
                        </div>
                        <group>
                            <field name="upload_file" filename="upload_filename"
                                   widget="binary" string="Excel File (.xlsx)"/>
                            <field name="upload_filename" invisible="1"/>
                        </group>
                    </group>
                    <field name="result_summary" readonly="1"
                           invisible="not result_summary" nolabel="1"/>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary" invisible="not upload_file"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="act_leave_bulk_upload" model="ir.actions.act_window">
        <field name="name">Bulk Upload Allocations</field>
        <field name="res_model">hr.leave.allocation.bulk.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================================ -->
    <!--  Menus (under Time Off root, HR-manager only)                -->
    <!-- ============================================================ -->
    <menuitem id="menu_ethara_leave_mgmt_root"
              name="Leave Management"
              parent="hr_holidays.menu_hr_holidays_root"
              groups="hr_holidays.group_hr_holidays_manager"
              sequence="50"/>

    <menuitem id="menu_ethara_leave_mgmt_employees"
              name="Employees"
              parent="menu_ethara_leave_mgmt_root"
              action="act_leave_mgmt_employees"
              sequence="10"/>

    <menuitem id="menu_ethara_leave_mgmt_cards"
              name="Balance Cards"
              parent="menu_ethara_leave_mgmt_root"
              action="act_leave_bucket_cards"
              sequence="15"/>

    <menuitem id="menu_ethara_leave_mgmt_allocations"
              name="Allocations"
              parent="menu_ethara_leave_mgmt_root"
              action="act_leave_mgmt_allocations"
              sequence="20"/>

    <menuitem id="menu_ethara_leave_mgmt_bulk_upload"
              name="Bulk Upload"
              parent="menu_ethara_leave_mgmt_root"
              action="act_leave_bulk_upload"
              sequence="30"/>

</odoo>
