<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expose the gazetted/restricted classification on the Time Off
         Public Holidays list and form so admins manage it in one place. -->
    <record id="view_public_holiday_list_classification" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.list.classification</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_holidays.resource_calendar_leaves_tree_inherit"/>
        <field name="arch" type="xml">
            <field name="date_to" position="after">
                <field name="holiday_classification"/>
            </field>
        </field>
    </record>

    <record id="view_public_holiday_form_classification" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.form.classification</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_holidays.resource_calendar_leave_form_inherit"/>
        <field name="arch" type="xml">
            <field name="holiday_id" position="after">
                <field name="holiday_classification"/>
            </field>
        </field>
    </record>
</odoo>
