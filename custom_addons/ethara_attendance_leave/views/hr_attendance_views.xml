<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Attendance Tree: Add late/productivity fields -->
    <record id="view_attendance_tree_ethara" model="ir.ui.view">
        <field name="name">hr.attendance.tree.ethara.attendance.leave</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="productive_hours" string="Productive Hrs"/>
                <field name="is_late" string="Late" widget="boolean_toggle"/>
                <field name="is_flexi_checkin" string="Flexi" optional="hide"/>
                <field name="is_productive_deficit" string="Deficit" widget="boolean_toggle"/>
                <field name="check_in_ist_time" string="Check-In (IST)" optional="hide"/>
                <field name="check_out_ist_time" string="Check-Out (IST)" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Attendance Form: Add late/productivity fields -->
    <record id="view_attendance_form_ethara" model="ir.ui.view">
        <field name="name">hr.attendance.form.ethara.attendance.leave</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="productive_hours"/>
                <field name="is_late"/>
                <field name="is_flexi_checkin"/>
                <field name="is_productive_deficit"/>
                <field name="check_in_ist_time"/>
                <field name="check_out_ist_time"/>
            </xpath>
        </field>
    </record>

</odoo>
