<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Employee Form: Add Probation & Late Arrival fields -->
    <record id="view_employee_form_ethara" model="ir.ui.view">
        <field name="name">hr.employee.form.ethara.attendance.leave</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Add Late Arrival section in a new notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="Attendance &amp; Leave" name="ethara_attendance_leave">
                    <group string="Late Arrival Tracking">
                        <group>
                            <field name="late_arrival_count"/>
                            <field name="total_late_penalty_deductions"/>
                        </group>
                        <group>
                            <field name="weekly_hour_deficit"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
