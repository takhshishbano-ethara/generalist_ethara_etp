<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="skoll.SandboxIframe">
        <div class="o_sandbox_iframe_widget position-relative" t-ref="root">

            <t t-if="isStarting and !shouldShowIframe">
                <div class="o_sandbox_iframe_placeholder d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="fa fa-cogs fa-spin o_sandbox_iframe_placeholder_icon" role="img" aria-label="Starting"/>
                    <div class="fw-semibold mt-3">Starting sandbox environment…</div>
                    <div class="text-muted mt-1 small" t-esc="currentStepLabel"/>
                </div>
                <div class="o_sandbox_progress_toast">
                    <div class="o_sandbox_progress_header d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold small">Sandbox Setup</span>
                        <span class="badge rounded-pill text-bg-primary small">
                            <t t-out="completedSteps"/>/<t t-out="totalSteps"/>
                        </span>
                    </div>
                    <div class="progress o_sandbox_progress_bar_track">
                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                             role="progressbar"
                             t-att-style="progressBarStyle"
                             t-att-aria-valuenow="progressPercent"
                             aria-valuemin="0" aria-valuemax="100"/>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mt-2">
                        <span class="text-muted small text-truncate me-2" t-esc="currentStepLabel"/>
                        <span class="fw-bold small text-nowrap"><t t-out="progressPercent"/>%</span>
                    </div>
                </div>
            </t>

            <t t-if="!isStarting and !shouldShowIframe and !state.error">
                <div class="o_sandbox_iframe_placeholder d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="fa fa-desktop o_sandbox_iframe_placeholder_icon" role="img" aria-label="Sandbox"/>
                    <div class="fw-semibold mt-2">Start the sandbox to view the browser session</div>
                </div>
            </t>

            <t t-if="shouldShowIframe">
                <div class="o_sandbox_iframe_toolbar d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge rounded-pill text-bg-success">Running</span>
                    <span class="o_sandbox_iframe_url text-truncate flex-grow-1" t-att-title="dashboardUrl">
                        <t t-out="truncatedUrl"/>
                    </span>
                    <a class="btn btn-outline-primary btn-sm" t-att-href="dashboardUrl" target="_blank" rel="noopener noreferrer">
                        <i class="fa fa-external-link me-1"/>
                        Open in new tab
                    </a>
                    <button class="btn btn-outline-secondary btn-sm" type="button" t-on-click="toggleFullscreen">
                        <i class="fa fa-expand me-1"/>
                        Fullscreen
                    </button>
                </div>
                <div class="o_sandbox_iframe_frame position-relative">
                    <iframe
                        t-att-src="dashboardUrl"
                        class="o_sandbox_iframe"
                        allow="clipboard-read; clipboard-write"
                        t-on-load="onIframeLoad"
                        t-on-error="onIframeError"
                    />
                    <t t-if="state.loading">
                        <div class="o_sandbox_iframe_loading position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center">
                            <div class="spinner-border text-primary" role="status" aria-label="Loading sandbox session"/>
                            <span class="mt-2 text-muted">Loading browser session…</span>
                        </div>
                    </t>
                    <t t-if="state.showProgress">
                        <div class="o_sandbox_progress_toast">
                            <div class="o_sandbox_progress_header d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-semibold small">Loading Session</span>
                                <span class="badge rounded-pill text-bg-primary small">
                                    <t t-out="completedSteps"/>/<t t-out="totalSteps"/>
                                </span>
                            </div>
                            <div class="progress o_sandbox_progress_bar_track">
                                <div class="progress-bar progress-bar-striped progress-bar-animated"
                                     role="progressbar"
                                     t-att-style="progressBarStyle"
                                     t-att-aria-valuenow="progressPercent"
                                     aria-valuemin="0" aria-valuemax="100"/>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mt-2">
                                <span class="text-muted small text-truncate me-2" t-esc="currentStepLabel"/>
                                <span class="fw-bold small text-nowrap"><t t-out="progressPercent"/>%</span>
                            </div>
                        </div>
                    </t>
                    <t t-if="state.error">
                        <div class="o_sandbox_iframe_error d-flex align-items-center justify-content-center text-center px-4">
                            <div>
                                <i class="fa fa-exclamation-triangle text-warning mb-2" role="img" aria-label="Error"/>
                                <div class="fw-semibold">Unable to load the sandbox session.</div>
                                <div class="text-muted">Try reopening it in a new tab or restarting the sandbox.</div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>

        </div>
    </t>
</templates>
