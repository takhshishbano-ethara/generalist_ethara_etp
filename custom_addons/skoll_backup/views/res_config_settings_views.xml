<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_skoll" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.skoll</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Skoll" string="Skoll" name="skoll">
                    <block title="Bedrock Configuration">
                        <setting
                            string="Generation ARN (Sonnet 4.6)"
                            help="Inference profile ARN for trajectory generation."
                        >
                            <field name="skoll_bedrock_inference_arn"/>
                        </setting>
                        <setting
                            string="QC ARN (Kimi K2.5)"
                            help="Inference profile ARN for trajectory QC reviews."
                        >
                            <field name="skoll_qc_inference_arn"/>
                        </setting>
                        <setting
                            string="Region"
                            help="AWS region for Bedrock endpoints (e.g. ap-south-1)."
                        >
                            <field name="skoll_bedrock_region"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
