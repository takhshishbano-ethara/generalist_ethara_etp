<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Per-category sequences for the dataset filename convention
        T2AV_<category>_<NNNNNN>.mp4. Each category has its own counter
        starting at 000001. `implementation=no_gap` guarantees no gaps even
        on rollback (uses a row-level lock instead of a PG sequence) — critical
        for dataset integrity: a failed upload releases the slot.
    -->

    <record id="seq_crowley_attempt_animals_wildlife" model="ir.sequence">
        <field name="name">Crowley Attempt: Animals Wildlife</field>
        <field name="code">crowley.attempt.animals_wildlife</field>
        <field name="padding">6</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="implementation">no_gap</field>
    </record>

