<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crowley_csv_export_wizard_form" model="ir.ui.view">
            <field name="name">crowley.csv.export.wizard.form</field>
            <field name="model">crowley.csv.export.wizard</field>
            <field name="arch" type="xml">
                <form string="Export for Migration">
                    <group invisible="state != 'draft'">
                        <field name="state" invisible="1"/>
                        <div colspan="2">
                            <p>Export all completed generations as Odoo-native CSVs
                               for import on another instance.</p>
                            <p>The ZIP contains:</p>
                            <ul>
                                <li><b>generations.csv</b></li>
                                <li><b>attempts.csv</b></li>
                                <li><b>fix_sequences.py</b></li>
                                <li><b>README.txt</b></li>
                            </ul>
                        </div>
                    </group>
                    <group invisible="state != 'done'">
                        <field name="state" invisible="1"/>
                        <group>
                            <field name="export_count"/>
                            <field name="attempt_count"/>
                        </group>
                        <field name="export_file" filename="export_filename"/>
                        <field name="export_filename" invisible="1"/>
                        <field name="log_text" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Export"
                                name="action_export"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button string="Close"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_crowley_csv_export_wizard" model="ir.actions.act_window">
            <field name="name">Export for Migration</field>
            <field name="res_model">crowley.csv.export.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
