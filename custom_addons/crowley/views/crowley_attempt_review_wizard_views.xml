<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crowley_attempt_review_wizard_form" model="ir.ui.view">
        <field name="name">crowley.attempt.review.wizard.form</field>
        <field name="model">crowley.attempt.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Attempt">
                <group>
                    <field name="attempt_id" readonly="1"/>
                    <field name="review_action" invisible="1"/>
                    <field name="review_reason"
                           placeholder="Enter your notes..."
                           required="review_action == 'reject'"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Approve" class="btn-success"
                            invisible="review_action != 'approve'"/>
                    <button name="action_confirm" type="object"
                            string="Reject" class="btn-danger"
                            invisible="review_action != 'reject'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
