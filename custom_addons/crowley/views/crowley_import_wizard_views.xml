<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_crowley_import_wizard_form" model="ir.ui.view">
            <field name="name">crowley.import.wizard.form</field>
            <field name="model">crowley.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Generations">
                    <group>
                        <div class="alert alert-info" role="alert">
                            <p class="mb-1">
                                Upload a CSV file to bulk-create video generation jobs.
                                Imported rows land in the <strong>Not Assigned</strong> state
                                and remain editable until you open one and click <em>Generate</em>.
                            </p>
                            <p class="mb-1">
                                <strong>Required columns:</strong>
                                <code>prompt</code>, <code>category</code>
                            </p>
                            <p class="mb-1">
                                <strong>Optional columns:</strong>
                                <code>negative_prompt</code>, <code>duration</code>,
                                <code>resolution</code>, <code>aspect_ratio</code>,
                                <code>seed</code>, <code>generate_audio</code>,
                                <code>sub_category</code>, <code>style</code>,
                                <code>priority</code>, <code>topic</code>, <code>complexity</code>
                            </p>
                            <p class="mb-1">
                                <strong>Allowed category values:</strong>
                                <code>av_sync_sound_effects</code>,
                                <code>multi_speaker_dialogue</code>,
                                <code>human_activities</code>,
                                <code>high_motion_action</code>,
                                <code>educational_videos</code>
                                (or their human-readable labels).
                            </p>
                            <p class="mb-0">
                                Validation is atomic — if any row fails, nothing is created.
                            </p>
                        </div>
                        <field name="csv_file" filename="csv_filename"/>
                        <field name="csv_filename" invisible="1"/>
                    </group>
                    <footer>
                        <button name="action_import" type="object"
                                string="Import" class="oe_highlight"/>
                        <button string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_crowley_import_wizard" model="ir.actions.act_window">
            <field name="name">Import Generations</field>
            <field name="res_model">crowley.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
