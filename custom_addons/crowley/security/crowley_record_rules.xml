<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_crowley_enrichment_user" model="ir.rule">
            <field name="name">Crowley Enrichment: user sees own jobs only</field>
            <field name="model_id" ref="model_crowley_enrichment"/>
            <field name="domain_force">[('job_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('crowley.group_crowley_user'))]"/>
        </record>

        <record id="rule_crowley_enrichment_manager" model="ir.rule">
            <field name="name">Crowley Enrichment: manager sees company jobs</field>
            <field name="model_id" ref="model_crowley_enrichment"/>
            <field name="domain_force">[('job_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('crowley.group_crowley_manager'))]"/>
        </record>

        <record id="rule_crowley_video_review_user" model="ir.rule">
            <field name="name">Crowley Video Review: user sees own jobs only</field>
            <field name="model_id" ref="model_crowley_video_review"/>
            <field name="domain_force">[('job_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('crowley.group_crowley_user'))]"/>
        </record>

        <record id="rule_crowley_video_review_manager" model="ir.rule">
            <field name="name">Crowley Video Review: manager sees company jobs</field>
            <field name="model_id" ref="model_crowley_video_review"/>
            <field name="domain_force">[('job_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('crowley.group_crowley_manager'))]"/>
        </record>

    </data>
</odoo>
