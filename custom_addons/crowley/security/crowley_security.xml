<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_crowley" model="ir.module.category">
            <field name="name">Crowley</field>
            <field name="description">AI Video Generation (Seedance 2.0)</field>
            <field name="sequence">90</field>
        </record>

        <!-- Privilege (Odoo 19: replaces category_id on res.groups) -->
        <record id="res_groups_privilege_crowley" model="res.groups.privilege">
            <field name="name">Crowley</field>
            <field name="sequence">90</field>
            <field name="category_id" ref="module_category_crowley"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- User Group -->
        <record id="group_crowley_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_crowley"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager Group (inherits User) -->
        <record id="group_crowley_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_crowley"/>
            <field name="implied_ids" eval="[(4, ref('group_crowley_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules: Users see own generations -->
        <record id="rule_crowley_generation_user" model="ir.rule">
            <field name="name">Crowley Generation: User sees own</field>
            <field name="model_id" ref="model_crowley_generation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_crowley_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rules: Managers see company jobs -->
        <record id="rule_crowley_generation_manager" model="ir.rule">
            <field name="name">Crowley Generation: Manager sees company jobs</field>
            <field name="model_id" ref="model_crowley_generation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_crowley_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- crowley.attempt: visibility mirrors the job's visibility -->
        <record id="rule_crowley_attempt_user" model="ir.rule">
            <field name="name">Crowley Attempt: User sees attempts of own jobs</field>
            <field name="model_id" ref="model_crowley_attempt"/>
            <field name="domain_force">[('job_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_crowley_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_crowley_attempt_manager" model="ir.rule">
            <field name="name">Crowley Attempt: Manager sees company attempts</field>
            <field name="model_id" ref="model_crowley_attempt"/>
            <field name="domain_force">[('job_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_crowley_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
