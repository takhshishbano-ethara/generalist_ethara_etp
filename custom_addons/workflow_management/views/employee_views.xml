<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend HR Employee Form to add workflow fields -->
    <record id="view_hr_employee_form_inherit_workflow" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.workflow</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add a new notebook page for Workflow Management fields -->
            <xpath expr="//notebook" position="inside">
                <page string="Workflow Management" name="workflow_management">
                    <group>
                        <group string="Project Info">
                            <field name="project_category"/>
                            <field name="current_project"/>
                            <field name="project_color" widget="color"/>
                        </group>
                        <group string="Work Status">
                            <field name="platform"/>
                            <field name="tasking_status"/>
                            <field name="allocation_status"/>
                        </group>
                    </group>
                    <group>
                        <group string="Location">
                            <field name="main_location"/>
                            <field name="current_location"/>
                            <field name="current_seat_id"/>
                        </group>
                    </group>
                    <group string="Seat Assignment History">
                        <field name="seat_history_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="create_date" string="Date"/>
                                <field name="seat_id"/>
                                <field name="floor_id"/>
                                <field name="action" widget="badge"
                                       decoration-success="action == 'assign'"
                                       decoration-warning="action == 'release'"
                                       decoration-info="action == 'transfer'"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
