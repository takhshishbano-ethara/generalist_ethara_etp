<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Room Booking List View -->
    <record id="view_workflow_room_booking_tree" model="ir.ui.view">
        <field name="name">workflow.room.booking.tree</field>
        <field name="model">workflow.room.booking</field>
        <field name="arch" type="xml">
            <list string="Room Bookings"
                  decoration-muted="status == 'cancelled'"
                  decoration-success="status == 'confirmed'">
                <field name="room_code"/>
                <field name="name"/>
                <field name="floor_id"/>
                <field name="organizer_id"/>
                <field name="booking_start"/>
                <field name="booking_end"/>
                <field name="duration_minutes"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'confirmed'"
                       decoration-danger="status == 'cancelled'"
                       decoration-info="status == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- Room Booking Form View -->
    <record id="view_workflow_room_booking_form" model="ir.ui.view">
        <field name="name">workflow.room.booking.form</field>
        <field name="model">workflow.room.booking</field>
        <field name="arch" type="xml">
            <form string="Room Booking">
                <header>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel Booking"
                            class="btn-danger"
                            invisible="status != 'confirmed'"
                            confirm="Are you sure you want to cancel this booking?"/>
                    <button name="action_complete"
                            type="object"
                            string="Mark Completed"
                            class="btn-success"
                            invisible="status != 'confirmed'"
                            groups="workflow_management.group_manager"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="confirmed,completed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Room Details">
                            <field name="room_code"/>
                            <field name="name"/>
                            <field name="floor_id"/>
                        </group>
                        <group string="Booking Info">
                            <field name="organizer_id"/>
                            <field name="organizer_email"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <group>
                        <group string="Schedule">
                            <field name="booking_start"/>
                            <field name="booking_end"/>
                            <field name="duration_minutes"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Room Booking Search View -->
    <record id="view_workflow_room_booking_search" model="ir.ui.view">
        <field name="name">workflow.room.booking.search</field>
        <field name="model">workflow.room.booking</field>
        <field name="arch" type="xml">
            <search string="Search Bookings">
                <field name="room_code"/>
                <field name="name"/>
                <field name="organizer_id"/>
                <separator/>
                <filter string="Confirmed" name="confirmed" domain="[('status', '=', 'confirmed')]"/>
                <filter string="Completed" name="completed" domain="[('status', '=', 'completed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('booking_start', '&gt;=', (context_today()).strftime('%Y-%m-%d')), ('booking_start', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter string="Room" name="group_room" context="{'group_by': 'room_code'}"/>
                    <filter string="Floor" name="group_floor" context="{'group_by': 'floor_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Room Booking Action -->
    <record id="action_workflow_room_booking" model="ir.actions.act_window">
        <field name="name">Room Bookings</field>
        <field name="res_model">workflow.room.booking</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>
</odoo>
