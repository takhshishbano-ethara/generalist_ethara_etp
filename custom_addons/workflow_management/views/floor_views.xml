<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Floor List View -->
    <record id="view_workflow_floor_tree" model="ir.ui.view">
        <field name="name">workflow.floor.tree</field>
        <field name="model">workflow.floor</field>
        <field name="arch" type="xml">
            <list string="Floors">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="floor_code"/>
                <field name="total_seats"/>
                <field name="occupied_seats"/>
                <field name="available_seats"/>
                <field name="reserved_seats"/>
            </list>
        </field>
    </record>

    <!-- Floor Form View -->
    <record id="view_workflow_floor_form" model="ir.ui.view">
        <field name="name">workflow.floor.form</field>
        <field name="model">workflow.floor</field>
        <field name="arch" type="xml">
            <form string="Floor">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Floor Name"/></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="floor_code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Seat Statistics">
                            <field name="total_seats"/>
                            <field name="occupied_seats"/>
                            <field name="available_seats"/>
                            <field name="reserved_seats"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Seats">
                            <field name="seat_ids">
                                <list>
                                    <field name="seat_code"/>
                                    <field name="zone"/>
                                    <field name="row"/>
                                    <field name="number"/>
                                    <field name="employee_id"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'available'"
                                           decoration-info="status == 'occupied'"
                                           decoration-warning="status == 'reserved'"
                                           decoration-danger="status == 'maintenance'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Floor Search View -->
    <record id="view_workflow_floor_search" model="ir.ui.view">
        <field name="name">workflow.floor.search</field>
        <field name="model">workflow.floor</field>
        <field name="arch" type="xml">
            <search string="Search Floors">
                <field name="name"/>
                <field name="floor_code"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Floor Action -->
    <record id="action_workflow_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">workflow.floor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
