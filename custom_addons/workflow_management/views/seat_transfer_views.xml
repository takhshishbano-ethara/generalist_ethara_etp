<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Seat Transfer List View -->
    <record id="view_workflow_seat_transfer_tree" model="ir.ui.view">
        <field name="name">workflow.seat.transfer.tree</field>
        <field name="model">workflow.seat.transfer</field>
        <field name="arch" type="xml">
            <list string="Seat Transfer Requests"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state in ('approved', 'completed')"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="from_seat_id"/>
                <field name="to_seat_id"/>
                <field name="requested_by"/>
                <field name="create_date" string="Requested On"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state in ('approved', 'completed')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Seat Transfer Form View -->
    <record id="view_workflow_seat_transfer_form" model="ir.ui.view">
        <field name="name">workflow.seat.transfer.form</field>
        <field name="model">workflow.seat.transfer</field>
        <field name="arch" type="xml">
            <form string="Seat Transfer Request">
                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit for Approval"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="workflow_management.group_manager"
                            confirm="Approve this seat transfer? The employee will be moved immediately."/>
                    <button name="action_reject"
                            type="object"
                            string="Reject"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="workflow_management.group_manager"/>
                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            class="btn-secondary"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Transfer Details">
                            <field name="employee_id"
                                   readonly="state != 'draft'"/>
                            <field name="from_seat_id" readonly="1"/>
                            <field name="to_seat_id"
                                   readonly="state != 'draft'"
                                   domain="[('status', 'in', ['available', 'reserved'])]"/>
                        </group>
                        <group string="Request Info">
                            <field name="requested_by" readonly="1"/>
                            <field name="reason"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Approval"
                           invisible="state in ('draft', 'submitted')">
                        <group>
                            <field name="decided_by"/>
                            <field name="decided_at"/>
                        </group>
                        <group>
                            <field name="approval_notes"
                                   readonly="state in ('approved', 'completed', 'rejected')"/>
                        </group>
                    </group>
                    <!-- Hidden computed fields for view logic -->
                    <field name="current_user_role" invisible="1"/>
                    <field name="is_current_user_manager" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Seat Transfer Search View -->
    <record id="view_workflow_seat_transfer_search" model="ir.ui.view">
        <field name="name">workflow.seat.transfer.search</field>
        <field name="model">workflow.seat.transfer</field>
        <field name="arch" type="xml">
            <search string="Search Transfers">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="requested_by"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="pending" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', 'in', ('approved', 'completed'))]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="My Requests" name="my_requests" domain="[('requested_by', '=', uid)]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Seat Transfer Action -->
    <record id="action_workflow_seat_transfer" model="ir.actions.act_window">
        <field name="name">Seat Transfers</field>
        <field name="res_model">workflow.seat.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 0}</field>
    </record>

    <!-- Pending Transfers Action (for manager quick access) -->
    <record id="action_workflow_seat_transfer_pending" model="ir.actions.act_window">
        <field name="name">Pending Transfers</field>
        <field name="res_model">workflow.seat.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
