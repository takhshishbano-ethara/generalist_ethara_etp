<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Seat List View -->
    <record id="view_workflow_seat_tree" model="ir.ui.view">
        <field name="name">workflow.seat.tree</field>
        <field name="model">workflow.seat</field>
        <field name="arch" type="xml">
            <list string="Seats" decoration-muted="status == 'maintenance'">
                <field name="seat_code"/>
                <field name="floor_id"/>
                <field name="zone"/>
                <field name="row"/>
                <field name="number"/>
                <field name="employee_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-info="status == 'occupied'"
                       decoration-warning="status == 'reserved'"
                       decoration-danger="status == 'maintenance'"/>
            </list>
        </field>
    </record>

    <!-- Seat Form View -->
    <record id="view_workflow_seat_form" model="ir.ui.view">
        <field name="name">workflow.seat.form</field>
        <field name="model">workflow.seat</field>
        <field name="arch" type="xml">
            <form string="Seat">
                <header>
                    <button name="action_release"
                            type="object"
                            string="Release"
                            class="btn-warning"
                            invisible="status != 'occupied'"
                            groups="workflow_management.group_manager"
                            confirm="Release this seat from the assigned employee?"/>
                    <button name="action_reserve"
                            type="object"
                            string="Reserve"
                            class="btn-secondary"
                            invisible="status != 'available'"
                            groups="workflow_management.group_manager"/>
                    <button name="action_set_maintenance"
                            type="object"
                            string="Set Maintenance"
                            class="btn-danger"
                            invisible="status not in ('available', 'reserved')"
                            groups="workflow_management.group_admin"/>
                    <button name="action_set_available"
                            type="object"
                            string="Set Available"
                            class="btn-success"
                            invisible="status != 'maintenance'"
                            groups="workflow_management.group_admin"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="available,occupied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="seat_code" placeholder="e.g. F2-A-012"/></h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="floor_id"/>
                            <field name="zone"/>
                            <field name="row"/>
                            <field name="number"/>
                        </group>
                        <group string="Assignment">
                            <field name="employee_id"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group string="Canvas Position" groups="workflow_management.group_admin">
                        <group>
                            <field name="position_x"/>
                            <field name="position_y"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assignment History">
                            <field name="history_ids">
                                <list>
                                    <field name="create_date" string="Date"/>
                                    <field name="employee_id"/>
                                    <field name="action" widget="badge"
                                           decoration-success="action == 'assign'"
                                           decoration-warning="action == 'release'"
                                           decoration-info="action == 'transfer'"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Seat Search View -->
    <record id="view_workflow_seat_search" model="ir.ui.view">
        <field name="name">workflow.seat.search</field>
        <field name="model">workflow.seat</field>
        <field name="arch" type="xml">
            <search string="Search Seats">
                <field name="seat_code"/>
                <field name="zone"/>
                <field name="employee_id"/>
                <field name="floor_id"/>
                <separator/>
                <filter string="Available" name="available" domain="[('status', '=', 'available')]"/>
                <filter string="Occupied" name="occupied" domain="[('status', '=', 'occupied')]"/>
                <filter string="Reserved" name="reserved" domain="[('status', '=', 'reserved')]"/>
                <filter string="Maintenance" name="maintenance" domain="[('status', '=', 'maintenance')]"/>
                <separator/>
                <group>
                    <filter string="Floor" name="group_floor" context="{'group_by': 'floor_id'}"/>
                    <filter string="Zone" name="group_zone" context="{'group_by': 'zone'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Seat Action -->
    <record id="action_workflow_seat" model="ir.actions.act_window">
        <field name="name">Seats</field>
        <field name="res_model">workflow.seat</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 0}</field>
    </record>
</odoo>
