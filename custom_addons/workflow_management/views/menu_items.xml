<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_workflow_root"
              name="Workflow Management"
              web_icon="workflow_management,static/description/icon.png"
              sequence="90"/>

    <!-- Seat Management Section -->
    <menuitem id="menu_workflow_seat_mgmt"
              name="Seat Management"
              parent="menu_workflow_root"
              sequence="10"/>

    <menuitem id="menu_workflow_floors"
              name="Floors"
              parent="menu_workflow_seat_mgmt"
              action="action_workflow_floor"
              sequence="10"/>

    <menuitem id="menu_workflow_seats"
              name="Seats"
              parent="menu_workflow_seat_mgmt"
              action="action_workflow_seat"
              sequence="20"/>

    <!-- Transfers Section -->
    <menuitem id="menu_workflow_transfers"
              name="Transfers"
              parent="menu_workflow_root"
              sequence="20"/>

    <menuitem id="menu_workflow_all_transfers"
              name="All Transfers"
              parent="menu_workflow_transfers"
              action="action_workflow_seat_transfer"
              sequence="10"/>

    <menuitem id="menu_workflow_pending_transfers"
              name="Pending Approval"
              parent="menu_workflow_transfers"
              action="action_workflow_seat_transfer_pending"
              sequence="20"
              groups="workflow_management.group_manager"/>

    <!-- Room Bookings Section -->
    <menuitem id="menu_workflow_bookings"
              name="Room Bookings"
              parent="menu_workflow_root"
              action="action_workflow_room_booking"
              sequence="30"/>

    <!-- Administration Section (Admin only) -->
    <menuitem id="menu_workflow_admin"
              name="Administration"
              parent="menu_workflow_root"
              sequence="90"
              groups="workflow_management.group_admin"/>

    <menuitem id="menu_workflow_audit_logs"
              name="Audit Logs"
              parent="menu_workflow_admin"
              action="action_workflow_audit_log"
              sequence="10"/>

    <menuitem id="menu_workflow_attendance_sync"
              name="Attendance Sync"
              parent="menu_workflow_admin"
              action="action_workflow_attendance_sync"
              sequence="20"/>
</odoo>
