<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category and Privilege: noupdate="0" so admin can customize -->
    <data noupdate="0">
        <record id="module_category_workflow_management" model="ir.module.category">
            <field name="name">Workflow Management</field>
            <field name="description">HRMS Seat Management and Workflows</field>
            <field name="sequence">90</field>
        </record>

        <record id="res_groups_privilege_workflow" model="res.groups.privilege">
            <field name="name">Workflow Management</field>
            <field name="sequence">90</field>
            <field name="category_id" ref="module_category_workflow_management"/>
        </record>
    </data>

    <!-- Groups: noupdate="1" to lock after first install -->
    <data noupdate="1">
        <!-- User: base role, can view seats/floors/bookings, create transfer requests -->
        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_workflow"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager: can approve/reject transfers, manage bookings -->
        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_workflow"/>
            <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        </record>

        <!-- Admin: full access to everything -->
        <record id="group_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="res_groups_privilege_workflow"/>
            <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Sequence for transfer references -->
        <record id="seq_seat_transfer" model="ir.sequence">
            <field name="name">Seat Transfer</field>
            <field name="code">workflow.seat.transfer</field>
            <field name="prefix">TRN-</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
