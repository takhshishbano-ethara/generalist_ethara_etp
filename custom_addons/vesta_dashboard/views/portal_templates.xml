          <div class="glance-row"><dt>No Adversary</dt><dd><b>50.0%</b></dd></div>
          <div class="glance-row"><dt>Single Adversary</dt><dd><b>25.0%</b></dd></div>
          <div class="glance-row"><dt>Coordinated Pressure</dt><dd><b>25.0%</b></dd></div>
          <div class="glance-row"><dt>Safety Degradation</dt><dd><b>−50.0%</b></dd></div>
        </dl>
