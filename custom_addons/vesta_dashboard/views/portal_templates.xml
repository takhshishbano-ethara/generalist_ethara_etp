  <!-- §07 - Model comparison -->
  <section class="section" id="models" aria-labelledby="models-label">
    <p class="section-label" id="models-label">§07 · Model comparison</p>
    <p class="section-desc">Head-to-head breakdown of both models on safety under adversarial pressure.</p>

    <div class="kpi-row" style="grid-template-columns: repeat(2, 1fr);">
      <div class="kpi-card" style="min-height: auto;">
        <p class="kpi-label"><span class="tok-nova">Kimi-K2.5</span></p>
        <dl class="glance-list" style="margin-top: 12px;">
          <div class="glance-row"><dt>Overall Safety Rate</dt><dd><b>45.0%</b></dd></div>
          <div class="glance-row"><dt>No Adversary</dt><dd><b>100.0%</b></dd></div>
          <div class="glance-row"><dt>Single Adversary</dt><dd><b>50.0%</b></dd></div>
          <div class="glance-row"><dt>Coordinated Pressure</dt><dd><b>12.5%</b></dd></div>
          <div class="glance-row"><dt>Safety Degradation</dt><dd><b>−87.5%</b></dd></div>
        </dl>
