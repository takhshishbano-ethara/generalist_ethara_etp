<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_arc_monitor" model="ir.module.category">
        <field name="name">ARC Monitor</field>
        <field name="sequence">22</field>
    </record>

    <record id="privilege_arc_monitor" model="res.groups.privilege">
        <field name="name">ARC Monitor</field>
        <field name="category_id" ref="module_category_arc_monitor"/>
    </record>

    <record id="group_arc_monitor_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_arc_monitor"/>
        <field name="comment">Can view monitor dashboard and trigger manual scans.</field>
    </record>

    <record id="group_arc_monitor_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_arc_monitor"/>
        <field name="implied_ids" eval="[(4, ref('group_arc_monitor_user'))]"/>
        <field name="comment">Full monitor access: manage scans, configure source path.</field>
    </record>

    <!-- Assign admin group to base admin user -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('arc_monitor.group_arc_monitor_admin'))]"/>
    </record>

    <!-- Record Rules -->

    <record id="rule_arc_monitor_scan_user_own" model="ir.rule">
        <field name="name">ARC Monitor Scan: User sees own + cron scans</field>
        <field name="model_id" ref="model_arc_monitor_scan"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('trigger', '=', 'cron')]</field>
        <field name="groups" eval="[(4, ref('group_arc_monitor_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_arc_monitor_scan_admin" model="ir.rule">
        <field name="name">ARC Monitor Scan: Admin full access</field>
        <field name="model_id" ref="model_arc_monitor_scan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_arc_monitor_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
