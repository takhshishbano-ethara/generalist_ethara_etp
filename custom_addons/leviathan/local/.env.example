# Copy to .env and edit. docker compose picks .env up automatically.

# --- Odoo DB (on the HOST) ---
ODOO_DB=leviathan_local
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=odoo

# --- Worker tuning (lower than prod, sized for laptop) ---
LEVIATHAN_PRD_POOL_SIZE=5
LEVIATHAN_WORKER_POLL_S=3

# --- Webhook token: must match the env var on your host Odoo process ---
# (export LEVIATHAN_WEBHOOK_TOKEN=devsecret before launching odoo-bin)
LEVIATHAN_WEBHOOK_TOKEN=devsecret

# --- S3 (MinIO local) ---
S3_BUCKET=leviathan-local
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=miniosecret
AWS_ENDPOINT_URL=http://minio:9000
