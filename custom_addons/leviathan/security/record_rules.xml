<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Taskers can only see their own jobs -->
        <record id="rule_leviathan_job_user" model="ir.rule">
            <field name="name">Leviathan Job: User sees own jobs</field>
            <field name="model_id" ref="model_leviathan_job"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_leviathan_user'))]"/>
        </record>

        <!-- Admins can see all jobs -->
        <record id="rule_leviathan_job_admin" model="ir.rule">
            <field name="name">Leviathan Job: Admin sees all</field>
            <field name="model_id" ref="model_leviathan_job"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_leviathan_admin'))]"/>
        </record>
    </data>
</odoo>
