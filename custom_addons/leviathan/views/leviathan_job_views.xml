<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- WIZARDS                                                      -->
    <!-- ============================================================ -->

    <!-- Start Task Wizard -->
    <record id="leviathan_start_task_wizard_view" model="ir.ui.view">
        <field name="name">leviathan.start.task.wizard.form</field>
        <field name="model">leviathan.start.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Start Task">
                <group>
                    <div class="alert alert-info" role="alert">
                        <p class="mb-0">Pick a category to get a matching task, or leave empty for any available task.</p>
                    </div>
                    <field name="category_id" placeholder="Any category"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Start Task" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leviathan_start_task_wizard" model="ir.actions.act_window">
        <field name="name">Start Task</field>
        <field name="res_model">leviathan.start.task.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Rerun Wizard (with asset/score context) -->
    <record id="leviathan_rerun_wizard_view" model="ir.ui.view">
        <field name="name">leviathan.rerun.wizard.form</field>
        <field name="model">leviathan.rerun.wizard</field>
        <field name="arch" type="xml">
            <form string="Rerun Pipeline">
                <group>
                    <div class="alert alert-info" role="alert">
                        <strong>Rerun Pipeline</strong>
                        <p class="mt-2 mb-0">Do you want to re-extract the website?</p>
                    </div>

                    <!-- Current extraction status -->
                    <div class="alert alert-light border" role="status">
                        <div class="row">
                            <div class="col-6">
                                <strong>Extraction:</strong>
                                <field name="asset_summary" class="ms-1"/>
                            </div>
                            <div class="col-3">
                                <strong>Score:</strong>
                                <field name="job_score_display" class="ms-1"/>
                            </div>
                            <div class="col-3">
                                <strong>QC:</strong>
                                <field name="job_qc_verdict" class="ms-1"/>
                            </div>
                        </div>
                    </div>
                </group>
                <footer>
                    <button name="action_rerun_generate_only" type="object"
                            string="Regenerate PRD Only" class="oe_highlight"
                            invisible="not has_assets and not has_screenshots"/>
                    <button name="action_rerun_full" type="object"
                            string="Re-extract Everything" class="btn-secondary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Import Wizard -->
    <record id="leviathan_import_wizard_view" model="ir.ui.view">
        <field name="name">leviathan.import.wizard.form</field>
        <field name="model">leviathan.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import URLs">
                <group>
                    <div class="alert alert-info" role="alert">
                        <p class="mb-1">Upload a CSV file with website URLs to create tasks.</p>
                        <p class="mb-0"><strong>Required column:</strong> <code>url</code><br/>
                        <strong>Optional column:</strong> <code>category</code> (must match an existing category name)</p>
                    </div>
                    <field name="csv_file" filename="csv_filename"/>
                    <field name="csv_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leviathan_import_wizard" model="ir.actions.act_window">
        <field name="name">Import URLs</field>
        <field name="res_model">leviathan.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Bulk Assign Wizard -->
    <record id="leviathan_bulk_assign_wizard_view" model="ir.ui.view">
        <field name="name">leviathan.bulk.assign.wizard.form</field>
        <field name="model">leviathan.bulk.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Assign Tasks">
                <group>
                    <field name="task_count" readonly="1"/>
                    <field name="user_id" domain="[('all_group_ids', 'in', %(leviathan.group_leviathan_user)d)]"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leviathan_bulk_assign" model="ir.actions.act_window">
        <field name="name">Bulk Assign</field>
        <field name="res_model">leviathan.bulk.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_leviathan_job"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- ============================================================ -->
    <!-- LIST VIEWS                                                   -->
    <!-- ============================================================ -->

    <!-- Admin List View -->
    <record id="leviathan_job_view_tree" model="ir.ui.view">
        <field name="name">leviathan.job.list</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <list js_class="leviathan_list" decoration-danger="state == 'failed'" decoration-muted="state in ('not_assigned','discarded')" decoration-success="state == 'done'" decoration-bf="state == 'submitted'">
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="site_name"/>
                <field name="category_id"/>
                <field name="state" widget="badge" decoration-info="state in ('extracting','extracted','generating','generated','scoring','scored','qc_running')" decoration-success="state in ('done','submitted')" decoration-danger="state == 'failed'" decoration-muted="state in ('not_assigned','discarded')"/>
                <field name="score_display"/>
                <field name="grade"/>
                <field name="qc_verdict"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Tasker List View -->
    <record id="leviathan_job_tasker_view_tree" model="ir.ui.view">
        <field name="name">leviathan.job.tasker.list</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <list js_class="leviathan_list" decoration-danger="state == 'failed'" decoration-muted="state == 'discarded'" decoration-success="state == 'done'" decoration-bf="state == 'submitted'">
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="site_name"/>
                <field name="category_id"/>
                <field name="state" widget="badge" decoration-info="state in ('extracting','extracted','generating','generated','scoring','scored','qc_running')" decoration-success="state in ('done','submitted')" decoration-danger="state == 'failed'" decoration-muted="state == 'discarded'"/>
                <field name="score_display"/>
                <field name="grade"/>
                <field name="qc_verdict"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- FORM VIEW                                                    -->
    <!-- ============================================================ -->

    <record id="leviathan_job_view_form" model="ir.ui.view">
        <field name="name">leviathan.job.form</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <form>
                <field name="is_admin" invisible="1"/>
                <field name="prd_text" invisible="1"/>
                <field name="screenshot_keys" invisible="1"/>
                <field name="asset_keys" invisible="1"/>
                <field name="error_message" invisible="1"/>
                <field name="extraction_warnings" invisible="1"/>
                <header>
                    <!-- =================================================== -->
                    <!-- HEADER BUTTONS                                      -->
                    <!-- Start Task is LIST-VIEW ONLY (via js_class button)  -->
                    <!-- =================================================== -->

                    <!-- DRAFT / NOT ASSIGNED: full auto pipeline (extract -> ... -> done).
                         Shown on batch-completed not_assigned tasks too — if the task
                         already has extraction data, action_run / action_stage_extract
                         open the rerun wizard instead of destroying the existing PRD. -->
                    <button name="action_run" type="object"
                            string="Run All" class="oe_highlight"
                            invisible="state not in ('draft', 'not_assigned')"/>

                    <!-- DRAFT / NOT ASSIGNED: staged manual run — extract, then park. -->
                    <button name="action_stage_extract" type="object"
                            string="Extract" class="btn-primary"
                            invisible="state not in ('draft', 'not_assigned')"/>

                    <!-- Staged steps: each shows only in its predecessor's parked state -->
                    <button name="action_stage_generate" type="object"
                            string="Generate PRD" class="oe_highlight"
                            invisible="state != 'extracted'"/>
                    <button name="action_stage_score" type="object"
                            string="Score" class="oe_highlight"
                            invisible="state != 'generated'"/>
                    <button name="action_stage_qc" type="object"
                            string="Run QC" class="oe_highlight"
                            invisible="state != 'scored'"/>

                    <!-- DONE: Primary actions -->
                    <button name="action_download_zip" type="object"
                            string="Download ZIP" class="oe_highlight"
                            invisible="state != 'done' or not prd_text"/>
                    <button name="action_mark_submitted" type="object"
                            string="Submit" class="btn-success"
                            invisible="state != 'done'"
                            confirm="Submit this task? This is final and cannot be undone."/>

                    <!-- DONE: Rerun (opens wizard with extraction context) -->
                    <button name="action_open_rerun_wizard" type="object"
                            string="Rerun Pipeline" class="btn-secondary"
                            invisible="state != 'done'"/>

                    <!-- FAILED / CANCELLED: Retry -->
                    <button name="action_retry" type="object"
                            string="Retry" class="oe_highlight"
                            invisible="state != 'failed'"/>

                    <!-- DISCARD: any state except already-discarded; both admin and tasker -->
                    <button name="action_discard" type="object"
                            string="Discard" class="btn-secondary"
                            invisible="state == 'discarded'"
                            confirm="Discard this task as unusable? Terminal — but it can be brought back via Assign."/>

                    <!-- CANCEL / RESET: while running OR parked at a staged step -->
                    <button name="action_cancel" type="object"
                            string="Cancel / Reset"
                            invisible="state not in ('extracting','generating','scoring','qc_running','extracted','generated','scored')"
                            confirm="Stop this task and return it to Draft?"/>

                    <!-- ASSIGN: bring a discarded task back as a Draft -->
                    <button name="action_reopen" type="object"
                            string="Assign" class="oe_highlight"
                            invisible="state != 'discarded'"/>

                    <button name="action_release_task" type="object"
                            string="Release Task" class="btn-secondary"
                            invisible="not is_admin or state not in ('draft', 'done', 'failed')"
                            confirm="Release this task back to the unassigned pool?"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,extracting,extracted,generating,generated,scoring,scored,qc_running,done,submitted"/>
                </header>

                <!-- Phase-2 tasker visibility (§5.15): short phase indicator
                     updated at every boundary by the worker / dispatcher /
                     webhook. Hidden when empty. -->
                <div class="d-flex align-items-center px-3 pt-2"
                     invisible="not pipeline_status">
                    <span class="badge bg-info text-white me-2">Pipeline</span>
                    <field name="pipeline_status" readonly="1" nolabel="1"
                           class="text-muted"/>
                </div>

                <!-- Pipeline progress (timing indicator) -->
                <field name="stage_progress_html" readonly="1" nolabel="1"
                       invisible="state not in ('extracting','extracted','generating','generated','scoring','scored','qc_running','done','submitted','failed')"
                       class="w-100 px-3 pt-2"/>

                <sheet>
                    <!-- ===== STATE BANNERS ===== -->

                    <!-- Not Assigned -->
                    <div class="alert alert-secondary" role="alert" invisible="state != 'not_assigned'">
                        <strong>Unassigned</strong> -- Click <em>Run Pipeline</em> to claim and process, or assign a user below.
                    </div>

                    <!-- In Progress -->
                    <div class="alert alert-info" role="alert" invisible="state not in ('extracting','generating','scoring','qc_running')">
                        <strong>Pipeline Running</strong> -- The system is processing this task. This page will update automatically.
                    </div>

                    <!-- Partial extraction: warnings, NOT a failure -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not extraction_warnings or state in ('failed','discarded','not_assigned')">
                        <strong>Partial Extraction</strong> -- extraction succeeded with warnings; the tasker may need to supply assets manually:
                        <field name="extraction_warnings" readonly="1" nolabel="1" class="d-block mt-1"/>
                    </div>

                    <!-- Done: QC Passed -->
                    <div class="alert alert-success" role="alert" invisible="state != 'done' or qc_verdict != 'shippable'">
                        <strong>Ready for Review</strong> -- QC passed. Review the PRD, then Download ZIP or Submit.
                    </div>

                    <!-- Done: QC Failed -->
                    <div class="alert alert-warning" role="alert" invisible="state != 'done' or qc_verdict == 'shippable'">
                        <strong>QC Failed</strong> -- PRD needs work. Edit it directly, regenerate using QC feedback, or rerun the pipeline.
                    </div>

                    <!-- Failed -->
                    <div class="alert alert-danger" role="alert" invisible="state != 'failed'">
                        <strong>Failed</strong> -- <field name="error_message" readonly="1" nolabel="1" class="d-inline"/>
                        <span class="ms-2">Click <em>Retry</em> to try again.</span>
                    </div>


                    <!-- Submitted (locked) -->
                    <div class="alert alert-success" role="alert" invisible="state != 'submitted'">
                        <strong>Submitted</strong> -- This task has been delivered. No further changes allowed.
                    </div>

                    <!-- Discarded (terminal) -->
                    <div class="alert alert-dark" role="alert" invisible="state != 'discarded'">
                        <strong>Discarded</strong> -- marked unusable (nothing extracted or site unsuitable).
                        Use <em>Assign</em> to bring it back into the workflow.
                    </div>

                    <!-- ===== TITLE + SUMMARY ===== -->
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group>
                            <!-- URL: tasker always readonly; admin always editable -->
                            <field name="url" widget="url" readonly="not is_admin"/>
                            <field name="site_name" readonly="1"/>
                            <!-- Category: editable for both admin and tasker at all times -->
                            <field name="category_id"/>
                            <field name="user_id"
                                   readonly="not is_admin or state not in ('not_assigned', 'draft')"
                                   options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="score_display" readonly="1"/>
                            <field name="grade" readonly="1"/>
                            <field name="qc_verdict" readonly="1"/>
                            <field name="duration_seconds" readonly="1" string="Duration (s)"/>
                        </group>
                    </group>

                    <!-- ===== TABS ===== -->
                    <notebook>

                        <!-- ============================== -->
                        <!-- TAB 1: PRD                     -->
                        <!-- ============================== -->
                        <page string="PRD" invisible="not prd_text">
                            <!-- Action buttons: only on done state -->
                            <div class="mb-2" invisible="state != 'done'">
                                <button name="action_save_prd_edit" type="object"
                                        string="Save Edits" class="btn btn-sm btn-primary me-1"/>
                                <button name="action_regenerate_with_qc_feedback" type="object"
                                        string="Regenerate PRD" class="btn btn-sm btn-warning me-1"
                                        confirm="Regenerate PRD using QC feedback? Current PRD will be replaced."/>
                            </div>

                            <!-- PRD rich text: editable only in done -->
                            <field name="prd_text_html" widget="html"
                                   readonly="state != 'done'"/>

                            <!-- Raw text: visible to both done and submitted for reference -->
                            <separator string="PRD (Raw Text)"/>
                            <field name="prd_text" readonly="1"/>
                        </page>

                        <!-- ============================== -->
                        <!-- TAB 2: Quality                 -->
                        <!-- ============================== -->
                        <page string="Quality" invisible="not score_report_json and not qc_report">
                            <!-- Action buttons: both admin and tasker on done -->
                            <div class="mb-3" invisible="state != 'done'">
                                <button name="action_rerun_qc" type="object"
                                        string="Rerun QC" class="btn btn-sm btn-info me-1"
                                        confirm="Re-evaluate QC on the current PRD?"/>
                                <button name="action_regenerate_with_qc_feedback" type="object"
                                        string="Regenerate PRD with Feedback" class="btn btn-sm btn-warning me-1"
                                        invisible="qc_verdict == 'shippable'"
                                        confirm="Regenerate PRD using QC feedback?"/>
                            </div>

                            <!-- QC Verdict Banners -->
                            <div class="alert alert-success mb-3" role="alert" invisible="qc_verdict != 'shippable'">
                                <strong>SHIPPABLE</strong> -- PRD passed all quality checks.
                            </div>
                            <div class="alert alert-danger mb-3" role="alert" invisible="qc_verdict != 'not_shippable'">
                                <strong>NOT SHIPPABLE</strong> -- Review the issues below and regenerate or edit.
                            </div>

                            <!-- Score Breakdown -->
                            <field name="score_report_html" readonly="1" nolabel="1"
                                   invisible="not score_report_json"/>

                            <!-- QC Report -->
                            <separator string="QC Report" invisible="not qc_report"/>
                            <field name="qc_report" readonly="1" invisible="not qc_report"/>
                        </page>

                        <!-- ============================== -->
                        <!-- TAB 3: Assets                  -->
                        <!-- ============================== -->
                        <!--
                            Always visible. Pre-2026-05-26 this tab was
                            hidden when both `screenshot_keys` and
                            `asset_keys` were empty (`invisible="not
                            screenshot_keys and not asset_keys"`), which
                            meant a tasker hitting a job where extraction
                            silently produced 0 uploads never even saw
                            the tab — worse UX than an empty tab.
                            Always-visible with an empty-state message
                            tells the tasker "extraction ran but produced
                            nothing here, talk to the operator" instead
                            of vanishing.
                        -->
                        <page string="Assets">
                            <!-- Re-extract: available to both admin and tasker on done -->
                            <div class="mb-3" invisible="state != 'done'">
                                <button name="action_open_rerun_wizard" type="object"
                                        string="Re-extract Website" class="btn btn-sm btn-secondary"
                                        confirm="Re-extract this website? Opens the rerun wizard."/>
                            </div>

                            <!-- Empty state: appears only when extraction
                                 produced zero screenshots AND zero assets. -->
                            <div class="alert alert-info mb-3"
                                 invisible="screenshot_keys or asset_keys">
                                <strong>No assets uploaded yet.</strong>
                                Either extraction has not finished, or the
                                Lambda hit an upload error. Check the
                                Quality / Pipeline tabs for details, or
                                click <em>Re-extract Website</em> above.
                            </div>

                            <!-- Extraction Summary (like Quality tab score breakdown) -->
                            <field name="asset_score_html" readonly="1" nolabel="1"
                                   invisible="not screenshot_keys and not asset_keys"/>

                            <group string="Screenshots" invisible="not screenshot_keys">
                                <field name="screenshot_urls_html" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Collected Assets" invisible="not asset_keys">
                                <field name="asset_urls_html" readonly="1" nolabel="1"/>
                            </group>
                        </page>

                        <!-- ============================== -->
                        <!-- TAB 4: Pipeline (admin only)   -->
                        <!-- ============================== -->
                        <page string="Pipeline" invisible="not is_admin">
                            <group>
                                <group string="Timing">
                                    <field name="started_at" readonly="1"/>
                                    <field name="completed_at" readonly="1"/>
                                    <field name="duration_seconds" readonly="1"/>
                                    <field name="last_heartbeat" readonly="1"/>
                                </group>
                                <group string="Extraction">
                                    <field name="page_count" readonly="1"/>
                                    <field name="tech_stack" readonly="1"/>
                                    <field name="llm_attempts" readonly="1"/>
                                    <field name="via_batch" readonly="1"/>
                                </group>
                            </group>
                            <group string="Links" invisible="not prd_url and not deliverables_url">
                                <field name="prd_url" widget="url" readonly="1"/>
                                <field name="deliverables_url" widget="url" readonly="1"/>
                            </group>
                            <group string="Error" invisible="not error_message">
                                <field name="error_message" readonly="1" nolabel="1"/>
                            </group>
                            <separator string="Extraction Data (sent to LLM)" invisible="not prd_prompt"/>
                            <field name="prd_prompt" readonly="1" invisible="not prd_prompt"/>
                            <separator string="Site Discovery" invisible="not site_discovery_json"/>
                            <field name="site_discovery_json" widget="json" readonly="1" invisible="not site_discovery_json"/>

                            <!-- Monitoring: what the Lambda + LLM actually did -->
                            <separator string="Extraction Warnings" invisible="not extraction_warnings"/>
                            <field name="extraction_warnings" readonly="1" nolabel="1" invisible="not extraction_warnings"/>
                            <separator string="Lambda Callback — status, phase log, extraction summary" invisible="not lambda_callback_json"/>
                            <field name="lambda_callback_json" widget="json" readonly="1" invisible="not lambda_callback_json"/>
                            <separator string="LLM Trace — every PRD attempt + QC" invisible="not llm_trace_json"/>
                            <field name="llm_trace_json" widget="json" readonly="1" invisible="not llm_trace_json"/>
                        </page>

                        <!-- Logs tab: per-job tail of every log record from
                             every process (Odoo / Worker / Lambda). Populated
                             live by log_handler.py for the [job=N]-tagged
                             Python logs; Lambda CloudWatch events are pulled
                             on demand via the Refresh button (admin only).
                             Always visible — empty list is fine when the job
                             is brand new. -->
                        <page string="Logs" name="logs">
                            <div class="oe_button_box mb-2">
                                <button name="action_refresh_lambda_logs"
                                        type="object"
                                        string="Refresh Lambda Logs"
                                        class="btn-secondary"
                                        groups="leviathan.group_leviathan_admin"
                                        invisible="not lambda_request_id"/>
                                <field name="lambda_request_id" readonly="1" class="ms-3"/>
                                <field name="last_lambda_log_ts" readonly="1" class="ms-3" invisible="not last_lambda_log_ts"/>
                            </div>
                            <field name="log_ids" nolabel="1" readonly="1">
                                <list decoration-danger="level == 'ERROR' or level == 'CRITICAL'"
                                      decoration-warning="level == 'WARNING'"
                                      decoration-muted="level == 'DEBUG'"
                                      default_order="timestamp asc, id asc"
                                      create="false" edit="false" delete="false">
                                    <field name="timestamp"/>
                                    <field name="source"/>
                                    <field name="level"/>
                                    <field name="pod" optional="hide"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SEARCH VIEW                                                  -->
    <!-- ============================================================ -->

    <record id="leviathan_job_view_search" model="ir.ui.view">
        <field name="name">leviathan.job.search</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="url"/>
                <field name="site_name"/>
                <field name="category_id"/>
                <filter name="my_tasks" string="My Tasks" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="not_assigned" string="Not Assigned" domain="[('state','=','not_assigned')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','in',('extracting','extracted','generating','generated','scoring','scored','qc_running'))]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="qc_failed" string="QC Failed" domain="[('qc_verdict','=','not_shippable')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_category" string="Category" context="{'group_by':'category_id'}"/>
                    <filter name="group_user" string="Tasker" context="{'group_by':'user_id'}"/>
                    <filter name="group_qc" string="QC Verdict" context="{'group_by':'qc_verdict'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- WINDOW ACTIONS                                               -->
    <!-- ============================================================ -->

    <!-- Admin: All Tasks -->
    <record id="action_leviathan_job" model="ir.actions.act_window">
        <field name="name">All Tasks</field>
        <field name="res_model">leviathan.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="leviathan_job_view_search"/>
        <field name="context">{}</field>
    </record>

    <!-- Tasker: My Tasks -->
    <record id="action_leviathan_job_tasker" model="ir.actions.act_window">
