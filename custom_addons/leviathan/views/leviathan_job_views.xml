<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rerun Wizard -->
    <record id="leviathan_rerun_wizard_view" model="ir.ui.view">
        <field name="name">leviathan.rerun.wizard.form</field>
        <field name="model">leviathan.rerun.wizard</field>
        <field name="arch" type="xml">
            <form string="Rerun Pipeline">
                <group>
                    <div class="alert alert-info" role="alert">
                        <strong>Do you want to re-extract the website?</strong>
                        <ul class="mb-0 mt-2">
                            <li><strong>No</strong> -- Keep existing extraction data, regenerate PRD and re-run QC</li>
                            <li><strong>Yes</strong> -- Re-extract the website from scratch, then regenerate PRD and QC</li>
                        </ul>
                    </div>
                </group>
                <footer>
                    <button name="action_rerun_generate_only" type="object" string="No, just regenerate" class="oe_highlight"/>
                    <button name="action_rerun_full" type="object" string="Yes, re-extract" class="btn-secondary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Import Wizard -->
    <record id="leviathan_import_wizard_view" model="ir.ui.view">
        <field name="name">leviathan.import.wizard.form</field>
        <field name="model">leviathan.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import URLs">
                <group>
                    <div class="alert alert-info" role="alert">
                        <p class="mb-1">Upload a CSV file with website URLs to add to the pool.</p>
                        <p class="mb-0"><strong>Required column:</strong> <code>url</code><br/>
                        <strong>Optional column:</strong> <code>category</code> (must match an existing category name)</p>
                    </div>
                    <field name="csv_file" filename="csv_filename"/>
                    <field name="csv_filename" invisible="1"/>
                    <field name="auto_assign"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leviathan_import_wizard" model="ir.actions.act_window">
        <field name="name">Import URLs</field>
        <field name="res_model">leviathan.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- List View -->
    <record id="leviathan_job_view_tree" model="ir.ui.view">
        <field name="name">leviathan.job.list</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-muted="state in ('cancelled','pool')" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="site_name"/>
                <field name="category_id"/>
                <field name="state" widget="badge" decoration-info="state in ('queued','extracting','generating','scoring')" decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-muted="state == 'pool'"/>
                <field name="score"/>
                <field name="grade"/>
                <field name="qc_verdict"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="leviathan_job_view_form" model="ir.ui.view">
        <field name="name">leviathan.job.form</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <form>
                <field name="is_admin" invisible="1"/>
                <header>
                    <!-- Pool: auto-assign this job to a tasker with open slots -->
                    <button name="action_assign_task" type="object" string="Assign" class="oe_highlight" invisible="state != 'pool' or not is_admin"/>

                    <!-- Draft: Run -->
                    <button name="action_queue" type="object" string="Run" class="oe_highlight" invisible="state != 'draft'"/>

                    <!-- Done: primary actions -->
                    <button name="action_download_zip" type="object" string="Download ZIP" class="oe_highlight" invisible="state != 'done' or not prd_text"/>
                    <button name="action_open_rerun_wizard" type="object" string="Rerun" class="btn-secondary" invisible="state != 'done'"/>
                    <button name="action_mark_submitted" type="object" string="Submit" class="btn-success" invisible="state != 'done'"/>

                    <!-- Failed: retry -->
                    <button name="action_retry" type="object" string="Retry" class="oe_highlight" invisible="state not in ('failed','cancelled')" confirm="Reset job to draft for re-queuing?"/>

                    <!-- Cancel (in-progress states) -->
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('pool','draft','done','failed','cancelled','submitted')"/>

                    <field name="state" widget="statusbar" statusbar_visible="pool,draft,queued,extracting,generating,scoring,done"/>
                </header>
                <sheet>
                    <!-- Pool Banner -->
                    <div class="alert alert-secondary" role="alert" invisible="state != 'pool'">
                        <strong>Pool</strong> -- This job is unassigned. It will be auto-assigned to a tasker, or an admin can assign it manually.
                    </div>

                    <!-- QC Failure Banner -->
                    <div class="alert alert-warning" role="alert" invisible="qc_verdict != 'not_shippable'">
                        <strong>QC Failed</strong> -- PRD not shippable.
                        Use the Quality tab actions to retry with QC feedback or rerun QC after editing.
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Top summary -->
                    <group>
                        <group>
                            <field name="url" widget="url"/>
                            <field name="site_name"/>
                            <field name="category_id"/>
                            <field name="user_id" readonly="not is_admin or state not in ('pool', 'draft')" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="score"/>
                            <field name="grade"/>
                            <field name="qc_verdict"/>
                            <field name="duration_seconds"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- TAB 1: PRD Editor -->
                        <page string="PRD Editor" invisible="not prd_text">
                            <div class="mb-2" invisible="state != 'done'">
                                <button name="action_save_prd_edit" type="object" string="Save Edits" class="btn btn-sm btn-primary me-1"/>
                            </div>
                            <field name="prd_text_html" widget="html"/>
                        </page>

                        <!-- TAB 2: PRD Raw -->
                        <page string="PRD (Raw)" invisible="not prd_text">
                            <field name="prd_text" readonly="1"/>
                        </page>

                        <!-- TAB 3: Quality -->
                        <page string="Quality" invisible="not score_report_json and not qc_report">
                            <div class="mb-3" invisible="state != 'done'">
                                <button name="action_regenerate_with_qc_feedback" type="object" string="Retry with QC Feedback" class="btn btn-sm btn-warning me-1" invisible="qc_verdict == 'shippable'" confirm="Regenerate PRD incorporating QC failure feedback?"/>
                                <button name="action_rerun_qc" type="object" string="Rerun QC" class="btn btn-sm btn-info me-1" confirm="Re-evaluate QC on the current PRD text?"/>
                            </div>

                            <div class="alert alert-success mb-3" role="alert" invisible="qc_verdict != 'shippable'">
                                <strong>SHIPPABLE</strong> -- PRD passed all QC checks.
                            </div>
                            <div class="alert alert-danger mb-3" role="alert" invisible="qc_verdict != 'not_shippable'">
                                <strong>NOT SHIPPABLE</strong> -- Issues below must be resolved.
                            </div>

                            <field name="score_report_html" readonly="1" nolabel="1" invisible="not score_report_json"/>
                            <separator string="QC Report" invisible="not qc_report"/>
                            <field name="qc_report" readonly="1" invisible="not qc_report"/>
                        </page>

                        <!-- TAB 4: Assets -->
                        <page string="Assets" invisible="not screenshot_keys and not asset_keys">
                            <group string="Screenshots" invisible="not screenshot_keys">
                                <field name="screenshot_urls_html" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Collected Assets" invisible="not asset_keys">
                                <field name="asset_urls_html" readonly="1" nolabel="1"/>
                            </group>
                            <group string="Artifacts Folder" invisible="not artifacts_url">
                                <field name="artifacts_url" widget="url" nolabel="1"/>
                            </group>
                        </page>

                        <!-- TAB 5: Pipeline -->
                        <page string="Pipeline">
                            <group>
                                <group string="Timing">
                                    <field name="started_at" readonly="1"/>
                                    <field name="completed_at" readonly="1"/>
                                    <field name="duration_seconds" readonly="1"/>
                                    <field name="last_heartbeat" readonly="1"/>
                                </group>
                                <group string="Extraction">
                                    <field name="page_count" readonly="1"/>
                                    <field name="tech_stack" readonly="1"/>
                                    <field name="llm_attempts" readonly="1"/>
                                </group>
                            </group>
                            <group string="Links" invisible="not prd_url and not deliverables_url">
                                <field name="prd_url" widget="url"/>
                                <field name="deliverables_url" widget="url"/>
                            </group>
                            <group string="Error" invisible="state != 'failed'">
                                <field name="error_message" readonly="1" nolabel="1"/>
                            </group>
                            <separator string="Extraction Data (sent to LLM)" invisible="not prd_prompt"/>
                            <field name="prd_prompt" readonly="1" invisible="not prd_prompt"/>
                            <separator string="Site Discovery" invisible="not site_discovery_json"/>
                            <field name="site_discovery_json" widget="json" readonly="1" invisible="not site_discovery_json"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="leviathan_job_view_search" model="ir.ui.view">
        <field name="name">leviathan.job.search</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="url"/>
                <field name="site_name"/>
                <field name="category_id"/>
                <filter name="my_jobs" string="My Jobs" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="pool" string="Pool (Unassigned)" domain="[('state','=','pool')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','in',('queued','extracting','generating','scoring'))]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="qc_failed" string="QC Failed" domain="[('qc_verdict','=','not_shippable')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_category" string="Category" context="{'group_by':'category_id'}"/>
                    <filter name="group_user" string="Tasker" context="{'group_by':'user_id'}"/>
                    <filter name="group_qc" string="QC Verdict" context="{'group_by':'qc_verdict'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Admin (sees all, can create) -->
    <record id="action_leviathan_job" model="ir.actions.act_window">
        <field name="name">Leviathan Jobs</field>
        <field name="res_model">leviathan.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="leviathan_job_view_search"/>
        <field name="context">{}</field>
    </record>

    <!-- Pool List View (with Assign Tasks button) -->
    <record id="leviathan_job_pool_view_tree" model="ir.ui.view">
        <field name="name">leviathan.job.pool.list</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'pool'">
                <header>
                    <button name="action_assign_tasks" type="object" string="Assign Tasks" class="oe_highlight"/>
                </header>
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="category_id"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Action: Admin Pool view (unassigned only) -->
    <record id="action_leviathan_pool" model="ir.actions.act_window">
        <field name="name">Job Pool</field>
        <field name="res_model">leviathan.job</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="leviathan_job_pool_view_tree"/>
        <field name="search_view_id" ref="leviathan_job_view_search"/>
        <field name="domain">[('state','=','pool')]</field>
        <field name="context">{'default_state': 'pool'}</field>
    </record>

    <!-- Action: Tasker (sees own, cannot create) -->
    <record id="action_leviathan_job_tasker" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">leviathan.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="leviathan_job_view_search"/>
        <field name="context">{'search_default_my_jobs': 1, 'create': False}</field>
    </record>
</odoo>
