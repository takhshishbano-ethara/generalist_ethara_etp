<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="leviathan_job_view_tree" model="ir.ui.view">
        <field name="name">leviathan.job.list</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-muted="state == 'cancelled'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="url"/>
                <field name="site_name"/>
                <field name="category_id"/>
                <field name="state" widget="badge" decoration-info="state in ('queued','extracting','generating','scoring')" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                <field name="score"/>
                <field name="grade"/>
                <field name="qc_verdict"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="leviathan_job_view_form" model="ir.ui.view">
        <field name="name">leviathan.job.form</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_queue" type="object" string="Queue" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done','failed','cancelled','submitted')"/>
                    <button name="action_retry" type="object" string="Retry (Full)" invisible="state not in ('failed','cancelled')" confirm="This will re-extract and regenerate from scratch. Continue?"/>
                    <button name="action_regenerate_with_qc_feedback" type="object" string="Regenerate PRD (with QC Feedback)" class="btn-warning" invisible="state != 'done' or qc_verdict == 'shippable'" confirm="This will regenerate the PRD using QC failure reasons as feedback. Continue?"/>
                    <button name="action_save_prd_edit" type="object" string="Save PRD Edits" class="oe_highlight" invisible="state != 'done'"/>
                    <button name="action_download_zip" type="object" string="Download ZIP" class="oe_highlight" invisible="not prd_text"/>
                    <button name="action_mark_submitted" type="object" string="Mark Submitted" class="btn-success" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,extracting,generating,scoring,done,submitted"/>
                </header>
                <sheet>
                    <!-- QC Failure Banner -->
                    <div class="alert alert-warning" role="alert" invisible="qc_verdict != 'not_shippable'">
                        <strong>⚠️ QC Failed — PRD Not Shippable</strong>
                        <p class="mb-0">Review the QC Report tab for specific issues. You can either:
                            (1) Edit the PRD directly in the Editor tab below,
                            (2) Click "Regenerate PRD (with QC Feedback)" to auto-fix via LLM.</p>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="qc_verdict != 'fixes'">
                        <strong>ℹ️ QC: Shippable with Fixes</strong>
                        <p class="mb-0">Minor issues found. Edit the PRD in the Editor tab or regenerate.</p>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="url" widget="url"/>
                            <field name="site_name"/>
                            <field name="category_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="score"/>
                            <field name="grade"/>
                            <field name="qc_verdict"/>
                            <field name="llm_attempts"/>
                            <field name="duration_seconds"/>
                            <field name="page_count"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- PRD Editor (HTML - editable by tasker) -->
                        <page string="PRD Editor" invisible="not prd_text">
                            <field name="prd_text_html" widget="html"/>
                        </page>
                        <!-- PRD Raw (read-only markdown) -->
                        <page string="PRD (Raw)" invisible="not prd_text">
                            <field name="prd_text" readonly="1"/>
                        </page>
                        <!-- QC Report (prominent when failed) -->
                        <page string="⚠️ QC Report" invisible="not qc_report" badge="qc_verdict">
                            <div class="alert alert-danger mb-3" invisible="qc_verdict != 'not_shippable'">
                                <strong>VERDICT: NOT SHIPPABLE</strong> — The issues below must be resolved before submission.
                            </div>
                            <field name="qc_report" readonly="1"/>
                        </page>
                        <!-- Score Breakdown -->
                        <page string="Score Report" invisible="not score_report_json">
                            <field name="score_report_json" widget="json"/>
                        </page>
                        <!-- Screenshots & Assets -->
                        <page string="Screenshots &amp; Assets" invisible="not screenshot_keys and not asset_keys">
                            <group string="Screenshots">
                                <field name="screenshot_keys" widget="json" readonly="1"/>
                            </group>
                            <group string="Assets">
                                <field name="asset_keys" widget="json" readonly="1"/>
                            </group>
                            <group string="Artifacts">
                                <field name="artifacts_url" widget="url"/>
                            </group>
                        </page>
                        <!-- Extraction Data (raw prompt sent to LLM) -->
                        <page string="Extraction Data" invisible="not prd_prompt">
                            <field name="prd_prompt" readonly="1"/>
                        </page>
                        <!-- Technical / Debug -->
                        <page string="Technical">
                            <group>
                                <group>
                                    <field name="tech_stack" readonly="1"/>
                                    <field name="prd_url" widget="url"/>
                                    <field name="deliverables_url" widget="url"/>
                                </group>
                                <group>
                                    <field name="started_at"/>
                                    <field name="completed_at"/>
                                    <field name="last_heartbeat"/>
                                    <field name="error_message" invisible="state != 'failed'"/>
                                </group>
                            </group>
                            <group string="Site Discovery (JSON)" invisible="not site_discovery_json">
                                <field name="site_discovery_json" widget="json" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="leviathan_job_view_search" model="ir.ui.view">
        <field name="name">leviathan.job.search</field>
        <field name="model">leviathan.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="url"/>
                <field name="site_name"/>
                <field name="category_id"/>
                <filter name="my_jobs" string="My Jobs" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state','in',('queued','extracting','generating','scoring'))]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="qc_failed" string="QC Failed" domain="[('qc_verdict','=','not_shippable')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_category" string="Category" context="{'group_by':'category_id'}"/>
                    <filter name="group_user" string="Tasker" context="{'group_by':'user_id'}"/>
                    <filter name="group_qc" string="QC Verdict" context="{'group_by':'qc_verdict'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_leviathan_job" model="ir.actions.act_window">
        <field name="name">Leviathan Jobs</field>
        <field name="res_model">leviathan.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="leviathan_job_view_search"/>
        <field name="context">{'search_default_my_jobs': 1}</field>
    </record>
</odoo>
