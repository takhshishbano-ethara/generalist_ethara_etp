        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="leviathan_job_view_search"/>
        <field name="context">{'search_default_my_tasks': 1, 'create': False}</field>
    </record>

    <!-- Bind tasker list view -->
    <record id="action_leviathan_job_tasker_tree" model="ir.actions.act_window.view">
