<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_leviathan_root"
              name="Leviathan"
              sequence="100"
              groups="group_leviathan_user"
              web_icon="leviathan,static/description/icon.png"/>

    <!-- Admin sees "All Tasks" (all, can create) -->
    <menuitem id="menu_leviathan_jobs_admin"
              name="All Tasks"
              parent="menu_leviathan_root"
              action="action_leviathan_job"
              sequence="10"
              groups="group_leviathan_admin"/>

    <!-- Tasker sees "My Tasks" (own tasks, Start Task button in list header) -->
    <menuitem id="menu_leviathan_jobs_tasker"
              name="My Tasks"
              parent="menu_leviathan_root"
              action="action_leviathan_job_tasker"
              sequence="11"
              groups="group_leviathan_user"/>

    <menuitem id="menu_leviathan_config"
              name="Configuration"
              parent="menu_leviathan_root"
              sequence="90"
              groups="group_leviathan_admin"/>

    <menuitem id="menu_leviathan_import"
              name="Import URLs"
              parent="menu_leviathan_config"
              action="action_leviathan_import_wizard"
              sequence="5"/>

    <menuitem id="menu_leviathan_settings"
              name="Settings"
              parent="menu_leviathan_config"
              action="base_setup.action_general_configuration"
              sequence="10"/>
</odoo>
