  <!-- ================= §08 METHODOLOGY ================= -->
  <section class="section" id="methodology" aria-labelledby="methodology-label" data-animate="fade-up">
    <p class="section-label" id="methodology-label">§08 · Methodology</p>
    <p class="section-desc">Three scoring principles ensure fair and reproducible results.</p>

    <div class="methodology-grid">
      <div class="meth-card" data-animate="fade-up" data-delay="0">
        <span class="meth-num mono">01</span>
        <h4 class="meth-title">Exact Match</h4>
        <p class="meth-desc">Answers must match ground truth exactly. No partial credit, no fuzzy matching.</p>
      </div>
      <div class="meth-card" data-animate="fade-up" data-delay="1">
        <span class="meth-num mono">02</span>
        <h4 class="meth-title">Tool Transparency</h4>
        <p class="meth-desc">All tool calls are logged. Models must demonstrate appropriate tool selection.</p>
      </div>
      <div class="meth-card" data-animate="fade-up" data-delay="2">
        <span class="meth-num mono">03</span>
        <h4 class="meth-title">Reproducibility</h4>
        <p class="meth-desc">Fixed seeds, deterministic scoring, published solution traces for independent verification.</p>
      </div>
    </div>
  </section>

  <!-- ================= §09 RESOURCES ================= -->
