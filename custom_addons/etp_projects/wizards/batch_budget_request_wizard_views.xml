<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etp_batch_budget_request_wizard_form" model="ir.ui.view">
        <field name="name">etp.batch.budget.request.wizard.form</field>
        <field name="model">etp.batch.budget.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Batch Budget">
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="project_budget_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="is_first_request" invisible="1"/>
                            <field name="requested_total" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="justification"
                               placeholder="Why is this budget needed? (Required)"/>
                    </group>
                    <notebook>
                        <page string="Model Lines" name="model_lines">
                            <field name="model_line_ids">
                                <list editable="bottom">
                                    <field name="ai_model_id"/>
                                    <field name="description"/>
                                    <field name="task_count"/>
                                    <field name="per_task_cost"/>
                                    <field name="requested_amount" sum="USD"/>
                                </list>
                            </field>
                        </page>
                        <page string="Infrastructure" name="infrastructure">
                            <field name="infra_line_ids">
                                <list editable="bottom">
                                    <field name="infra_type_id"/>
                                    <field name="description"/>
                                    <field name="requested_amount" sum="USD"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_submit" type="object"
                            string="Submit Request" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_etp_batch_budget_request_wizard" model="ir.actions.act_window">
        <field name="name">Request Batch Budget</field>
        <field name="res_model">etp.batch.budget.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_etp_batch_budget_request_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
