<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etp_batch_budget_request_wizard_form" model="ir.ui.view">
        <field name="name">etp.batch.budget.request.wizard.form</field>
        <field name="model">etp.batch.budget.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Phase Budget">
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="project_budget_id" readonly="1"/>
                            <field name="request_type"/>
                        </group>
                        <group>
                            <field name="total_tasks"
                                   invisible="request_type == 'topup'"/>
                            <field name="buffer_pct"
                                   invisible="request_type == 'topup'"/>
                            <field name="requested_total"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <group>
                        <field name="justification"
                               placeholder="Why is this budget needed? (Required)"/>
                    </group>
                    <group string="Notification to Approvers">
                        <field name="subject"
                               placeholder="Optional email subject (defaults if blank)"/>
                        <field name="message"
                               placeholder="Optional message included in the approval email"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <notebook>
                        <page string="Model Lines" name="model_lines"
                              invisible="request_type in ('topup', 'device')">
                            <field name="model_line_ids">
                                <list editable="bottom">
                                    <field name="ai_model_id"/>
                                    <field name="description"/>
                                    <field name="cost_type"/>
                                    <field name="per_trajectory_cost"
                                           readonly="cost_type == 'per_task'"/>
                                    <field name="iterations"
                                           readonly="cost_type == 'per_task'"/>
                                    <field name="per_task_cost"
                                           readonly="cost_type == 'per_trajectory'"/>
                                    <field name="requested_amount" sum="USD" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Infrastructure" name="infrastructure"
                              invisible="request_type in ('topup', 'new_model')">
                            <field name="infra_line_ids">
                                <list editable="bottom">
                                    <field name="infra_type_id"/>
                                    <field name="description"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="requested_amount" sum="USD"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subscriptions" name="subscriptions"
                              invisible="request_type == 'topup'">
                            <field name="subscription_line_ids">
                                <list editable="bottom">
                                    <field name="subscription_id"/>
                                    <field name="cost_per_subscription"/>
                                    <field name="assigned_user_ids"
                                           widget="many2many_tags"/>
                                    <field name="subscription_count"/>
                                    <field name="requested_amount" sum="USD"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_submit" type="object"
                            string="Submit Request" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_etp_batch_budget_request_wizard" model="ir.actions.act_window">
        <field name="name">Request Phase Budget</field>
        <field name="res_model">etp.batch.budget.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_etp_batch_budget_request_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
