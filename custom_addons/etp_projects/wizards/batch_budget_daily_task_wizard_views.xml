<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etp_batch_budget_daily_task_wizard_form" model="ir.ui.view">
        <field name="name">etp.batch.budget.daily.task.wizard.form</field>
        <field name="model">etp.batch.budget.daily.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Daily Task">
                <sheet>
                    <field name="batch_id" invisible="1"/>
                    <field name="connected_model" invisible="1"/>
                    <group string="Entry">
                        <field name="entry_date"/>
                        <field name="done_count"/>
                        <field name="total_cost"/>
                        <field name="note"/>
                    </group>
                    <group string="Per Task / Trajectory">
                        <field name="per_task_cost" readonly="1"/>
                        <field name="ideal_per_task_cost" readonly="1"/>
                        <field name="no_of_trajectory" readonly="1"/>
                        <field name="per_trajectory_cost" readonly="1"/>
                        <field name="ideal_per_trajectory_cost" readonly="1"/>
                        <field name="health_status" widget="badge"
                               decoration-success="health_status == 'healthy'"
                               decoration-warning="health_status == 'warning'"
                               decoration-danger="health_status == 'critical'"
                               decoration-muted="health_status == 'unknown'"/>
                    </group>
                    <group string="Daily Infra / Subscription">
                        <field name="infra_cost" readonly="1"/>
                        <field name="subscription_cost" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_etp_batch_budget_daily_task_wizard" model="ir.actions.act_window">
        <field name="name">Add Daily Task</field>
        <field name="res_model">etp.batch.budget.daily.task.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_batch_id': active_id}</field>
    </record>

</odoo>
