<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etp_project_aws_budget_list" model="ir.ui.view">
        <field name="name">etp.project.aws.budget.list</field>
        <field name="model">etp.project.aws.budget</field>
        <field name="arch" type="xml">
            <list string="Project AWS Budgets">
                <field name="project_id"/>
                <field name="name"/>
                <field name="project_type" optional="show"/>
                <field name="budget_amount" optional="show" sum="USD"/>
                <field name="tags_summary"/>
                <field name="last_fetched_at"/>
            </list>
        </field>
    </record>

    <record id="view_etp_project_aws_budget_form" model="ir.ui.view">
        <field name="name">etp.project.aws.budget.form</field>
        <field name="model">etp.project.aws.budget</field>
        <field name="arch" type="xml">
            <form string="Project AWS Budget">
                <header>
                    <button name="action_fetch_cost" type="object" string="Fetch Cost" class="btn-primary"/>
                    <button name="action_fetch_openrouter" type="object" string="Fetch OpenRouter" class="btn-secondary" invisible="not openrouter_enabled"/>
                    <button name="action_fetch_moonshot" type="object" string="Fetch Moonshot" class="btn-secondary" invisible="not moonshot_enabled"/>
                    <button name="action_fetch_openai" type="object" string="Fetch OpenAI" class="btn-secondary" invisible="not openai_enabled"/>
                    <button name="action_fetch_gcp" type="object" string="Fetch GCP" class="btn-secondary" invisible="not gcp_enabled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Alpha Q3 Cloud Budget"/></h1>
                    </div>
                    <group>
                        <group string="Project">
                            <field name="project_id"/>
                            <field name="project_type"/>
                            <field name="budget_amount"/>
                            <field name="active"/>
                        </group>
                        <group string="Status">
                            <field name="last_fetched_at" readonly="1"/>
                            <field name="cost_line_count" readonly="1"/>
                            <field name="total_approved_amount" readonly="1"/>
                            <field name="topup_total_amount" readonly="1"/>
                            <field name="batch_budget_remain" readonly="1"/>
                            <field name="allocated_amount" readonly="1"/>
                            <field name="consumed_amount" readonly="1"/>
                            <field name="llm_consumed_amount" readonly="1"/>
                            <field name="remaining_amount" readonly="1"/>
                            <field name="allocatable_amount" readonly="1"/>
                            <field name="consumed_pct" readonly="1" widget="progressbar"/>
                            <field name="health_status" widget="badge" readonly="1"
                                   decoration-success="health_status == 'healthy'"
                                   decoration-info="health_status == 'warning'"
                                   decoration-warning="health_status == 'at_risk'"
                                   decoration-danger="health_status == 'critical'"
                                   decoration-muted="health_status == 'unknown'"/>
                        </group>
                    </group>
                    <group string="Approvals">
                        <group>
                            <field name="approver_user_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="cto_user_id"/>
                        </group>
                    </group>
                    <group string="AWS Credentials">
                        <group>
                            <field name="aws_access_key_id" password="True"/>
                            <field name="aws_secret_access_key" password="True"/>
                        </group>
                        <group>
                            <field name="aws_region"/>
                            <field name="fetch_months"/>
                        </group>
                    </group>
                    <group string="AWS Tag Filters">
                        <field name="tag_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="tag_key" placeholder="e.g. Project"/>
                                <field name="tag_value" placeholder="e.g. etharaA"/>
                                <field name="active" optional="show"/>
                            </list>
                        </field>
                    </group>
                    <group string="OpenRouter">
                        <group>
                            <field name="openrouter_enabled"/>
                            <field name="openrouter_api_key" password="True" invisible="not openrouter_enabled" required="openrouter_enabled"/>
                            <field name="openrouter_inference_key_hash" invisible="not openrouter_enabled" placeholder="SHA-256 hash (optional, for per-project filter)"/>
                        </group>
                        <group>
                            <field name="last_openrouter_fetched_at" readonly="1" invisible="not openrouter_enabled"/>
                        </group>
                    </group>
                    <group string="Moonshot">
                        <group>
                            <field name="moonshot_enabled"/>
                            <field name="moonshot_api_key" password="True" invisible="not moonshot_enabled" required="moonshot_enabled"/>
                        </group>
                        <group>
                            <field name="last_moonshot_fetched_at" readonly="1" invisible="not moonshot_enabled"/>
                            <field name="moonshot_last_used_usd" readonly="1" invisible="not moonshot_enabled"/>
                            <field name="moonshot_last_used_at" readonly="1" invisible="not moonshot_enabled"/>
                        </group>
                    </group>
                    <group string="OpenAI">
                        <group>
                            <field name="openai_enabled"/>
                            <field name="openai_api_key" password="True" invisible="not openai_enabled" required="openai_enabled"/>
                            <field name="openai_project_id" invisible="not openai_enabled" placeholder="proj_..."/>
                        </group>
                        <group>
                            <field name="last_openai_fetched_at" readonly="1" invisible="not openai_enabled"/>
                        </group>
                    </group>
                    <group string="GCP (BigQuery Billing Export)">
                        <group>
                            <field name="gcp_enabled"/>
                            <field name="gcp_project_id" invisible="not gcp_enabled" required="gcp_enabled" placeholder="e.g. my-billing-project"/>
                            <field name="gcp_bq_dataset" invisible="not gcp_enabled" required="gcp_enabled"/>
                            <field name="gcp_bq_table" invisible="not gcp_enabled" required="gcp_enabled" placeholder="gcp_billing_export_v1_XXXXXX_YYYYYY"/>
                        </group>
                        <group>
                            <field name="last_gcp_fetched_at" readonly="1" invisible="not gcp_enabled"/>
                            <field name="gcp_service_filter" invisible="not gcp_enabled" placeholder="e.g. Generative Language API"/>
                            <field name="gcp_label_key" invisible="not gcp_enabled" placeholder="e.g. team"/>
                            <field name="gcp_label_value" invisible="not gcp_enabled" placeholder="e.g. alpha"/>
                        </group>
                        <group colspan="2" invisible="not gcp_enabled">
                            <field name="gcp_service_account_json" required="gcp_enabled" widget="text"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models" name="models">
                            <field name="model_line_ids">
                                <list editable="bottom">
                                    <field name="ai_model_id"/>
                                    <field name="per_task_cost" sum="USD"/>
                                </list>
                            </field>
                        </page>
                        <page string="Infrastructure" name="infrastructure">
                            <field name="infra_line_ids">
                                <list editable="bottom">
                            <field name="infra_type_id"/>
                            <field name="description"/>
                            <field name="budget_amount" sum="USD"/>
                                </list>
                            </field>
                        </page>
                        <page string="Batches" name="batches">
                            <field name="batch_budget_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="total_tasks"/>
                                    <field name="batch_budget" sum="USD" optional="hide"/>
                                    <field name="approved_amount" sum="USD"/>
                                    <field name="consumed_cost" sum="USD"/>
                                    <field name="remaining_cost" sum="USD"/>
                                    <field name="health_status" widget="badge"
                                           decoration-success="health_status == 'healthy'"
                                           decoration-info="health_status == 'warning'"
                                           decoration-warning="health_status == 'at_risk'"
                                           decoration-danger="health_status == 'critical'"
                                           decoration-muted="health_status == 'unknown'"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state in ('approved','delivered')"
                                           decoration-primary="state == 'in_progress'"
                                           decoration-danger="state == 'rejected'"
                                           decoration-muted="state in ('draft','withdrawn','closed')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Top-ups" name="topups">
                            <field name="topup_ids" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="name"/>
                                    <field name="amount" sum="USD"/>
                                    <field name="requester_id"/>
                                    <field name="approver_id" optional="show"/>
                                    <field name="approval_date" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'pending'"
                                           decoration-success="state == 'approved'"
                                           decoration-danger="state == 'rejected'"
                                           decoration-muted="state == 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cost Lines (Service Breakdown)" name="cost_lines">
                            <field name="cost_line_ids" readonly="1">
                                <list>
                                    <field name="period"/>
                                    <field name="granularity" optional="show"/>
                                    <field name="service_name"/>
                                    <field name="model_name" optional="show"/>
                                    <field name="token_type" optional="show"/>
                                    <field name="usage_quantity" optional="hide" sum="Usage"/>
                                    <field name="usage_unit" optional="hide"/>
                                    <field name="is_model_breakdown" optional="hide"/>
                                    <field name="source" optional="show"/>
                                    <field name="source_tag_key" optional="show"/>
                                    <field name="source_tag_value" optional="show"/>
                                    <field name="amount_source" sum="USD"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fetch History" name="fetch_history">
                            <field name="fetch_log_ids" readonly="1">
                                <list create="0" edit="0" delete="0"
                                      decoration-success="status == 'success'"
                                      decoration-danger="status == 'error'">
                                    <field name="fetched_at"/>
                                    <field name="source"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'success'"
                                           decoration-danger="status == 'error'"/>
                                    <field name="triggered_by_id"/>
                                    <field name="created_count" sum="Created"/>
                                    <field name="updated_count" sum="Updated"/>
                                    <field name="tags_summary" optional="show"/>
                                    <field name="fetch_months" optional="hide"/>
                                    <field name="api_hit_count" sum="API Hits" optional="show"/>
                                    <field name="api_hit_cost_usd" sum="API Cost (USD)" optional="show"/>
                                    <field name="error_message" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_etp_project_aws_budget_search" model="ir.ui.view">
        <field name="name">etp.project.aws.budget.search</field>
        <field name="model">etp.project.aws.budget</field>
        <field name="arch" type="xml">
            <search string="Project AWS Budgets">
                <field name="name"/>
                <field name="project_id"/>
                <field name="project_type"/>
                <filter name="filter_project_type_rnd" string="R&amp;D" domain="[('project_type','=','rnd')]"/>
                <filter name="filter_project_type_ops" string="Operations" domain="[('project_type','=','operations')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active','=',False)]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                    <filter name="group_project_type" string="Project Type" context="{'group_by':'project_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_etp_project_aws_budget" model="ir.actions.act_window">
        <field name="name">Project AWS Budgets</field>
        <field name="res_model">etp.project.aws.budget</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_etp_project_aws_budget_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a project AWS budget</p>
            <p>Set the project, AWS keys, and Tag Key + Value. Click <b>Fetch Cost</b> to pull per-service spend from Cost Explorer.</p>
        </field>
    </record>

    <record id="view_etp_project_aws_cost_line_list" model="ir.ui.view">
        <field name="name">etp.project.aws.cost.line.list</field>
        <field name="model">etp.project.aws.cost.line</field>
        <field name="arch" type="xml">
            <list string="AWS Cost by Service" create="0">
                <field name="period"/>
                <field name="granularity" optional="show"/>
                <field name="project_id"/>
                <field name="source_tag_key"/>
                <field name="source_tag_value"/>
                <field name="service_name"/>
                <field name="model_name" optional="show"/>
                <field name="token_type" optional="show"/>
                <field name="usage_quantity" optional="hide" sum="Usage"/>
                <field name="usage_unit" optional="hide"/>
                <field name="usage_type" optional="hide"/>
                <field name="is_model_breakdown" optional="hide"/>
                <field name="source" optional="show"/>
                <field name="amount_source" sum="USD"/>
            </list>
        </field>
    </record>

    <record id="view_etp_project_aws_cost_line_pivot" model="ir.ui.view">
        <field name="name">etp.project.aws.cost.line.pivot</field>
        <field name="model">etp.project.aws.cost.line</field>
        <field name="arch" type="xml">
            <pivot string="AWS Cost by Service" sample="1">
                <field name="service_name" type="row"/>
                <field name="model_name" type="row"/>
                <field name="period" type="col" interval="month"/>
                <field name="amount_source" type="measure"/>
                <field name="usage_quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_etp_project_aws_cost_line_graph" model="ir.ui.view">
        <field name="name">etp.project.aws.cost.line.graph</field>
        <field name="model">etp.project.aws.cost.line</field>
        <field name="arch" type="xml">
            <graph string="AWS Cost by Service" type="bar" stacked="1" sample="1">
                <field name="service_name"/>
                <field name="amount_source" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_etp_project_aws_cost_line_search" model="ir.ui.view">
        <field name="name">etp.project.aws.cost.line.search</field>
        <field name="model">etp.project.aws.cost.line</field>
        <field name="arch" type="xml">
            <search string="AWS Cost by Service">
                <field name="project_id"/>
                <field name="service_name"/>
                <field name="model_name"/>
                <field name="usage_type"/>
                <field name="source_tag_key"/>
                <field name="source_tag_value"/>
                <field name="source"/>
                <field name="granularity"/>
                <field name="token_type"/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('period','&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_service_rows" string="Service Rows" domain="[('is_model_breakdown','=',False)]"/>
                <filter name="filter_model_rows" string="Model Breakdown" domain="[('is_model_breakdown','=',True)]"/>
                <separator/>
                <filter name="filter_aws_source" string="AWS" domain="[('source','=','aws')]"/>
                <filter name="filter_openrouter_source" string="OpenRouter" domain="[('source','=','openrouter')]"/>
                <filter name="filter_moonshot_source" string="Moonshot" domain="[('source','=','moonshot')]"/>
                <filter name="filter_openai_source" string="OpenAI" domain="[('source','=','openai')]"/>
                <filter name="filter_gcp_source" string="GCP" domain="[('source','=','gcp')]"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                    <filter name="group_service" string="Service" context="{'group_by':'service_name'}"/>
                    <filter name="group_model" string="Model" context="{'group_by':'model_name'}"/>
                    <filter name="group_token_type" string="Token Type" context="{'group_by':'token_type'}"/>
                    <filter name="group_period" string="Period" context="{'group_by':'period:month'}"/>
                    <filter name="group_source" string="Source" context="{'group_by':'source'}"/>
                    <filter name="group_source_tag" string="Source Tag" context="{'group_by':'source_tag_key'}"/>
                    <filter name="group_granularity" string="Granularity" context="{'group_by':'granularity'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_etp_project_aws_cost_line" model="ir.actions.act_window">
        <field name="name">AWS Cost by Service</field>
        <field name="res_model">etp.project.aws.cost.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_etp_project_aws_cost_line_search"/>
    </record>

    <menuitem id="menu_etp_project_aws_root" name="AWS Budgets" parent="project.menu_main_pm" sequence="80"/>
    <menuitem id="menu_etp_project_aws_budget" name="Project Budgets" parent="menu_etp_project_aws_root" action="action_etp_project_aws_budget" sequence="10"/>
    <menuitem id="menu_etp_project_aws_cost_line" name="AWS Cost by Service" parent="menu_etp_project_aws_root" action="action_etp_project_aws_cost_line" sequence="20"/>
    <menuitem id="menu_etp_batch_budget" name="Batch Budgets" parent="menu_etp_project_aws_root" action="action_etp_batch_budget" sequence="15"/>
    <menuitem id="menu_etp_ai_model" name="AI Models" parent="menu_etp_project_aws_root" action="action_etp_ai_model" sequence="30"/>

</odoo>
