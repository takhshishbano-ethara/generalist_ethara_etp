<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_etp_projects" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.etp.projects</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ETP Projects" string="ETP Projects" name="etp_projects">
                    <block title="Project Budget Approvals" help="Defaults applied when a new Project Budget is created.">
                        <setting string="Default Approvers"
                                 help="Users automatically added as approvers on every new Project Budget (form view and API). API callers can supply additional approver_ids — they are merged with this list.">
                            <field name="etp_default_approver_user_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </setting>
                    </block>
                    <block title="AWS Credentials" groups="base.group_system" help="AWS IAM keys used to fetch the service catalog from the AWS Pricing API. Paste and click Sync AWS Pricing Now.">
                        <setting string="AWS_ACCESS_KEY_ID"
                                 help="AWS IAM access key ID (starts with AKIA...).">
                            <field name="etp_aws_access_key_id" password="True" placeholder="AKIA..."/>
                        </setting>
                        <setting string="AWS_SECRET_ACCESS_KEY"
                                 help="AWS IAM secret access key.">
                            <field name="etp_aws_secret_access_key" password="True" placeholder="Paste secret"/>
                        </setting>
                        <setting string="AWS_REGION"
                                 help="Default AWS region used when fetching pricing. Example: us-east-1.">
                            <field name="etp_aws_region_name" placeholder="us-east-1"/>
                        </setting>
                        <setting string="AWS Pricing Sync"
                                 help="Fetch the AWS service catalog into Odoo. Runs automatically every day at 02:00 UTC.">
                            <div class="d-flex align-items-center gap-2">
                                <button name="action_trigger_aws_sync" type="object" string="Sync AWS Pricing Now" class="btn btn-primary"/>
                            </div>
                            <field name="etp_aws_synced_service_count" invisible="1"/>
                            <div class="text-muted mt-2">
                                <field name="etp_aws_last_sync_summary" nolabel="1" readonly="1"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
