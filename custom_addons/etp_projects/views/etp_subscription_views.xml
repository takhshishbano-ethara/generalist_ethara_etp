<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etp_subscription_list" model="ir.ui.view">
        <field name="name">etp.subscription.list</field>
        <field name="model">etp.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="cost" sum="USD"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_etp_subscription_form" model="ir.ui.view">
        <field name="name">etp.subscription.form</field>
        <field name="model">etp.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="cost"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etp_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">etp.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
