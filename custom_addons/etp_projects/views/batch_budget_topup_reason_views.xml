<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etp_batch_budget_topup_reason_list" model="ir.ui.view">
        <field name="name">etp.batch.budget.topup.reason.list</field>
        <field name="model">etp.batch.budget.topup.reason</field>
        <field name="arch" type="xml">
            <list string="Top-up Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_etp_batch_budget_topup_reason_form" model="ir.ui.view">
        <field name="name">etp.batch.budget.topup.reason.form</field>
        <field name="model">etp.batch.budget.topup.reason</field>
        <field name="arch" type="xml">
            <form string="Top-up Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_etp_batch_budget_topup_reason_search" model="ir.ui.view">
        <field name="name">etp.batch.budget.topup.reason.search</field>
        <field name="model">etp.batch.budget.topup.reason</field>
        <field name="arch" type="xml">
            <search string="Top-up Reasons">
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_etp_batch_budget_topup_reason" model="ir.actions.act_window">
        <field name="name">Top-up Reasons</field>
        <field name="res_model">etp.batch.budget.topup.reason</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_etp_batch_budget_topup_reason_search"/>
    </record>

    <menuitem id="menu_etp_batch_budget_topup_reason"
              name="Top-up Reasons"
              parent="menu_etp_project_aws_root"
              action="action_etp_batch_budget_topup_reason"
              sequence="60"/>

</odoo>
