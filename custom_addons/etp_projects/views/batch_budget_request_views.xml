<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etp_batch_budget_request_list" model="ir.ui.view">
        <field name="name">etp.batch.budget.request.list</field>
        <field name="model">etp.batch.budget.request</field>
        <field name="arch" type="xml">
            <list string="Phase Budget Requests"
                  decoration-info="state == 'pending'"
                  decoration-success="state in ('approved','partially_approved')"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state in ('draft','withdrawn')">
                <field name="name"/>
                <field name="batch_id"/>
                <field name="project_id"/>
                <field name="sequence_number"/>
                <field name="request_date"/>
                <field name="requester_id"/>
                <field name="requested_total" sum="USD"/>
                <field name="approved_total" sum="USD"/>
                <field name="parent_request_id" optional="hide"/>
                <field name="approver_id" optional="show"/>
                <field name="approval_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state in ('approved','partially_approved')"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state in ('draft','withdrawn')"/>
            </list>
        </field>
    </record>

    <record id="view_etp_batch_budget_request_form" model="ir.ui.view">
        <field name="name">etp.batch.budget.request.form</field>
        <field name="model">etp.batch.budget.request</field>
        <field name="arch" type="xml">
            <form string="Phase Budget Request">
                <header>
                    <button name="action_submit_for_approval" type="object"
                            string="Submit for Approval" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-secondary"
                            invisible="state != 'pending'"/>
                    <button name="action_withdraw" type="object"
                            string="Withdraw" class="btn-secondary"
                            invisible="state not in ('draft','pending')"/>
                    <button name="action_create_follow_up" type="object"
                            string="Create Follow-up Request" class="btn-primary"
                            invisible="not can_follow_up"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <field name="is_followup" invisible="1"/>
                    <field name="can_follow_up" invisible="1"/>
                    <field name="has_active_followup" invisible="1"/>
                    <field name="follow_up_count" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_follow_ups" type="object"
                                class="oe_stat_button" icon="fa-list-alt"
                                invisible="follow_up_count == 0">
                            <field name="follow_up_count" widget="statinfo"
                                   string="Follow-ups"/>
                        </button>
                        <button name="action_open_parent_request" type="object"
                                class="oe_stat_button" icon="fa-arrow-up"
                                invisible="not parent_request_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Parent</span>
                                <span class="o_stat_value">
                                    <field name="parent_request_id" readonly="1" nolabel="1"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Source">
                            <field name="batch_id" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="project_id" readonly="1"/>
                            <field name="project_budget_id" readonly="1"/>
                            <field name="sequence_number" readonly="1"/>
                        </group>
                        <group string="Decision">
                            <field name="requester_id" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                            <field name="approver_id" readonly="1"
                                   invisible="not approver_id"/>
                            <field name="approval_date" readonly="1"
                                   invisible="not approval_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="justification"
                               readonly="state != 'draft'"
                               placeholder="Why is this budget needed?"/>
                    </group>
                    <group string="Totals">
                        <group>
                            <field name="total_tasks" readonly="state != 'draft'"/>
                            <field name="buffer_pct" readonly="state != 'draft'"/>
                            <field name="requested_total"/>
                        </group>
                        <group>
                            <field name="approved_total"/>
                            <field name="remaining_amount"
                                   invisible="state != 'partially_approved'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Model Lines" name="model_lines">
                            <field name="model_line_ids"
                                   readonly="state not in ('draft','pending')">
                                <list editable="bottom">
                                    <field name="ai_model_id"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="description"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="cost_type"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="per_trajectory_cost"
                                           readonly="parent.state != 'draft' or cost_type == 'per_task'"/>
                                    <field name="iterations"
                                           readonly="parent.state != 'draft' or cost_type == 'per_task'"/>
                                    <field name="per_task_cost"
                                           readonly="parent.state != 'draft' or cost_type == 'per_trajectory'"/>
                                    <field name="requested_amount" sum="USD"
                                           readonly="1"/>
                                    <field name="approved_amount" sum="USD"
                                           readonly="parent.state not in ('draft','pending')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Infrastructure" name="infrastructure">
                            <field name="infra_line_ids"
                                   readonly="state not in ('draft','pending')">
                                <list editable="bottom">
                                    <field name="infra_type_id"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="description"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="requested_amount" sum="USD"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="approved_amount" sum="USD"
                                           readonly="parent.state not in ('draft','pending')"/>
                                    <field name="start_date"
                                           readonly="parent.state not in ('draft','pending')"/>
                                    <field name="end_date"
                                           readonly="parent.state not in ('draft','pending')"/>
                                    <field name="per_day_requested" sum="USD"/>
                                    <field name="per_day_approved" sum="USD"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subscriptions" name="subscriptions">
                            <field name="subscription_line_ids"
                                   readonly="state not in ('draft','pending')">
                                <list editable="bottom">
                                    <field name="subscription_id"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="assigned_user_ids" widget="many2many_tags"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="cost_per_subscription"/>
                                    <field name="subscription_count"/>
                                    <field name="final_amount" sum="USD"/>
                                    <field name="requested_amount" sum="USD"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="approved_amount" sum="USD"
                                           readonly="parent.state not in ('draft','pending')"/>
                                    <field name="per_day_cost" sum="USD"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notification" name="notification">
                            <group>
                                <field name="priority" readonly="state != 'draft'"/>
                                <field name="subject" readonly="state != 'draft'"/>
                            </group>
                            <field name="message" readonly="state != 'draft'"/>
                            <field name="attachment_ids" widget="many2many_binary"
                                   readonly="state != 'draft'"/>
                        </page>
                        <page string="Rejection" name="rejection"
                              invisible="state != 'rejected'">
                            <group>
                                <field name="rejection_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_etp_batch_budget_request_search" model="ir.ui.view">
        <field name="name">etp.batch.budget.request.search</field>
        <field name="model">etp.batch.budget.request</field>
        <field name="arch" type="xml">
            <search string="Phase Budget Requests">
                <field name="name"/>
                <field name="batch_id"/>
                <field name="project_id"/>
                <field name="requester_id"/>
                <field name="approver_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_pending" string="Pending Approval" domain="[('state','=','pending')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="filter_partial" string="Partially Approved" domain="[('state','=','partially_approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter name="filter_followups" string="Follow-ups Only"
                        domain="[('parent_request_id','!=', False)]"/>
                <filter name="filter_originals" string="Originals Only"
                        domain="[('parent_request_id','=', False)]"/>
                <separator/>
                <filter name="filter_my_requests" string="My Requests"
                        domain="[('requester_id','=', uid)]"/>
                <filter name="filter_to_approve" string="To Approve"
                        domain="[('state','=','pending'), ('project_budget_id.approver_user_ids','in', uid)]"/>
                <group>
                    <filter name="group_batch" string="Phase" context="{'group_by':'batch_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_requester" string="Requester" context="{'group_by':'requester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_etp_batch_budget_request" model="ir.actions.act_window">
        <field name="name">Budget Requests</field>
        <field name="res_model">etp.batch.budget.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_etp_batch_budget_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No budget requests yet</p>
            <p>Open a Phase Budget and click <b>Request Budget</b> to submit a new request.</p>
        </field>
    </record>

    <record id="view_etp_batch_budget_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">etp.batch.budget.request.reject.wizard.form</field>
        <field name="model">etp.batch.budget.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Budget Request">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="reason" placeholder="Why is this request being rejected?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Reject" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_etp_batch_budget_request"
              name="Budget Requests"
              parent="menu_etp_project_aws_root"
              action="action_etp_batch_budget_request"
              sequence="18"/>

</odoo>
