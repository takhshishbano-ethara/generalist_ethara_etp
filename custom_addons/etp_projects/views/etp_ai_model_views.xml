<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etp_ai_model_list" model="ir.ui.view">
        <field name="name">etp.ai.model.list</field>
        <field name="model">etp.ai.model</field>
        <field name="arch" type="xml">
            <list string="AI Models" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_etp_ai_model_form" model="ir.ui.view">
        <field name="name">etp.ai.model.form</field>
        <field name="model">etp.ai.model</field>
        <field name="arch" type="xml">
            <form string="AI Model">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="provider"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etp_ai_model" model="ir.actions.act_window">
        <field name="name">AI Models</field>
        <field name="res_model">etp.ai.model</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
