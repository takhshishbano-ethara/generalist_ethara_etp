<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Project form: Internal/External classification field -->
    <record id="edit_project_classification" model="ir.ui.view">
        <field name="name">project.project.form.classification</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="project_classification" widget="radio" options="{'horizontal': true}"/>
                <field name="connected_table"/>
                <field name="category_url"/>
                <field name="budget_refresh_url"/>
                <field name="tasker_url"/>
            </xpath>
            <xpath expr="//page[@name='settings']" position="after">
                <page name="api_mappings" string="API Mappings"
                      invisible="project_classification != 'external'">
                    <field name="api_map_ids">
                        <list editable="bottom">
                            <field name="table_name"/>
                            <field name="field_name"/>
                            <field name="api_prefix"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Project form: role-filter domains, TPM field, CSV import button -->
    <record id="edit_project_team_assignment" model="ir.ui.view">
        <field name="name">project.project.form.team.assignment</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_extension.edit_project_inherit_extension"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='technical_team']" position="attributes">
                <attribute name="string">Project Team</attribute>
            </xpath>
            <xpath expr="//page[@name='technical_team']/group" position="before">
                <div class="oe_button_box">
                    <button name="%(action_etp_project_team_csv_import)d"
                            type="action"
                            string="Import Team CSV"
                            class="btn-primary"
                            icon="fa-upload"
                            context="{'default_project_id': id}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='project_tasker']" position="attributes">
                <attribute name="domain">[('user_id.user_role.name', '=', 'Tasker')]</attribute>
            </xpath>
            <xpath expr="//field[@name='project_qc_reviewer']" position="attributes">
                <attribute name="domain">[('user_id.user_role.name', 'in', ['QC', 'QR'])]</attribute>
            </xpath>
            <xpath expr="//field[@name='project_lead']" position="attributes">
                <attribute name="domain">[('user_id.user_role.name', '=', 'PL')]</attribute>
            </xpath>
            <xpath expr="//field[@name='project_lead']" position="before">
                <field name="project_tpm"
                       widget="many2many_tags"
                       domain="[('user_id.user_role.name', '=', 'TPM')]"
                       options="{'color_field': 'color'}"/>
            </xpath>
        </field>
    </record>

    <!-- Restrict the base Project app to internal projects only -->
    <record id="project.open_view_project_all" model="ir.actions.act_window">
        <field name="domain">[("is_template", "=", False), ("project_classification", "=", "internal")]</field>
    </record>
    <record id="project.open_view_project_all_group_stage" model="ir.actions.act_window">
        <field name="domain">[("is_template", "=", False), ("project_classification", "=", "internal")]</field>
    </record>
    <record id="project.open_view_project_all_config" model="ir.actions.act_window">
        <field name="domain">[("is_template", "=", False), ("project_classification", "=", "internal")]</field>
    </record>
    <record id="project.open_view_project_all_config_group_stage" model="ir.actions.act_window">
        <field name="domain">[("is_template", "=", False), ("project_classification", "=", "internal")]</field>
    </record>

    <!-- Restrict the Tasks menus to tasks of internal projects -->
    <!-- (private tasks with no project remain visible) -->
    <record id="project.action_view_task" model="ir.actions.act_window">
        <field name="domain">[('project_id', '!=', False), ('has_template_ancestor', '=', False), ('project_id.project_classification', '=', 'internal')]</field>
    </record>
    <record id="project.action_view_my_task" model="ir.actions.act_window">
        <field name="domain">['&amp;', '&amp;', ('user_ids', 'in', uid), ('has_template_ancestor', '=', False), '|', ('project_id', '=', False), ('project_id.project_classification', '=', 'internal')]</field>
    </record>
    <record id="project.action_view_all_task" model="ir.actions.act_window">
        <field name="domain">['&amp;', ('has_template_ancestor', '=', False), '|', ('project_id', '=', False), ('project_id.project_classification', '=', 'internal')]</field>
    </record>

</odoo>
