<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etp_infra_type_list" model="ir.ui.view">
        <field name="name">etp.infra.type.list</field>
        <field name="model">etp.infra.type</field>
        <field name="arch" type="xml">
            <list string="Infrastructure Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_etp_infra_type_form" model="ir.ui.view">
        <field name="name">etp.infra.type.form</field>
        <field name="model">etp.infra.type</field>
        <field name="arch" type="xml">
            <form string="Infrastructure Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_etp_infra_type_search" model="ir.ui.view">
        <field name="name">etp.infra.type.search</field>
        <field name="model">etp.infra.type</field>
        <field name="arch" type="xml">
            <search string="Infrastructure Types">
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_etp_infra_type" model="ir.actions.act_window">
        <field name="name">Infrastructure Types</field>
        <field name="res_model">etp.infra.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_etp_infra_type_search"/>
    </record>

</odoo>
