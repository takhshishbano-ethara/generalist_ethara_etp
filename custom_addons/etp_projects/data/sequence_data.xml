<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_etp_batch_budget" model="ir.sequence">
            <field name="name">Phase Budget</field>
            <field name="code">etp.batch.budget</field>
            <field name="prefix">PB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_etp_project_budget_topup" model="ir.sequence">
            <field name="name">Project Budget Top-up</field>
            <field name="code">etp.project.budget.topup</field>
            <field name="prefix">PBT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_etp_batch_budget_request" model="ir.sequence">
            <field name="name">Phase Budget Request</field>
            <field name="code">etp.batch.budget.request</field>
            <field name="prefix">PBR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
