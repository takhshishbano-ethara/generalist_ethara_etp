<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_batch_approval_request" model="mail.template">
            <field name="name">Batch Budget: Approval Request</field>
            <field name="model_id" ref="model_etp_batch_budget"/>
            <field name="subject">[Batch Budget] Approval Requested: {{ object.name }}</field>
            <field name="email_from">{{ (object.requester_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:13px;color:#212529;">
    <p>Hello,</p>
    <p>
        <strong t-out="object.requester_id.name or 'A user'"></strong>
        has submitted a <strong>Batch Budget</strong> for your approval.
    </p>
    <table style="border-collapse:collapse;margin:12px 0;">
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Batch:</td><td><strong t-out="object.name"></strong></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Project:</td><td t-out="object.project_id.display_name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Project Budget:</td><td t-out="object.project_budget_id.display_name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Total Tasks:</td><td t-out="object.total_tasks or 0"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Estimated Cost:</td><td t-out="'%.2f USD' % (object.estimated_cost or 0.0)"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Buffer %:</td><td t-out="'%.2f' % (object.buffer_pct or 0.0)"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Batch Budget:</td><td><strong t-out="'%.2f USD' % (object.batch_budget or 0.0)"></strong></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Date Range:</td><td><span t-out="object.start_date or '—'"></span> &#8594; <span t-out="object.end_date or '—'"></span></td></tr>
    </table>
    <p style="margin-top:12px;"><strong>Model Lines</strong></p>
    <table style="border-collapse:collapse;border:1px solid #dee2e6;">
        <thead><tr style="background:#f8f9fa;">
            <th style="padding:6px 12px;border:1px solid #dee2e6;text-align:left;">Model</th>
            <th style="padding:6px 12px;border:1px solid #dee2e6;text-align:right;">Per Task Cost (USD)</th>
        </tr></thead>
        <tbody>
            <tr t-foreach="object.model_line_ids" t-as="line">
                <td style="padding:6px 12px;border:1px solid #dee2e6;" t-out="line.ai_model_id.name or ''"></td>
                <td style="padding:6px 12px;border:1px solid #dee2e6;text-align:right;" t-out="'%.4f' % (line.per_task_cost or 0.0)"></td>
            </tr>
        </tbody>
    </table>
    <p style="margin-top:16px;">
        Approve or reject this batch from the in-app form: open
        <em t-out="object.name"></em> under <em>AWS Budgets &gt; Batch Budgets</em>.
    </p>
</div>
            </field>
        </record>

        <record id="mail_template_batch_approved" model="mail.template">
            <field name="name">Batch Budget: Approved</field>
            <field name="model_id" ref="model_etp_batch_budget"/>
            <field name="subject">[Batch Budget Approved] {{ object.name }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:13px;color:#212529;">
    <p>Hello,</p>
    <p>
        Your batch budget <strong t-out="object.name"></strong> has been
        <strong style="color:#198754;">approved</strong> by
        <span t-out="object.approver_id.name or ''"></span>.
    </p>
    <table style="border-collapse:collapse;margin:12px 0;">
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Project:</td><td t-out="object.project_id.display_name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Approved Budget:</td><td><strong t-out="'%.2f USD' % (object.batch_budget or 0.0)"></strong></td></tr>
    </table>
</div>
            </field>
        </record>

        <record id="mail_template_batch_rejected" model="mail.template">
            <field name="name">Batch Budget: Rejected</field>
            <field name="model_id" ref="model_etp_batch_budget"/>
            <field name="subject">[Batch Budget Rejected] {{ object.name }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:13px;color:#212529;">
    <p>Hello,</p>
    <p>
        Your batch budget <strong t-out="object.name"></strong> was
        <strong style="color:#dc3545;">rejected</strong> by
        <span t-out="object.approver_id.name or ''"></span>.
    </p>
    <p><strong>Reason:</strong></p>
    <blockquote style="border-left:3px solid #dc3545;padding:8px 12px;background:#f8f9fa;" t-out="object.rejection_reason or ''"></blockquote>
</div>
            </field>
        </record>

        <record id="mail_template_batch_threshold" model="mail.template">
            <field name="name">Batch Budget: Threshold Alert</field>
            <field name="model_id" ref="model_etp_batch_budget"/>
            <field name="subject">[Batch Budget Alert] {{ object.name }} at {{ '%.1f' % (object.consumed_pct or 0.0) }}%</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:13px;color:#212529;">
    <p>Hello,</p>
    <p>
        Batch budget <strong t-out="object.name"></strong> has reached
        <strong><span t-out="'%.1f' % (object.consumed_pct or 0.0)"></span>%</strong> consumption.
    </p>
    <table style="border-collapse:collapse;margin:12px 0;">
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Project:</td><td t-out="object.project_id.display_name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Batch Budget:</td><td t-out="'%.2f USD' % (object.batch_budget or 0.0)"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Consumed (AWS):</td><td><strong t-out="'%.2f USD' % (object.consumed_cost or 0.0)"></strong></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Remaining:</td><td t-out="'%.2f USD' % (object.remaining_cost or 0.0)"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Date Range:</td><td><span t-out="object.start_date or ''"></span> &#8594; <span t-out="object.end_date or ''"></span></td></tr>
    </table>
</div>
            </field>
        </record>

        <record id="mail_template_topup_approval_request" model="mail.template">
            <field name="name">Project Budget Top-up: Approval Request</field>
            <field name="model_id" ref="model_etp_project_budget_topup"/>
            <field name="subject">[Project Budget Top-up] Approval Requested: {{ object.name }}</field>
            <field name="email_from">{{ (object.requester_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:13px;color:#212529;">
    <p>Hello,</p>
    <p>
        <strong t-out="object.requester_id.name or 'A user'"></strong>
        is requesting an additional <strong>Project Budget Top-up</strong>.
    </p>
    <table style="border-collapse:collapse;margin:12px 0;">
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Top-up:</td><td><strong t-out="object.name"></strong></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Project:</td><td t-out="object.project_id.display_name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Project Budget:</td><td t-out="object.project_budget_id.display_name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Amount:</td><td><strong t-out="'%.2f USD' % (object.amount or 0.0)"></strong></td></tr>
    </table>
    <p><strong>Justification</strong></p>
    <blockquote style="border-left:3px solid #6c757d;padding:8px 12px;background:#f8f9fa;" t-out="object.justification or ''"></blockquote>
</div>
            </field>
        </record>

        <record id="mail_template_topup_approved" model="mail.template">
            <field name="name">Project Budget Top-up: Approved</field>
            <field name="model_id" ref="model_etp_project_budget_topup"/>
            <field name="subject">[Project Budget Top-up Approved] {{ object.name }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:13px;color:#212529;">
    <p>Hello,</p>
    <p>
        Your Project Budget Top-up <strong t-out="object.name"></strong> for
        <strong t-out="'%.2f USD' % (object.amount or 0.0)"></strong>
        has been <strong style="color:#198754;">approved</strong>.
    </p>
</div>
            </field>
        </record>

        <record id="mail_template_topup_rejected" model="mail.template">
            <field name="name">Project Budget Top-up: Rejected</field>
            <field name="model_id" ref="model_etp_project_budget_topup"/>
            <field name="subject">[Project Budget Top-up Rejected] {{ object.name }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:13px;color:#212529;">
    <p>Hello,</p>
    <p>
        Your Project Budget Top-up <strong t-out="object.name"></strong> was
        <strong style="color:#dc3545;">rejected</strong>.
    </p>
    <p><strong>Reason:</strong></p>
    <blockquote style="border-left:3px solid #dc3545;padding:8px 12px;background:#f8f9fa;" t-out="object.rejection_reason or ''"></blockquote>
</div>
            </field>
        </record>

        <record id="mail_template_batch_request_submitted" model="mail.template">
            <field name="name">Batch Budget Request: Submitted</field>
            <field name="model_id" ref="model_etp_batch_budget_request"/>
            <field name="subject">[Budget Request] Approval Requested: {{ object.name }}</field>
            <field name="email_from">{{ (object.requester_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:13px;color:#212529;">
    <p>Hello,</p>
    <p>
        <strong t-out="object.requester_id.name or 'A user'"></strong>
        has submitted a <strong>Batch Budget Request</strong> for your approval.
    </p>
    <table style="border-collapse:collapse;margin:12px 0;">
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Request:</td><td><strong t-out="object.name"></strong></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Batch:</td><td t-out="object.batch_id.name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Project:</td><td t-out="object.project_id.display_name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Request #:</td><td t-out="object.sequence_number or 0"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Requested Total:</td><td><strong t-out="'%.2f USD' % (object.requested_total or 0.0)"></strong></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Requested On:</td><td t-out="object.request_date or ''"></td></tr>
    </table>
    <p><strong>Justification</strong></p>
    <blockquote style="border-left:3px solid #6c757d;padding:8px 12px;background:#f8f9fa;" t-out="object.justification or ''"></blockquote>
    <p style="margin-top:12px;"><strong>Model Lines</strong></p>
    <table style="border-collapse:collapse;border:1px solid #dee2e6;">
        <thead><tr style="background:#f8f9fa;">
            <th style="padding:6px 12px;border:1px solid #dee2e6;text-align:left;">Model</th>
            <th style="padding:6px 12px;border:1px solid #dee2e6;text-align:right;">Tasks</th>
            <th style="padding:6px 12px;border:1px solid #dee2e6;text-align:right;">Per Task (USD)</th>
            <th style="padding:6px 12px;border:1px solid #dee2e6;text-align:right;">Requested (USD)</th>
        </tr></thead>
        <tbody>
            <tr t-foreach="object.model_line_ids" t-as="line">
                <td style="padding:6px 12px;border:1px solid #dee2e6;" t-out="line.ai_model_id.name or ''"></td>
                <td style="padding:6px 12px;border:1px solid #dee2e6;text-align:right;" t-out="line.task_count or 0"></td>
                <td style="padding:6px 12px;border:1px solid #dee2e6;text-align:right;" t-out="'%.4f' % (line.per_task_cost or 0.0)"></td>
                <td style="padding:6px 12px;border:1px solid #dee2e6;text-align:right;" t-out="'%.2f' % (line.requested_amount or 0.0)"></td>
            </tr>
        </tbody>
    </table>
    <p t-if="object.infra_line_ids" style="margin-top:12px;"><strong>Infrastructure Lines</strong></p>
    <table t-if="object.infra_line_ids" style="border-collapse:collapse;border:1px solid #dee2e6;">
        <thead><tr style="background:#f8f9fa;">
            <th style="padding:6px 12px;border:1px solid #dee2e6;text-align:left;">Infra Type</th>
            <th style="padding:6px 12px;border:1px solid #dee2e6;text-align:left;">Description</th>
            <th style="padding:6px 12px;border:1px solid #dee2e6;text-align:right;">Requested (USD)</th>
        </tr></thead>
        <tbody>
            <tr t-foreach="object.infra_line_ids" t-as="iline">
                <td style="padding:6px 12px;border:1px solid #dee2e6;" t-out="dict(iline._fields['infra_type'].selection).get(iline.infra_type, iline.infra_type or '')"></td>
                <td style="padding:6px 12px;border:1px solid #dee2e6;" t-out="iline.description or ''"></td>
                <td style="padding:6px 12px;border:1px solid #dee2e6;text-align:right;" t-out="'%.2f' % (iline.requested_amount or 0.0)"></td>
            </tr>
        </tbody>
    </table>
</div>
            </field>
        </record>

        <record id="mail_template_batch_request_approved" model="mail.template">
            <field name="name">Batch Budget Request: Approved</field>
            <field name="model_id" ref="model_etp_batch_budget_request"/>
            <field name="subject">[Budget Request {{ 'Partially Approved' if object.state == 'partially_approved' else 'Approved' }}] {{ object.name }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:13px;color:#212529;">
    <p>Hello,</p>
    <p>
        Your batch budget request <strong t-out="object.name"></strong> has been
        <strong style="color:#198754;" t-out="'partially approved' if object.state == 'partially_approved' else 'approved'"></strong> by
        <span t-out="object.approver_id.name or ''"></span>.
    </p>
    <table style="border-collapse:collapse;margin:12px 0;">
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Batch:</td><td t-out="object.batch_id.name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Project:</td><td t-out="object.project_id.display_name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Requested Total:</td><td t-out="'%.2f USD' % (object.requested_total or 0.0)"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Approved Total:</td><td><strong t-out="'%.2f USD' % (object.approved_total or 0.0)"></strong></td></tr>
    </table>
    <p style="margin-top:12px;">
        The approved amount has been added to the batch budget. You may now log daily tasks against this batch.
    </p>
</div>
            </field>
        </record>

        <record id="mail_template_batch_request_rejected" model="mail.template">
            <field name="name">Batch Budget Request: Rejected</field>
            <field name="model_id" ref="model_etp_batch_budget_request"/>
            <field name="subject">[Budget Request Rejected] {{ object.name }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:13px;color:#212529;">
    <p>Hello,</p>
    <p>
        Your batch budget request <strong t-out="object.name"></strong> was
        <strong style="color:#dc3545;">rejected</strong> by
        <span t-out="object.approver_id.name or ''"></span>.
    </p>
    <table style="border-collapse:collapse;margin:12px 0;">
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Batch:</td><td t-out="object.batch_id.name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Project:</td><td t-out="object.project_id.display_name or ''"></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:#666;">Requested Total:</td><td t-out="'%.2f USD' % (object.requested_total or 0.0)"></td></tr>
    </table>
    <p><strong>Reason:</strong></p>
    <blockquote style="border-left:3px solid #dc3545;padding:8px 12px;background:#f8f9fa;" t-out="object.rejection_reason or ''"></blockquote>
</div>
            </field>
        </record>

    </data>
</odoo>
