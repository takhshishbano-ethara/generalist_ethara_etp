<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_jaeger_trajectory_run_tree" model="ir.ui.view">
        <field name="name">jaeger.trajectory.run.tree</field>
        <field name="model">jaeger.trajectory.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="instance_id"/>
                <field name="repository_id"/>
                <field name="run_number"/>
                <field name="model"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'resolved'"
                       decoration-danger="status in ('unresolved','error')"
                       decoration-warning="status in ('running','evaluating')"/>
                <field name="resolved"/>
                <field name="api_cost"/>
                <field name="duration_seconds"/>
                <field name="prompt_tokens"/>
                <field name="completion_tokens"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_jaeger_trajectory_run_form" model="ir.ui.view">
        <field name="name">jaeger.trajectory.run.form</field>
        <field name="model">jaeger.trajectory.run</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="repository_id"/>
                            <field name="run_number"/>
                            <field name="model"/>
                            <field name="status" widget="badge"/>
                            <field name="eks_pod_name"/>
                        </group>
                        <group>
                            <field name="resolved"/>
                            <field name="api_calls"/>
                            <field name="api_cost"/>
                            <field name="api_time_seconds"/>
                            <field name="prompt_tokens"/>
                            <field name="completion_tokens"/>
                            <field name="duration_seconds"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agent Patch" name="patch">
                            <field name="agent_patch"/>
                        </page>
                        <page string="Conversation" name="conversation">
                            <field name="conversation_log"/>
                        </page>
                        <page string="Evaluation" name="eval">
                            <group>
                                <field name="eval_status" widget="badge"/>
                                <field name="eval_passed_count"/>
                                <field name="eval_failed_count"/>
                            </group>
                            <field name="eval_report_json"/>
                            <field name="fix_patch_run_log"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_jaeger_trajectory_run" model="ir.actions.act_window">
        <field name="name">Trajectory Runs</field>
        <field name="res_model">jaeger.trajectory.run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
