<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jaeger_import_tokens_wizard_form" model="ir.ui.view">
        <field name="name">jaeger.import.tokens.wizard.form</field>
        <field name="model">jaeger.import.tokens.wizard</field>
        <field name="arch" type="xml">
            <form string="Import GitHub Tokens">
                <group>
                    <field name="token_file" filename="token_filename"/>
                    <field name="token_filename" invisible="1"/>
                </group>
                <group invisible="not result_message">
                    <field name="result_message" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button string="Import" name="action_import" type="object" class="btn-primary"
                            invisible="result_message"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_jaeger_import_tokens_wizard" model="ir.actions.act_window">
        <field name="name">Import Tokens</field>
        <field name="res_model">jaeger.import.tokens.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
