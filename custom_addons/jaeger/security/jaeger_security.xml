<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_jaeger" model="ir.module.category">
            <field name="name">Jaeger</field>
            <field name="description">SWE Task Data Collection Pipeline</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privilege (Odoo 19: replaces category_id on res.groups) -->
        <record id="res_groups_privilege_jaeger" model="res.groups.privilege">
            <field name="name">Jaeger</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="module_category_jaeger"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- User Group -->
        <record id="group_jaeger_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_jaeger"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Admin Group (inherits User) -->
        <record id="group_jaeger_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_jaeger"/>
            <field name="implied_ids" eval="[(4, ref('group_jaeger_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules: Users see own repos -->
        <record id="rule_jaeger_repository_user" model="ir.rule">
            <field name="name">Jaeger Repository: User sees own</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_jaeger_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rules: Admins see all -->
        <record id="rule_jaeger_repository_admin" model="ir.rule">
            <field name="name">Jaeger Repository: Admin sees all</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_jaeger_admin'))]"/>
        </record>
    </data>
</odoo>
