FROM docker:27-dind

RUN apk add --no-cache python3 py3-pip git bash curl && \
    python3 -m ensurepip && \
    pip3 install --no-cache-dir --break-system-packages requests boto3

COPY custom_addons/jaeger/worker/ /app/worker/

WORKDIR /app
ENTRYPOINT ["dockerd-entrypoint.sh"]
CMD ["python3", "worker/phase2_entrypoint.py"]
