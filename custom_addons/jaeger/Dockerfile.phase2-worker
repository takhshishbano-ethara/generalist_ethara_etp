FROM python:3.12-alpine AS deps
RUN pip install --no-cache-dir requests boto3

FROM docker:27-dind
COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/lib/python3.12/site-packages
RUN apk add --no-cache python3 git bash curl

COPY custom_addons/jaeger/worker/ /app/worker/

WORKDIR /app
ENV DOCKER_TLS_CERTDIR=""
RUN printf '#!/bin/sh\ndockerd --host=unix:///var/run/docker.sock --storage-driver=overlay2 &\nexec python3 worker/phase2_entrypoint.py\n' > /app/start.sh && chmod +x /app/start.sh
ENTRYPOINT ["/app/start.sh"]
