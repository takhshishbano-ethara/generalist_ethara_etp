<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Batch Scrape: publish pending repos to jaeger_scrape queue -->
        <!-- Phase 2-7: disabled. Re-enable when RabbitMQ consumer is deployed. -->
        <record id="jaeger_cron_batch_scrape" model="ir.cron">
            <field name="name">Jaeger: Batch Scrape Repos</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="code">model._cron_batch_scrape()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>

            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>

        <!-- Batch Docker: publish repos ready for Docker build -->
        <!-- Phase 2-7: disabled -->
        <record id="jaeger_cron_batch_docker" model="ir.cron">
            <field name="name">Jaeger: Batch Docker Builds</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="code">model._cron_batch_docker()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>

            <field name="active" eval="False"/>
            <field name="priority">5</field>
        </record>

        <!-- Poll EKS: check trajectory job status -->
        <!-- Phase 2-7: disabled -->
        <record id="jaeger_cron_poll_eks" model="ir.cron">
            <field name="name">Jaeger: Poll EKS Trajectories</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="code">model._cron_poll_eks_trajectories()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>

            <field name="active" eval="False"/>
            <field name="priority">10</field>
        </record>

        <!-- Auto-advance: safety net for stage transitions missed by inline gate checks -->
        <record id="jaeger_cron_auto_advance" model="ir.cron">
            <field name="name">Jaeger: Auto-advance Stages</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="code">model._cron_auto_advance_stages()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>

            <field name="active" eval="True"/>
            <field name="priority">15</field>
        </record>

        <!-- Watchdog: reset Docker builds stuck in 'building' for 2+ hours -->
        <record id="jaeger_cron_watchdog_stale_builds" model="ir.cron">
            <field name="name">Jaeger: Watchdog Stale Builds</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="code">model._cron_watchdog_stale_builds()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>

            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- Watchdog: mark stale scrape jobs (running >60min) as failed -->
        <record id="jaeger_cron_watchdog_stale_scrapes" model="ir.cron">
            <field name="name">Jaeger: Watchdog Stale Scrapes</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="code">model._cron_watchdog_stale_scrapes()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>

            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- Reconcile K8s Job status for running scrape pipelines -->
        <record id="jaeger_cron_reconcile_scrape_jobs" model="ir.cron">
            <field name="name">Jaeger: Reconcile Scrape Jobs (K8s)</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="code">model._cron_reconcile_scrape_jobs()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>

            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="jaeger_cron_watchdog_stale_tests" model="ir.cron">
            <field name="name">Jaeger: Watchdog Stale Test Executions</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="code">model._cron_watchdog_stale_tests()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <record id="jaeger_cron_watchdog_stale_dataset" model="ir.cron">
            <field name="name">Jaeger: Watchdog Stale Dataset Finalization</field>
            <field name="model_id" ref="model_jaeger_repository"/>
            <field name="code">model._cron_watchdog_stale_dataset()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>
        <!-- Token Health Check: probe GitHub rate_limit API, update state -->
        <record id="jaeger_cron_token_health_check" model="ir.cron">
            <field name="name">Jaeger: Token Health Check</field>
            <field name="model_id" ref="model_jaeger_github_token"/>
            <field name="code">model._cron_token_health_check()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- Token Expiry Alert: notify admins of tokens expiring within 7 days -->
        <record id="jaeger_cron_token_expiry_alert" model="ir.cron">
            <field name="name">Jaeger: Token Expiry Alert</field>
            <field name="model_id" ref="model_jaeger_github_token"/>
            <field name="code">model._cron_token_expiry_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>

        <!-- Token Orphan Reclaim: release tokens still leased to finished/failed repos -->
        <record id="jaeger_cron_token_orphan_reclaim" model="ir.cron">
            <field name="name">Jaeger: Token Orphan Reclaim</field>
            <field name="model_id" ref="model_jaeger_github_token"/>
            <field name="code">model._cron_token_orphan_reclaim()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">5</field>
        </record>

        <!-- Token Pool Metrics: snapshot pool state for monitoring -->
        <record id="jaeger_cron_pool_metrics" model="ir.cron">
            <field name="name">Jaeger: Pool Metrics Snapshot</field>
            <field name="model_id" ref="model_jaeger_github_token"/>
            <field name="code">model._cron_pool_metrics()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">15</field>
        </record>
    </data>
</odoo>
