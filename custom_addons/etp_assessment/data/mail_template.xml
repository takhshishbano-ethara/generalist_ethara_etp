<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_day_invitation" model="mail.template">
        <field name="name">ETP Assessment: Day Invitation</field>
        <field name="model_id" ref="model_etp_assessment_day_session"/>
        <field name="subject">Your assessment is ready: {{ object.assessment_id.name }} — Day {{ object.day_id.sequence }}</field>
        <field name="email_from">{{ (object.assessment_id.create_uid.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.evaluator_id.applicant_id.email_from or '' }}</field>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:14px;color:#333;line-height:1.5">
    <p>Hi <strong t-out="object.evaluator_id.applicant_id.partner_name or 'there'"/>,</p>
    <p>You have been assigned to take an assessment.</p>
    <table style="border-collapse:collapse;margin:12px 0">
        <tr><td style="padding:6px 12px"><b>Assessment:</b></td><td t-out="object.assessment_id.name"/></tr>
        <tr><td style="padding:6px 12px"><b>Day:</b></td><td t-out="object.day_id.sequence"/></tr>
        <tr><td style="padding:6px 12px"><b>Skill:</b></td><td t-out="object.day_id.skill_id.name or ''"/></tr>
        <tr><td style="padding:6px 12px"><b>Duration:</b></td><td><span t-out="object.day_id.duration_minutes"/> minutes</td></tr>
        <tr><td style="padding:6px 12px"><b>Questions:</b></td><td t-out="object.total_questions"/></tr>
    </table>
    <p style="margin:24px 0">
        <a t-att-href="(object.assessment_id.env['ir.config_parameter'].sudo().get_param('web.base.url') or 'http://localhost:8069') + '/assessment/day/' + (object.access_token or '')"
           style="background:#714B67;color:#fff;padding:10px 22px;text-decoration:none;border-radius:4px;font-weight:600">
            Start this assessment
        </a>
        &amp;nbsp;&amp;nbsp;
        <a t-att-href="(object.assessment_id.env['ir.config_parameter'].sudo().get_param('web.base.url') or 'http://localhost:8069') + '/my/assessments'"
           style="color:#714B67;padding:10px 18px;text-decoration:none;border:1px solid #714B67;border-radius:4px;font-weight:600">
            Go to My Assessments
        </a>
    </p>
    <p style="color:#888;font-size:12px">
        Or paste this URL into your browser:<br/>
        <span t-out="(object.assessment_id.env['ir.config_parameter'].sudo().get_param('web.base.url') or 'http://localhost:8069') + '/assessment/day/' + (object.access_token or '')"/>
    </p>
    <p style="color:#888;font-size:12px">This link is personal to you. Do not share it.</p>
</div>
        </field>
        <field name="auto_delete" eval="False"/>
        <field name="use_default_to" eval="False"/>
        <field name="lang">en_US</field>
    </record>

    <record id="mail_template_single_invitation" model="mail.template">
        <field name="name">ETP Assessment: Single Test Invitation</field>
        <field name="model_id" ref="model_etp_assessment_evaluator"/>
        <field name="subject">Your assessment is ready: {{ object.assessment_id.name }}</field>
        <field name="email_from">{{ (object.assessment_id.create_uid.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.applicant_id.email_from or '' }}</field>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:14px;color:#333;line-height:1.5">
    <p>Hi <strong t-out="object.applicant_id.partner_name or 'there'"/>,</p>
    <p>You have been assigned an assessment.</p>
    <table style="border-collapse:collapse;margin:12px 0">
        <tr><td style="padding:6px 12px"><b>Assessment:</b></td><td t-out="object.assessment_id.name"/></tr>
        <tr><td style="padding:6px 12px"><b>Category:</b></td><td t-out="object.assessment_id.category_id.name or ''"/></tr>
        <tr><td style="padding:6px 12px"><b>Duration:</b></td><td><span t-out="object.assessment_id.duration_minutes"/> minutes</td></tr>
        <tr><td style="padding:6px 12px"><b>Questions:</b></td><td t-out="object.total_questions"/></tr>
    </table>
    <p style="margin:24px 0">
        <a t-att-href="'/assessment/' + (object.access_token or '')"
           style="background:#714B67;color:#fff;padding:10px 22px;text-decoration:none;border-radius:4px;font-weight:600">
            Start Assessment
        </a>
    </p>
    <p style="color:#888;font-size:12px">
        Or paste this URL into your browser:<br/>
        <span t-out="(object.assessment_id.env['ir.config_parameter'].sudo().get_param('web.base.url') or 'http://localhost:8069') + '/assessment/' + (object.access_token or '')"/>
    </p>
    <p style="color:#888;font-size:12px">This link is personal to you. Do not share it.</p>
</div>
        </field>
        <field name="auto_delete" eval="False"/>
        <field name="use_default_to" eval="False"/>
        <field name="lang">en_US</field>
    </record>
</odoo>
