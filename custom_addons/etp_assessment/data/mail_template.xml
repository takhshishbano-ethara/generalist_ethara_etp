<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="email_assessment_invitation" model="mail.template">
            <field name="name">Assessment Invitation</field>
            <field name="model_id" ref="model_etp_assessment_evaluator"/>
            <field name="email_from">{{ (object.assessment_id.create_uid.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.employee_id.work_email or object.employee_id.private_email or '' }}</field>
            <field name="subject">Assessment Invitation: {{ object.assessment_id.name }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    <table style="width: 100%; max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <tr>
            <td style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 32px; text-align: center;">
                <h1 style="color: #ffffff; margin: 0; font-size: 24px;">Assessment Invitation</h1>
            </td>
        </tr>
        <tr>
            <td style="padding: 32px;">
                <p style="font-size: 16px; color: #333;">
                    Hello <strong><t t-out="object.employee_id.name">Candidate</t></strong>,
                </p>
                <p style="font-size: 14px; color: #555;">
                    You have been assigned to complete the following assessment:
                </p>
                <div style="background: #f8f9fa; border-radius: 8px; padding: 16px; margin: 16px 0;">
                    <p style="margin: 4px 0;"><strong>Assessment:</strong> <t t-out="object.assessment_id.name">Assessment</t></p>
                    <p style="margin: 4px 0;"><strong>Total Questions:</strong> <t t-out="object.total_questions">0</t></p>
                    <t t-if="object.assessment_id.duration_minutes">
                        <p style="margin: 4px 0;"><strong>Time Limit:</strong> <t t-out="object.assessment_id.duration_minutes">0</t> minutes</p>
                    </t>
                    <t t-if="object.assessment_id.end_date">
                        <p style="margin: 4px 0;"><strong>Deadline:</strong> <t t-out="object.assessment_id.end_date">-</t></p>
                    </t>
                </div>

                <div style="background: #fff5f5; border: 1px solid #fee2e2; border-radius: 8px; padding: 16px; margin: 16px 0;">
                    <p style="margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #dc3545;">⚠️ Important Rules</p>
                    <ul style="margin: 0; padding-left: 18px; font-size: 13px; color: #555; line-height: 1.8;">
                        <li>Do NOT switch tabs or windows during the assessment.</li>
                        <li>Do NOT take screenshots or use screen recording.</li>
                        <li>Do NOT copy text or open Developer Tools.</li>
                        <li>Any violation will auto-submit your assessment immediately.</li>
                    </ul>
                </div>

                <p style="font-size: 14px; color: #555;">
                    Click the button below to view full instructions and start your assessment. No login required.
                </p>
                <div style="text-align: center; margin: 24px 0;">
                    <a t-att-href="'%s/assessment/%s' % (object.env['ir.config_parameter'].sudo().get_param('web.base.url'), object.access_token)"
                       style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #ffffff; padding: 14px 32px; border-radius: 8px; text-decoration: none; font-size: 16px; font-weight: 600;">
                        Start Assessment →
                    </a>
                </div>
                <p style="font-size: 12px; color: #999; margin-top: 24px;">
                    This link is unique to you. Please do not share it with anyone else.
                </p>
            </td>
        </tr>
    </table>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>
