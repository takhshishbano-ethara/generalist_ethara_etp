<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="etp_assessment_dimension_tree" model="ir.ui.view">
        <field name="name">etp.assessment.dimension.tree</field>
        <field name="model">etp.assessment.dimension</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="options_display" string="Options"/>
                <field name="option_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_dimension_form" model="ir.ui.view">
        <field name="name">etp.assessment.dimension.form</field>
        <field name="model">etp.assessment.dimension</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Dimension Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Options">
                            <field name="option_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etp_assessment_dimension" model="ir.actions.act_window">
        <field name="name">Dimensions</field>
        <field name="res_model">etp.assessment.dimension</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
