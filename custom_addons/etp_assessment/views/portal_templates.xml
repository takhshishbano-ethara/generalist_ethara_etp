<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Portal Layout Base -->
    <template id="portal_layout" name="Assessment Portal Layout">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title><t t-esc="page_title or 'ETP Assessment'"/></title>
                <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/>
                <style>
                    body { background: #f4f6f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
                    .assessment-container { max-width: 900px; margin: 40px auto; padding: 0 20px; }
                    .assessment-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 32px; margin-bottom: 24px; }
                    .assessment-header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border-radius: 12px; padding: 32px; margin-bottom: 24px; }
                    .progress-bar-custom { height: 8px; border-radius: 4px; background: #e9ecef; overflow: hidden; }
                    .progress-bar-fill { height: 100%; background: linear-gradient(90deg, #667eea, #764ba2); border-radius: 4px; transition: width 0.3s ease; }
                    .dimension-card { border: 2px solid #e9ecef; border-radius: 8px; padding: 16px; margin-bottom: 12px; transition: border-color 0.2s; }
                    .dimension-card:hover { border-color: #667eea; }
                    .dimension-title { margin-bottom: 10px; font-weight: 600; color: #333; }
                    .dimensions-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
                    .options-row { display: flex; flex-wrap: wrap; gap: 6px; }
                    .option-radio { display: none; }
                    .option-label { display: inline-block; padding: 8px 14px; border: 2px solid #e9ecef; border-radius: 6px; cursor: pointer; transition: all 0.2s; font-size: 14px; }
                    .option-label:hover { border-color: #667eea; background: #f8f9ff; }
                    .option-radio:checked + .option-label { border-color: #667eea; background: #667eea; color: #fff; }
                    .btn-submit { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; color: #fff; padding: 12px 32px; border-radius: 8px; font-size: 16px; font-weight: 600; }
                    .btn-submit:hover { opacity: 0.9; color: #fff; }
                    .question-type-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
                    .type-image_comparison { background: #e3f2fd; color: #1565c0; }
                    .type-text { background: #e8f5e9; color: #2e7d32; }
                    .type-coding { background: #fce4ec; color: #c62828; }
                    .type-image_text { background: #fff3e0; color: #e65100; }
                    .type-video { background: #f3e5f5; color: #6a1b9a; }
                    .code-block { background: #1e1e1e; color: #d4d4d4; padding: 16px; border-radius: 8px; overflow-x: auto; font-family: 'Fira Code', monospace; font-size: 14px; }
                    .image-comparison-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
                    .image-comparison-grid img { width: 100%; border-radius: 8px; border: 2px solid #e9ecef; }
                    @media (max-width: 768px) { .image-comparison-grid { grid-template-columns: 1fr; } }
                    .timer-bar { display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.15); padding: 8px 16px; border-radius: 8px; }
                    .timer-icon { font-size: 18px; }
                    .timer-label { font-size: 14px; opacity: 0.9; }
                    .timer-value { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; }
                    .timer-bar.timer-warning { background: rgba(255, 193, 7, 0.3); }
                    .timer-bar.timer-danger { background: rgba(220, 53, 69, 0.4); animation: pulse 1s infinite; }
                    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
                    body { -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none; user-select: none; }
                    body * { -webkit-touch-callout: none; }
                    img { pointer-events: none; -webkit-user-drag: none; }
                    .violation-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(220,53,69,0.95); z-index: 99999; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; }
                    .violation-overlay h2 { font-size: 2rem; margin-bottom: 12px; }
                    .violation-overlay p { font-size: 1.1rem; opacity: 0.9; }
                </style>
            </head>
            <body oncontextmenu="return false;" oncopy="return false;" oncut="return false;" onpaste="return false;" ondragstart="return false;" onselectstart="return false;">
                <div class="assessment-container">
                    <t t-raw="0"/>
                </div>
                <script>
                    (function() {
                        var form = document.querySelector("form");
                        var violated = false;

                        function triggerViolation(reason) {
                            if (violated) return;
                            violated = true;
                            var overlay = document.createElement("div");
                            overlay.className = "violation-overlay";
                            overlay.innerHTML = '&lt;h2&gt;⚠️ Violation Detected&lt;/h2&gt;&lt;p&gt;' + reason + '&lt;/p&gt;&lt;p&gt;Your assessment is being submitted automatically.&lt;/p&gt;';
                            document.body.appendChild(overlay);
                            if (form) {
                                setTimeout(function() { form.submit(); }, 1500);
                            }
                        }

                        document.addEventListener("keydown", function(e) {
                            if (e.key === "PrintScreen" || e.key === "Snapshot") {
                                e.preventDefault();
                                triggerViolation("Screenshot attempt detected");
                            }
                            /* macOS screenshot shortcuts: Cmd+Shift+3, Cmd+Shift+4, Cmd+Shift+5 */
                            if (e.metaKey &amp;&amp; e.shiftKey &amp;&amp; (e.key === "3" || e.key === "4" || e.key === "5")) {
                                e.preventDefault();
                                triggerViolation("Screenshot shortcut detected (Cmd+Shift+" + e.key + ")");
                            }
                            if ((e.ctrlKey || e.metaKey) &amp;&amp; e.shiftKey &amp;&amp; (e.key === "S" || e.key === "s")) {
                                e.preventDefault();
                                triggerViolation("Screenshot shortcut detected");
                            }
                            if ((e.ctrlKey || e.metaKey) &amp;&amp; (e.key === "c" || e.key === "C" || e.key === "a" || e.key === "A" || e.key === "u" || e.key === "U" || e.key === "s" || e.key === "S" || e.key === "p" || e.key === "P")) {
                                e.preventDefault();
                                return false;
                            }
                            if (e.key === "F12" || (e.ctrlKey &amp;&amp; e.shiftKey &amp;&amp; (e.key === "I" || e.key === "i" || e.key === "J" || e.key === "j"))) {
                                e.preventDefault();
                                triggerViolation("Developer tools detected");
                            }
                        });

                        document.addEventListener("visibilitychange", function() {
                            if (document.hidden &amp;&amp; form &amp;&amp; !violated) {
                                triggerViolation("You switched away from the assessment tab");
                            }
                        });

                        window.addEventListener("blur", function() {
                            if (form &amp;&amp; !violated) {
                                triggerViolation("You switched away from the assessment window");
                            }
                        });

                        if (navigator.mediaDevices &amp;&amp; navigator.mediaDevices.getDisplayMedia) {
                            var origGetDisplayMedia = navigator.mediaDevices.getDisplayMedia.bind(navigator.mediaDevices);
                            navigator.mediaDevices.getDisplayMedia = function() {
                                triggerViolation("Screen capture attempt detected");
                                return Promise.reject(new Error("Screen capture blocked"));
                            };
                        }

                        var observer = new PerformanceObserver(function(list) {
                            list.getEntries().forEach(function(entry) {
                                if (entry.name &amp;&amp; entry.name.indexOf("screenshot") !== -1) {
                                    triggerViolation("Screenshot extension detected");
                                }
                            });
                        });
                        try { observer.observe({entryTypes: ["resource"]}); } catch(e) {}

                        setInterval(function() {
                            var threshold = 160;
                            if (window.outerWidth - window.innerWidth > threshold || window.outerHeight - window.innerHeight > threshold) {
                                if (!violated &amp;&amp; form) {
                                    triggerViolation("Developer tools detected");
                                }
                            }
                        }, 2000);
                    })();
                </script>
            </body>
        </html>
    </template>

    <!-- Invalid Token Page -->
    <template id="portal_invalid_token" name="Invalid Token">
        <t t-call="etp_assessment.portal_layout">
            <t t-set="page_title">Invalid Link</t>
            <div class="assessment-card text-center">
                <div style="font-size: 64px; margin-bottom: 16px;">🔒</div>
                <h2>Invalid or Expired Link</h2>
                <p class="text-muted">This assessment link is not valid. It may have expired or been used already.</p>
                <p class="text-muted">Please check your email for the correct link or contact your administrator.</p>
            </div>
        </t>
    </template>

    <!-- Assessment Closed Page -->
    <template id="portal_assessment_closed" name="Assessment Closed">
        <t t-call="etp_assessment.portal_layout">
            <t t-set="page_title">Assessment Completed</t>
            <div class="assessment-header" style="text-align: center;">
                <div style="font-size: 56px; margin-bottom: 12px;">✅</div>
                <h2 style="margin: 0; font-size: 1.75rem;">Assessment Completed</h2>
                <p style="opacity: 0.85; margin-top: 8px; margin-bottom: 0;">
                    <t t-esc="assessment.name"/>
                </p>
            </div>
            <div class="assessment-card text-center">
                <p style="color: #555; font-size: 16px;">
                    Hello, <strong><t t-esc="evaluator.employee_id.name"/></strong>
                </p>
                <p style="color: #6c757d;">
                    This assessment has been closed and is no longer accepting responses.
                </p>
                <div style="background: linear-gradient(135deg, #f8f9fa, #e9ecef); border-radius: 12px; padding: 24px; margin: 24px auto; max-width: 300px;">
                    <div style="font-size: 42px; font-weight: 700; color: #667eea;">
                        <t t-esc="evaluator.answered_count"/> / <t t-esc="evaluator.total_questions"/>
                    </div>
                    <div style="font-size: 13px; color: #6c757d; margin-top: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Questions Attempted</div>
                </div>
                <t t-if="evaluator.answered_count == evaluator.total_questions">
                    <div style="display: inline-block; background: #d4edda; color: #155724; padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 600;">✓ All questions completed</div>
                </t>
                <t t-else="">
                    <div style="display: inline-block; background: #fff3cd; color: #856404; padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 600;">
                        <t t-esc="evaluator.total_questions - evaluator.answered_count"/> question(s) not attempted
                    </div>
                </t>
                <p style="color: #adb5bd; font-size: 12px; margin-top: 24px; margin-bottom: 0;">
                    Your responses have been recorded. You may close this window.
                </p>
            </div>
        </t>
    </template>

    <!-- Assessment Complete Page -->
    <template id="portal_assessment_complete" name="Assessment Complete">
        <t t-call="etp_assessment.portal_layout">
            <t t-set="page_title">Assessment Complete</t>
            <div class="assessment-card text-center">
                <div style="font-size: 64px; margin-bottom: 16px;">🎉</div>
                <h2 style="color: #1a1a2e;">Well Done!</h2>
                <p style="color: #555; font-size: 16px; margin-top: 12px;">
                    Thank you, <strong><t t-esc="evaluator.employee_id.name"/></strong>!
                    You have successfully completed "<strong><t t-esc="assessment.name"/></strong>".
                </p>
                <div style="background: linear-gradient(135deg, #667eea20, #764ba220); border-radius: 12px; padding: 24px; margin: 24px auto; max-width: 320px; border: 1px solid #667eea30;">
                    <div style="font-size: 48px; font-weight: 700; color: #667eea;">
                        <t t-esc="evaluator.answered_count"/> / <t t-esc="evaluator.total_questions"/>
                    </div>
                    <div style="font-size: 14px; color: #6c757d; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px;">Questions Attempted</div>
                </div>
                <t t-if="evaluator.answered_count == evaluator.total_questions">
                    <p style="color: #155724; font-weight: 600; margin-top: 16px;">
                        ✓ All questions have been answered
                    </p>
                </t>
                <t t-else="">
                    <p style="color: #856404; font-weight: 600; margin-top: 16px;">
                        <t t-esc="evaluator.total_questions - evaluator.answered_count"/> question(s) were not attempted
                    </p>
                </t>
                <p style="color: #adb5bd; font-size: 13px; margin-top: 24px;">
                    Your responses have been recorded. You may close this window.
                </p>
            </div>
        </t>
    </template>

    <!-- Instructions / Rules Page (shown before starting) -->
    <template id="portal_instructions" name="Assessment Instructions">
        <t t-call="etp_assessment.portal_layout">
            <t t-set="page_title" t-value="'Instructions - ' + assessment.name"/>

            <div class="assessment-header" style="text-align: center;">
                <h2 style="margin: 0;">📝 Assessment Instructions</h2>
                <p style="opacity: 0.85; margin-top: 8px; margin-bottom: 0; font-size: 1.1rem;">
                    <t t-esc="assessment.name"/>
                </p>
            </div>

            <div class="assessment-card">
                <h5 style="color: #1a1a2e; margin-bottom: 16px;">Welcome, <t t-esc="evaluator.employee_id.name"/></h5>
                <p style="color: #555;">Please read the following rules carefully before starting your assessment.</p>

                <div style="background: #f8f9fa; border-radius: 10px; padding: 20px; margin: 20px 0;">
                    <h6 style="color: #667eea; margin-bottom: 12px; font-weight: 700;">📋 Assessment Details</h6>
                    <table style="width: 100%; font-size: 14px;">
                        <tr style="border-bottom: 1px solid #e9ecef;">
                            <td style="padding: 8px 0; color: #6c757d;">Total Questions</td>
                            <td style="padding: 8px 0; font-weight: 600; text-align: right;"><t t-esc="evaluator.total_questions"/></td>
                        </tr>
                        <t t-if="duration_minutes">
                            <tr style="border-bottom: 1px solid #e9ecef;">
                                <td style="padding: 8px 0; color: #6c757d;">Time Limit</td>
                                <td style="padding: 8px 0; font-weight: 600; text-align: right;"><t t-esc="duration_minutes"/> minutes</td>
                            </tr>
                        </t>
                        <t t-if="assessment.end_date">
                            <tr>
                                <td style="padding: 8px 0; color: #6c757d;">Assessment Deadline</td>
                                <td style="padding: 8px 0; font-weight: 600; text-align: right;"><t t-esc="assessment.end_date"/></td>
                            </tr>
                        </t>
                    </table>
                </div>

                <div style="margin: 24px 0;">
                    <h6 style="color: #dc3545; margin-bottom: 12px; font-weight: 700;">⚠️ Important Rules</h6>
                    <div style="background: #fff5f5; border: 1px solid #fee2e2; border-radius: 8px; padding: 16px;">
                        <ul style="margin: 0; padding-left: 20px; font-size: 14px; color: #444; line-height: 2;">
                            <li><strong>Do NOT switch tabs or windows</strong> — Your assessment will be auto-submitted immediately.</li>
                            <li><strong>Do NOT take screenshots</strong> — Any screenshot attempt (keyboard shortcut or extension) will auto-submit your assessment.</li>
                            <li><strong>Do NOT copy text</strong> — Text selection, copy, cut, and paste are disabled.</li>
                            <li><strong>Do NOT open Developer Tools</strong> — Opening browser dev tools will auto-submit your assessment.</li>
                            <li><strong>Do NOT right-click</strong> — Context menu is disabled throughout the assessment.</li>
                            <li><strong>Do NOT use screen recording</strong> — Screen capture attempts are detected and will auto-submit.</li>
                        </ul>
                    </div>
                </div>

                <div style="margin: 24px 0;">
                    <h6 style="color: #155724; margin-bottom: 12px; font-weight: 700;">✅ Guidelines</h6>
                    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 16px;">
                        <ul style="margin: 0; padding-left: 20px; font-size: 14px; color: #444; line-height: 2;">
                            <li>Read each question carefully before answering.</li>
                            <li>Select one option per dimension for each question.</li>
                            <li>Provide a brief justification for your choices.</li>
                            <li>Once submitted, a question cannot be changed.</li>
                            <t t-if="duration_minutes">
                                <li>The timer starts as soon as you click "Start Assessment".</li>
                                <li>If time runs out, unanswered questions will be auto-submitted.</li>
                            </t>
                            <li>Ensure a stable internet connection throughout.</li>
                        </ul>
                    </div>
                </div>

                <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 16px; margin: 24px 0;">
                    <p style="margin: 0; font-size: 13px; color: #92400e;">
                        <strong>⚡ Note:</strong> By clicking "Start Assessment" below, you acknowledge that you have read and understood the above rules. Any violation will result in immediate auto-submission of your assessment.
                    </p>
                </div>
            </div>

            <form t-attf-action="/assessment/#{token}/begin" method="post" style="text-align: center; margin-bottom: 40px;">
                <button type="submit" class="btn btn-submit" style="padding: 14px 48px; font-size: 18px;">
                    🚀 Start Assessment
                </button>
            </form>
        </t>
    </template>

    <!-- Question Page -->
    <template id="portal_question_page" name="Assessment Question">
        <t t-call="etp_assessment.portal_layout">
            <t t-set="page_title" t-value="'Question ' + str(current_index) + ' - ' + assessment.name"/>

            <!-- Header -->
            <div class="assessment-header">
                <h3 class="mb-1"><t t-esc="assessment.name"/></h3>
                <p class="mb-3 opacity-75">
                    Welcome, <t t-esc="evaluator.employee_id.name"/>
                </p>
                <t t-if="deadline_iso">
                    <div class="timer-bar mb-3" id="timer-container">
                        <span class="timer-icon">⏱</span>
                        <span class="timer-label">Time Remaining:</span>
                        <span class="timer-value" id="countdown-timer">--:--:--</span>
                    </div>
                </t>
                <t t-if="duration_minutes and not deadline_iso">
                    <div class="timer-bar mb-3">
                        <span class="timer-icon">⏱</span>
                        <span class="timer-label">Duration:</span>
                        <span class="timer-value"><t t-esc="duration_minutes"/> min</span>
                    </div>
                </t>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span>Question <t t-esc="current_index"/> of <t t-esc="total_questions"/></span>
                    <span><t t-esc="progress_percent"/>% Complete</span>
                </div>
                <div class="progress-bar-custom">
                    <div class="progress-bar-fill" t-attf-style="width: #{progress_percent}%"></div>
                </div>
            </div>

            <!-- Question Content -->
            <div class="assessment-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h4 class="mb-0"><t t-esc="question.name"/></h4>
                    <span t-attf-class="question-type-badge type-#{question.question_type}">
                        <t t-esc="question.question_type"/>
                    </span>
                </div>

                <!-- Prompt -->
                <div class="mb-4" style="background: #f8f9fa; padding: 16px; border-radius: 8px; border-left: 4px solid #667eea;">
                    <p class="mb-0" style="white-space: pre-wrap;"><t t-esc="question.prompt"/></p>
                </div>

                <!-- Description (for text and image_text types) -->
                <t t-if="question.description and question.question_type in ('text', 'image_text')">
                    <div class="mb-4">
                        <p style="white-space: pre-wrap;"><t t-esc="question.description"/></p>
                    </div>
                </t>

                <!-- Image Comparison -->
                <t t-if="question.question_type == 'image_comparison'">
                    <div class="image-comparison-grid mb-4">
                        <div>
                            <h6 class="text-center mb-2">Response A</h6>
                            <t t-if="question.image_a">
                                <img t-att-src="'/web/image/etp.assessment.question/' + str(question.id) + '/image_a'" alt="Response A"/>
                            </t>
                            <t t-elif="question.image_a_url">
                                <img t-att-src="question.image_a_url" alt="Response A"/>
                            </t>
                        </div>
                        <div>
                            <h6 class="text-center mb-2">Response B</h6>
                            <t t-if="question.image_b">
                                <img t-att-src="'/web/image/etp.assessment.question/' + str(question.id) + '/image_b'" alt="Response B"/>
                            </t>
                            <t t-elif="question.image_b_url">
                                <img t-att-src="question.image_b_url" alt="Response B"/>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Image + Text -->
                <t t-if="question.question_type == 'image_text'">
                    <div class="mb-4 text-center">
                        <t t-if="question.image_a">
                            <img t-att-src="'/web/image/etp.assessment.question/' + str(question.id) + '/image_a'" alt="Question Image" style="max-width: 100%; border-radius: 8px;"/>
                        </t>
                        <t t-elif="question.image_a_url">
                            <img t-att-src="question.image_a_url" alt="Question Image" style="max-width: 100%; border-radius: 8px;"/>
                        </t>
                    </div>
                </t>

                <!-- Coding -->
                <t t-if="question.question_type == 'coding'">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>Code Snippet</strong>
                            <span class="badge bg-secondary"><t t-esc="question.code_language or 'code'"/></span>
                        </div>
                        <pre class="code-block"><t t-esc="question.code_snippet"/></pre>
                    </div>
                </t>

                <!-- Video -->
                <t t-if="question.question_type == 'video'">
                    <div class="mb-4 text-center">
                        <a t-att-href="question.video_url" target="_blank" class="btn btn-outline-primary">
                            🎬 Open Video
                        </a>
                        <p class="text-muted mt-2 small"><t t-esc="question.video_url"/></p>
                    </div>
                </t>
            </div>

            <!-- Response Form -->
            <form t-attf-action="/assessment/#{token}/submit" method="post">
                <input type="hidden" name="question_id" t-att-value="question.id"/>

                <!-- Dimensions -->
                <div class="assessment-card">
                    <h5 class="mb-3">Rate each dimension</h5>
                    <div class="dimensions-grid">
                        <t t-foreach="dimensions" t-as="dim">
                            <div class="dimension-card">
                                <h6 class="dimension-title"><t t-esc="dim.dimension_id.name"/></h6>
                                <div class="options-row">
                                    <t t-foreach="dim.option_line_ids" t-as="opt">
                                        <input type="radio"
                                               t-attf-name="dimension_#{dim.dimension_id.id}"
                                               t-att-value="opt.master_option_id.id"
                                               t-attf-id="opt_#{dim.dimension_id.id}_#{opt.master_option_id.id}"
                                               class="option-radio"
                                               required="required"/>
                                        <label t-attf-for="opt_#{dim.dimension_id.id}_#{opt.master_option_id.id}" class="option-label">
                                            <t t-esc="opt.name"/>
                                        </label>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- Justification -->
                <div class="assessment-card">
                    <h5 class="mb-3">Justification</h5>
                    <textarea name="justification" class="form-control" rows="4"
                              placeholder="Explain your reasoning for the ratings above..."></textarea>
                </div>

                <!-- Submit Button -->
                <div class="text-center mb-5">
                    <button type="submit" class="btn btn-submit">
                        Submit &amp; Next →
                    </button>
                    <p class="text-muted mt-2 small">
                        <t t-if="current_index &lt; total_questions">
                            After submitting, you'll proceed to the next question.
                        </t>
                        <t t-else="">
                            This is the last question. Submitting will complete your assessment.
                        </t>
                    </p>
                </div>
            </form>

            <!-- Countdown Timer Script -->
            <t t-if="deadline_iso">
                <script>
                    (function() {
                        var deadline = new Date("<t t-esc="deadline_iso"/>");
                        var timerEl = document.getElementById("countdown-timer");
                        var containerEl = document.getElementById("timer-container");
                        var form = document.querySelector("form");
                        var autoSubmitted = false;

                        function updateTimer() {
                            var now = new Date();
                            var diff = deadline - now;

                            if (diff &lt;= 0) {
                                timerEl.textContent = "00:00:00";
                                if (!autoSubmitted) {
                                    autoSubmitted = true;
                                    containerEl.className = "timer-bar mb-3 timer-danger";
                                    form.submit();
                                }
                                return;
                            }

                            var hours = Math.floor(diff / 3600000);
                            var mins = Math.floor((diff % 3600000) / 60000);
                            var secs = Math.floor((diff % 60000) / 1000);

                            timerEl.textContent =
                                String(hours).padStart(2, "0") + ":" +
                                String(mins).padStart(2, "0") + ":" +
                                String(secs).padStart(2, "0");

                            if (diff &lt; 60000) {
                                containerEl.className = "timer-bar mb-3 timer-danger";
                            } else if (diff &lt; 300000) {
                                containerEl.className = "timer-bar mb-3 timer-warning";
                            }
                        }

                        updateTimer();
                        setInterval(updateTimer, 1000);
                    })();
                </script>
            </t>
        </t>
    </template>

    <!-- Progress Page -->
    <template id="portal_progress_page" name="Assessment Progress">
        <t t-call="etp_assessment.portal_layout">
            <t t-set="page_title" t-value="'Progress - ' + assessment.name"/>

            <div class="assessment-header">
                <h3 class="mb-1"><t t-esc="assessment.name"/></h3>
                <p class="mb-0 opacity-75">
                    <t t-esc="evaluator.employee_id.name"/> — Progress Overview
                </p>
            </div>

            <div class="assessment-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Questions</h5>
                    <span class="badge bg-primary"><t t-esc="answered_count"/> / <t t-esc="total_questions"/> answered</span>
                </div>

                <t t-foreach="question_statuses" t-as="qs">
                    <div class="d-flex align-items-center p-2 mb-2" style="border-radius: 6px; background: #f8f9fa;">
                        <span class="me-3 fw-bold" style="min-width: 30px;">#<t t-esc="qs['index']"/></span>
                        <span class="flex-grow-1"><t t-esc="qs['question'].name"/></span>
                        <t t-if="qs['status'] == 'submitted'">
                            <span class="badge bg-success">✓ Submitted</span>
                        </t>
                        <t t-elif="qs['status'] == 'draft'">
                            <span class="badge bg-warning">Draft</span>
                        </t>
                        <t t-else="">
                            <span class="badge bg-secondary">Pending</span>
                        </t>
                    </div>
                </t>

                <div class="text-center mt-4">
                    <a t-attf-href="/assessment/#{token}" class="btn btn-submit">
                        Continue Assessment →
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>
