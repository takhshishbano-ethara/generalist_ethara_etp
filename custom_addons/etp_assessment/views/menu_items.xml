<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_etp_assessment_dashboard" model="ir.actions.client">
        <field name="name">Assessment Dashboard</field>
        <field name="tag">etp_assessment.dashboard</field>
    </record>

    <record id="action_etp_assessment_prompt" model="ir.actions.client">
        <field name="name">Prompt</field>
        <field name="tag">etp_assessment.prompt_generator</field>
    </record>

    <menuitem id="menu_etp_assessment_root"
              name="ETP Assessment"
              sequence="100"/>

    <menuitem id="menu_etp_assessment_dashboard"
              name="Dashboard"
              parent="menu_etp_assessment_root"
              action="action_etp_assessment_dashboard"
              sequence="1"/>

    <menuitem id="menu_etp_assessment_master"
              name="Configuration"
              parent="menu_etp_assessment_root"
              sequence="50"/>

    <menuitem id="menu_etp_assessment_category"
              name="Categories"
              parent="menu_etp_assessment_master"
              action="action_etp_assessment_category"
              sequence="5"/>

    <menuitem id="menu_etp_assessment_dimension"
              name="Dimensions"
              parent="menu_etp_assessment_master"
              action="action_etp_assessment_dimension"
              sequence="10"/>

    <menuitem id="menu_etp_assessment_question"
              name="Question Bank"
              parent="menu_etp_assessment_root"
              action="action_etp_assessment_question"
              sequence="10"/>

    <menuitem id="menu_etp_assessment_prompt"
              name="Prompt"
              parent="menu_etp_assessment_root"
              action="action_etp_assessment_prompt"
              sequence="11"/>

    <menuitem id="menu_etp_assessment_question_import"
              name="Import Questions"
              parent="menu_etp_assessment_root"
              action="action_etp_assessment_question_import"
              sequence="12"/>


    <menuitem id="menu_etp_assessment_list"
              name="Assessments"
              parent="menu_etp_assessment_root"
              action="action_etp_assessment"
              sequence="20"/>

    <menuitem id="menu_etp_assessment_evaluator_assignments"
              name="Candidate Assignments"
              parent="menu_etp_assessment_root"
              action="action_etp_assessment_evaluator"
              sequence="25"/>

    <menuitem id="menu_etp_assessment_response"
              name="Responses"
              parent="menu_etp_assessment_root"
              action="action_etp_assessment_response"
              sequence="30"/>
</odoo>
