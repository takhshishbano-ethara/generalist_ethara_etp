<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="etp_assessment_day_session_my_tree" model="ir.ui.view">
        <field name="name">etp.assessment.day.session.my.tree</field>
        <field name="model">etp.assessment.day.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="assessment_id"/>
                <field name="day_sequence" string="Day #"/>
                <field name="skill_id"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'locked'"
                       decoration-info="state == 'available'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state in ('submitted','scored')"
                       decoration-danger="state == 'missed'"/>
                <field name="total_questions"/>
                <field name="answered_count"/>
                <field name="scheduled_start" string="Opens"/>
                <field name="started_at"/>
                <field name="deadline_datetime"/>
                <field name="score"/>
                <field name="max_score"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_day_session_my_form" model="ir.ui.view">
        <field name="name">etp.assessment.day.session.my.form</field>
        <field name="model">etp.assessment.day.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_day" string="Start Day"
                            type="object" class="oe_highlight"
                            invisible="state != 'available'"/>
                    <button name="action_submit_day" string="Submit Day"
                            type="object" class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="locked,available,in_progress,submitted,scored"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="assessment_id" readonly="1"/>
                            <field name="day_id" readonly="1"/>
                            <field name="skill_id" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_questions" readonly="1"/>
                            <field name="answered_count" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="deadline_datetime" readonly="1"/>
                            <field name="score" readonly="1"/>
                            <field name="max_score" readonly="1"/>
                            <field name="access_token" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Score Details">
                            <field name="response_ids" readonly="1">
                                <list>
                                    <field name="question_id"/>
                                    <field name="question_type"
                                           string="Type" optional="show"/>
                                    <field name="answer_summary"
                                           string="Candidate Answer"/>
                                    <field name="correct_summary"
                                           string="Correct Answer" optional="show"/>
                                    <field name="score" string="Obj"/>
                                    <field name="max_score" string="Obj Max"/>
                                    <field name="llm_score" string="Subj"/>
                                    <field name="llm_max_score" string="Subj Max"/>
                                    <field name="llm_passed" widget="boolean"
                                           string="Subj Pass"/>
                                    <field name="llm_feedback"
                                           string="Subj Feedback" optional="hide"/>
                                    <field name="llm_state" widget="badge"
                                           string="Subj State"
                                           decoration-info="llm_state in ('pending','queued')"
                                           decoration-success="llm_state == 'scored'"
                                           decoration-muted="llm_state == 'not_needed'"
                                           decoration-danger="llm_state == 'failed'"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="etp_assessment_day_session_my_search" model="ir.ui.view">
        <field name="name">etp.assessment.day.session.my.search</field>
        <field name="model">etp.assessment.day.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="assessment_id"/>
                <field name="skill_id"/>
                <separator/>
                <filter name="filter_upcoming" string="Upcoming"
                        domain="[('state','=','locked')]"/>
                <filter name="filter_available" string="Available Now"
                        domain="[('state','=','available')]"/>
                <filter name="filter_in_progress" string="In Progress"
                        domain="[('state','=','in_progress')]"/>
                <separator/>
                <filter name="filter_history" string="History"
                        domain="[('state','in',('submitted','scored','missed'))]"/>
                <filter name="filter_done" string="Completed"
                        domain="[('state','in',('submitted','scored'))]"/>
                <filter name="filter_missed" string="Missed"
                        domain="[('state','=','missed')]"/>
                <group>
                    <filter name="group_assessment" string="Assessment"
                            context="{'group_by':'assessment_id'}"/>
                    <filter name="group_state" string="State"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_my_assessments" model="ir.actions.act_window">
        <field name="name">My Assessments</field>
        <field name="res_model">etp.assessment.day.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="etp_assessment_day_session_my_search"/>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No assessments assigned yet</p>
            <p>Your assigned assessments — upcoming, active, and completed — will appear here.</p>
        </field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('etp_assessment_day_session_my_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('etp_assessment_day_session_my_form')})]"/>
    </record>

    <record id="etp_assessment_day_admin_tree" model="ir.ui.view">
        <field name="name">etp.assessment.day.admin.tree</field>
        <field name="model">etp.assessment.day</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="assessment_id"/>
                <field name="skill_id"/>
                <field name="question_source"/>
                <field name="question_count"/>
                <field name="available_question_count"/>
                <field name="duration_minutes"/>
                <field name="scheduled_start"/>
            </list>
        </field>
    </record>

    <record id="action_assessment_days_admin" model="ir.actions.act_window">
        <field name="name">Day Plans</field>
        <field name="res_model">etp.assessment.day</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('etp_assessment_day_admin_tree')})]"/>
    </record>

    <record id="action_assessment_day_sessions_admin" model="ir.actions.act_window">
        <field name="name">All Day Sessions</field>
        <field name="res_model">etp.assessment.day.session</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
