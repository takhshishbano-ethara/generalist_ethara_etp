<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         CANDIDATE "MY ASSESSMENTS" — the only tab a candidate sees.
         Kanban grouped Available / Upcoming / Past, each card launches the
         proctored runner. Backed by record rules (own rows only).
         ===================================================================== -->
    <record id="etp_assessment_day_session_my_kanban" model="ir.ui.view">
        <field name="name">etp.assessment.day.session.my.kanban</field>
        <field name="model">etp.assessment.day.session</field>
        <field name="arch" type="xml">
            <kanban default_group_by="bucket" class="o_etp_my_kanban"
                    records_draggable="0" group_create="0" create="0">
                <field name="bucket"/>
                <field name="state"/>
                <field name="access_token"/>
                <field name="score_display"/>
                <field name="assessment_id"/>
                <field name="day_sequence"/>
                <field name="skill_id"/>
                <field name="total_questions"/>
                <field name="duration_minutes"/>
                <field name="scheduled_start"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card p-3">
                            <div class="o_kanban_record_title">
                                <strong><field name="assessment_id"/></strong>
                            </div>
                            <div class="text-muted mb-2">
                                Day <field name="day_sequence"/>:
                                <field name="skill_id"/>
                            </div>
                            <div class="small text-muted">
                                <div><i class="fa fa-question-circle me-1"/><field name="total_questions"/> questions</div>
                                <div t-if="record.duration_minutes.raw_value">
                                    <i class="fa fa-clock-o me-1"/><field name="duration_minutes"/> minutes</div>
                                <div t-if="record.scheduled_start.raw_value">
                                    <i class="fa fa-calendar me-1"/><field name="scheduled_start"/></div>
                            </div>
                            <div class="mt-2">
                                <field name="state" widget="badge"
                                       decoration-muted="state == 'locked'"
                                       decoration-info="state == 'available'"
                                       decoration-warning="state == 'in_progress'"
                                       decoration-success="state in ('submitted','scored')"
                                       decoration-danger="state == 'missed'"/>
                                <span t-if="record.score_display.value"
                                      class="ms-2 fw-bold"><field name="score_display"/></span>
                            </div>
                            <div class="mt-3"
                                 t-if="record.state.raw_value == 'available' or record.state.raw_value == 'in_progress'">
                                <button name="action_open_test" type="object"
                                        class="btn btn-success btn-sm">
                                    <t t-if="record.state.raw_value == 'in_progress'">Resume</t>
                                    <t t-else="">Start</t>
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="etp_assessment_day_session_my_tree" model="ir.ui.view">
        <field name="name">etp.assessment.day.session.my.tree</field>
        <field name="model">etp.assessment.day.session</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="assessment_id"/>
                <field name="day_sequence" string="Day #"/>
                <field name="skill_id"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'locked'"
                       decoration-info="state == 'available'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state in ('submitted','scored')"
                       decoration-danger="state == 'missed'"/>
                <field name="total_questions"/>
                <field name="answered_count"/>
                <field name="duration_minutes"/>
                <field name="scheduled_start"/>
                <field name="score_display" string="Score"/>
                <button name="action_open_test" type="object" string="Start / Resume"
                        class="btn-link" icon="fa-play"
                        invisible="state not in ('available','in_progress')"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_day_session_my_form" model="ir.ui.view">
        <field name="name">etp.assessment.day.session.my.form</field>
        <field name="model">etp.assessment.day.session</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_open_test" string="Start / Resume Test"
                            type="object" class="oe_highlight"
                            invisible="state not in ('available','in_progress')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="locked,available,in_progress,submitted,scored"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="assessment_id" readonly="1"/>
                            <field name="day_id" readonly="1"/>
                            <field name="skill_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_questions" readonly="1"/>
                            <field name="answered_count" readonly="1"/>
                            <field name="duration_minutes" readonly="1"/>
                            <field name="scheduled_start" readonly="1"/>
                            <field name="score_display" string="Score" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="etp_assessment_day_session_my_search" model="ir.ui.view">
        <field name="name">etp.assessment.day.session.my.search</field>
        <field name="model">etp.assessment.day.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="assessment_id"/>
                <field name="skill_id"/>
                <separator/>
                <filter name="filter_available" string="Available"
                        domain="[('bucket','=','available')]"/>
                <filter name="filter_upcoming" string="Upcoming"
                        domain="[('bucket','=','upcoming')]"/>
                <filter name="filter_past" string="Past"
                        domain="[('bucket','=','past')]"/>
                <group>
                    <filter name="group_bucket" string="Bucket"
                            context="{'group_by':'bucket'}"/>
                    <filter name="group_assessment" string="Assessment"
                            context="{'group_by':'assessment_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_my_assessments" model="ir.actions.act_window">
        <field name="name">My Assessments</field>
        <field name="res_model">etp.assessment.day.session</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="etp_assessment_day_session_my_search"/>
        <field name="context">{'search_default_group_bucket': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('etp_assessment_day_session_my_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('etp_assessment_day_session_my_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('etp_assessment_day_session_my_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No assessments assigned yet</p>
            <p>When an assessment is assigned to you, it will appear here. You
               will also receive an email with a link.</p>
        </field>
    </record>

    <record id="etp_assessment_day_admin_tree" model="ir.ui.view">
        <field name="name">etp.assessment.day.admin.tree</field>
        <field name="model">etp.assessment.day</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="assessment_id"/>
                <field name="skill_id"/>
                <field name="question_source"/>
                <field name="question_count"/>
                <field name="available_question_count"/>
                <field name="duration_minutes"/>
                <field name="scheduled_start"/>
            </list>
        </field>
    </record>

    <record id="action_assessment_days_admin" model="ir.actions.act_window">
        <field name="name">Day Plans</field>
        <field name="res_model">etp.assessment.day</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('etp_assessment_day_admin_tree')})]"/>
    </record>

    <record id="action_assessment_day_sessions_admin" model="ir.actions.act_window">
        <field name="name">All Day Sessions</field>
        <field name="res_model">etp.assessment.day.session</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
