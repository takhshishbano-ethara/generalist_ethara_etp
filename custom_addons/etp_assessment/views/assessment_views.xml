<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="etp_assessment_tree" model="ir.ui.view">
        <field name="name">etp.assessment.tree</field>
        <field name="model">etp.assessment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="question_limit"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state == 'in_progress'" decoration-danger="state == 'cancelled'"/>
                <field name="response_count"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_form" model="ir.ui.view">
        <field name="name">etp.assessment.form</field>
        <field name="model">etp.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start Assessment" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_llm_score_all" string="Score Subjective (All)" type="object" icon="fa-magic" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state not in ('cancelled',)"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Assessment Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="category_id" readonly="state != 'draft'"/>
                            <field name="question_limit" readonly="state != 'draft'"/>
                            <field name="total_questions_available"/>
                            <field name="duration_minutes" readonly="state != 'draft'"/>
                        </group>
                        <group string="Schedule">
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                            <field name="deadline"/>
                            <field name="response_count"/>
                        </group>
                    </group>
                    <group>
                        <group string="Rules &amp; Proctoring">
                            <field name="rule_block_tab_switch" readonly="state in ('done', 'cancelled')"/>
                            <field name="rule_block_screenshot" readonly="state in ('done', 'cancelled')"/>
                            <field name="rule_block_copy_paste" readonly="state in ('done', 'cancelled')"/>
                            <field name="rule_block_right_click" readonly="state in ('done', 'cancelled')"/>
                            <field name="rule_block_devtools" readonly="state in ('done', 'cancelled')"/>
                            <field name="rule_watermark" readonly="state in ('done', 'cancelled')"/>
                        </group>
                        <group string="Violations &amp; Answers">
                            <field name="violation_action" widget="radio" readonly="state in ('done', 'cancelled')"/>
                            <field name="require_justification_image_comparison" readonly="state in ('done', 'cancelled')"/>
                            <field name="llm_auto_score" readonly="state in ('done', 'cancelled')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Candidates" invisible="state == 'draft'">
                            <field name="assessment_evaluator_ids" readonly="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-warning="state == 'in_progress'" decoration-success="state == 'submitted'"/>
                                    <field name="started_at"/>
                                    <field name="deadline_datetime"/>
                                    <field name="answered_count"/>
                                    <field name="total_questions"/>
                                    <field name="total_score"/>
                                    <field name="max_possible_score"/>
                                    <field name="llm_total_score" string="Subjective Pts" optional="show"/>
                                    <field name="llm_state" widget="badge" optional="show" decoration-success="llm_state == 'scored'" decoration-danger="llm_state == 'failed'"/>
                                    <field name="score_percent" string="Final Score /100" optional="show"/>
                                    <field name="result" widget="badge" decoration-success="result == 'pass'" decoration-danger="result == 'fail'" decoration-muted="result == 'pending'"/>
                                    <field name="is_locked"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assign Candidates" invisible="state != 'draft'">
                            <group string="Manual Assignment">
                                <field name="evaluator_ids" widget="many2many_tags" nolabel="1"/>
                            </group>
                            <group string="Import from CSV">
                                <group>
                                    <field name="candidate_csv_file" filename="candidate_csv_filename"/>
                                    <field name="candidate_csv_filename" invisible="1"/>
                                </group>
                                <group>
                                    <button name="action_import_candidates_csv" string="Import Candidates" type="object" class="oe_highlight" icon="fa-upload"/>
                                    <button name="action_download_candidate_template" string="Download Template" type="object" icon="fa-download"/>
                                </group>
                            </group>
                        </page>
                        <page string="Selected Questions" invisible="state == 'draft'">
                            <field name="question_ids" readonly="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="prompt"/>
                                    <field name="category_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Responses">
                            <field name="response_ids" readonly="1">
                                <list>
                                    <field name="evaluator_id"/>
                                    <field name="question_id"/>
                                    <field name="objective_score" string="Objective"/>
                                    <field name="objective_max" string="Obj Max" optional="hide"/>
                                    <field name="needs_llm" string="Subjective?" widget="boolean"/>
                                    <field name="subjective_result" widget="badge" string="Subjective"
                                           decoration-success="subjective_result == 'pass'"
                                           decoration-danger="subjective_result == 'fail'"/>
                                    <field name="subjective_score" string="Subj Points" optional="show"/>
                                    <field name="subjective_reasoning" string="Reasoning" optional="show"/>
                                    <field name="llm_state" widget="badge" string="Subj State" optional="hide"
                                           decoration-info="llm_state in ('pending','queued')"
                                           decoration-success="llm_state == 'scored'"
                                           decoration-muted="llm_state == 'not_needed'"
                                           decoration-danger="llm_state == 'failed'"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'submitted'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etp_assessment" model="ir.actions.act_window">
        <field name="name">Assessments</field>
        <field name="res_model">etp.assessment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Assessment Evaluator Views -->
    <record id="etp_assessment_evaluator_tree" model="ir.ui.view">
        <field name="name">etp.assessment.evaluator.tree</field>
        <field name="model">etp.assessment.evaluator</field>
        <field name="arch" type="xml">
            <list>
                <field name="assessment_id"/>
                <field name="employee_id"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'" decoration-warning="state == 'in_progress'" decoration-success="state == 'submitted'"/>
                <field name="answered_count"/>
                <field name="total_questions"/>
                <field name="total_score"/>
                <field name="llm_total_score" string="Subjective Pts" optional="show"/>
                <field name="score_percent" string="Final Score /100" optional="show"/>
                <field name="result" widget="badge" decoration-success="result == 'pass'" decoration-danger="result == 'fail'" decoration-muted="result == 'pending'"/>
                <field name="llm_state" widget="badge" string="Subj State" optional="show" decoration-success="llm_state == 'scored'" decoration-danger="llm_state == 'failed'"/>
                <field name="is_locked"/>
                <field name="is_violated" widget="boolean" decoration-danger="is_violated"/>
                <field name="violation_reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_evaluator_form" model="ir.ui.view">
        <field name="name">etp.assessment.evaluator.form</field>
        <field name="model">etp.assessment.evaluator</field>
        <field name="arch" type="xml">
             <form>
                <header>
                    <button name="action_llm_score" string="Score Subjective" type="object" icon="fa-magic" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,submitted"/>
                </header>
                <div class="alert alert-danger" invisible="not is_violated" role="alert">
                    <strong>⚠️ Violation:</strong> <field name="violation_reason" readonly="1"/> — <field name="violation_datetime" readonly="1"/>
                </div>
                <sheet>
                    <group>
                        <group>
                            <field name="assessment_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="total_questions"/>
                            <field name="answered_count"/>
                            <field name="total_score"/>
                            <field name="max_possible_score"/>
                            <field name="objective_total" string="Objective Total"/>
                            <field name="objective_max_total" string="Objective Max"/>
                            <field name="llm_total_score" string="Subjective Total"/>
                            <field name="llm_max_score" string="Subjective Max"/>
                            <field name="subjective_pending" string="Subjective Pending"/>
                            <field name="llm_state" string="Subjective State"/>
                            <field name="llm_scored_at"/>
                            <field name="llm_error" invisible="not llm_error"/>
                            <field name="is_locked"/>
                            <field name="is_violated"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Responses">
                            <field name="response_ids">
                                <list>
                                    <field name="question_id"/>
                                    <field name="objective_score" string="Objective"/>
                                    <field name="needs_llm" string="Subjective?" widget="boolean"/>
                                    <field name="subjective_result" widget="badge" string="Subjective"
                                           decoration-success="subjective_result == 'pass'"
                                           decoration-danger="subjective_result == 'fail'"/>
                                    <field name="subjective_score" string="Subj Points" optional="show"/>
                                    <field name="subjective_reasoning" string="Reasoning" optional="show"/>
                                    <field name="llm_state" widget="badge" string="Subj State" optional="hide"
                                           decoration-info="llm_state in ('pending','queued')"
                                           decoration-success="llm_state == 'scored'"
                                           decoration-muted="llm_state == 'not_needed'"
                                           decoration-danger="llm_state == 'failed'"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etp_assessment_evaluator" model="ir.actions.act_window">
        <field name="name">Candidate Assignments</field>
        <field name="res_model">etp.assessment.evaluator</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Response Views -->
    <record id="etp_assessment_response_tree" model="ir.ui.view">
        <field name="name">etp.assessment.response.tree</field>
        <field name="model">etp.assessment.response</field>
        <field name="arch" type="xml">
            <list>
                <field name="assessment_id"/>
                <field name="evaluator_id"/>
                <field name="question_id"/>
                <field name="objective_score" string="Objective"/>
                <field name="needs_llm" string="Subjective?" widget="boolean"/>
                <field name="subjective_result" widget="badge" string="Subjective"
                       decoration-success="subjective_result == 'pass'"
                       decoration-danger="subjective_result == 'fail'"/>
                <field name="subjective_score" string="Subj Points" optional="show"/>
                <field name="llm_state" widget="badge" string="Subj State" optional="hide"
                       decoration-info="llm_state in ('pending','queued')"
                       decoration-success="llm_state == 'scored'"
                       decoration-muted="llm_state == 'not_needed'"
                       decoration-danger="llm_state == 'failed'"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="etp_assessment_response_form" model="ir.ui.view">
        <field name="name">etp.assessment.response.form</field>
        <field name="model">etp.assessment.response</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="assessment_id" readonly="1"/>
                            <field name="evaluator_id" readonly="1"/>
                            <field name="question_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="objective_score" string="Objective Score"/>
                            <field name="objective_max" string="Objective Max"/>
                            <field name="needs_llm" string="Needs Subjective"/>
                            <field name="subjective_result" widget="badge" string="Subjective Result"
                                   decoration-success="subjective_result == 'pass'"
                                   decoration-danger="subjective_result == 'fail'"/>
                            <field name="subjective_score" string="Subjective Points"/>
                            <field name="llm_max_score" string="Subjective Max"/>
                            <field name="llm_state" string="Subjective State"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dimension Answers">
                            <field name="line_ids" readonly="state == 'submitted'">
                                <list editable="bottom">
                                    <field name="dimension_id"/>
                                    <field name="selected_option_id" domain="[('dimension_id', '=', dimension_id)]"/>
                                </list>
                            </field>
                        </page>
                        <page string="Justification">
                            <field name="justification" nolabel="1" placeholder="Provide your justification..." readonly="state == 'submitted'"/>
                        </page>
                        <page string="Subjective Reasoning" invisible="llm_state in ('not_needed', 'pending', 'queued')">
                            <field name="llm_feedback" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etp_assessment_response" model="ir.actions.act_window">
        <field name="name">Responses</field>
        <field name="res_model">etp.assessment.response</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
