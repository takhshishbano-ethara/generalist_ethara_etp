<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="etp_assessment.Dashboard">
        <div class="etp-dash">
            <div class="etp-dash-header">
                <div class="etp-dash-header-left">
                    <h1 class="etp-dash-title">ETP Assessment</h1>
                    <span class="etp-dash-subtitle">Dashboard &amp; Analytics</span>
                </div>
                <div class="etp-dash-header-right">
                    <button class="btn btn-primary" t-on-click="() => this.openAssessments()">
                        <i class="fa fa-list me-1"/> All Assessments
                    </button>
                    <button class="btn btn-outline-primary ms-2" t-on-click="openQuestions">
                        <i class="fa fa-database me-1"/> Question Bank
                    </button>
                </div>
            </div>

            <div t-if="!state.loaded" class="etp-dash-loading">
                <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
                <span>Loading dashboard…</span>
            </div>

            <div t-if="state.loaded" class="etp-dash-body">

                <div class="etp-dash-kpi-row">
                    <div class="etp-dash-kpi-card etp-kpi-assessments" t-on-click="() => this.openAssessments()">
                        <div class="etp-dash-kpi-icon"><i class="fa fa-clipboard"/></div>
                        <div class="etp-dash-kpi-value"><t t-esc="state.kpis.total_assessments"/></div>
                        <div class="etp-dash-kpi-label">Total Assessments</div>
                        <div class="etp-dash-kpi-breakdown">
                            <span class="etp-mini etp-mini-draft"><t t-esc="state.kpis.draft"/> draft</span>
                            <span class="etp-mini etp-mini-active"><t t-esc="state.kpis.in_progress"/> active</span>
                            <span class="etp-mini etp-mini-done"><t t-esc="state.kpis.done"/> done</span>
                        </div>
                    </div>
                    <div class="etp-dash-kpi-card etp-kpi-questions" t-on-click="openQuestions">
                        <div class="etp-dash-kpi-icon"><i class="fa fa-question-circle"/></div>
                        <div class="etp-dash-kpi-value"><t t-esc="state.kpis.total_questions"/></div>
                        <div class="etp-dash-kpi-label">Questions</div>
                    </div>
                    <div class="etp-dash-kpi-card etp-kpi-evaluators" t-on-click="openEvaluators">
                        <div class="etp-dash-kpi-icon"><i class="fa fa-users"/></div>
                        <div class="etp-dash-kpi-value"><t t-esc="state.kpis.total_evaluators"/></div>
                        <div class="etp-dash-kpi-label">Candidate Assignments</div>
                        <div class="etp-dash-kpi-breakdown">
                            <span class="etp-mini etp-mini-draft"><t t-esc="state.kpis.evaluators_pending"/> pending</span>
                            <span class="etp-mini etp-mini-active"><t t-esc="state.kpis.evaluators_in_progress"/> active</span>
                            <span class="etp-mini etp-mini-done"><t t-esc="state.kpis.evaluators_submitted"/> done</span>
                        </div>
                    </div>
                    <div class="etp-dash-kpi-card etp-kpi-responses" t-on-click="openResponses">
                        <div class="etp-dash-kpi-icon"><i class="fa fa-check-square-o"/></div>
                        <div class="etp-dash-kpi-value"><t t-esc="state.kpis.responses_submitted"/></div>
                        <div class="etp-dash-kpi-label">Responses Submitted</div>
                        <div class="etp-dash-kpi-breakdown">
                            <span class="etp-mini"><t t-esc="state.kpis.total_responses"/> total</span>
                            <span class="etp-mini etp-mini-draft"><t t-esc="state.kpis.responses_draft"/> draft</span>
                        </div>
                    </div>
                    <div class="etp-dash-kpi-card etp-kpi-completion">
                        <div class="etp-dash-kpi-icon"><i class="fa fa-pie-chart"/></div>
                        <div class="etp-dash-kpi-value"><t t-esc="state.kpis.completion_rate"/>%</div>
                        <div class="etp-dash-kpi-label">Completion Rate</div>
                    </div>
                </div>

                <div class="etp-dash-charts-row">
                    <div class="etp-dash-chart-card">
                        <h3 class="etp-dash-chart-title">Question Types</h3>
                        <div class="etp-dash-chart-body">
                            <canvas t-ref="questionTypeChart"/>
                        </div>
                    </div>
                    <div class="etp-dash-chart-card">
                        <h3 class="etp-dash-chart-title">Questions by Category</h3>
                        <div class="etp-dash-chart-body">
                            <canvas t-ref="categoryChart"/>
                        </div>
                    </div>
                    <div class="etp-dash-chart-card">
                        <h3 class="etp-dash-chart-title">Completion Status</h3>
                        <div class="etp-dash-chart-body">
                            <canvas t-ref="completionChart"/>
                        </div>
                    </div>
                </div>

                <div class="etp-dash-panels-row">
                    <div class="etp-dash-panel">
                        <div class="etp-dash-panel-header">
                            <span><i class="fa fa-bolt me-2"/>Active Assessments</span>
                            <button class="btn btn-sm btn-link" t-on-click="() => this.openAssessments('in_progress')">
                                View All <i class="fa fa-arrow-right ms-1"/>
                            </button>
                        </div>
                        <div class="etp-dash-panel-body">
                            <t t-if="!state.active_work.length">
                                <div class="etp-dash-empty">No active assessments.</div>
                            </t>
                            <t t-foreach="state.active_work" t-as="a" t-key="a.id">
                                <div class="etp-dash-row" t-on-click="() => this.openAssessmentRecord(a.id)">
                                    <div class="etp-dash-row-name">
                                        <strong><t t-esc="a.name"/></strong>
                                        <span class="etp-dash-row-meta">
                                            <t t-esc="a.evaluators_done"/>/<t t-esc="a.evaluators_total"/> candidates done
                                        </span>
                                    </div>
                                    <div class="etp-dash-progress-bar">
                                        <div class="etp-dash-progress-fill"
                                             t-attf-style="width: {{a.evaluators_total ? Math.round(a.evaluators_done / a.evaluators_total * 100) : 0}}%"/>
                                    </div>
                                    <div t-if="a.end_date" class="etp-dash-row-date">
                                        <i class="fa fa-clock-o me-1"/><t t-esc="a.end_date.split('T')[0]"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="etp-dash-panel">
                        <div class="etp-dash-panel-header">
                            <span><i class="fa fa-trophy me-2"/>Top Candidates</span>
                            <button class="btn btn-sm btn-link" t-on-click="openEvaluators">
                                View All <i class="fa fa-arrow-right ms-1"/>
                            </button>
                        </div>
                        <div class="etp-dash-panel-body">
                            <t t-if="!state.evaluator_performance.length">
                                <div class="etp-dash-empty">No completed evaluations yet.</div>
                            </t>
                            <t t-foreach="state.evaluator_performance" t-as="ev" t-key="ev.id">
                                <div class="etp-dash-row">
                                    <div class="etp-dash-row-name">
                                        <strong><t t-esc="ev.name"/></strong>
                                        <span class="etp-dash-row-meta"><t t-esc="ev.assessment_name"/></span>
                                    </div>
                                    <div class="etp-dash-score">
                                        <span class="etp-dash-score-value"><t t-esc="ev.total_score"/>/<t t-esc="ev.max_possible"/></span>
                                        <span class="etp-dash-score-pct">(<t t-esc="scorePercentage(ev.total_score, ev.max_possible)"/>)</span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <div class="etp-dash-dimension-section" t-if="state.dimension_stats.length">
                    <div class="etp-dash-panel etp-dash-panel-full">
                        <div class="etp-dash-panel-header">
                            <span><i class="fa fa-bar-chart me-2"/>Dimension Analytics</span>
                        </div>
                        <div class="etp-dash-panel-body">
                            <div class="etp-dash-chart-body etp-dash-chart-wide">
                                <canvas t-ref="dimensionChart"/>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
