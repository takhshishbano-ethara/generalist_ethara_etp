<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="etp_assessment.PromptGenerator">
    <div class="o_etp_prompt p-3" style="max-width: 1100px; margin: 0 auto;">

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Prompt → Question Bank</h2>
        <button class="btn btn-link" t-on-click="() => state.showSystemPrompts = !state.showSystemPrompts">
          <i class="fa fa-cog me-1"/> System Prompts
        </button>
      </div>

      <!-- editable system prompts -->
      <div t-if="state.showSystemPrompts" class="card mb-3">
        <div class="card-body">
          <div class="mb-3">
            <label class="fw-bold">Skills extraction system prompt</label>
            <textarea class="form-control" rows="3" t-model="state.sysSkills"/>
            <button class="btn btn-sm btn-secondary mt-2" t-on-click="() => this.onSaveSystemPrompt('skills')">Save</button>
          </div>
          <div>
            <label class="fw-bold">Question generation system prompt</label>
            <textarea class="form-control" rows="3" t-model="state.sysQuestions"/>
            <button class="btn btn-sm btn-secondary mt-2" t-on-click="() => this.onSaveSystemPrompt('questions')">Save</button>
          </div>
        </div>
      </div>

      <!-- INPUT -->
      <div class="card mb-3">
        <div class="card-body">
          <div class="row g-2 mb-2">
            <div class="col-md-6">
              <label class="form-label">Title</label>
              <input class="form-control" t-model="state.title"/>
            </div>
            <div class="col-md-6">
              <label class="form-label">Target Category (for approved questions)</label>
              <select class="form-select" t-model.number="state.categoryId">
                <option value="0">— None —</option>
                <option t-foreach="state.categories" t-as="c" t-key="c.id" t-att-value="c.id" t-esc="c.name"/>
              </select>
            </div>
          </div>
          <label class="form-label">Source Text (SOP / instructions / any text)</label>
          <textarea class="form-control" rows="7" t-model="state.sourceText"
                    placeholder="Paste the project SOP or instructions here..."/>
          <div class="mt-3">
            <button class="btn btn-primary" t-on-click="onExtractSkills" t-att-disabled="state.loadingSkills">
              <i t-if="state.loadingSkills" class="fa fa-spinner fa-spin me-1"/>
              <i t-else="" class="fa fa-magic me-1"/>
              Skills
            </button>
          </div>
        </div>
      </div>

      <!-- SKILLS -->
      <div t-if="state.skills.length or state.loadingSkills" class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-bold">Skills <span class="badge bg-secondary" t-esc="state.skills.length"/></span>
          <button class="btn btn-success btn-sm" t-on-click="onGenerateQuestions"
                  t-att-disabled="state.loadingQuestions or !state.skills.length">
            <i t-if="state.loadingQuestions" class="fa fa-spinner fa-spin me-1"/>
            <i t-else="" class="fa fa-cogs me-1"/>
            Generate Questions
          </button>
        </div>
        <div class="list-group list-group-flush">
          <div t-foreach="state.skills" t-as="s" t-key="s.id" class="list-group-item d-flex justify-content-between align-items-center">
            <div class="me-3">
              <div class="fw-bold" t-esc="s.name"/>
              <small class="text-muted" t-esc="s.description"/>
            </div>
            <div class="d-flex align-items-center" style="white-space: nowrap;">
              <label class="me-2 small text-muted">Max Q</label>
              <input type="number" min="1" max="20" class="form-control form-control-sm"
                     style="width: 70px;" t-model.number="s.max_questions"/>
            </div>
          </div>
        </div>
      </div>

      <!-- QUESTIONS grouped by skill -->
      <div t-if="state.questions.length or state.loadingQuestions" class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-bold">Generated Questions
            <span class="badge bg-secondary" t-esc="state.questions.length"/>
          </span>
          <span class="badge bg-success">Approved: <t t-esc="approvedCount"/></span>
        </div>
        <div class="card-body">
          <div t-if="state.loadingQuestions and !state.questions.length" class="text-center text-muted py-4">
            <i class="fa fa-spinner fa-spin fa-2x"/>
            <div class="mt-2">Generating questions…</div>
          </div>

          <div t-foreach="questionsBySkill" t-as="grp" t-key="grp.skill" class="mb-4">
            <h5 class="border-bottom pb-1">
              <i class="fa fa-tag me-1 text-primary"/><t t-esc="grp.skill"/>
              <span class="badge bg-light text-dark ms-2" t-esc="grp.items.length"/>
            </h5>
            <table class="table table-sm align-middle">
              <thead>
                <tr>
                  <th style="width: 30%;">Title</th>
                  <th>Question</th>
                  <th style="width: 90px;">Type</th>
                  <th style="width: 160px;" class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <tr t-foreach="grp.items" t-as="q" t-key="q.id"
                    t-attf-class="{{ q.state === 'approved' ? 'table-success' : q.state === 'denied' ? 'table-danger text-muted' : '' }}">
                  <td t-esc="q.name"/>
                  <td><small t-esc="q.question_prompt"/></td>
                  <td><span class="badge bg-info text-dark" t-esc="q.question_type"/></td>
                  <td class="text-end">
                    <t t-if="q.state === 'draft'">
                      <button class="btn btn-sm btn-success me-1" t-on-click="() => this.onDecision(q, true)">
                        <i class="fa fa-check"/> Approve
                      </button>
                      <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.onDecision(q, false)">
                        <i class="fa fa-times"/> Deny
                      </button>
                    </t>
                    <span t-elif="q.state === 'approved'" class="badge bg-success">Added to bank</span>
                    <span t-else="" class="badge bg-danger">Denied</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </t>

</templates>
