<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="etp_assessment.PromptGenerator">
    <div class="o_etp_prompt p-3" style="max-width: 1100px; margin: 0 auto;">

      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Question Generation</h2>
        <button class="btn btn-link" t-on-click="() => state.showSystemPrompts = !state.showSystemPrompts">
          <i class="fa fa-cog me-1"/> System Prompts
        </button>
      </div>

      <!-- editable system prompts: SEED + SCORING (the two live prompts) -->
      <div t-if="state.showSystemPrompts" class="card mb-3">
        <div class="card-body">
          <div class="mb-3">
            <label class="fw-bold">Seed prompt (resources + golden example → questions)</label>
            <textarea class="form-control" rows="4" t-model="state.sysSeed"/>
            <button class="btn btn-sm btn-secondary mt-2" t-on-click="() => this.onSaveSystemPrompt('seed')">Save</button>
          </div>
          <div>
            <label class="fw-bold">Scoring prompt (grades submitted answers, sees images)</label>
            <textarea class="form-control" rows="4" t-model="state.sysScoring"/>
            <button class="btn btn-sm btn-secondary mt-2" t-on-click="() => this.onSaveSystemPrompt('scoring')">Save</button>
          </div>
        </div>
      </div>

      <!-- INPUT -->
      <div class="card mb-3">
        <div class="card-body">
          <div class="row g-2 mb-3">
            <div class="col-md-4">
              <label class="form-label">Title</label>
              <input class="form-control" t-model="state.title"/>
            </div>
            <div class="col-md-4">
              <label class="form-label">Target Category (auto-created if empty)</label>
              <select class="form-select" t-model.number="state.categoryId">
                <option value="0">— Auto —</option>
                <option t-foreach="state.categories" t-as="c" t-key="c.id" t-att-value="c.id" t-esc="c.name"/>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Max Questions (0 = model decides)</label>
              <input type="number" min="0" max="100" class="form-control" t-model.number="state.maxQuestions"/>
            </div>
          </div>

          <!-- RESOURCE FILES -->
          <label class="form-label fw-bold">Resource Files (SOP, instruction docs — .docx / .txt / .md)</label>
          <input type="file" multiple="multiple" accept=".docx,.txt,.md,.csv,.html" style="display:none;" t-ref="fileInput" t-on-change="onFilesSelected"/>
          <div class="border rounded p-2 mb-3" style="background: #fafafa;">
            <div t-if="!state.resources.length" class="text-muted small py-2 text-center">
              No files uploaded yet — the seed prompt reads these to extract skills and questions.
            </div>
            <div t-foreach="state.resources" t-as="r" t-key="r.id"
                 class="d-flex justify-content-between align-items-center py-1 border-bottom">
              <div>
                <i class="fa fa-file-text-o me-2 text-primary"/>
                <span t-esc="r.name"/>
                <span t-if="!r.extraction_error" class="badge bg-light text-dark ms-2">
                  <t t-esc="Math.round(r.char_count / 1000)"/>k chars
                </span>
                <span t-else="" class="badge bg-warning text-dark ms-2" t-att-title="r.extraction_error">
                  <i class="fa fa-exclamation-triangle me-1"/>no text
                </span>
              </div>
              <button class="btn btn-sm btn-link text-danger" t-on-click="() => this.onRemoveResource(r)">
                <i class="fa fa-trash"/>
              </button>
            </div>
            <div class="mt-2 d-flex align-items-center">
              <button class="btn btn-outline-primary btn-sm" t-on-click="onPickFiles" t-att-disabled="state.uploading">
                <i t-if="state.uploading" class="fa fa-spinner fa-spin me-1"/>
                <i t-else="" class="fa fa-upload me-1"/>
                Upload Files
              </button>
              <small t-if="state.resources.length" class="text-muted ms-3">
                <t t-esc="state.resources.length"/> file(s) · ~<t t-esc="Math.round(totalChars / 1000)"/>k chars total
              </small>
            </div>
          </div>

          <!-- GOLDEN EXAMPLE -->
          <label class="form-label fw-bold">Golden Example Question</label>
          <textarea class="form-control mb-3" rows="3" t-model="state.goldenExample"
                    placeholder="Paste ONE exemplary question showing the desired style, depth and format..."/>

          <label class="form-label">Additional Notes (optional)</label>
          <textarea class="form-control mb-3" rows="2" t-model="state.notes"
                    placeholder="Optional extra instructions appended after the files..."/>

          <button class="btn btn-primary" t-on-click="onGenerate" t-att-disabled="state.loadingQuestions">
            <i t-if="state.loadingQuestions" class="fa fa-spinner fa-spin me-1"/>
            <i t-else="" class="fa fa-magic me-1"/>
            Generate Questions
          </button>
        </div>
      </div>

      <!-- QUESTIONS -->
      <div t-if="state.questions.length or state.loadingQuestions" class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-bold">Generated Questions
            <span class="badge bg-secondary" t-esc="state.questions.length"/>
            <span class="badge bg-success ms-1">Approved: <t t-esc="approvedCount"/></span>
          </span>
          <div>
            <button t-if="pendingImgCount" class="btn btn-info btn-sm me-2"
                    t-on-click="onGenerateImages" t-att-disabled="state.loadingImages">
              <i t-if="state.loadingImages" class="fa fa-spinner fa-spin me-1"/>
              <i t-else="" class="fa fa-picture-o me-1"/>
              Generate Images (<t t-esc="pendingImgCount"/>)
            </button>
            <button class="btn btn-success btn-sm" t-on-click="onApproveAll">
              <i class="fa fa-check-square-o me-1"/> Approve All
            </button>
          </div>
        </div>
        <div class="card-body">
          <div t-if="state.loadingQuestions and !state.questions.length" class="text-center text-muted py-4">
            <i class="fa fa-spinner fa-spin fa-2x"/>
            <div class="mt-2">Generating questions…</div>
          </div>

          <div t-foreach="state.questions" t-as="q" t-key="q.id"
               t-attf-class="border rounded p-3 mb-3 {{ q.state === 'approved' ? 'border-success bg-success-subtle' : q.state === 'denied' ? 'border-danger opacity-50' : '' }}">
            <div class="d-flex justify-content-between align-items-start">
              <div class="me-3">
                <div class="fw-bold">
                  <t t-esc="q.name"/>
                  <span class="badge bg-info text-dark ms-2" t-esc="q.question_type"/>
                  <span t-if="q.image_state === 'generated'" class="badge bg-success ms-1">images ready</span>
                  <span t-elif="q.image_state === 'pending'" class="badge bg-warning text-dark ms-1">images pending</span>
                  <span t-elif="q.image_state === 'failed'" class="badge bg-danger ms-1" t-att-title="q.image_error">images failed</span>
                </div>
                <small class="text-muted" t-esc="q.question_prompt"/>
              </div>
              <div style="white-space: nowrap;">
                <t t-if="q.state === 'draft'">
                  <button class="btn btn-sm btn-success me-1" t-on-click="() => this.onDecision(q, true)">
                    <i class="fa fa-check"/> Approve
                  </button>
                  <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.onDecision(q, false)">
                    <i class="fa fa-times"/> Deny
                  </button>
                </t>
                <span t-elif="q.state === 'approved'" class="badge bg-success">Added to bank</span>
                <span t-else="" class="badge bg-danger">Denied</span>
              </div>
            </div>

            <!-- image prompts + thumbnails for image_comparison -->
            <div t-if="q.question_type === 'image_comparison'" class="row g-2 mt-2">
              <div class="col-md-6">
                <small class="text-muted d-block">Prompt A: <t t-esc="q.image_prompt_a"/></small>
                <img t-if="q.image_state === 'generated'" t-att-src="imgUrl(q, 'a')"
                     class="img-thumbnail mt-1" style="max-height: 140px;"/>
              </div>
              <div class="col-md-6">
                <small class="text-muted d-block">Prompt B: <t t-esc="q.image_prompt_b"/></small>
                <img t-if="q.image_state === 'generated'" t-att-src="imgUrl(q, 'b')"
                     class="img-thumbnail mt-1" style="max-height: 140px;"/>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </t>

</templates>
