<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Inherited to add more fields-->
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.inherit.odoo.slack.connector</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//page[@name='general_info']" position="after">
                    <page name="stack_integration"
                          string="Slack Configuration">
                        <group>
                            <group>
                                <field name="token" password="True"/>
                            </group>
                            <group>
                                <button name="action_sync"
                                        string="Sync with Slack"
                                        type="object"
                                        class="oe_highlight"/>
                                <field name="slack_sync" invisible="1"/>
                            </group>
                        </group>
                        <!-- Last sync results -->
                        <group invisible="slack_sync == False"
                               string="Last Sync Results">
                            <group>
                                <field name="slack_last_sync"/>
                                <field name="slack_sync_matched"/>
                            </group>
                            <group>
                                <field name="slack_sync_already_linked"/>
                                <field name="slack_sync_unmatched"/>
                            </group>
                        </group>
                        <notebook invisible="slack_sync == False">
                            <page string="Users">
                                <group>
                                    <field name="slack_users_ids">
                                        <list create="false" delete="0">
                                            <field name="name"/>
                                            <field name="email"/>
                                            <field name="user"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page string="Channels">
                                <group>
                                    <field name="slack_channel_ids">
                                        <list
                                              create="false" delete="0">
                                            <field name="name"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </page>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
